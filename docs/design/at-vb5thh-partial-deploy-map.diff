+
+# Deploy map. dotfiles.root is the clone: it comes from MISE_DOTFILES_ROOT, else the
+# [settings.dotfiles] default above. Group entries resolve relative sources against that
+# root, so the clone can live anywhere and no source names a path. exclude = ["**"] stops
+# the group walking the rest of the repo into $HOME; only the entries below deploy.
+[dotfile_groups.dev-profile]
+root = "."
+exclude = ["**"]
+
+[dotfile_groups.dev-profile.entries]
+"~/.agents" = { source = "agents", mode = "symlink" }
+"~/.config/dprint/dprint.jsonc" = { source = "config/dprint.jsonc", mode = "symlink" }
+"~/.config/hk/config.pkl" = { source = "hk/hk.pkl", mode = "symlink" }
+"~/.config/mise/conf.d/dev-profile" = { source = "profile", mode = "symlink" }
+"~/.config/worktrunk/config.toml/dev-profile" = { source = "config/worktrunk.toml", merge = true }
+"~/.config/yamllint/config" = { source = "config/yamllint.yaml", mode = "symlink" }
+"~/.local/share/dev-profile/bin" = { source = "bin", mode = "symlink" }
+"~/.local/share/dev-profile/mise.zsh" = { source = "shell/mise.zsh", mode = "symlink" }
+"~/.local/share/dev-profile/shell.zsh" = { source = "shell/shell.zsh", mode = "symlink" }
+"~/.local/share/dev-profile/xdg" = { source = "xdg", mode = "symlink" }
+"~/.stylelintrc.json" = { source = "config/stylelintrc.json", mode = "symlink" }

