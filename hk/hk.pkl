// House style for every repository on this machine.
//
// Every step is one of hk's builtins, under the name the profile has always used
// for it. The builtin supplies the command, the file globs and the fix, so this
// file carries policy only — globs, exclusions, ordering, profiles — and no tool
// invocations. What stays written here is the two rules hk does not ship: the
// TypeScript security gate, and the branch guard.
//
// Which files a step sees is hk's job, not a wrapper's. The pre-push hook
// measures the files a push introduces once and hands hk that list
// (hk run pre-push --files0-from); pre-commit hands hk what is staged.
//
// A repository that wants different rules opts out in its own configuration
// instead of being detected:
//
//   git config --local hk.skipSteps "golangci-lint,brakeman"
//   git config --local hk.skipHook pre-push
//
// or carries its own hk.pkl, which hk reads ahead of this file.

amends "package://github.com/jdx/hk/releases/download/v2.11.0/hk@2.11.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.11.0/hk@2.11.0#/Builtins.pkl"

fail_fast = false
stash_backup_count = 20
exclude =
  List(
    "**/testdata",
    "**/fixtures",
    "**/node_modules",
    "**/.venv",
    "**/vendor",
    "**/third_party",
    "**/dist",
    "**/build",
    "**/coverage",
    "**/.next",
    "**/.turbo",
    "**/.cache",
    "**/.beads",
  )

local lockfiles =
  List(
    "**/aube-lock.yaml",
    "**/pnpm-lock.yaml",
    "**/package-lock.json",
    "**/go.sum",
    "**/bun.lock*",
    "**/*.lock",
  )

local jsGlobs =
  List(
    "**/*.js",
    "**/*.mjs",
    "**/*.cjs",
    "**/*.ts",
    "**/*.mts",
    "**/*.cts",
    "**/*.jsx",
    "**/*.tsx",
    "**/*.vue",
    "**/*.svelte",
    "**/*.astro",
  )

local pyGlobs = List("**/*.py", "**/*.pyi")
local mdGlobs = List("**/*.md", "**/*.markdown")
local goGlobs = List("**/*.go")
local tfGlobs = List("**/*.tf", "**/*.tfvars")
local allGlobs = List("**/*")

local k8sGlobs =
  List(
    "**/k8s/**/*.yaml",
    "**/k8s/**/*.yml",
    "**/kubernetes/**/*.yaml",
    "**/kubernetes/**/*.yml",
    "**/manifests/**/*.yaml",
    "**/manifests/**/*.yml",
    "**/deploy/**/*.yaml",
    "**/deploy/**/*.yml",
    "**/deployments/**/*.yaml",
    "**/deployments/**/*.yml",
  )

local k8sExclude =
  List(
    "**/templates/**",
    "**/values.yaml",
    "**/values.yml",
    "**/values-*.yaml",
    "**/values-*.yml",
    "**/kustomization.yaml",
    "**/kustomization.yml",
  )

local workflowGlobs = List(".github/workflows/*.yml", ".github/workflows/*.yaml")

local fixers = new Mapping<String, Step> {
  ["dprint"] = (Builtins.dprint) {
    exclude = lockfiles
    depends =
      List(
        "stylelint",
        "oxlint-fix",
        "ruff-fix",
        "go-imports",
        "tofu-fix",
        "newlines",
        "trailing-whitespace",
      )
  }
  ["stylelint"] = Builtins.stylelint
  ["go-imports"] = (Builtins.go_imports) { glob = goGlobs }
  ["oxlint-fix"] = (Builtins.ox_lint) { glob = jsGlobs }
  // hk's ruff builtin runs check with --fix and formats; the rule families stay
  // the profile's choice.
  ["ruff-fix"] = (Builtins.ruff) { glob = pyGlobs }
  ["markdownlint-fix"] = (Builtins.markdown_lint) {
    glob = mdGlobs
    exclude = List("agents/learnings/**")
  }
  ["newlines"] = (Builtins.newlines) { glob = allGlobs }
  ["trailing-whitespace"] = (Builtins.trailing_whitespace) { glob = allGlobs }
  ["tofu-fix"] = (Builtins.tofu) { glob = tfGlobs }
}

local gates = new Mapping<String, Step> {
  ["hadolint"] = (Builtins.hadolint) { glob = List("**/Dockerfile*") }
  ["actionlint"] = (Builtins.actionlint) { glob = workflowGlobs }
  ["pinact"] = (Builtins.pinact) { glob = List(".github/workflows/*", "**/action.*") }
  ["zizmor"] = (Builtins.zizmor) {
    glob =
      List(
        ".github/workflows/*.yml",
        ".github/workflows/*.yaml",
        ".github/dependabot.yml",
        "**/action.yml",
        "**/action.yaml",
      )
  }
  ["gosec"] = (Builtins.go_sec) {
    glob = goGlobs
    dir = "{{workspace}}"
    workspace_indicator = "go.mod"
  }
  ["go-vet"] = (Builtins.go_vet) {
    glob = goGlobs
    dir = "{{workspace}}"
    workspace_indicator = "go.mod"
  }
  ["golangci-lint"] = (Builtins.golangci_lint) {
    glob = goGlobs
    dir = "{{workspace}}"
    workspace_indicator = "go.mod"
  }
  ["govulncheck"] = (Builtins.go_vuln_check) {
    glob = List("**/go.mod", "**/go.sum")
    dir = "{{workspace}}"
    workspace_indicator = "go.mod"
  }
  // Foxguard judges every TypeScript file with the retained pack plus its own built-ins. Findings are fixed by hand.
  // It replaced the semgrep gate on 2026-11-03: semgrep's own transitive pins carried Dependabot moderates no
  // semgrep release fixes (mcp==1.29.0, opentelemetry-api~=1.37.0 are hard requirements of the scanner itself).
  // security/fixtures/manifest.json records the measured detections, including the pack rules Foxguard misses.
  ["foxguard-typescript"] {
    check =
      "RAYON_NUM_THREADS=2 mise x github:0sec-labs/foxguard@0.14.1 -- foxguard diff --rules ~/.config/foxguard/typescript.yml origin/main"
    glob = List("**/*.ts", "**/*.mts", "**/*.cts", "**/*.tsx")
  }
  ["kube-linter"] = (Builtins.kube_linter) {
    glob = k8sGlobs
    exclude = k8sExclude
  }
  ["kubeconform"] = (Builtins.kubeconform) {
    glob = k8sGlobs
    exclude = k8sExclude
  }
  ["markdownlint"] = (Builtins.markdown_lint) {
    glob = mdGlobs
    exclude = List("agents/learnings/**")
  }
  ["ruff"] = (Builtins.ruff) { glob = pyGlobs }
  ["oxlint"] = (Builtins.ox_lint) { glob = jsGlobs }
  ["tofu"] = (Builtins.tofu) { glob = tfGlobs }
  // betterleaks reports per path; the files a push does not introduce are debt
  // the push did not write, and the hook hands hk only the introduced ones.
  ["betterleaks"] = Builtins.betterleaks
  ["case-conflicts"] = Builtins.check_case_conflict
  ["check-added-large-files"] = (Builtins.check_added_large_files) { exclude = lockfiles }
  ["check-executables-have-shebangs"] = Builtins.check_executables_have_shebangs
  ["check-symlinks"] = Builtins.check_symlinks
  ["destroyed-symlinks"] = Builtins.destroyed_symlinks
  ["forbid-submodules"] = Builtins.forbid_submodules
  ["gitleaks"] = Builtins.gitleaks
  ["merge-conflicts"] = Builtins.check_merge_conflict
  ["private-keys"] = Builtins.detect_private_key
  ["strict-json"] = (Builtins.jq) {
    glob = List("**/*.json")
    exclude =
      lockfiles
        + List(
          "**/tsconfig*.json",
          "**/jsconfig*.json",
          "**/.devcontainer/**",
          "**/.vscode/**",
          "**/zed/**/*.json",
        )
  }
  ["brakeman"] = Builtins.brakeman
  ["bundle-audit"] = Builtins.bundle_audit
  ["cargo-deny"] = (Builtins.cargo_deny) {
    glob = List("**/Cargo.toml", "**/Cargo.lock", "**/deny.toml", "**/.deny.toml")
    dir = "{{workspace}}"
    workspace_indicator = "Cargo.lock"
  }
  // shellcheck 0.11.0 has no zsh dialect: a shell directive errors (SC1103) and
  // the sh parser cannot read zsh constructs. .zsh files are sourced by zsh, so
  // they are out of scope for the step rather than filtered by a wrapper.
  ["shellcheck"] = (Builtins.shellcheck) { exclude = List("**/*.zsh") }
  ["yamllint"] = (Builtins.yamllint) {
    glob = List("**/*.yml", "**/*.yaml")
    exclude = lockfiles + List("**/cloud-init.yaml")
  }
}

hooks {
  ["commit-msg"] {
    steps {
      // Conventional Commits subject, as hk's own check reads it.
      ["conventional-commit"] = Builtins.check_conventional_commit
    }
  }
  ["pre-commit"] {
    fix = true
    stash = "git"
    // A direct commit on main/master is refused here, before anything else runs.
    // The step is glob-less on purpose: hk still runs it for an empty commit, so
    // the branch check cannot be skipped by having nothing staged.
    steps = new Mapping<String, Step> {
      ...fixers
      ["no-commit-to-default-branch"] { check = "dev-profile-no-commit-to-default-branch" }
    }
  }
  ["pre-push"] {
    // Magic by default: fix everything fixable before gating, so a push heals
    // its own lint debt instead of bouncing. The hook hands hk the files the
    // push introduces, so every step judges only those.
    fix = true
    stash = "git"
    steps = new Mapping<String, Step> { ...fixers; ...gates }
  }
  ["fix"] {
    fix = true
    steps = fixers
  }
  ["check"] {
    steps = new Mapping<String, Step> { ...fixers; ...gates }
  }
}
