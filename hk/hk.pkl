amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"

// Native replacement for the frozen dev-profile hook set: every step calls a mise-pinned tool directly.
// Steps that existed only as dev-profile bin wrappers (hardcoded-dev-port, identity-guard, no-trunk-prettier,
// suppressions, go-mod-tidy, perlcritic, php-lint, ty, clang-tidy, pushed-diagnostics) are deliberately absent.
// ruff and markdownlint route through dev-profile-new-findings, which blocks only the findings a change
// introduces: a fork branch that merged upstream is not judged on upstream's own lines.
fail_fast = false
stash_backup_count = 20
exclude =
  List(
    "**/testdata",
    "**/fixtures",
    "**/node_modules",
    "**/.venv",
    "**/vendor",
    "**/third_party",
    "**/dist",
    "**/build",
    "**/coverage",
    "**/.next",
    "**/.turbo",
    "**/.cache",
    "**/.beads",
  )

local lockfiles =
  List(
    "**/aube-lock.yaml",
    "**/pnpm-lock.yaml",
    "**/package-lock.json",
    "**/go.sum",
    "**/bun.lock*",
    "**/*.lock",
  )

local jsGlobs =
  List(
    "**/*.js",
    "**/*.mjs",
    "**/*.cjs",
    "**/*.ts",
    "**/*.mts",
    "**/*.cts",
    "**/*.jsx",
    "**/*.tsx",
    "**/*.vue",
    "**/*.svelte",
    "**/*.astro",
  )

local k8sGlobs =
  List(
    "**/k8s/**/*.yaml",
    "**/k8s/**/*.yml",
    "**/kubernetes/**/*.yaml",
    "**/kubernetes/**/*.yml",
    "**/manifests/**/*.yaml",
    "**/manifests/**/*.yml",
    "**/deploy/**/*.yaml",
    "**/deploy/**/*.yml",
    "**/deployments/**/*.yaml",
    "**/deployments/**/*.yml",
  )

local k8sExclude =
  List(
    "**/templates/**",
    "**/values.yaml",
    "**/values.yml",
    "**/values-*.yaml",
    "**/values-*.yml",
    "**/kustomization.yaml",
    "**/kustomization.yml",
  )

// shellcheck 0.11.0 has no zsh dialect: a shell directive errors (SC1103) and
// the sh parser cannot read zsh constructs. .zsh files are sourced by zsh and
// are excluded from shellcheck on purpose.
local shellFiles =
  """
  shell_files() {
    for f in "$@"; do
      case "$f" in
        *.sh|*.bash|*.ksh|*.dash|*.bats) echo "$f" ;;
        *)
          if head -n 1 "$f" 2>/dev/null | grep -Eq '^#![[:space:]]*(/usr/bin/env[[:space:]]+(-S[[:space:]]+)?)?([^[:space:]]*/)?(sh|bash|ksh|dash|bats)([[:space:]]|$)'; then echo "$f"; fi
          ;;
      esac
    done
  }
  """
local fixers = new Mapping<String, Step> {
  ["dprint"] {
    check = "dprint check --allow-no-files {{files}}"
    fix = "dprint fmt --allow-no-files {{files}}"
    exclude = lockfiles
    depends =
      List(
        "stylelint",
        "oxlint-fix",
        "ruff-fix",
        "go-imports",
        "tofu-fix",
        "newlines",
        "trailing-whitespace",
      )
  }
  ["stylelint"] {
    fix = "stylelint --fix {{files}}"
    glob = List("**/*.css", "**/*.scss", "**/*.sass")
  }
  ["go-imports"] {
    fix = "goimports -w {{files}}"
    check_list_files = "goimports -l {{files}}"
    glob = List("**/*.go")
  }
  ["oxlint-fix"] {
    fix = "oxlint --fix {{files}}"
    glob = jsGlobs
  }
  ["ruff-fix"] {
    fix =
      "ruff check --force-exclude --fix-only --unsafe-fixes --extend-select UP,FURB,SIM,PERF,C4,PIE {{files}}"
    glob = List("**/*.py", "**/*.pyi")
  }
  ["markdownlint-fix"] {
    fix = "markdownlint --fix {{files}}"
    glob = List("**/*.md", "**/*.markdown")
    exclude = List("agents/learnings/**")
  }
  // hk runs a glob-less step even for an empty commit; a glob lets hk skip it.
  ["newlines"] {
    fix = "hk util end-of-file-fixer --fix {{files}}"
    check_diff = "hk util end-of-file-fixer --diff {{files}}"
    glob = List("**/*")
  }
  ["trailing-whitespace"] {
    fix = "hk util trailing-whitespace --fix {{files}}"
    check_diff = "hk util trailing-whitespace --diff {{files}}"
    glob = List("**/*")
  }
  ["tofu-fix"] {
    fix = "tofu fmt {{files}}"
    glob = List("**/*.tf", "**/*.tfvars")
  }
}

local gates = new Mapping<String, Step> {
  ["hadolint"] { check = "hadolint {{files}}"; glob = List("**/Dockerfile*") }
  ["actionlint"] {
    check = "dev-profile-new-findings actionlint {{files}}"
    glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
    diagnostic_format = "gcc"
  }
  ["pinact"] {
    check = "dev-profile-new-findings pinact {{files}}"
    glob = List(".github/workflows/*", "**/action.*")
  }
  ["zizmor"] {
    check = "dev-profile-new-findings zizmor {{files}}"
    glob =
      List(
        ".github/workflows/*.yml",
        ".github/workflows/*.yaml",
        ".github/dependabot.yml",
        "**/action.yml",
        "**/action.yaml",
      )
  }
  ["gosec"] {
    check = "gosec ./..."
    glob = List("**/*.go")
    dir = "{{workspace}}"
    workspace_indicator = "go.mod"
  }
  ["go-vet"] {
    check = "go vet ./..."
    glob = List("**/*.go")
    dir = "{{workspace}}"
    workspace_indicator = "go.mod"
  }
  ["golangci-lint"] {
    check = "golangci-lint run --fix=false --allow-parallel-runners ./..."
    fix = "golangci-lint run --fix ./..."
    glob = List("**/*.go")
    dir = "{{workspace}}"
    workspace_indicator = "go.mod"
  }
  ["govulncheck"] {
    check = "govulncheck ./..."
    glob = List("**/go.mod", "**/go.sum")
    dir = "{{workspace}}"
    workspace_indicator = "go.mod"
  }
  ["oxlint"] { check = "oxlint {{files}}"; fix = "oxlint --fix {{files}}"; glob = jsGlobs }
  // Foxguard judges every TypeScript file with the retained pack plus its own built-ins. Findings are fixed by hand.
  // It replaced the semgrep gate on 2026-11-03: semgrep's own transitive pins carried Dependabot moderates no
  // semgrep release fixes (mcp==1.29.0, opentelemetry-api~=1.37.0 are hard requirements of the scanner itself).
  // security/fixtures/manifest.json records the measured detections, including the pack rules Foxguard misses.
  ["foxguard-typescript"] {
    check =
      "RAYON_NUM_THREADS=2 mise x github:0sec-labs/foxguard@0.14.1 -- foxguard diff --rules ~/.config/foxguard/typescript.yml origin/main"
    glob = List("**/*.ts", "**/*.mts", "**/*.cts", "**/*.tsx")
  }
  ["kube-linter"] {
    check = "kube-linter lint --fail-if-no-objects-found {{files}}"
    glob = k8sGlobs
    exclude = k8sExclude
  }
  ["kubeconform"] {
    check = "kubeconform -summary -strict -ignore-missing-schemas {{files}}"
    glob = k8sGlobs
    exclude = k8sExclude
  }
  ["markdownlint"] {
    check = "dev-profile-new-findings markdownlint {{files}}"
    fix = "dev-profile-new-findings --fix markdownlint {{files}}"
    glob = List("**/*.md", "**/*.markdown")
    exclude = List("agents/learnings/**")
  }
  ["ruff"] {
    check = "dev-profile-new-findings ruff {{files}}"
    fix = "dev-profile-new-findings --fix ruff {{files}}"
    glob = List("**/*.py", "**/*.pyi")
  }
  ["betterleaks"] {
    check = "betterleaks dir --redact --verbose --no-banner --confidence medium {{files}}"
    glob = List("**/*")
  }
  ["case-conflicts"] { check = "hk util check-case-conflict {{files}}"; glob = List("**/*") }
  ["check-added-large-files"] {
    check = "hk util check-added-large-files {{files}}"
    glob = List("**/*")
    exclude = lockfiles
  }
  ["check-executables-have-shebangs"] {
    check = "hk util check-executables-have-shebangs {{files}}"
    glob = List("**/*")
  }
  ["check-symlinks"] { check = "hk util check-symlinks {{files}}"; glob = List("**/*") }
  ["destroyed-symlinks"] { check = "hk util destroyed-symlinks" }
  ["forbid-submodules"] { check = "hk util forbid-submodules"; glob = List("**/.gitmodules") }
  // gitleaks FTLs on a missing --config path, so pass one only when the repository ships it.
  ["gitleaks"] {
    check =
      "config=\"\"\nif [ -f .gitleaks.toml ]; then\n  config=\"--config .gitleaks.toml\"\nfi\ngitleaks git $config --redact --no-banner --log-opts=\"HEAD --not --remotes\""
  }
  ["merge-conflicts"] {
    check = "hk util check-merge-conflict --assume-in-merge {{files}}"
    glob = List("**/*")
  }
  ["private-keys"] { check = "hk util detect-private-key {{files}}"; glob = List("**/*") }
  ["strict-json"] {
    check =
      "status=0\nfor file in {{files}}; do\n  jq empty \"$file\" || { echo \"not strict JSON: $file\" >&2; status=1; }\ndone\nexit $status"
    glob = List("**/*.json")
    exclude =
      lockfiles
        + List(
          "**/tsconfig*.json",
          "**/jsconfig*.json",
          "**/.devcontainer/**",
          "**/.vscode/**",
          "**/zed/**/*.json",
        )
  }
  ["brakeman"] {
    check = "brakeman --no-pager --quiet"
    glob =
      List(
        "**/*.rb",
        "**/*.rake",
        "**/*.erb",
        "**/*.ru",
        "**/Gemfile",
        "**/Gemfile.lock",
        "**/Rakefile",
      )
  }
  ["bundle-audit"] { check = "bundle-audit check"; glob = List("**/Gemfile.lock") }
  ["cargo-deny"] {
    check = "cargo-deny --locked --workspace check"
    glob = List("**/Cargo.toml", "**/Cargo.lock", "**/deny.toml", "**/.deny.toml")
    dir = "{{workspace}}"
    workspace_indicator = "Cargo.lock"
  }
  ["shellcheck"] {
    check =
      "\(shellFiles)\nFILES=$(shell_files {{files}})\n[ -n \"$FILES\" ] || exit 0\nshellcheck --severity=warning $FILES"
  }
  ["tofu"] { check = "tofu fmt -check {{files}}"; glob = List("**/*.tf", "**/*.tfvars") }
  ["yamllint"] {
    check = "dev-profile-new-findings yamllint {{files}}"
    glob = List("**/*.yml", "**/*.yaml")
    exclude = lockfiles + List("**/cloud-init.yaml")
  }
}

hooks {
  ["commit-msg"] {
    steps {
      // Conventional Commits subject: type(scope)!: description, under 72 characters.
      ["conventional-commit"] {
        check =
          "head -n1 {{commit_msg_file}} | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\\([^)]+\\))?!?: .{1,60}$'"
      }
    }
  }
  ["pre-commit"] {
    fix = true
    stash = "git"
    // A direct commit on main/master is refused here, before anything else runs.
    // The step is glob-less on purpose: hk still runs it for an empty commit, so
    // the branch check cannot be skipped by having nothing staged.
    steps = new Mapping<String, Step> {
      ...fixers
      ["no-commit-to-default-branch"] { check = "dev-profile-no-commit-to-default-branch" }
    }
  }
  ["pre-push"] {
    // Magic by default: fix everything fixable before gating, so a push heals
    // its own lint debt instead of bouncing.
    fix = true
    stash = "git"
    steps = new Mapping<String, Step> { ...fixers; ...gates }
  }
  ["fix"] {
    fix = true
    steps = fixers
  }
  ["check"] {
    steps = new Mapping<String, Step> { ...fixers; ...gates }
  }
}
