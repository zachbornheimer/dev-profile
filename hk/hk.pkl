amends "package://github.com/jdx/hk/releases/download/v2.10.0/hk@2.10.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.10.0/hk@2.10.0#/Builtins.pkl"

// House style for every repository on this machine.
//
// The runner owns file selection, so a step declares the files it touches and the
// command it runs on them, and hk derives its read/write locks from that. Two
// consequences shape this file:
//
//   - A step that is one tool over the files hk hands it is hk's own builtin. The
//     builtin supplies the command and the optimizations hk can only apply to a
//     builtin -- check_diff (a patch computed under read locks), check_list_files,
//     check_first, batch, declared effects -- so what stays here is policy: globs,
//     exclusions, ordering.
//   - A step whose tool needs more than a file list (a ratchet, a package scope, a
//     budget, a whole-app path) keeps its command and says so with
//     `exclusive = true`, because hk would otherwise schedule it as if it only
//     touched its own selection. Those steps read or scan more than they declare.
//
// Which files a push judges is the hook's job, not each step's. dev-profile-pre-push
// measures the files the push introduces once and hands hk that list
// (`hk run pre-push --files0-from <file>`); a branch that merged its default branch
// therefore answers only for what it wrote. pre-commit hands hk the staged files.
//
// Steps that existed only as dev-profile bin wrappers (hardcoded-dev-port,
// identity-guard, no-trunk-prettier, suppressions, go-mod-tidy, perlcritic,
// php-lint, ty, clang-tidy, pushed-diagnostics) are deliberately absent.
fail_fast = false
stash_backup_count = 20
exclude =
  List(
    "**/testdata",
    "**/fixtures",
    "**/node_modules",
    "**/.venv",
    "**/vendor",
    "**/third_party",
    "**/dist",
    "**/build",
    "**/coverage",
    "**/.next",
    "**/.turbo",
    "**/.cache",
    "**/.beads",
  )

local lockfiles =
  List(
    "**/aube-lock.yaml",
    "**/pnpm-lock.yaml",
    "**/package-lock.json",
    "**/go.sum",
    "**/bun.lock*",
    "**/*.lock",
  )

local jsGlobs =
  List(
    "**/*.js",
    "**/*.mjs",
    "**/*.cjs",
    "**/*.ts",
    "**/*.mts",
    "**/*.cts",
    "**/*.jsx",
    "**/*.tsx",
    "**/*.vue",
    "**/*.svelte",
    "**/*.astro",
  )

local pyGlobs = List("**/*.py", "**/*.pyi")
local mdGlobs = List("**/*.md", "**/*.markdown")
local tfGlobs = List("**/*.tf", "**/*.tfvars")
local yamlGlobs = List("**/*.yml", "**/*.yaml")

local k8sGlobs =
  List(
    "**/k8s/**/*.yaml",
    "**/k8s/**/*.yml",
    "**/kubernetes/**/*.yaml",
    "**/kubernetes/**/*.yml",
    "**/manifests/**/*.yaml",
    "**/manifests/**/*.yml",
    "**/deploy/**/*.yaml",
    "**/deploy/**/*.yml",
    "**/deployments/**/*.yaml",
    "**/deployments/**/*.yml",
  )

local k8sExclude =
  List(
    "**/templates/**",
    "**/values.yaml",
    "**/values.yml",
    "**/values-*.yaml",
    "**/values-*.yml",
    "**/kustomization.yaml",
    "**/kustomization.yml",
  )

// shellcheck 0.11.0 has no zsh dialect: a shell directive errors (SC1103) and
// the sh parser cannot read zsh constructs. .zsh files are sourced by zsh and
// are excluded from shellcheck on purpose. The filter prints, of the files it
// is handed, the ones shellcheck can read; it carries no double quote, so it
// rides inside the single-quoted `sh -c` argument below.
local shellcheckFilter =
  """
  for file in "$@"; do
    case "$file" in
    *.sh|*.bash|*.ksh|*.dash|*.bats) echo "$file" ;;
    *)
      if head -n 1 "$file" 2>/dev/null | grep -Eq "^#![[:space:]]*(/usr/bin/env[[:space:]]+(-S[[:space:]]+)?)?([^[:space:]]*/)?(sh|bash|ksh|dash|bats)([[:space:]]|$)"; then
        echo "$file"
      fi
      ;;
    esac
  done
  """

local fixers = new Mapping<String, Step> {
  // dprint holds the write lock on its files and waits for the other fixers, so a
  // formatter never rewrites a file another fixer is still editing.
  ["dprint"] = (Builtins.dprint) {
    exclude = lockfiles
    depends =
      List(
        "stylelint",
        "oxlint-fix",
        "ruff-fix",
        "go-imports",
        "tofu-fix",
        "newlines",
        "trailing-whitespace",
      )
  }
  // stylelint exits 78 with a ConfigurationError when the repo supplies no config, and hk
  // dumps that stderr whenever any unrelated step fails. dev-profile-stylelint-fix absorbs
  // the no-config and unfixable-lint output and falls back to the profile's config.
  ["stylelint"] {
    fix = "dev-profile-stylelint-fix -- {{files}}"
    glob = List("**/*.css", "**/*.scss", "**/*.sass")
  }
  ["go-imports"] = (Builtins.go_imports) { glob = List("**/*.go") }
  // hk's oxlint builtin denies warnings; ours used to warn and pass. The builtin's
  // command is the profile's policy now: a warning is a finding.
  ["oxlint-fix"] = (Builtins.ox_lint) { glob = jsGlobs }
  // --fix-only never reports or exits non-zero on leftover violations, so this
  // fixer cannot block a push on inherited findings and stays bare.
  ["ruff-fix"] {
    fix =
      "ruff check --force-exclude --fix-only --unsafe-fixes --extend-select UP,FURB,SIM,PERF,C4,PIE -- {{files}}"
    glob = pyGlobs
  }
  ["markdownlint-fix"] = (Builtins.markdown_lint) {
    glob = mdGlobs
    exclude = List("agents/learnings/**")
  }
  // hk runs a glob-less step even for an empty commit; a glob lets hk skip it.
  ["newlines"] = (Builtins.newlines) { glob = List("**/*") }
  ["trailing-whitespace"] = (Builtins.trailing_whitespace) { glob = List("**/*") }
  ["tofu-fix"] = (Builtins.tofu) { glob = tfGlobs }
}

local gates = new Mapping<String, Step> {
  ["hadolint"] = (Builtins.hadolint) { glob = List("**/Dockerfile*") }
  ["actionlint"] = (Builtins.actionlint) {
    glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
    diagnostic_format = "gcc"
  }
  ["pinact"] = (Builtins.pinact) { glob = List(".github/workflows/*", "**/action.*") }
  ["zizmor"] = (Builtins.zizmor) {
    glob =
      List(
        ".github/workflows/*.yml",
        ".github/workflows/*.yaml",
        ".github/dependabot.yml",
        "**/action.yml",
        "**/action.yaml",
      )
  }
  // gosec's verdict belongs to dev-profile-gosec-packages: it gosecs the
  // packages holding the pushed files but fails only on findings located in
  // those files, so a finding already sitting in an untouched file of the same
  // package does not block a push that did not introduce it
  // (tests/gosec-fixture.sh pins that policy). It compiles whole packages, so it
  // reads beyond the files it is handed: exclusive.
  ["gosec"] {
    check = "dev-profile-gosec-packages -- {{files}}"
    glob = List("**/*.go")
    dir = "{{workspace}}"
    workspace_indicator = "go.mod"
    exclusive = true
  }
  ["go-vet"] = (Builtins.go_vet) {
    glob = List("**/*.go")
    dir = "{{workspace}}"
    workspace_indicator = "go.mod"
    exclusive = true
  }
  // The push gate rides dev-profile-golangci-ratchet, which reports only the
  // issues the branch adds on top of origin's default branch: debt already on
  // the default branch is what the push inherited, not what it introduces. It
  // carries no fixer: the step's whole-workspace `--fix` rewrote every module
  // in the tree mid-push, and the whole-tree steps that ran after it (gosec,
  // go-vet) then judged files the fixer had broken.
  ["golangci-lint"] {
    check = "dev-profile-golangci-ratchet"
    glob = List("**/*.go")
    dir = "{{workspace}}"
    workspace_indicator = "go.mod"
    exclusive = true
  }
  ["govulncheck"] = (Builtins.go_vuln_check) {
    glob = List("**/go.mod", "**/go.sum")
    dir = "{{workspace}}"
    workspace_indicator = "go.mod"
    exclusive = true
  }
  ["oxlint"] = (Builtins.ox_lint) { glob = jsGlobs }
  // Foxguard judges every TypeScript file with the retained pack plus its own built-ins. Findings are fixed by hand.
  // It replaced the semgrep gate on 2026-11-03: semgrep's own transitive pins carried Dependabot moderates no
  // semgrep release fixes (mcp==1.29.0, opentelemetry-api~=1.37.0 are hard requirements of the scanner itself).
  // security/fixtures/manifest.json records the measured detections, including the pack rules Foxguard misses.
  // The step judges the files this push introduces, not the tree: `foxguard diff` walks every file on both sides
  // whatever path it is given (6754 TypeScript files in can1357/oh-my-pi cost 30-70 minutes a push, and every fix
  // round paid it again). dev-profile-foxguard-introduced scans only those files through the engine's
  // `--changed-files-from` mode and suppresses what the target's own copy of them reports, so the verdict is the
  // diff's while the scan takes seconds (tests/foxguard-introduced-fixture.sh pins both halves).
  // The pack is a Semgrep import, so the importer re-prints its readiness report on stderr at every load --
  // ~500 "Warning: taint rule ..." lines whether or not the scan finds anything. That report is already recorded
  // in the manifest and asserted by dev-env's `mise run test:foxguard`, so it is kept for a failing scan only.
  // The scan is budgeted: foxguard 0.14.1 re-scans the whole tree per invocation (~10 min with this pack on
  // oh-my-pi) and its new-findings phase degenerates to ~1% CPU on a monorepo-size diff -- reproduced with a
  // one-rule pack, so the pack is not the trigger -- wedging the step far past every push runner's deadline.
  // A wedged step meant a wedged gate: the runner SIGKILLed the push job, `hk run pre-push` died with
  // "Killed: 9", and no verdict was ever reported. The budget fails the step closed instead: the gate always
  // reaches a verdict, the scan still runs in full whenever it keeps up, and the push is blocked (never
  // waved through) when the scanner cannot. DEV_PROFILE_FOXGUARD_BUDGET (seconds) overrides the budget.
  // hk has no per-step timeout, so the budget lives in the command; exclusive keeps it from
  // racing the fixers that rewrite the tree it scans.
  ["foxguard-typescript"] {
    check =
      """
      err=$(mktemp)
      rc=0
      budget="${DEV_PROFILE_FOXGUARD_BUDGET:-1200}"
      timeout -k 30 "${budget}" env RAYON_NUM_THREADS=2 dev-profile-foxguard-introduced --rules ~/.config/foxguard/typescript.yml --target origin/main -- {{files}} 2>"$err" || rc=$?
      [ "$rc" -eq 0 ] || cat "$err" >&2
      if [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; then
        echo "foxguard-typescript: scan exceeded its ${budget}s budget; failing closed -- foxguard wedges on monorepo-size diffs, and unbudgeted it stopped any verdict from being reported" >&2
      fi
      rm -f "$err"
      exit "$rc"
      """
    glob = List("**/*.ts", "**/*.mts", "**/*.cts", "**/*.tsx")
    exclusive = true
  }
  ["kube-linter"] = (Builtins.kube_linter) { glob = k8sGlobs; exclude = k8sExclude }
  ["kubeconform"] = (Builtins.kubeconform) { glob = k8sGlobs; exclude = k8sExclude }
  ["markdownlint"] = (Builtins.markdown_lint) {
    glob = mdGlobs
    exclude = List("agents/learnings/**")
  }
  ["ruff"] = (Builtins.ruff) { glob = pyGlobs }
  // betterleaks' builtin filters its candidates to `types = ["text"]`, and hk types a
  // file holding a key body as non-text: the builtin skipped the very files a secret
  // scan exists for (measured on a probe tree of nine files -- eight matched, the
  // ninth being the committed key). The builtin's command runs verbatim without that
  // filter, and keeps this profile's --confidence medium.
  ["betterleaks"] {
    check = "betterleaks dir --redact --verbose --no-banner --confidence medium -- {{files}}"
    glob = List("**/*")
  }
  ["case-conflicts"] = (Builtins.check_case_conflict) { glob = List("**/*") }
  // The util has no added-only flag, so the wrapper narrows the candidates to the
  // files this push adds; without it a merge-carried large file would block a push
  // that did not add it.
  ["check-added-large-files"] {
    check = "dev-profile-changed-files --added hk util check-added-large-files -- {{files}}"
    glob = List("**/*")
    exclude = lockfiles
  }
  ["check-executables-have-shebangs"] = (Builtins.check_executables_have_shebangs) {
    glob = List("**/*")
  }
  ["check-symlinks"] = (Builtins.check_symlinks) { glob = List("**/*") }
  ["destroyed-symlinks"] = (Builtins.destroyed_symlinks) { glob = List("**/*") }
  ["forbid-submodules"] = (Builtins.forbid_submodules) { glob = List("**/.gitmodules") }
  // gitleaks FTLs on a missing --config path, so pass one only when the repository ships it.
  // It scans a commit range, not the files it is handed, so it stays exclusive.
  ["gitleaks"] {
    check =
      "config=\"\"\nif [ -f .gitleaks.toml ]; then\n  config=\"--config .gitleaks.toml\"\nfi\ngitleaks git $config --redact --no-banner --log-opts=\"HEAD --not --remotes\""
    exclusive = true
  }
  ["merge-conflicts"] = (Builtins.check_merge_conflict) { glob = List("**/*") }
  // hk's detect_private_key builtin carries the same `types = ["text"]` filter and drops
  // the same extension-less key file (tests/pre-push-empty-file-list-fixture.sh pins it:
  // a pushed .deploy-key must fail the push). Its command runs verbatim without the filter.
  ["private-keys"] {
    check = "hk util detect-private-key -- {{files}}"
    glob = List("**/*")
  }
  ["strict-json"] {
    check =
      "sh -c 'status=0\nfor file in \"$@\"; do\n  jq empty \"$file\" || { echo \"not strict JSON: $file\" >&2; status=1; }\ndone\nexit $status' sh -- {{files}}"
    glob = List("**/*.json")
    exclude =
      lockfiles
        + List(
          "**/tsconfig*.json",
          "**/jsconfig*.json",
          "**/.devcontainer/**",
          "**/.vscode/**",
          "**/zed/**/*.json",
        )
  }
  // Brakeman takes one application path, never the changed files, and bundle-audit takes
  // a project directory, never a lockfile: both wrappers scan each file from the root that
  // holds it, so an app below the repo root is scanned as its own project. Both read a
  // whole application, so both are exclusive.
  ["brakeman"] {
    check = "dev-profile-brakeman {{files}}"
    glob =
      List(
        "**/*.rb",
        "**/*.rake",
        "**/*.erb",
        "**/*.ru",
        "**/Gemfile",
        "**/Gemfile.lock",
        "**/Rakefile",
      )
    exclusive = true
  }
  ["bundle-audit"] {
    check = "dev-profile-bundle-audit {{files}}"
    glob = List("**/Gemfile.lock")
    exclusive = true
  }
  ["cargo-deny"] = (Builtins.cargo_deny) {
    glob = List("**/Cargo.toml", "**/Cargo.lock", "**/deny.toml", "**/.deny.toml")
    dir = "{{workspace}}"
    workspace_indicator = "Cargo.lock"
    exclusive = true
  }
  // The filter prints only the given files shellcheck can read, and a push of
  // none of them leaves it empty: xargs then runs shellcheck with no file, and
  // its usage error fails the push. `-r` (a no-op on BSD xargs, which already
  // skips the empty run) keeps that from happening.
  ["shellcheck"] {
    check = "sh -c '\(shellcheckFilter)' sh -- {{files}} | xargs -r shellcheck --severity=warning"
  }
  ["tofu"] = (Builtins.tofu) { glob = tfGlobs }
  ["yamllint"] = (Builtins.yamllint) {
    check = "yamllint --strict -- {{files}}"
    glob = yamlGlobs
    exclude = lockfiles + List("**/cloud-init.yaml")
  }
}

hooks {
  ["commit-msg"] {
    steps {
      // Conventional Commits subject: type(scope)!: description, under 72 characters.
      // A merge commit carries Git's own "Merge ..." subject instead, so the merge
      // commit being created is exempt: MERGE_HEAD exists only while it is in
      // flight, and every other commit still has to be conventional.
      ["conventional-commit"] {
        check =
          "git rev-parse -q --verify MERGE_HEAD >/dev/null || head -n1 {{commit_msg_file}} | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\\([^)]+\\))?!?: .{1,60}$'"
      }
    }
  }
  ["pre-commit"] {
    fix = true
    stash = "git"
    // A direct commit on main/master is refused here, before anything else runs.
    // The step is glob-less on purpose: hk still runs it for an empty commit, so
    // the branch check cannot be skipped by having nothing staged.
    steps = new Mapping<String, Step> {
      ...fixers
      ["no-commit-to-default-branch"] { check = "dev-profile-no-commit-to-default-branch" }
    }
  }
  ["pre-push"] {
    // Magic by default: fix everything fixable before gating, so a push heals
    // its own lint debt instead of bouncing. dev-profile-pre-push measures the
    // files the push introduces and hands hk that list with --files0-from, so
    // every step judges only what the push introduces.
    fix = true
    stash = "git"
    // hk has no per-step timeout. The whole gate gets one so a wedged tool fails
    // the hook (with a message naming the timeout) instead of outliving the push
    // runner's deadline, which used to kill the job with no verdict at all.
    timeout = "30m"
    steps = new Mapping<String, Step> { ...fixers; ...gates }
  }
  ["fix"] {
    fix = true
    steps = fixers
  }
  ["check"] {
    steps = new Mapping<String, Step> { ...fixers; ...gates }
  }
}
