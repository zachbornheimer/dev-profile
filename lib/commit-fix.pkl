/// `wt step commit --fix`: commit, and on failure hand the errors to omp.
///
/// `wt step commit` is a built-in, so it rejects `--fix` before any alias can
/// see it. This package's bin directory is on PATH ahead of the worktrunk
/// install, so the generated `wt` there strips the flag and runs the script
/// the alias also calls. The notice is zsh `print` on stderr: alias bodies
/// run under sh, and the user is told in the shell they are using.
module commitfix

import "../profile.pkl"

aliases: Mapping<String, String> = new {
  ["commit-fix"] = "\(profile.installPath)/bin/dev-profile-commit-fix step commit {{ args }}"
}

wrappers: Mapping<String, String> = new {
  // lib/commit-fix.sh: the real wt; on failure, says so and execs omp.
  ["dev-profile-commit-fix"] =
    let (r = read?("commit-fix.sh")) if (r is String) r else if (r == null) "" else r.text
  // lib/wt.sh: the PATH wrapper. `step commit --fix` becomes the fix script; every
  // other invocation execs the real binary, including shell completion.
  ["wt"] = let (r = read?("wt.sh")) if (r is String) r else if (r == null) "" else r.text
}
