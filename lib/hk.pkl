/// Global hk config, derived from profile.pkl. hk evaluates and type-checks this
/// module itself; ~/.config/hk/config.pkl links here.
///   commit                   → fixers (rewrite and restage) plus the two cheap guards,
///                              conventional-commit and no-commit-to-branch; nothing else judges
///   `hk fix` / `hk check`    → the same steps, without the default-branch commit guard;
///                              `--slow` adds the push checks
///   push                     → every judge-only check on the pushed range, no fixing, may block
/// Each step comes from one file under tools/; profile.pkl derives the maps.
amends "package://github.com/jdx/hk/releases/download/v2.7.0/hk@2.7.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.7.0/hk@2.7.0#/Builtins.pkl"

import "../profile.pkl"

fail_fast = false
stash_backup_count = 20
exclude = profile.exclude.toList()

// Top-level steps feed the implicit pre-commit, fix and check hooks.
steps {
  // Format last, after fixers have removed or rewritten code.
  ["dprint"] = (Builtins.dprint) {
    depends = profile.fixers.keys.toList()
    exclude = profile.lockfiles
  }
  ...profile.fixers
  // Commit guards judge the commit being made, not the code: the lint verb
  // disables them. A hygiene tool (same step at commit and push) stays on.
  for (id, step in profile.commitGuards) {
    [id] =
      if (profile.checks.containsKey(id))
        step
      else
        (step) { profiles = List("!" + profile.lintProfile) }
  }
  // Push checks, only on request (`hk check --slow`). A tool with the same step
  // at commit and push (hygiene) is already above under that name.
  for (id, step in profile.checks) {
    when (!profile.fixers.containsKey(id) && !profile.commitGuards.containsKey(id)) {
      [id] =
        if (profile.fullTreeChecks.containsKey("\(id)-full-tree"))
          (step) { profiles = List("slow", "!" + profile.lintProfile) }
        else
          (step) { profiles = List("slow") }
    }
  }
  // The lint verb judges the whole tree: a ratcheting push check is swapped for its full-tree twin.
  for (id, step in profile.fullTreeChecks) {
    [id] = (step) { profiles = List(profile.lintProfile) }
  }
}

hooks {
  ["commit-msg"] {
    steps {
      ["conventional-commit"] { check = "dev-profile-commit-msg {{commit_msg_file}}" }
    }
  }
  ["pre-push"] {
    steps {
      ...profile.checks
    }
  }
  // Replaces the inherited step only: hk fix/check may run on main; commit still cannot.
  ["fix"] {
    steps {
      ["no-commit-to-branch"] = (profile.commitGuards["no-commit-to-branch"]) {
        step_condition = "false"
      }
    }
  }
  ["check"] {
    steps {
      ["no-commit-to-branch"] = (profile.commitGuards["no-commit-to-branch"]) {
        step_condition = "false"
      }
    }
  }
}
