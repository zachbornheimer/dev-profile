/// End-of-day clone command behind `wt done`.
///
/// Commit, push, draft pull requests, and prune are on by default.
/// `--drop` is not. `--dry-run` only fetches origin.
module done

import "pr.pkl"
import "script.pkl"

wrappers: Mapping<String, String> = new {
  ["dev-profile-done"] = read("done.sh").text
}

aliases: Mapping<String, String> = new {
  ["done"] = pr.bin("dev-profile-done") + " {{ args }}"
}
