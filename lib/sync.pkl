/// Keep every clone of a repo backed up to GitHub, reconcile what diverged
/// between clones, then clean up what GitHub already holds. The scripts stay
/// callable for the fixtures. No worktrunk alias: `wt sync` is worktrunk-sync,
/// and `wt done` is the clone command.
module sync

import "pr.pkl"
import "script.pkl"

/// Script fragment: fetch origin, then `default_branch`, `on_github`,
/// `adds_nothing`, `worktrees` and `worktree_of`.
repoFacts: String =
  #"""
  # Only origin: another remote that fails must not stop this. PR heads land in
  # refs/sync/pull, out of `git branch -r`, so work GitHub holds only as a PR counts.
  git fetch --prune --quiet origin '+refs/heads/*:refs/remotes/origin/*' '+refs/pull/*/head:refs/sync/pull/*'
  git symbolic-ref --quiet refs/remotes/origin/HEAD >/dev/null ||
    git remote set-head origin --auto >/dev/null 2>&1 || true
  default_branch="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || :)"
  default_branch="${default_branch#origin/}"
  default_branch="${default_branch:-main}"
  base="refs/remotes/origin/${default_branch}"

  # True when a branch or PR head on origin already contains commit $1.
  on_github() {
    [[ -n "$(git for-each-ref --contains "$1" --count=1 refs/remotes/origin refs/sync/pull)" ]]
  }

  # True when merging $1 into $2 would change nothing: an ancestor, or content
  # already there (a squash merge, or a rebase that $2 went through).
  adds_nothing() {
    git merge-base --is-ancestor "$1" "$2" && return 0
    local tree
    tree="$(git merge-tree --write-tree "$2" "$1" 2>/dev/null | sed -n 1p)" || return 1
    [[ "${tree}" == "$(git rev-parse "$2^{tree}")" ]]
  }

  # Worktrees, the primary first, one per line as fields split by ${sep} (empty
  # fields survive, unlike tabs): path, branch (empty when detached), HEAD, and
  # "locked" or empty.
  sep=$'\037'
  worktrees() {
    git worktree list --porcelain | awk -v OFS="${sep}" '
      function emit() { if (path != "") print path, branch, head, locked }
      /^worktree / { emit(); path = substr($0, 10); branch = ""; head = ""; locked = "" }
      /^HEAD / { head = substr($0, 6) }
      /^branch refs\/heads\// { branch = substr($0, 19) }
      /^locked/ { locked = "locked" }
      END { emit() }'
  }

  # The worktree line for branch $1, if it has one.
  worktree_of() { worktrees | awk -F "${sep}" -v b="$1" '$2 == b && !found { print; found = 1 }'; }
  """#

/// Script fragment: `clone_id` (this clone's backup namespace, or empty before
/// its first sync), `report`, and `snapshot`. The caller sets `max_file_mb`,
/// `left_out` (a file) and, optionally, `nested` (a file).
snapshotTools: String =
  #"""
  clone_id() { git config --get dev-profile.sync-clone || :; }

  report() { printf '  %-13s %s\n' "$1" "$2"; }

  # A commit of HEAD plus every staged, unstaged and untracked change in
  # worktree $1, built in a scratch index: the worktree itself is untouched.
  # A file over the size limit keeps its committed version (or stays out, if
  # new) and is recorded in ${left_out}. A nested repository is recorded as a
  # pointer only, listed in ${nested} and reported: run wt sync inside it.
  snapshot() {
    local index tree path size
    index="$(mktemp)"
    cp "$(git -C "$1" rev-parse --path-format=absolute --git-path index)" "${index}"
    GIT_INDEX_FILE="${index}" git -C "$1" add -A 2>/dev/null # quiet about nested repositories; a failure still stops here
    while IFS= read -r -d '' path; do
      size="$(GIT_INDEX_FILE="${index}" git -C "$1" cat-file -s ":${path}" 2>/dev/null)" || continue
      if ((size > max_file_mb * 1024 * 1024)); then
        GIT_INDEX_FILE="${index}" git -C "$1" reset --quiet HEAD -- "${path}"
        echo "$1/${path}" >>"${left_out}"
        report skipped "$1/${path}: over ${max_file_mb} MB" >&2
      fi
    done < <(GIT_INDEX_FILE="${index}" git -C "$1" diff --cached --name-only -z --diff-filter=AM HEAD)
    GIT_INDEX_FILE="${index}" git -C "$1" diff --cached --raw --diff-filter=A HEAD |
      awk -F '\t' '$1 ~ / 160000 / { print $2 }' | while IFS= read -r path; do
      echo "$1/${path}" >>"${nested:-/dev/null}"
      report nested "$1/${path}: a repository of its own; run wt sync inside it" >&2
    done
    tree="$(GIT_INDEX_FILE="${index}" git -C "$1" write-tree)"
    rm -f "${index}"
    git -C "$1" commit-tree "${tree}" -p HEAD -m "wip: uncommitted changes in $1"
  }
  """#

local pruneScript =
  #"""
  \#(script.bash)
  # Remove what is already safe on GitHub. Always: worktrees and branches
  # merged into the default branch (wt step prune), and branches whose tip is
  # exactly a PR GitHub merged (squash merges wt cannot prove integrated).
  #   --pushed  also clean worktrees and branches whose tip equals GitHub's
  #   --remote  also branches on GitHub already absorbed into the default branch
  #             (never one with an open PR)
  # Other flags go to wt step prune; --dry-run previews everything.
  dry_run=false pushed=false remote=false
  args=()
  for arg in "$@"; do
    case "${arg}" in
    --pushed)
      pushed=true
      continue
      ;;
    --remote)
      remote=true
      continue
      ;;
    --foreground) continue ;; # always foreground, so the sweeps below see the result
    --dry-run) dry_run=true ;;
    esac
    args+=("${arg}")
  done

  \#(repoFacts)
  wt step prune --foreground ${args[@]+"${args[@]}"}

  \#(pr.github)
  \#(pr.removeMerged)

  # remove <branch> <reason> [wt remove flags...]: honours --dry-run.
  remove() {
    local branch="$1" reason="$2"
    shift 2
    if [[ "${dry_run}" == true ]]; then
      echo "Would remove ${branch}: ${reason}"
    else
      wt remove --foreground "$@" "${branch}" || echo "Kept ${branch}" >&2
    fi
  }

  merged="$(ghr pr list --state merged --limit "${DEV_PROFILE_PRUNE_PR_LIMIT:-200}" \
    --json headRefName,headRefOid,headRepositoryOwner \
    --jq ".[] | select(.headRepositoryOwner.login == \"${owner}\") | \"\(.headRefName) \(.headRefOid)\"")"

  # fd 3 keeps wt's stdin free for approval prompts.
  while read -r name oid <&3; do
    [[ -n "${name}" && "${name}" != "${default_branch}" ]] || continue
    [[ "$(git rev-parse --verify --quiet "refs/heads/${name}")" == "${oid}" ]] || continue
    if [[ "${dry_run}" == true ]]; then
      echo "Would remove ${name}: its PR merged on GitHub"
    else
      remove_merged "${name}" "${oid}" || echo "Kept ${name}" >&2
    fi
  done 3<<<"${merged}"

  if [[ "${pushed}" == true ]]; then
    primary="$(worktrees | sed -n 1p | cut -d "${sep}" -f1)"

    # Ignored paths tools regenerate on their own (space-separated), which never
    # make a worktree worth keeping.
    disposable="${DEV_PROFILE_PRUNE_DISPOSABLE-.trunk}"

    # Ignored files in worktree $1 (.env, local config) that the primary worktree
    # lacks or holds differently: removing the worktree would destroy them.
    unique_ignored() {
      local path tool_state
      while IFS= read -r -d '' path; do
        [[ "${path}" == '!! '* ]] || continue
        path="${path#!! }"
        path="${path%/}"
        for tool_state in ${disposable}; do
          [[ "${path}" != "${tool_state}" && "${path}" != "${tool_state}/"* ]] || continue 2
        done
        if [[ -d "$1/${path}" ]]; then
          [[ -e "${primary}/${path}" ]] || echo "${path}"
        else
          cmp -s "$1/${path}" "${primary}/${path}" || echo "${path}"
        fi
      done < <(git -C "$1" status --porcelain=v1 -z --ignored)
    }

    while read -r branch tip <&3; do
      [[ "${branch}" != "${default_branch}" ]] || continue
      [[ "$(git rev-parse --verify --quiet "refs/remotes/origin/${branch}")" == "${tip}" ]] || continue
      dir="" locked=""
      IFS="${sep}" read -r dir _ _ locked < <(worktree_of "${branch}") || true
      [[ "${dir}" != "${primary}" && -z "${locked}" ]] || continue
      if [[ -n "${dir}" ]]; then
        [[ -z "$(git -C "${dir}" status --porcelain)" ]] || continue
        only_here="$(unique_ignored "${dir}" | awk 'NR <= 3' | paste -sd, -)"
        if [[ -n "${only_here}" ]]; then
          echo "Kept ${branch}: ignored files exist only in ${dir} (${only_here}); remove it yourself once they are safe" >&2
          continue
        fi
      fi
      remove "${branch}" "identical to GitHub's copy" --force-delete
    done 3< <(git for-each-ref --format='%(refname:short) %(objectname)' refs/heads)
  fi

  if [[ "${remote}" == true ]]; then
    doomed=() leases=()
    open="$(ghr pr list --state open --limit 1000 --json headRefName,headRepositoryOwner \
      --jq ".[] | select(.headRepositoryOwner.login == \"${owner}\") | .headRefName")"
    while read -r branch tip <&3; do
      [[ "${branch}" != "${default_branch}" && "${branch}" != HEAD ]] || continue
      # Never sync's backups: a stash keeps untracked files in a parent that
      # "absorbed into main" cannot see. Delete those by hand once restored.
      [[ "${branch}" != backup/* ]] || continue
      grep -qxF -- "${branch}" <<<"${open}" && continue
      adds_nothing "${tip}" "${base}" || continue # squash merges count too
      if [[ "${dry_run}" == true ]]; then
        echo "Would delete origin/${branch}: absorbed into ${default_branch}"
      else
        doomed+=("${branch}")
        leases+=("--force-with-lease=refs/heads/${branch}:${tip}")
      fi
    done 3< <(git for-each-ref --format='%(refname:lstrip=3) %(objectname)' refs/remotes/origin)

    # Delete in batches: pre-push hooks run once per push, not once per branch.
    # Each lease names the tip judged absorbed, so a branch moved since is kept.
    batch="${DEV_PROFILE_PRUNE_DELETE_BATCH:-100}"
    for ((i = 0; i < ${#doomed[@]}; i += batch)); do
      git push --quiet "${leases[@]:i:batch}" --delete origin "${doomed[@]:i:batch}" ||
        echo "A batch of deletions was refused; see above" >&2
    done
    if [[ "${#doomed[@]}" -gt 0 ]]; then
      git fetch --prune --quiet origin
      for branch in "${doomed[@]}"; do
        if git rev-parse --verify --quiet "refs/remotes/origin/${branch}" >/dev/null; then
          echo "Kept origin/${branch}: GitHub refused the deletion" >&2
        else
          echo "Deleted origin/${branch}: absorbed into ${default_branch}"
        fi
      done
    fi
  fi
  """#

/// Generated bin/ scripts the worktrunk aliases run.
wrappers: Mapping<String, String> = new {
  ["dev-profile-sync"] =
    let (r = read?("sync.sh")) if (r is String) r else if (r == null) "" else r.text
  ["dev-profile-reconcile"] =
    let (r = read?("reconcile.sh")) if (r is String) r else if (r == null) "" else r.text
  ["dev-profile-prune"] = pruneScript
}

/// No worktrunk aliases. `wt sync` belongs to worktrunk-sync. `wt done` is the
/// clone command. These scripts stay so the fixtures can still call them.
aliases: Mapping<String, String> = new {}
