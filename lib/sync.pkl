/// Keep every clone of a repo backed up to GitHub, reconcile what diverged
/// between clones, then clean up what GitHub already holds. The scripts stay
/// callable for the fixtures. No worktrunk alias: `wt sync` is worktrunk-sync,
/// and `wt done` is the clone command.
module sync

/// Generated bin/ scripts the worktrunk aliases run.
wrappers: Mapping<String, String> = new {
  ["dev-profile-sync"] =
    let (r = read?("sync.sh")) if (r is String) r else if (r == null) "" else r.text
  ["dev-profile-reconcile"] =
    let (r = read?("reconcile.sh")) if (r is String) r else if (r == null) "" else r.text
  ["dev-profile-prune"] =
    let (r = read?("prune.sh")) if (r is String) r else if (r == null) "" else r.text
}

/// No worktrunk aliases. `wt sync` belongs to worktrunk-sync. `wt done` is the
/// clone command. These scripts stay so the fixtures can still call them.
aliases: Mapping<String, String> = new {}
