/// Retire a clone: back it up, prove GitHub holds everything unique in it, then
/// move it and its worktrees to the Trash. No worktrunk alias: `wt done --drop`
/// is the clone command. The script stays so the fixture can still call it.
module retire

import "pr.pkl"
import "script.pkl"
import "sync.pkl"

/// Generated bin/ script the worktrunk alias runs.
wrappers: Mapping<String, String> = new {
  ["dev-profile-retire"] =
    let (r = read?("retire.sh")) if (r is String) r else if (r == null) "" else r.text
}

/// No worktrunk alias. `wt done --drop` retires a clone. The script stays so
/// the fixture can still call it.
aliases: Mapping<String, String> = new {}
