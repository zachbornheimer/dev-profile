/// Renders consumer configs from profile.pkl. Each function returns one file body.
module render

import "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl" as hk
import "package://pkg.pkl-lang.org/pkl-pantry/pkl.toml@1.0.3#/toml.pkl"

import "../profile.pkl"
import "contract.pkl"
import "githooks.pkl"
import "script.pkl"
import "Tool.pkl"
import "types.pkl"

/// Generated-file banner using the target language's line-comment prefix.
function header(comment: String): String = script.header(comment)

// ---- Typed config values. Renderers turn them into files; no hand-built syntax.
local tomlRenderer = new toml.Renderer {}
local jsonRenderer = new JsonRenderer { indent = "  " }
local yamlRenderer = new YamlRenderer {}

/// YAML file with a generated-file banner.
function yamlFile(value: Any): String = header("#") + "\n" + yamlRenderer.renderDocument(value)

/// markdownlint defaults: dprint owns layout, so its formatting rules are off.
markdownlint: Dynamic = new {
  MD013 = false // line length
  MD033 = false // inline HTML
  MD041 = false // first line must be a heading
}

/// yamllint defaults: dprint owns layout, so only real problems fail --strict.
yamllint: Dynamic = new {
  `extends` = "default"
  rules {
    ["line-length"] = "disable"
    ["document-start"] = "disable"
    truthy { ["check-keys"] = false }
    comments { ["min-spaces-from-content"] = 1 }
  }
}

/// TOML file with a generated-file banner.
function tomlFile(value: Any): String = header("#") + "\n" + tomlRenderer.renderDocument(value)

/// Prefix profile wrapper names so dprint exec does not depend on PATH.
function execCommand(cmd: String): String =
  if (cmd.startsWith("dev-profile-"))
    cmd.replaceFirst("dev-profile-", "\(profile.installPath)/bin/dev-profile-")
  else
    cmd

/// JSONC file (dprint accepts comments) with a generated-file banner.
function jsoncFile(value: Any): String = header("//") + "\n" + jsonRenderer.renderDocument(value)

local function pins(xs: Listing<types.Pin>): Mapping<String, String> = new {
  for (p in xs) { when (p.install) { [p.id] = p.version } }
}

local function depsFor(ids: Listing<String>?): Mapping<String, Dynamic> = new {
  for (d in profile.deps) {
    when (ids == null || ids.contains(d.id)) { [d.id] { auto = d.auto } }
  }
}

dprint: Dynamic = new {
  incremental = true
  shebangs {
    for (lang in profile.languages) { for (shebang, ext in lang.shebangs) { [shebang] = ext } }
  }
  excludes = profile.dprintExcludes.toList()
  exec {
    cwd = "${configDir}"
    timeout = 30
    commands =
      profile.languages
        .toList()
        .filter((lang) -> lang.dprint.kind == "exec")
        .map((lang) -> new Dynamic {
          // Absolute: Neovim/GUI PATH has mise shims but not installDir/bin, so a
          // bare `dev-profile-*` exec is a silent no-op on save.
          command = execCommand(lang.dprint.command)
          exts = lang.dprint.exts.toList()
        })
  }
  plugins = profile.dprintPlugins.toList()
}

/// Second bootstrap pass loads this as the global config; install links it to
/// ~/.config/mise/conf.d/dev-profile.toml.
mise: Dynamic = new {
  tools {
    ...pins(profile.kernelTools)
    ...pins(profile.tools)
    ...pins(profile.toolPins)
  }
  settings {
    experimental = profile.settings.experimental
    auto_install = profile.settings.autoInstall
    not_found_auto_install = profile.settings.notFoundAutoInstall
    not_found_auto_install_registry = profile.settings.notFoundAutoInstallRegistry
    idiomatic_version_file_ignore_minimum_versions =
      profile.settings.idiomaticVersionFileIgnoreMinimumVersions
    idiomatic_version_file_enable_tools = profile.settings.idiomaticVersionFileEnableTools.toList()
    trusted_config_paths = profile.settings.trustedConfigPaths.toList()
  }
  env { ["_"] { path = List("\(profile.installDir)/bin") } }
  dotfiles {
    for (target, file in profile.liveTargets) {
      [target] { source = "\(profile.installDir)/\(file)"; mode = "symlink" }
    }
  }
  deps = depsFor(null)
  bootstrap { packages { ...profile.brewPackages } }
}

// Worktrunk default prompt structure, with Conventional Commits required even
// when recent or folded subjects are not. Keep {{ user_guidance }} so
// template-append restates the rule after <style>.
local conventionalCommitRule =
  """
  Always Conventional Commits even when recent or folded commits are not.
  Subject MUST be type(optional-scope): imperative description.
  Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert.
  Subject under 72 chars.
  """

local commitGenerationTemplate =
  """
  <task>Write a commit message for the staged changes below.</task>

  <format>
  - Subject MUST be `type(optional-scope): imperative description`
  - Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
  - Subject under 72 chars
  - For material changes, add a blank line then a body paragraph explaining the change
  - Output only the commit message, no quotes or code blocks
  </format>

  <style>
  - Imperative mood: "Add feature" not "Added feature"
  - Always Conventional Commits even when recent commits are not
  - Describe the change, not the intent or benefit
  </style>
  {% if user_guidance %}
  <user-guidance>
  {{ user_guidance }}
  </user-guidance>
  {% endif %}{% if project_guidance %}
  <project-guidance>
  {{ project_guidance }}
  </project-guidance>
  {% endif %}
  <diffstat>
  {{ git_diff_stat }}
  </diffstat>

  <diff>
  {{ git_diff }}
  </diff>

  <context>
  Branch: {{ branch }}
  {% if recent_commits %}<recent_commits>
  {% for commit in recent_commits %}- {{ commit }}
  {% endfor %}</recent_commits>{% endif %}
  </context>

  """

local squashGenerationTemplate =
  """
  <task>Write a commit message for the change in <diff>, which is everything the squash will record. <commits> lists what it folds in.</task>

  <format>
  - Subject MUST be `type(optional-scope): imperative description`
  - Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
  - Subject under 72 chars
  - For material changes, add a blank line then a body paragraph explaining the change
  - Output only the commit message, no quotes or code blocks
  </format>

  <style>
  - Imperative mood: "Add feature" not "Added feature"
  - Always Conventional Commits even when folded commits are not
  - Describe the change, not the intent or benefit
  </style>
  {% if user_guidance %}
  <user-guidance>
  {{ user_guidance }}
  </user-guidance>
  {% endif %}{% if project_guidance %}
  <project-guidance>
  {{ project_guidance }}
  </project-guidance>
  {% endif %}
  <commits branch="{{ branch }}" target="{{ target_branch }}">
  {% for detail in commit_details %}- {{ detail.subject }}
  {% endfor %}</commits>

  <diffstat>
  {{ git_diff_stat }}
  </diffstat>

  <diff>
  {{ git_diff }}
  </diff>

  """

worktrunk: Dynamic = new {
  ["worktree-path"] = profile.worktreePath
  // Blocking, so deps and isolated PORT/DB_NAME exist before anyone edits.
  // --no-install: dependency installs belong to mise (deps auto), not workz.
  ["pre-start"] { workz = "workz sync --isolated --quiet --no-install" }
  ["post-start"] { copy = "wt step copy-ignored" }
  // Release the removed worktree's workz port/DB allocation.
  ["post-remove"] { workz = "workz doctor --fix >/dev/null" }
  step { ["copy-ignored"] { exclude = List(".venv/", "**/.venv/") } }
  commit {
    generation {
      command = profile.llmCommand
      template = commitGenerationTemplate
      `squash-template` = squashGenerationTemplate
      `template-append` = conventionalCommitRule
    }
  }
  aliases {
    up =
      """
      git fetch --all --prune; wt step for-each -- sh -c '
        git rev-parse --verify -q @{u} >/dev/null || exit 0
        g=$(git rev-parse --git-dir)
        rebasing() { test -d "$g/rebase-merge" || test -d "$g/rebase-apply"; }
        rebasing && exit 0
        git diff --quiet HEAD || { git merge --ff-only --no-autostash @{u}; exit 0; }
        git rebase @{u} --no-autostash || { rebasing || exit 0; git rebase --abort; }
      '
      """
    pr =
      """
      wt switch {{ args }} -x sh -- -eu -c '
        # Validate prerequisites before changing repository state.
        command -v gh >/dev/null || {
          echo "GitHub CLI (gh) is required" >&2
          exit 1
        }
        git remote get-url origin >/dev/null || exit 1

        # Never publish the default branch or a detached HEAD.
        branch=$(git symbolic-ref --quiet --short HEAD) || {
          echo "Cannot publish detached HEAD" >&2
          exit 1
        }
        base=$(gh repo view --json defaultBranchRef \\
          --jq ".defaultBranchRef.name")

        [ -n "$base" ] && [ "$branch" != "$base" ] || {
          echo "Refusing to publish the default branch" >&2
          exit 1
        }

        # Prevent accidentally replacing a different upstream.
        upstream=$(git rev-parse --abbrev-ref \\
          --symbolic-full-name "@{upstream}" 2>/dev/null || :)
        [ -z "$upstream" ] || [ "$upstream" = "origin/$branch" ] || {
          echo "Unexpected upstream: $upstream" >&2
          exit 1
        }

        # Refuse unfinished Git operations.
        for operation in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD \\
                         rebase-merge rebase-apply; do
          if [ -e "$(git rev-parse --git-path "$operation")" ]; then
            echo "Unfinished Git operation: $operation" >&2
            exit 1
          fi
        done

        # Commit only when changes exist; honor commit hooks.
        if [ -n "$(git status --porcelain)" ]; then
          wt step commit
        fi

        # Publish safely; never force-push.
        git push --set-upstream origin "HEAD:refs/heads/$branch"

        # Reuse an open PR rather than creating a duplicate.
        owner=$(gh repo view --json owner --jq ".owner.login")
        url=$(gh pr list --head "$branch" --state open \\
          --json url,headRepositoryOwner --jq "[.[] | select(.headRepositoryOwner.login == \\"$owner\\")][0].url // empty")

        if [ -n "$url" ]; then
          printf "PR: %s\\n" "$url"
        else
          gh pr create --fill --head "$branch"
        fi
      '
      """
    ship =
      """
      set -eu

      branch=$(git symbolic-ref --quiet --short HEAD) || {
        echo "Detached HEAD; refusing to ship" >&2
        exit 1
      }

      default=$(gh repo view --json defaultBranchRef \\
        --jq '.defaultBranchRef.name')

      owner=$(gh repo view --json owner --jq '.owner.login')

      if [ "$branch" = "$default" ]; then
        echo "Skipping default branch: $branch"
        exit 0
      fi

      # Refuse unfinished Git operations.
      for operation in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD \\
                       rebase-merge rebase-apply; do
        if [ -e "$(git rev-parse --git-path "$operation")" ]; then
          echo "Unfinished Git operation: $operation" >&2
          exit 1
        fi
      done

      # Do not recreate previously closed or merged PRs.
      open_pr=$(gh pr list --head "$branch" --state open \\
        --json url,headRepositoryOwner --jq \\
        "[.[] | select(.headRepositoryOwner.login == \\"$owner\\")][0].url // empty")

      if [ -z "$open_pr" ]; then
        previous=$(gh pr list --head "$branch" --state all \\
          --json state,headRepositoryOwner --jq \\
          "[.[] | select(.headRepositoryOwner.login == \\"$owner\\")][0].state // empty")

        case "$previous" in
          CLOSED|MERGED)
            echo "Skipping previously closed PR: $branch"
            exit 0
            ;;
        esac
      fi

      # Let Worktrunk commit pending changes.
      if [ -n "$(git status --porcelain)" ]; then
        wt step commit
      fi

      # Never publish if changes remain uncommitted.
      if [ -n "$(git status --porcelain)" ]; then
        echo "Uncommitted changes remain: $branch" >&2
        exit 1
      fi

      # Prevent accidentally replacing a different upstream.
      upstream=$(git rev-parse --abbrev-ref \\
        --symbolic-full-name "@{upstream}" 2>/dev/null || :)
      if [ -n "$upstream" ] && [ "$upstream" != "origin/$branch" ]; then
        echo "Unexpected upstream: $upstream" >&2
        exit 1
      fi

      # Skip work that Worktrunk identifies as already integrated.
      if wt list --full --format=json | jq -e --arg b "$branch" '
        any(.items[]; .branch == $b and
          .default_branch.integration != null)
      ' >/dev/null; then
        echo "Already integrated: $branch"
        exit 0
      fi

      # Respect stacked PR targets when configured.
      base=$(git config --get "branch.$branch.gh-merge-base" || :)
      base=${base:-$default}

      # Skip branches with no commits ahead of the PR base.
      git rev-parse --verify "origin/$base" >/dev/null
      if [ "$(git rev-list --count "origin/$base..HEAD")" -eq 0 ]; then
        echo "No commits ahead of $base: $branch"
        exit 0
      fi

      # Publish without rewriting remote history.
      git push --set-upstream origin "HEAD:refs/heads/$branch"

      # Reuse an existing PR, otherwise create a draft.
      open_pr=$(gh pr list --head "$branch" --state open \\
        --json url,headRepositoryOwner --jq \\
        "[.[] | select(.headRepositoryOwner.login == \\"$owner\\")][0].url // empty")

      if [ -n "$open_pr" ]; then
        printf "PR: %s\\n" "$open_pr"
      else
        gh pr create --draft --fill --head "$branch" --base "$base"
      fi
      """
    ["ship-all"] = "git fetch origin --prune && wt step for-each -- wt ship"
  }
}

// ---- profile.json (Conform manifest)
class Filetype {
  language: String
  formatters: Listing<String>
  format_on_save: Boolean
}

class Manifest {
  generated: Boolean = true
  source: String = "profile.pkl"
  formatter: String = "dprint"
  filetypes: Mapping<String, Filetype>
  tools: Mapping<String, ToolInfo>
}

/// One tool in profile.json: where it lives, what it does, and its step per hook.
class ToolInfo {
  category: String
  doc: String
  hooks: Mapping<String, HookInfo>
  scripts: Listing<String>
}

class HookInfo {
  /// The hk step name in this hook.
  step: String
  fix: String?
  check: String?
  /// The glob or hk file types the step runs on; null means every file.
  files: String?
  /// Steps in the same hook this one runs after.
  after: Listing<String>
}

/// A step command as one line: hk builtins use CommandSpec, Command and Script objects.
function describe(cmd: Any): String? =
  if (cmd == null)
    null
  else if (cmd is String)
    cmd
  else if (cmd is hk.CommandSpec)
    describe(cmd.command)
  else if (cmd is hk.Command)
    cmd.argv.join(" ")
  else if (cmd is hk.Script)
    cmd.linux ?? cmd.other ?? cmd.macos ?? cmd.windows
  else
    cmd.toString()

local function hookInfo(name: String, tool: Tool, hook: Tool.Hook): HookInfo =
  let (stepName = if (hook == "pre-commit") profile.commitStepName(name, tool) else name)
  let (
    hkStep =
      if (hook == "pre-push")
        profile.checks[stepName]
      else if (profile.fixers.containsKey(stepName))
        profile.fixers[stepName]
      else
        profile.commitGuards[stepName]
  )
    new HookInfo {
      step = stepName
      fix = describe(hkStep.fix)
      check = describe(hkStep.check ?? hkStep.check_diff ?? hkStep.check_list_files)
      files = files(hkStep)
      after = new {
        for (d in (if (hkStep.depends is String) List(hkStep.depends) else hkStep.depends)) { d }
      }
    }

/// A step's file selection as one line: its globs, or its hk file types.
local function files(step: hk.Step): String? =
  if (step.glob is List)
    step.glob.join(" ")
  else if (step.glob != null)
    step.glob.toString()
  else if (step.types != null)
    "types: " + step.types.join(" ")
  else
    null

local function toolInfos(): Mapping<String, ToolInfo> = new {
  for (name, tool in profile.catalog) {
    [name] = new ToolInfo {
      category = profile.toolCategories[name]
      doc = tool.doc
      hooks { for (hook, _ in tool.on) { [hook] = hookInfo(name, tool, hook) } }
      scripts { for (scriptName, _ in tool.scripts) { scriptName } }
    }
  }
}

local function entries(): Mapping<String, Filetype> = new {
  for (lang in profile.languages) {
    when (lang.dprint.kind != "none") {
      for (ft in lang.nvimFiletypes) {
        [ft] = new Filetype {
          language = lang.id
          formatters { "dprint" }
          format_on_save = lang.formatOnSave
        }
      }
    }
  }
}

manifest: Manifest = new {
  filetypes = entries()
  tools = toolInfos()
}

// ---- wrapper scripts (generated bin/)
/// Every tool's scripts, plus the contract and git-hook entry points.
wrappers: Mapping<String, String> = new {
  for (_, tool in profile.catalog) { ...tool.scripts }
  ...contract.wrappers
  ...githooks.wrappers
}

// ---- Personal directory overlay: linked as ~/Developer/Personal/mise.toml.
personalOverlay: Dynamic = new {
  env {
    DEV_PROFILE = "personal"
    // The contract scripts, also on PATH where only this overlay is loaded (CI roots).
    ["_"] { path = List("\(profile.installDir)/bin") }
  }
  settings { experimental = true }
  tools { dprint = pins(profile.tools)["dprint"] }
  deps = depsFor(new Listing { "aube"; "uv"; "composer"; "go" })
  tasks {
    fmt {
      description = "Format with dprint using the Personal ancestor config"
      dir = "{{cwd}}"
      run = "dprint fmt"
    }
    ...contract.tasks
  }
}

// ---- Shell init: each tool is guarded so a missing binary never breaks startup.
shellZsh: String =
  new Listing<String> {
    header("#")
    for (tool, cmd in profile.shellInit) {
      "command -v \(tool) >/dev/null && eval \"$(\(cmd))\""
    }
  }.join("\n") + "\n"
