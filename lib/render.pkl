/// Renders consumer configs from profile.pkl. Each function returns one file body.
module render

import "package://pkg.pkl-lang.org/pkl-pantry/pkl.toml@1.0.3#/toml.pkl"

import "../profile.pkl"
import "contract.pkl"
import "types.pkl"

local headerLines: List<String> =
  List(
    "Code generated by `mise run generate`. DO NOT EDIT.",
    "Source of truth: profile.pkl",
  )

/// Generated-file banner using the target language's line-comment prefix.
function header(comment: String): String = headerLines.map((l) -> "\(comment) \(l)").join("\n")

// ---- Typed config values. Renderers turn them into files; no hand-built syntax.
local tomlRenderer = new toml.Renderer {}
local jsonRenderer = new JsonRenderer { indent = "  " }
local yamlRenderer = new YamlRenderer {}

/// YAML file with a generated-file banner.
function yamlFile(value: Any): String = header("#") + "\n" + yamlRenderer.renderDocument(value)

/// markdownlint defaults: dprint owns layout, so its formatting rules are off.
markdownlint: Dynamic = new {
  MD013 = false // line length
  MD033 = false // inline HTML
  MD041 = false // first line must be a heading
}

/// yamllint defaults: dprint owns layout, so only real problems fail --strict.
yamllint: Dynamic = new {
  `extends` = "default"
  rules {
    ["line-length"] = "disable"
    ["document-start"] = "disable"
    truthy { ["check-keys"] = false }
  }
}

/// TOML file with a generated-file banner.
function tomlFile(value: Any): String = header("#") + "\n" + tomlRenderer.renderDocument(value)

/// Prefix profile wrapper names so dprint exec does not depend on PATH.
function execCommand(cmd: String): String =
  if (cmd.startsWith("dev-profile-"))
    cmd.replaceFirst("dev-profile-", "\(profile.installPath)/bin/dev-profile-")
  else
    cmd

/// JSONC file (dprint accepts comments) with a generated-file banner.
function jsoncFile(value: Any): String = header("//") + "\n" + jsonRenderer.renderDocument(value)

local function pins(xs: Listing<types.Pin>): Mapping<String, String> = new {
  for (p in xs) { when (p.install) { [p.id] = p.version } }
}

local function depsFor(ids: Listing<String>?): Mapping<String, Dynamic> = new {
  for (d in profile.deps) {
    when (ids == null || ids.contains(d.id)) { [d.id] { auto = d.auto } }
  }
}

dprint: Dynamic = new {
  incremental = true
  shebangs {
    for (lang in profile.languages) { for (shebang, ext in lang.shebangs) { [shebang] = ext } }
  }
  excludes = profile.dprintExcludes.toList()
  exec {
    cwd = "${configDir}"
    timeout = 30
    commands =
      profile.languages
        .toList()
        .filter((lang) -> lang.dprint.kind == "exec")
        .map((lang) -> new Dynamic {
          // Absolute: Neovim/GUI PATH has mise shims but not installDir/bin, so a
          // bare `dev-profile-*` exec is a silent no-op on save.
          command = execCommand(lang.dprint.command)
          exts = lang.dprint.exts.toList()
        })
  }
  plugins = profile.dprintPlugins.toList()
}

/// Second bootstrap pass loads this as the global config; install links it to
/// ~/.config/mise/conf.d/dev-profile.toml.
mise: Dynamic = new {
  tools {
    ...pins(profile.kernelTools)
    ...pins(profile.tools)
  }
  settings {
    experimental = profile.settings.experimental
    auto_install = profile.settings.autoInstall
    not_found_auto_install = profile.settings.notFoundAutoInstall
    not_found_auto_install_registry = profile.settings.notFoundAutoInstallRegistry
    idiomatic_version_file_ignore_minimum_versions =
      profile.settings.idiomaticVersionFileIgnoreMinimumVersions
    idiomatic_version_file_enable_tools = profile.settings.idiomaticVersionFileEnableTools.toList()
    trusted_config_paths = profile.settings.trustedConfigPaths.toList()
  }
  env { ["_"] { path = List("\(profile.installDir)/bin") } }
  dotfiles {
    for (target, file in profile.liveTargets) {
      [target] { source = "\(profile.installDir)/\(file)"; mode = "symlink" }
    }
  }
  deps = depsFor(null)
  bootstrap { packages { ...profile.brewPackages } }
}

// Worktrunk default prompt structure, with Conventional Commits required even
// when recent or folded subjects are not. Keep {{ user_guidance }} so
// template-append restates the rule after <style>.
local conventionalCommitRule =
  """
  Always Conventional Commits even when recent or folded commits are not.
  Subject MUST be type(optional-scope): imperative description.
  Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert.
  Subject under 72 chars.
  """

local commitGenerationTemplate =
  """
  <task>Write a commit message for the staged changes below.</task>

  <format>
  - Subject MUST be `type(optional-scope): imperative description`
  - Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
  - Subject under 72 chars
  - For material changes, add a blank line then a body paragraph explaining the change
  - Output only the commit message, no quotes or code blocks
  </format>

  <style>
  - Imperative mood: "Add feature" not "Added feature"
  - Always Conventional Commits even when recent commits are not
  - Describe the change, not the intent or benefit
  </style>
  {% if user_guidance %}
  <user-guidance>
  {{ user_guidance }}
  </user-guidance>
  {% endif %}{% if project_guidance %}
  <project-guidance>
  {{ project_guidance }}
  </project-guidance>
  {% endif %}
  <diffstat>
  {{ git_diff_stat }}
  </diffstat>

  <diff>
  {{ git_diff }}
  </diff>

  <context>
  Branch: {{ branch }}
  {% if recent_commits %}<recent_commits>
  {% for commit in recent_commits %}- {{ commit }}
  {% endfor %}</recent_commits>{% endif %}
  </context>

  """

local squashGenerationTemplate =
  """
  <task>Write a commit message for the change in <diff>, which is everything the squash will record. <commits> lists what it folds in.</task>

  <format>
  - Subject MUST be `type(optional-scope): imperative description`
  - Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
  - Subject under 72 chars
  - For material changes, add a blank line then a body paragraph explaining the change
  - Output only the commit message, no quotes or code blocks
  </format>

  <style>
  - Imperative mood: "Add feature" not "Added feature"
  - Always Conventional Commits even when folded commits are not
  - Describe the change, not the intent or benefit
  </style>
  {% if user_guidance %}
  <user-guidance>
  {{ user_guidance }}
  </user-guidance>
  {% endif %}{% if project_guidance %}
  <project-guidance>
  {{ project_guidance }}
  </project-guidance>
  {% endif %}
  <commits branch="{{ branch }}" target="{{ target_branch }}">
  {% for detail in commit_details %}- {{ detail.subject }}
  {% endfor %}</commits>

  <diffstat>
  {{ git_diff_stat }}
  </diffstat>

  <diff>
  {{ git_diff }}
  </diff>

  """

worktrunk: Dynamic = new {
  ["worktree-path"] = profile.worktreePath
  // Blocking, so deps and isolated PORT/DB_NAME exist before anyone edits.
  // --no-install: dependency installs belong to mise (deps auto), not workz.
  ["pre-start"] { workz = "workz sync --isolated --quiet --no-install" }
  ["post-start"] { copy = "wt step copy-ignored" }
  // Release the removed worktree's workz port/DB allocation.
  ["post-remove"] { workz = "workz doctor --fix >/dev/null" }
  step { ["copy-ignored"] { exclude = List(".venv/", "**/.venv/") } }
  commit {
    generation {
      command = profile.llmCommand
      template = commitGenerationTemplate
      `squash-template` = squashGenerationTemplate
      `template-append` = conventionalCommitRule
    }
  }
  aliases {
    up =
      """
      git fetch --all --prune; wt step for-each -- sh -c '
        git rev-parse --verify -q @{u} >/dev/null || exit 0
        g=$(git rev-parse --git-dir)
        rebasing() { test -d "$g/rebase-merge" || test -d "$g/rebase-apply"; }
        rebasing && exit 0
        git diff --quiet HEAD || { git merge --ff-only --no-autostash @{u}; exit 0; }
        git rebase @{u} --no-autostash || { rebasing || exit 0; git rebase --abort; }
      '
      """
    pr =
      """
      wt switch {{ args }} -x sh -- -eu -c '
        # Validate prerequisites before changing repository state.
        command -v gh >/dev/null || {
          echo "GitHub CLI (gh) is required" >&2
          exit 1
        }
        git remote get-url origin >/dev/null || exit 1

        # Never publish the default branch or a detached HEAD.
        branch=$(git symbolic-ref --quiet --short HEAD) || {
          echo "Cannot publish detached HEAD" >&2
          exit 1
        }
        base=$(gh repo view --json defaultBranchRef \\
          --jq ".defaultBranchRef.name")

        [ -n "$base" ] && [ "$branch" != "$base" ] || {
          echo "Refusing to publish the default branch" >&2
          exit 1
        }

        # Prevent accidentally replacing a different upstream.
        upstream=$(git rev-parse --abbrev-ref \\
          --symbolic-full-name "@{upstream}" 2>/dev/null || :)
        [ -z "$upstream" ] || [ "$upstream" = "origin/$branch" ] || {
          echo "Unexpected upstream: $upstream" >&2
          exit 1
        }

        # Commit only when changes exist; honor commit hooks.
        if [ -n "$(git status --porcelain)" ]; then
          wt step commit
        fi

        # Publish safely; never force-push.
        git push --set-upstream origin "HEAD:refs/heads/$branch"

        # Reuse an open PR rather than creating a duplicate.
        url=$(gh pr list --head "$branch" --state open \\
          --json url --jq ".[0].url // empty")

        if [ -n "$url" ]; then
          printf "PR: %s\\n" "$url"
        else
          gh pr create --fill --head "$branch"
        fi
      '
      """
    ship =
      """
      set -eu

      branch=$(git symbolic-ref --quiet --short HEAD) || {
        echo "Detached HEAD; refusing to ship" >&2
        exit 1
      }

      default=$(gh repo view --json defaultBranchRef \\
        --jq '.defaultBranchRef.name')

      if [ "$branch" = "$default" ]; then
        echo "Skipping default branch: $branch"
        exit 0
      fi

      # Refuse unfinished Git operations.
      for operation in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD \\
                       rebase-merge rebase-apply; do
        if [ -e "$(git rev-parse --git-path "$operation")" ]; then
          echo "Unfinished Git operation: $operation" >&2
          exit 1
        fi
      done

      # Do not recreate previously closed or merged PRs.
      open_pr=$(gh pr list --head "$branch" --state open \\
        --json url --jq '.[0].url // empty')

      if [ -z "$open_pr" ]; then
        previous=$(gh pr list --head "$branch" --state all \\
          --json state --jq '.[0].state // empty')

        case "$previous" in
          CLOSED|MERGED)
            echo "Skipping previously closed PR: $branch"
            exit 0
            ;;
        esac
      fi

      # Let Worktrunk commit pending changes.
      if [ -n "$(git status --porcelain)" ]; then
        wt step commit
      fi

      # Never publish if changes remain uncommitted.
      if [ -n "$(git status --porcelain)" ]; then
        echo "Uncommitted changes remain: $branch" >&2
        exit 1
      fi

      # Publish without rewriting remote history.
      git push --set-upstream origin "HEAD:refs/heads/$branch"

      # Reuse an existing PR, otherwise create a draft.
      open_pr=$(gh pr list --head "$branch" --state open \\
        --json url --jq '.[0].url // empty')

      if [ -n "$open_pr" ]; then
        printf "PR: %s\\n" "$open_pr"
      else
        gh pr create --draft --fill --head "$branch"
      fi
      """
    ["ship-all"] = "git fetch origin --prune && wt step for-each -- wt ship"
  }
}

// ---- profile.json (Conform manifest)
class Filetype {
  language: String
  formatters: Listing<String>
  format_on_save: Boolean
}

class Manifest {
  generated: Boolean = true
  source: String = "profile.pkl"
  formatter: String = "dprint"
  filetypes: Mapping<String, Filetype>
}

local function entries(): Mapping<String, Filetype> = new {
  for (lang in profile.languages) {
    when (lang.dprint.kind != "none") {
      for (ft in lang.nvimFiletypes) {
        [ft] = new Filetype {
          language = lang.id
          formatters { "dprint" }
          format_on_save = lang.formatOnSave
        }
      }
    }
  }
}

manifest: Manifest = new {
  filetypes = entries()
}

// ---- wrapper scripts (generated bin/)
local bash = "#!/usr/bin/env bash\nset -euo pipefail\n" + header("#") + "\n"

local phpContext =
  """
  \(bash)
  # Walk up from a path and print: wordpress | php-cs-fixer | phpcs | generic
  # Used by php fmt/lint so editor and hk share one detector.

  start="${1:-.}"
  if [[ -f "${start}" ]]; then
    dir="$(cd "$(dirname "${start}")" && pwd)"
  else
    dir="$(cd "${start}" && pwd)"
  fi

  has_wordpress_marker() {
    local root="$1"
    [[ -d "${root}/wp-content" || -f "${root}/wp-config.php" || -f "${root}/wp-load.php" ]] && return 0
    local f
    for f in phpcs.xml .phpcs.xml phpcs.xml.dist .phpcs.xml.dist; do
      if [[ -f "${root}/${f}" ]] && grep -Eq 'WordPress(-Core|-Extra|-Docs|-VIP-Go)?' "${root}/${f}"; then
        return 0
      fi
    done
    return 1
  }

  has_phpcs() {
    local root="$1" f
    for f in phpcs.xml .phpcs.xml phpcs.xml.dist .phpcs.xml.dist; do
      [[ -f "${root}/${f}" ]] && return 0
    done
    return 1
  }

  has_php_cs_fixer() {
    local root="$1"
    [[ -f "${root}/.php-cs-fixer.php" || -f "${root}/.php-cs-fixer.dist.php" ]]
  }

  while [[ "${dir}" != "/" ]]; do
    if has_wordpress_marker "${dir}"; then
      echo "wordpress ${dir}"
      exit 0
    fi
    dir="$(dirname "${dir}")"
  done

  if [[ -f "${start}" ]]; then
    dir="$(cd "$(dirname "${start}")" && pwd)"
  else
    dir="$(cd "${start}" && pwd)"
  fi

  while [[ "${dir}" != "/" ]]; do
    if has_php_cs_fixer "${dir}"; then
      echo "php-cs-fixer ${dir}"
      exit 0
    fi
    if has_phpcs "${dir}"; then
      echo "phpcs ${dir}"
      exit 0
    fi
    dir="$(dirname "${dir}")"
  done

  echo "generic ${PWD}"
  """

local phpFmt =
  """
  \(bash)
  # Format PHP. WordPress → PHPCBF only. Never mago / php-cs-fixer after PHPCBF.

  phpcbf_ok() {
    local code=0
    "$@" || code=$?
    # 0 nothing to fix, 1 fixed, 2 unfixable remain (push judges); 3+ is a real error.
    if [[ "${code}" -le 2 ]]; then
      return 0
    fi
    return "${code}"
  }

  # $1 = file to rewrite; $2 = path whose repo decides the context (defaults to $1).
  format_file() {
    local file="$1"
    local ctx root
    ctx="$(dev-profile-php-context "${2:-$1}")"
    root="${ctx#* }"
    case "${ctx%% *}" in
      wordpress)
        if [[ -f "${root}/phpcs.xml" ]]; then
          phpcbf_ok phpcbf --standard="${root}/phpcs.xml" "${file}"
        elif [[ -f "${root}/phpcs.xml.dist" ]]; then
          phpcbf_ok phpcbf --standard="${root}/phpcs.xml.dist" "${file}"
        elif [[ -f "${root}/.phpcs.xml" ]]; then
          phpcbf_ok phpcbf --standard="${root}/.phpcs.xml" "${file}"
        elif [[ -f "${root}/.phpcs.xml.dist" ]]; then
          phpcbf_ok phpcbf --standard="${root}/.phpcs.xml.dist" "${file}"
        else
          phpcbf_ok phpcbf --standard=WordPress "${file}"
        fi
        ;;
      php-cs-fixer)
        php-cs-fixer fix --using-cache=no "${file}"
        ;;
      phpcs)
        if [[ -f "${root}/phpcs.xml" ]]; then
          phpcbf_ok phpcbf --standard="${root}/phpcs.xml" "${file}"
        elif [[ -f "${root}/phpcs.xml.dist" ]]; then
          phpcbf_ok phpcbf --standard="${root}/phpcs.xml.dist" "${file}"
        else
          phpcbf_ok phpcbf "${file}"
        fi
        ;;
      *)
        if command -v php-cs-fixer >/dev/null 2>&1 && [[ -f "${HOME}/.config/php-cs-fixer/.php-cs-fixer.dist.php" ]]; then
          php-cs-fixer fix --using-cache=no --config="${HOME}/.config/php-cs-fixer/.php-cs-fixer.dist.php" "${file}"
        elif command -v phpcbf >/dev/null 2>&1; then
          phpcbf_ok phpcbf "${file}"
        else
          cat "${file}" >/dev/null
        fi
        ;;
    esac
  }

  format_stdin() {
    # Global, not local: the EXIT trap runs after this function returns.
    # A real .php name in a temp dir: phpcbf skips files without the extension.
    tmpdir="$(mktemp -d)"
    trap 'rm -rf "${tmpdir}"' EXIT
    local tmp="${tmpdir}/stdin.php"
    cat >"${tmp}"
    # stdout is the formatted file for dprint; formatter chatter goes to stderr.
    format_file "${tmp}" "$1" >&2
    cat "${tmp}"
  }

  if [[ "${1:-}" == "--stdin-path" ]]; then
    format_stdin "$2"
    exit 0
  fi
  if [[ $# -eq 0 ]]; then
    format_stdin "${PWD}"
    exit 0
  fi

  for f in "$@"; do
    format_file "${f}"
  done
  """

local phpLint =
  """
  \(bash)
  # Full PHP lint for push. WordPress → PHPCS/WPCS. Never a generic PHP formatter.

  if [[ $# -eq 0 ]]; then
    echo "dev-profile-php-lint: files required" >&2
    exit 2
  fi

  ctx="$(dev-profile-php-context "$1")"
  root="${ctx#* }"
  case "${ctx%% *}" in
    wordpress)
      if [[ -f "${root}/phpcs.xml" ]]; then
        phpcs --standard="${root}/phpcs.xml" "$@"
      elif [[ -f "${root}/phpcs.xml.dist" ]]; then
        phpcs --standard="${root}/phpcs.xml.dist" "$@"
      elif [[ -f "${root}/.phpcs.xml" ]]; then
        phpcs --standard="${root}/.phpcs.xml" "$@"
      elif [[ -f "${root}/.phpcs.xml.dist" ]]; then
        phpcs --standard="${root}/.phpcs.xml.dist" "$@"
      else
        phpcs --standard=WordPress "$@"
      fi
      ;;
    phpcs)
      phpcs "$@"
      ;;
    *)
      if command -v phpcs >/dev/null 2>&1; then
        phpcs "$@"
      else
        echo "phpcs not on PATH; skipping PHP lint" >&2
      fi
      ;;
  esac
  """

local rustfmt =
  """
  \(bash)
  if ! command -v rustfmt >/dev/null 2>&1; then
    cat
    exit 0
  fi
  if [[ $# -eq 0 ]]; then
    rustfmt
  else
    rustfmt "$@"
  fi
  """

local clang =
  """
  \(bash)
  if ! command -v clang-format >/dev/null 2>&1; then
    cat
    exit 0
  fi
  if [[ $# -eq 0 ]]; then
    clang-format
  else
    clang-format -i "$@"
  fi
  """

local swiftFormat =
  """
  \(bash)
  if command -v swift-format >/dev/null 2>&1; then
    if [[ $# -eq 0 ]]; then
      swift-format format --stdin
    else
      swift-format format --in-place "$@"
    fi
    exit 0
  fi
  if command -v swiftformat >/dev/null 2>&1; then
    if [[ $# -eq 0 ]]; then
      swiftformat --quiet stdin
    else
      swiftformat --quiet "$@"
    fi
    exit 0
  fi
  cat
  """

local swiftlintFix =
  """
  \(bash)
  if ! command -v swiftlint >/dev/null 2>&1; then
    exit 0
  fi
  if [[ $# -eq 0 ]]; then
    exit 0
  fi
  exec dev-profile-fix swiftlint --fix --quiet "$@"
  """

local oxlintFix =
  """
  \(bash)
  # Safe fixes plus suggestions (modernize); never --fix-dangerously.
  # Exit 1 = diagnostics left for push; anything else is a real error.
  code=0
  oxlint --fix --fix-suggestions "$@" || code=$?
  [[ "${code}" -le 1 ]] || exit "${code}"
  """

local golangciRatchet =
  """
  \(bash)
  # Push gate: fail only on issues the branch adds relative to the upstream default
  # branch, so old debt in untouched files never blocks a push. Without a base ref
  # (no remote, fresh clone) fall back to the full tree. `mise run lint` stays full-tree.
  base=""
  for ref in "$(git symbolic-ref -q --short refs/remotes/origin/HEAD || true)" origin/main origin/master; do
    if [[ -n "${ref}" ]] && git rev-parse -q --verify "${ref}^{commit}" >/dev/null; then
      base="${ref}"
      break
    fi
  done
  if [[ -z "${base}" ]]; then
    echo "golangci-ratchet: no upstream default branch; linting the full tree" >&2
    exec golangci-lint run --fix=false --allow-parallel-runners ./...
  fi
  exec golangci-lint run --fix=false --allow-parallel-runners --new-from-merge-base="${base}" ./...
  """

local pushedDiagnostics =
  #"""
  \#(bash)
  # Whole-program linters with no new-issues mode (go vet, cargo clippy): run the command,
  # then fail only on diagnostics located in the pushed files. Usage: CMD ARGS... :: FILES...
  cmd=()
  while (($#)) && [[ "$1" != "::" ]]; do cmd+=("$1"); shift; done
  shift || true
  ((${#cmd[@]})) || { echo "usage: dev-profile-pushed-diagnostics CMD ARGS... :: FILES..." >&2; exit 2; }
  out="$("${cmd[@]}" 2>&1)" && exit 0
  fail=0
  while IFS= read -r diag; do
    path="${diag%%:*}"
    path="${path#./}"
    for f in "$@"; do
      if [[ "${f}" == "${path}" || "${f}" == */"${path}" || "${path}" == */"${f}" ]]; then
        echo "${diag}" >&2
        fail=1
      fi
    done
  done < <(grep -E '^[^ :]+\.(go|rs):[0-9]+(:[0-9]+)?: ' <<<"${out}" || true)
  if [[ "${fail}" -eq 0 ]] && ! grep -Eq '^[^ :]+\.(go|rs):[0-9]+' <<<"${out}"; then
    echo "${out}" >&2 # failure with no file diagnostics (build or setup error): surface it
    exit 1
  fi
  exit "${fail}"
  """#

local pklFmt =
  """
  \(bash)
  # stdin → stdout. pkl exits 11 when it changed formatting; that is success here.
  code=0
  pkl format - || code=$?
  [[ "${code}" -eq 0 || "${code}" -eq 11 ]] || exit "${code}"
  """

local tolerantFix =
  """
  \(bash)
  # Run a fixer; exit 1 means "issues left for push to judge", not a failure.
  code=0
  "$@" || code=$?
  [[ "${code}" -le 1 ]] || exit "${code}"
  """

local rubocopFix =
  """
  \(bash)
  if ! command -v rubocop >/dev/null 2>&1; then
    exit 0
  fi
  if [[ $# -eq 0 ]]; then
    exit 0
  fi
  # -A includes unsafe cops (modernize). Exit 1 = offenses left for push; 2 = real error.
  code=0
  rubocop -A --fail-level F "$@" || code=$?
  [[ "${code}" -le 1 ]] || exit "${code}"
  """

local ty =
  """
  \(bash)
  if ! command -v ty >/dev/null 2>&1; then
    exit 0
  fi
  ty check "$@"
  """

wrappers: Mapping<String, String> = new {
  ["dev-profile-php-context"] = phpContext
  ["dev-profile-php-fmt"] = phpFmt
  ["dev-profile-php-lint"] = phpLint
  ["dev-profile-rustfmt"] = rustfmt
  ["dev-profile-clang-format"] = clang
  ["dev-profile-swift-format"] = swiftFormat
  ["dev-profile-swiftlint-fix"] = swiftlintFix
  ["dev-profile-rubocop-fix"] = rubocopFix
  ["dev-profile-oxlint-fix"] = oxlintFix
  ["dev-profile-golangci-ratchet"] = golangciRatchet
  ["dev-profile-pushed-diagnostics"] = pushedDiagnostics
  ["dev-profile-fix"] = tolerantFix
  ["dev-profile-pkl-fmt"] = pklFmt
  ["dev-profile-ty"] = ty
  ...contract.wrappers
}

// ---- Personal directory overlay: linked as ~/Developer/Personal/mise.toml.
personalOverlay: Dynamic = new {
  env {
    DEV_PROFILE = "personal"
    // The contract scripts, also on PATH where only this overlay is loaded (CI roots).
    ["_"] { path = List("\(profile.installDir)/bin") }
  }
  settings { experimental = true }
  tools { dprint = pins(profile.tools)["dprint"] }
  deps = depsFor(new Listing { "aube"; "uv"; "composer"; "go" })
  tasks {
    fmt {
      description = "Format with dprint using the Personal ancestor config"
      dir = "{{cwd}}"
      run = "dprint fmt"
    }
    ...contract.tasks
  }
}

// ---- Shell init: each tool is guarded so a missing binary never breaks startup.
shellZsh: String =
  new Listing<String> {
    header("#")
    for (tool, cmd in profile.shellInit) {
      "command -v \(tool) >/dev/null && eval \"$(\(cmd))\""
    }
  }.join("\n") + "\n"
