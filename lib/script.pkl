/// Shared pieces of the generated bin/ scripts. No profile import, so tool
/// files can use it without a cycle.
module script

local headerLines: List<String> =
  List(
    "Code generated by `mise run generate`. DO NOT EDIT.",
    "Source of truth: profile.pkl",
  )

/// Generated-file banner using the target language's line-comment prefix.
function header(comment: String): String = headerLines.map((l) -> "\(comment) \(l)").join("\n")

/// Every wrapper starts with this: strict bash plus the generated-file banner.
bash: String = "#!/usr/bin/env bash\nset -euo pipefail\n" + header("#") + "\n"

/// Script fragment: `root`, `nearest_up <file> <glob>` and `absolute <file>`, for
/// fixers that find a config or crate by walking up from a staged file.
nearestUp: String =
  #"""
  root="$(cd "$(git rev-parse --show-toplevel)" && pwd -P)"

  # The nearest directory at or above file $1, up to the repo root, that holds a
  # file matching glob $2. Prints nothing when there is none.
  nearest_up() {
    local dir
    dir="$(cd "$(dirname "$1")" && pwd -P)"
    while :; do
      if compgen -G "${dir}/$2" >/dev/null; then
        echo "${dir}"
        return 0
      fi
      if [[ "${dir}" == "${root}" || "${dir}" == / ]]; then return 0; fi
      dir="$(dirname "${dir}")"
    done
  }

  # Absolute path of a staged file.
  absolute() {
    echo "$(cd "$(dirname "$1")" && pwd -P)/$(basename "$1")"
  }
  """#

/// Script fragment: `push_remote`, `empty_tree`, `default_base <tip>` and `ranges`, for
/// steps that judge or fix what a push uploads. `ranges` prints "<base> <tip>" per
/// pushed ref. In a push, SAH_PUSH_REFS names the saved pre-push stdin
/// ("<local ref> <local sha> <remote ref> <remote sha>"); a new branch, or a
/// remote tip this clone lacks, diffs from the merge-base with the default
/// branch (the empty tree on a first push). Outside a push: merge-base of HEAD.
pushRanges: String =
  #"""
  push_remote="${DEV_PROFILE_PUSH_REMOTE:-origin}"
  empty_tree="$(git hash-object -t tree /dev/null)"
  default_base() { # <tip>
    local ref
    for ref in "${push_remote}/HEAD" "${push_remote}/main" "${push_remote}/master"; do
      if git rev-parse -q --verify "${ref}^{commit}" >/dev/null 2>&1; then
        git merge-base "$1" "${ref}" 2>/dev/null && return 0
      fi
    done
    echo "${empty_tree}"
  }
  ranges() {
    local all_zeros='^0+$' _lref local_sha _rref remote_sha
    if [[ -n "${SAH_PUSH_REFS:-}" && -r "${SAH_PUSH_REFS}" ]]; then
      while read -r _lref local_sha _rref remote_sha; do
        [[ -n "${local_sha:-}" ]] || continue
        if [[ "${local_sha}" =~ ${all_zeros} ]]; then continue; fi
        if [[ "${remote_sha}" =~ ${all_zeros} ]] || ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
          echo "$(default_base "${local_sha}") ${local_sha}"
        else
          echo "${remote_sha} ${local_sha}"
        fi
      done <"${SAH_PUSH_REFS}"
    else
      echo "$(default_base HEAD) HEAD"
    fi
  }
  """#

/// Script fragment: `operation_in_progress`, true while a merge, cherry-pick,
/// revert or rebase is unfinished.
gitOperation: String =
  #"""
  operation_in_progress() {
    local operation
    for operation in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply; do
      if [[ -e "$(git rev-parse --git-path "${operation}")" ]]; then return 0; fi
    done
    return 1
  }
  """#

/// Script fragment: `hooked_notes` and `mark_hooked <commit>`. A commit made through
/// the commit hooks carries a note in this ref: its fixers already ran on exactly its
/// tree, so a push has nothing to fix in it. Commits made without the hooks (HK=0,
/// --no-verify, history from before the profile) carry none.
hookedNotes: String =
  #"""
  hooked_notes=dev-profile-hooked
  mark_hooked() {
    git notes --ref="${hooked_notes}" add -f -m hooked "$1" >/dev/null 2>&1 || true
  }
  """#

/// Script fragment: `count_files <n>`, which prints "1 file" or "<n> files".
countFiles: String =
  #"""
  count_files() {
    if (($1 == 1)); then echo "1 file"; else echo "$1 files"; fi
  }
  """#

/// Script fragment: `remote_named <name-or-url>`, the configured remote that name
/// or URL stands for. Prints nothing when none does, so a caller never guesses.
pushRemote: String =
  #"""
  remote_named() {
    local line key name
    if git config --get "remote.$1.url" >/dev/null 2>&1; then echo "$1"; return 0; fi
    while IFS= read -r line; do
      [[ "${line#* }" == "$1" ]] || continue
      key="${line%% *}"
      name="${key#remote.}"
      echo "${name%.*}"
      return 0
    done < <(git config --get-regexp '^remote\..*\.(url|pushurl)$' 2>/dev/null || true)
  }
  """#

/// Script fragment: `checked_out_pushes`, the sha of each pushed ref that is the
/// checked-out branch going to the branch of the same name. Only such a push may
/// get a commit added: fixing `main` from `feat`, or `main:other` from `main`,
/// would put a commit on a branch the user did not push. Reads SAH_PUSH_REFS; with
/// none, the push is HEAD itself.
checkedOutPushes: String =
  #"""
  checked_out_pushes() {
    local current lref lsha rref _rsha
    current="$(git symbolic-ref -q HEAD)" || return 0
    if [[ -z "${SAH_PUSH_REFS:-}" || ! -r "${SAH_PUSH_REFS}" ]]; then
      git rev-parse HEAD
      return 0
    fi
    while read -r lref lsha rref _rsha; do
      [[ "${lref}" != HEAD ]] || lref="${current}"
      [[ "${lref}" == "${current}" && "${rref}" == "${current}" ]] || continue
      echo "${lsha}"
    done <"${SAH_PUSH_REFS}"
  }
  """#

/// Script fragment: `root`, `physical`, `nearest`, `gowork_for` and `packages`,
/// for Go steps that group the given files by package and module.
goModules: String =
  #"""
  root="$(cd "$(git rev-parse --show-toplevel)" && pwd -P)"

  # Physical absolute path, so it compares equal to the paths go prints.
  physical() {
    echo "$(cd "$(dirname "$1")" && pwd -P)/${1##*/}"
  }

  # The nearest directory at or above $1, up to the repo root, holding file $2.
  nearest() {
    local dir="$1"
    while :; do
      if [[ -f "${dir}/$2" ]]; then
        echo "${dir}"
        return 0
      fi
      if [[ "${dir}" == "${root}" || "${dir}" == / ]]; then return 0; fi
      dir="$(dirname "${dir}")"
    done
  }

  # "off" when a go.work above the module does not list it: go would refuse to
  # build it there ("directory is outside modules listed in go.work").
  gowork_for() {
    local module="$1" workdir rel members
    workdir="$(nearest "${module}" go.work)"
    [[ -n "${workdir}" ]] || return 0
    rel="${module#"${workdir}"}"
    rel="${rel#/}"
    members="$(cd "${workdir}" && go work edit -json |
      jq -r '.Use[]?.DiskPath | sub("^\\./"; "") | sub("/$"; "") | if . == "" then "." else . end')"
    grep -qxF -- "${rel:-.}" <<<"${members}" || echo off
  }

  # The go tool ignores directories named testdata; so do we, since their
  # files are fixtures that need not build.
  under_testdata() {
    case "/${1#"${root}"}/" in */testdata/*) return 0 ;; esac
    return 1
  }

  # Staged Go files → one line per package: <module dir>, <GOWORK>, <package dir> joined by the unit separator (tab would collapse an empty GOWORK).
  packages() {
    local file dir module
    for file in "$@"; do
      if [[ -f "${file}" ]]; then dirname "$(physical "${file}")"; fi
    done | sort -u | while IFS= read -r dir; do
      under_testdata "${dir}" && continue
      module="$(nearest "${dir}" go.mod)"
      [[ -n "${module}" ]] || continue
      printf '%s\x1f%s\x1f%s\n' "${module}" "$(gowork_for "${module}")" "${dir}"
    done | sort
  }
  """#

/// `goModules` plus `pattern`, for Go steps that run a tool per package.
goPackages: String = goModules + "\n\n" + goPattern

local goPattern: String =
  #"""
  # The go package pattern for a package dir, relative to its module ("./x" or ".").
  pattern() {
    echo ".${2#"$1"}"
  }
  """#

/// Script fragment: `perl_config <tool> <dir>` and `require_perl_tool <tool>`, for
/// the perltidy and perlcritic wrappers. Neither tool looks for its rc file above
/// the current directory, so the wrapper passes one explicitly: the rc file at
/// the repo root of <dir> wins, else the profile's own, rendered next to bin/.
perlTools: String =
  #"""
  profile_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

  # Where dev-profile-perl-tools-install puts the CPAN tools. Hooks and GUI editors
  # may not have the shell's local::lib environment, so find them here.
  perl_lib_root="${HOME}/perl5"
  export PATH="${PATH}:${perl_lib_root}/bin"
  export PERL5LIB="${perl_lib_root}/lib/perl5${PERL5LIB:+:${PERL5LIB}}"

  # Fail the step, never skip it: a formatter or linter that silently does nothing is worse than none.
  require_perl_tool() { # <tool>
    if ! command -v "$1" >/dev/null 2>&1; then
      echo "$1 is not installed; install it with: dev-profile-perl-tools-install" >&2
      exit 1
    fi
  }

  # The rc file for tool $1: the repo's own .<tool>rc at the root of the repo holding dir $2, else the profile's <tool>rc.
  perl_config() { # <tool> <dir>
    local repo_root
    repo_root="$(git -C "$2" rev-parse --show-toplevel 2>/dev/null)" || repo_root="$2"
    if [[ -f "${repo_root}/.$1rc" ]]; then
      echo "${repo_root}/.$1rc"
    else
      echo "${profile_dir}/$1rc"
    fi
  }
  """#
