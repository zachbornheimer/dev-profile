/// Shared pieces of the generated bin/ scripts. No profile import, so tool
/// files can use it without a cycle.
module script

local headerLines: List<String> =
  List(
    "Code generated by `mise run generate`. DO NOT EDIT.",
    "Source of truth: profile.pkl",
  )

/// Generated-file banner using the target language's line-comment prefix.
function header(comment: String): String = headerLines.map((l) -> "\(comment) \(l)").join("\n")

/// A POSIX shell single-quoted word: the value exactly, whatever it holds.
function shellWord(value: String): String = "'" + value.replaceAll("'", #"'\''"#) + "'"

/// lib/facts.sh: one readonly assignment per fact, sourceable by sh and bash.
function factsFile(facts: Map<String, String>): String =
  new Listing<String> {
    "# shellcheck shell=sh"
    header("#")
    "# Values the bin/ scripts read at run time; each comes from a tool's `facts`."
    for (name, value in facts) { "readonly \(name)=\(shellWord(value))" }
  }.join("\n") + "\n"
