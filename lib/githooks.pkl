/// Helper a hook can run when the active hk config may not define that event.
/// Not what bootstrap installs: `mise run install-git-hooks` writes `hk run`
/// into `~/.gitconfig`. SAH does not share that install; it overrides those
/// keys under its root with `includeIf worktree:`.
module githooks

import "render.pkl"

/// Generated bin/ scripts the global git hooks run.
wrappers: Mapping<String, String> = new {
  ["dev-profile-git-hook"] =
    let (r = read?("git-hook.sh")) if (r is String) r else if (r == null) "" else r.text
}
