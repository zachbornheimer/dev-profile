{
  // Personal ancestor dprint config. Installed as ~/Developer/Personal/dprint.jsonc.
  // Wasm plugins are shareable. The exec process plugin stays in this local file
  // because remote extends ignore non-Wasm plugins.
  "incremental": true,
  "excludes": [
    "**/*-lock.json",
    "**/node_modules",
    "**/.venv",
    "**/vendor",
    "**/target",
    "**/.git",
    "**/dist"
  ],
  "exec": {
    "cwd": "${configDir}",
    "commands": [
      {
        "command": "perltidy",
        "exts": ["pl", "pm", "t"]
      },
      {
        "command": "terraform fmt -",
        "exts": ["tf"]
      }
    ]
  },
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.25.1",
    "npm:@dprint/markdown@0.26.0",
    "npm:@dprint/toml@0.8.0",
    "npm:@dprint/dockerfile@0.6.0",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/ruff@0.9.1",
    "npm:@jakebailey/dprint-plugin-gofumpt@0.0.18",
    "npm:@dprint/mago@0.29.1",
    "npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67",
    "npm:@kachick/dprint-plugin-sh@0.1.2"
  ]
}
