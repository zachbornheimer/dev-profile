# API keys for every AI CLI (claude, codex, opencode, grok) — resolved from
# 1Password once by `op inject` into ~/.cache/ai/keys.env (see ai-keys::env
# in ~/.zshrc.local).
# Contains NO secrets, only 1Password references. Safe to commit / capture in dotfiles.
#
# Setup:
#   1. Create the four items in 1Password (with ROTATED keys — the old ones leaked).
#      Item names must NOT contain colons (op:// uses colon as delimiter).
#      Use these exact names:
#        op item create --category="API Credential" --vault="Private" \
#          --title="Claude Code OpenAI API Key" credential="sk-...ROTATED..."
#        op item create --category="API Credential" --vault="Private" \
#          --title="Claude Code xAI API Key" credential="xai-...ROTATED..."
#        op item create --category="API Credential" --vault="Private" \
#          --title="Claude Code Cerebras API Key" credential="csk-...ROTATED..."
#        op item create --category="API Credential" --vault="Private" \
#          --title="Claude Code Exa API Key" credential="..."
#   2. Verify: ai-keys-refresh && grep -c _API_KEY ~/.cache/ai/keys.env
#   3. Then `claude`/`c`, `codex`, `opencode`, `grok` all launch with the keys exported;
#      subagents inherit them. `ai-keys-refresh` re-injects after editing this file.
#
# NOTE: replace "Private" with your actual vault name if different.

OPENAI_API_KEY=op://Zysys/Claude Code OpenAI API Key/credential
X_AI_API_KEY=op://Zysys/Claude Code xAI API Key/credential
CEREBRAS_API_KEY=op://Zysys/Claude Code Cerebras API Key/credential
EXA_API_KEY=op://Zysys/Claude Code Exa API Key/credential

# PagerDuty MCP (Claude Code plugin) — REST API key, header `Token token=<key>`.
PAGERDUTY_API_KEY=op://SAH/PagerDuty DevOps API Key/credential

# OpenRouter: the capability runtime language route, and TypeSafe (openrouter/~typesafe/jev-latest).
# There is no direct TYPESAFE_API_KEY; TypeSafe calls go through this key.
OPENROUTER_API_KEY=op://Zysys/OpenRouter API Key/credential
