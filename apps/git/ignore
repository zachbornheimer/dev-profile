# Global ignore: applies to EVERY repo on this machine.
# Your personal/OS junk goes here; rules a project shares go in that
# project's own .gitignore. To see which rule hides a path:
#     git check-ignore -v <path>

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
# The macOS icon file is "Icon" plus one trailing character (\r or space)
Icon
Icon?
# Files macOS makes when copying to drives
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.localized
__MACOSX/
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# --- Editors, backups, temp files ---
*~
*.swp
*.swo

# --- Python ---
__pycache__/
*.py[cod]

# --- Node tooling ---
node_modules/
.node_modules/
npm-debug.log*
yarn-error.log*

