version = 1

[settings]
max_concurrency = 32
default_timeout = "30s"

[defaults]
agents = ["claude", "codex", "gemini", "grok", "hermes", "copilot", "opencode", "mastra"]
protocol = "native"
shell = true
timeout = "30s"

[[hooks]]
name = "elicitationresult-aoe-status-sh"
events = ["ElicitationResult", "prompt.submit"]
command = ["/Users/zbornheimer/.agents/hooks/aoe-status.sh running"]
timeout = "2s"

[[hooks]]
name = "notification-aoe-status-sh"
events = ["Notification"]
command = ["/Users/zbornheimer/.agents/hooks/aoe-status.sh waiting"]
timeout = "2s"
matcher = "permission_prompt|elicitation_dialog|agent_needs_input"

[[hooks]]
name = "notification-aoe-status-sh-2"
events = ["Notification"]
command = ["/Users/zbornheimer/.agents/hooks/aoe-status.sh idle"]
timeout = "2s"
matcher = "idle_prompt|agent_completed"

[[hooks]]
name = "posttooluse-bash-signature-record"
events = ["tool.after", "PostToolUseFailure"]
policy = "record-bash-signature"
timeout = "5s"
matcher = "Bash"

[[hooks]]
name = "posttooluse-output-budget"
events = ["tool.after"]
policy = "output-budget"
timeout = "5s"
matcher = "Bash"

[[hooks]]
name = "posttooluse-edit-record"
events = ["tool.after"]
policy = "record-edit"
timeout = "5s"
matcher = "Edit|Write"

[[hooks]]
name = "posttooluse-agent-spawn-record"
events = ["tool.after"]
policy = "record-agent-spawn"
timeout = "5s"
matcher = "Agent|Task"

[[hooks]]
name = "posttooluse-work-order-report-py"
events = ["tool.after"]
command = ["/Users/zbornheimer/.agents/hooks/work-order-report.py"]
timeout = "60s"
matcher = "Agent|Task"

[[hooks]]
name = "posttooluse-aoe-status-sh"
events = ["tool.after"]
command = ["/Users/zbornheimer/.agents/hooks/aoe-status.sh running"]
timeout = "2s"
matcher = "AskUserQuestion"

[[hooks]]
name = "precompact-goals-note-compaction-py"
events = ["context.compact.before"]
command = ["/Users/zbornheimer/.agents/hooks/goals-note-compaction.py"]
timeout = "15s"
