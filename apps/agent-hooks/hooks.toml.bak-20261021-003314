  "git config --global user.email z@chary.me; git config --global user.name 'Zach Bornheimer'; git config --global commit.gpgsign true",
]
timeout = "5s"

[[hooks]]
name = "sessionstart-goals-recall-py"
events = ["session.start"]
command = ["/Users/zbornheimer/.agents/hooks/goals-recall.py"]
timeout = "15s"
matcher = "startup|resume|compact"

[[hooks]]
name = "sessionstart-aoe-extract-session-sh"
events = ["session.start", "prompt.submit"]
command = ["/Users/zbornheimer/.agents/hooks/aoe-extract-session.sh"]
timeout = "5s"

[[hooks]]
name = "sessionstart-memory-recall-py"
events = ["session.start"]
command = ["/Users/zbornheimer/.agents/hooks/memory-recall.py"]
timeout = "15s"
matcher = "startup|resume|compact"

[[hooks]]
name = "sessionstart-sh"
events = ["session.start", "prompt.submit"]
command = [
  "[ -n \"$AOE_INSTANCE_ID\" ] || exit 0; [ -n \"$AOE_HOOK_BIN\" ] || exit 0; [ -x \"$AOE_HOOK_BIN\" ] || exit 0; \"$AOE_HOOK_BIN\" __extract-session-id --field session-id --agent \"$AGENT_HOOKS_AGENT\" 2>/dev/null; exit 0",
]
timeout = "5s"

[[hooks]]
name = "stop-find"
events = ["turn.stop"]
command = [
  "find -L /Users/zbornheimer/.claude/skills \\( -name \"*.py\" -o -name \"*.sh\" \\) -newer /tmp/.claude_lint_sentinel 2>/dev/null | grep -q . && { touch /tmp/.claude_lint_sentinel; (cd /Users/zbornheimer/.claude && mise run lint || true); }; touch /tmp/.claude_lint_sentinel",
]
timeout = "15s"

[[hooks]]
name = "stop-completion-gate-py"
events = ["turn.stop"]
