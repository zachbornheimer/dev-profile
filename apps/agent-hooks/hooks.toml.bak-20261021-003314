# This hook must stay last among prompt.submit hooks: agent-hooks concatenates each hook's additionalContext in
# config order, so this runner's capability XML is the final block the agent receives, after intent, project and
# the atask context. The runner applies nested-run-guard internally and prints the XML as additionalContext.
[[hooks]]
name = "userpromptsubmit-capability-xml-sh"
events = ["prompt.submit"]
command = ["/Users/zbornheimer/.agents/hooks/prompt-submit-capabilities.sh"]
timeout = "45s"

# A denied shell tool is a routing signal: the hook injects the one instruction
# that gets the agent back to a working command runner.
[[hooks]]
name = "permissiondenied-shell-denial-steer-py"
events = ["PermissionDenied", "PostToolUseFailure"]
command = ["/Users/zbornheimer/.agents/hooks/shell-denial-steer.py"]
timeout = "5s"
matcher = "Bash|sh|zsh|exec|shell|terminal|run_terminal_command"
