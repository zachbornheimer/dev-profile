{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "/Users/zbornheimer/.claude/CLAUDE.md",
    "/Users/zbornheimer/.claude/rules/*.md"
  ],
  "skills": {
    "paths": [
      "/Users/zbornheimer/.agents/skills"
    ]
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "enabled": true
    },
    "firefox-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@mozilla/firefox-devtools-mcp@latest"
      ],
      "enabled": false
    },
    "agentmux": {
      "type": "local",
      "command": [
        "agentmux",
        "mcp"
      ],
      "enabled": true
    },
    "evident-output": {
      "type": "local",
      "command": [
        "/Users/zbornheimer/.local/bin/evident-output-mcp"
      ],
      "enabled": false
    },
    "open-computer-use": {
      "type": "local",
      "command": [
        "open-computer-use",
        "mcp"
      ],
      "enabled": false
    },
    "MCP_DOCKER": {
      "type": "local",
      "command": [
        "docker",
        "mcp",
        "gateway",
        "run",
        "--profile",
        "zach"
      ],
      "enabled": true,
      "environment": {
        "DOCKER_HOST": "unix:///Users/zbornheimer/.docker/run/docker.sock"
      }
    },
    "agent-mail": {
      "type": "local",
      "command": [
        "/opt/homebrew/opt/mcp-agent-mail/bin/mcp-agent-mail"
      ],
      "enabled": false
    }
  }
}
