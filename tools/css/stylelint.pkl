amends "../../lib/Tool.pkl"

doc = "stylelint --fix at commit; exit 2 leaves problems for push, 78 means no config here."
pin { id = "npm:stylelint"; version = "17.16.0" }
on {
  ["pre-commit"] {
    glob = List("**/*.css", "**/*.scss", "**/*.sass")
    fix = "dev-profile-stylelint-fix {{files}}"
  }
}

scripts {
  ["dev-profile-stylelint-fix"] =
    let (r = read?("stylelint-fix.sh")) if (r is String) r else if (r == null) "" else r.text
}
