amends "../../lib/Tool.pkl"

doc =
  "Swift lint. Commit applies --fix; push reports what is left. Skips when swiftlint is not installed."
on {
  ["pre-commit"] { glob = List("**/*.swift"); fix = "dev-profile-swiftlint-fix {{files}}" }
  ["pre-push"] = module.builtins.swiftlint
}

scripts {
  ["dev-profile-swiftlint-fix"] =
    let (r = read?("swiftlint-fix.sh")) if (r is String) r else if (r == null) "" else r.text
}
