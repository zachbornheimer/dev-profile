amends "../../lib/Tool.pkl"

doc =
  "Swift lint. Commit applies --fix; push reports what is left. Skips when swiftlint is not installed."
on {
  ["pre-commit"] { glob = List("**/*.swift"); fix = "dev-profile-swiftlint-fix {{files}}" }
  ["pre-push"] = module.builtins.swiftlint
}

local swiftlintFix =
  """
  \(bash)
  if ! command -v swiftlint >/dev/null 2>&1; then
    exit 0
  fi
  if [[ $# -eq 0 ]]; then
    exit 0
  fi
  exec dev-profile-fix swiftlint --fix --quiet "$@"
  """

scripts {
  ["dev-profile-swiftlint-fix"] = swiftlintFix
}
