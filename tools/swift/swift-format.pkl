amends "../../lib/Tool.pkl"

doc =
  "swift-format (or swiftformat) after swiftlint's fixes. Also the dprint exec command for Swift."
on {
  ["pre-commit"] {
    glob = List("**/*.swift")
    depends = List("swiftlint-fix")
    fix = "dev-profile-swift-format {{files}}"
  }
}

scripts {
  ["dev-profile-swift-format"] =
    let (r = read?("swift-format.sh")) if (r is String) r else if (r == null) "" else r.text
}
