amends "../../lib/Tool.pkl"

doc = "Ruby lint. Commit applies -A, unsafe cops included; push reports what is left."
on {
  ["pre-commit"] { glob = List("**/*.rb", "**/*.rake"); fix = "dev-profile-rubocop-fix {{files}}" }
  ["pre-push"] = module.builtins.rubocop
}

scripts {
  ["dev-profile-rubocop-fix"] =
    let (r = read?("rubocop-fix.sh")) if (r is String) r else if (r == null) "" else r.text
}
