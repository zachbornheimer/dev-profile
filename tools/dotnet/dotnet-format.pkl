amends "../../lib/Tool.pkl"

doc =
  "dotnet format style and analyzer fixes, limited to the staged files of each solution or project."
on {
  ["pre-commit"] {
    glob = List("**/*.cs", "**/*.vb")
    fix = "dev-profile-dotnet-format-fix {{files}}"
  }
}

scripts {
  ["dev-profile-dotnet-format-fix"] =
    let (r = read?("dotnet-format-fix.sh")) if (r is String) r else if (r == null) "" else r.text
}
