amends "../../lib/Tool.pkl"

doc = "GitHub Actions security audit at push; skips when zizmor is not installed."
pin { id = "zizmor"; version = "1.30.1" }
on {
  ["pre-push"] = (module.builtins.zizmor) {
    check = "dev-profile-if-installed zizmor zizmor --no-progress {{files}}"
    fix = null
  }
}
