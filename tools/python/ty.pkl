amends "../../lib/Tool.pkl"

doc = "Python type check at push; skips when ty is not installed."
on {
  ["pre-push"] { types = List("python"); check = "dev-profile-ty {{files}}" }
}

scripts {
  ["dev-profile-ty"] =
    let (r = read?("ty.sh")) if (r is String) r else if (r == null) "" else r.text
}
