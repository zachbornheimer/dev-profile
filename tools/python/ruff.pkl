amends "../../lib/Tool.pkl"

doc =
  "Python lint. Commit applies safe and unsafe fixes plus the modernizing rule sets; push reports what is left."
pin { id = "ruff"; version = "0.16.10" }
on {
  ["pre-commit"] {
    types = List("python")
    fix =
      "ruff check --force-exclude --fix-only --unsafe-fixes --extend-select UP,FURB,SIM,PERF,C4,PIE {{files}}"
  }
  ["pre-push"] = module.builtins.ruff
}
