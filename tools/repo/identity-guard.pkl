amends "../../lib/Tool.pkl"

doc =
  "Fail the push when the repo's local git config sets user.name, user.email, or commit.gpgsign=false; identity and signing come from global config only."
on {
  ["pre-push"] {
    check = "dev-profile-identity-guard"
  }
}

scripts {
  ["dev-profile-identity-guard"] =
    let (r = read?("identity-guard.sh")) if (r is String) r else if (r == null) "" else r.text
}
