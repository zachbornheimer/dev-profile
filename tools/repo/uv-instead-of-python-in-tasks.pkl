amends "../../lib/Tool.pkl"

doc =
  "mise tasks run Python through uv: `python3 x.py` becomes `uv run x.py`, so missing dependencies fail loudly instead of being guessed."
on {
  ["pre-commit"] {
    glob = List("**/mise.toml", "**/.mise.toml", "**/mise-tasks/**", "**/.mise/tasks/**")
    fix = "dev-profile-uv-instead-of-python-in-tasks {{files}}"
  }
}

scripts {
  ["dev-profile-uv-instead-of-python-in-tasks"] =
    read?("uv-instead-of-python-in-tasks.sh")?.text ?? ""
}
