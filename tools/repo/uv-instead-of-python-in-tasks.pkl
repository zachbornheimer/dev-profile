amends "../../lib/Tool.pkl"

doc =
  "mise tasks run Python through uv: `python3 x.py` becomes `uv run x.py`, so missing dependencies fail loudly instead of being guessed."
on {
  ["pre-commit"] {
    glob = List("**/mise.toml", "**/.mise.toml", "**/mise-tasks/**", "**/.mise/tasks/**")
    fix = "dev-profile-uv-instead-of-python-in-tasks {{files}}"
  }
}

local uvInsteadOfPythonInTasks =
  #"""
  #!/usr/bin/env bash
  set -euo pipefail
  # Commit-time fixer: Python in a mise task runs through uv. `python3 x.py`
  # becomes `uv run x.py` (honoring the uv project or the script's PEP 723
  # header); any other bare python/python3 becomes `uv run python3`. Missing
  # dependencies then fail loudly instead of being guessed.
  (($#)) || exit 0
  cmd='(^|[;&|(]|=\s*"|\[\s*"|,\s*")(\s*(?:[A-Za-z_][A-Za-z0-9_]*=\S*\s+)*)'
  perl -pi -e "
    s{${cmd}python3?\s+(?=[^\s\"';&|]+\.py(?:[\s\"';&|)]|\$))}{\$1\$2uv run }g;
    s{${cmd}(python3?)(?=[\s\"';&|)]|\$)}{\$1\$2uv run \$3}g;
  " "$@"
  """#

scripts {
  ["dev-profile-uv-instead-of-python-in-tasks"] = uvInsteadOfPythonInTasks
}
