amends "../../lib/Tool.pkl"

doc =
  "A dev server reads its port from $PORT and runs through `mise run dev`, which gives each checkout its own port and https://<name>.localhost URL behind Caddy; a hardcoded dev port literal added by the push fails it unless the same file also reads PORT from the environment. Only the app's own server port is judged: a literal that is the fallback of an env read on its line, or a localhost address on a port the repo does not serve (Ollama, a memory API, a proxy), passes. Only lines the push adds are judged, so existing literals never block an unrelated edit."
skipsLockfiles = true

// Tests, fixtures and docs name ports on purpose.
local notAppCode: List<String> =
  List(
    "**/tests/**",
    "**/test/**",
    "**/__tests__/**",
    "**/testdata/**",
    "**/fixtures/**",
    "**/*_test.go",
    "**/*.test.*",
    "**/*.spec.*",
    "**/test_*.py",
    "**/*_test.py",
    "**/conftest.py",
    "**/docs/**",
    "**/*.md",
    "**/*.mdx",
    "**/*.rst",
    "**/*.txt",
  )

// The globs own_ports excludes, so it never learns a port out of a test or doc.
facts { ["PROFILE_NOT_APP_CODE"] = notAppCode.join("\n") }

on {
  ["pre-push"] {
    exclude = notAppCode
    check = "dev-profile-hardcoded-dev-port {{files}}"
  }
}

scripts {
  ["dev-profile-hardcoded-dev-port"] =
    let (r = read?("hardcoded-dev-port.sh")) if (r is String) r else if (r == null) "" else r.text
}
