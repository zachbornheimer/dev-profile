amends "../../lib/Tool.pkl"

doc =
  "A dev server reads its port from $PORT and runs through `mise run dev`, which gives each checkout its own port and https://<name>.localhost URL behind Caddy; a hardcoded dev port literal added by the push fails it unless the same file also reads PORT from the environment. Only the app's own server port is judged: a literal that is the fallback of an env read on its line, or a localhost address on a port the repo does not serve (Ollama, a memory API, a proxy), passes. Only lines the push adds are judged, so existing literals never block an unrelated edit."
skipsLockfiles = true

// Tests, fixtures and docs name ports on purpose.
local notAppCode: List<String> =
  List(
    "**/tests/**",
    "**/test/**",
    "**/__tests__/**",
    "**/testdata/**",
    "**/fixtures/**",
    "**/*_test.go",
    "**/*.test.*",
    "**/*.spec.*",
    "**/test_*.py",
    "**/*_test.py",
    "**/conftest.py",
    "**/docs/**",
    "**/*.md",
    "**/*.mdx",
    "**/*.rst",
    "**/*.txt",
  )

// git pathspecs that keep own_ports from learning a port out of a test or doc.
local appCodeOnly: String = notAppCode.map((glob) -> "':(exclude,glob)\(glob)'").join(" ")

on {
  ["pre-push"] {
    exclude = notAppCode
    check = "dev-profile-hardcoded-dev-port {{files}}"
  }
}

local hardcodedDevPort =
  #"""
  \#(bash)
  # Pre-push judge: no hardcoded dev port added to app code (added lines only). A file that reads PORT from
  # the environment may keep a literal as its fallback default.
  (($#)) || exit 0

  # Where the app's own server binds. One ERE per line: a bind address, a listen
  # address string, .listen(<port>), PORT=<port>. Always judged.
  listen_sites() {
    cat <<'EOF'
  0\.0\.0\.0:[0-9]{4,5}([^0-9]|$)
  ["'`]:[0-9]{4,5}["'`]
  \.listen\([[:space:]]*[0-9]{4,5}
  (^|[^[:alnum:]_])PORT=["']?[0-9]{2,5}
  EOF
  }

  # A client-side address. It is the app's own only when the repo serves that
  # port; otherwise it names another service (Ollama, a memory API, a proxy).
  client_address() {
    echo '(127\.0\.0\.1|localhost):[0-9]{4,5}([^0-9]|$)'
  }

  # An env read whose fallback is on the same line: the literal is configurable.
  env_fallbacks() {
    cat <<'EOF'
  \$\{[A-Za-z_][A-Za-z0-9_]*:?[-=]
  [Ee][Nn][Vv](\.[A-Za-z_][A-Za-z0-9_]*|\[["'][A-Za-z_][A-Za-z0-9_]*["']\])[[:space:]]*(\?\?|\|\|)
  ENV\{[A-Za-z_][A-Za-z0-9_]*\}[[:space:]]*(//|\|\|)
  [Gg]etenv\([^)]*\)[[:space:]]*(\?\?|\?:|\|\||or[[:space:]])
  [A-Za-z_.]*[Ee][Nn][Vv][A-Za-z_.]*\([[:space:]]*["'][A-Z][A-Z0-9_]*["'][[:space:]]*,
  EOF
  }

  # Ports most dev servers default to: a URL on one is taken as the app's own
  # even when no listen site in the repo names it.
  conventional_dev_ports() {
    printf '%s\n' 3000 3001 4000 4200 4321 5000 5173 5174 8000 8080 8081 8888 9000
  }

  # A compose file's published port, "<host>:<container>".
  compose_ports() {
    cat <<'EOF'
  ^[[:space:]]*-?[[:space:]]*["']?[0-9]{4,5}:[0-9]{2,5}(/[a-z]+)?["']?[[:space:]]*(#.*)?$
  EOF
  }

  # The ways code reads PORT from its environment.
  reads_port() {
    cat <<'EOF'
  process\.env\.PORT
  env\.PORT
  [Gg]etenv\(["']PORT["']
  LookupEnv\(["']PORT["']
  environ(\.get)?[\[(]["']PORT["']
  ENV(\.fetch)?[\[(]["']PORT["']
  env\(["']PORT["']
  \$\{?PORT([^[:alnum:]_]|$)
  EOF
  }

  # "<base> <tip>" per pushed ref. In a push, SAH_PUSH_REFS names the saved
  # pre-push stdin ("<local ref> <local sha> <remote ref> <remote sha>"); a
  # new branch, or a remote tip this clone lacks, diffs from the merge-base
  # with the default branch. Outside a push: merge-base of HEAD.
  empty_tree="$(git hash-object -t tree /dev/null)"
  default_base() { # <tip>
    local ref
    for ref in origin/HEAD origin/main origin/master; do
      if git rev-parse -q --verify "${ref}^{commit}" >/dev/null; then
        git merge-base "$1" "${ref}" 2>/dev/null && return 0
      fi
    done
    echo "${empty_tree}"
  }
  ranges() {
    local all_zeros='^0+$' _lref local_sha _rref remote_sha
    if [[ -n "${SAH_PUSH_REFS:-}" && -r "${SAH_PUSH_REFS}" ]]; then
      while read -r _lref local_sha _rref remote_sha; do
        [[ -n "${local_sha:-}" ]] || continue
        if [[ "${local_sha}" =~ ${all_zeros} ]]; then continue; fi
        if [[ "${remote_sha}" =~ ${all_zeros} ]] || ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
          echo "$(default_base "${local_sha}") ${local_sha}"
        else
          echo "${remote_sha} ${local_sha}"
        fi
      done <"${SAH_PUSH_REFS}"
    else
      echo "$(default_base HEAD) HEAD"
    fi
  }

  # Every port this repo's own server takes: the conventional dev ports plus
  # each port a tracked, non-test file listens on or publishes from compose.
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  own_ports() {
    conventional_dev_ports
    {
      git -C "${repo_root}" grep -hIoE -e "$(listen_sites | paste -sd'|' -)" -e '--port[= ][0-9]{4,5}' \
        -- . \#(appCodeOnly) || true
    } | grep -oE '[0-9]{4,5}' || true
    {
      git -C "${repo_root}" grep -hIoE -e "$(compose_ports)" -- '*compose*.yml' '*compose*.yaml' \
        \#(appCodeOnly) || true
    } | grep -oE '[0-9]{4,5}:' | tr -d ':' || true
  }


  own="$(own_ports)"
  status=0
  # One diff, one judge. A per-file re-diff was 16s on a 223-file push, and
  # a per-file awk of that diff was still 7s. A hook that slow fails the push.
  diff_cache="$(mktemp)"
  readers="$(mktemp)"
  trap 'rm -f "${diff_cache}" "${readers}"' EXIT
  while read -r base tip; do
    [[ -n "${base:-}" ]] || continue
    git diff -U0 --no-color --no-ext-diff "${base}" "${tip}" -- "$@" >>"${diff_cache}" || [[ $? -eq 1 ]]
  done < <(ranges)
  grep -lIE -e "$(reads_port)" -- "$@" >"${readers}" 2>/dev/null || true
  hits="$(
    LISTEN_RE="$(listen_sites | paste -sd'|' -)" \
    FALLBACK_RE="$(env_fallbacks | paste -sd'|' -)" \
    CLIENT_RE="$(client_address)" \
    COMPOSE_RE="$(compose_ports)" \
    OWN_PORTS="${own}" \
    READERS="${readers}" \
    awk '
      BEGIN {
        listen = ENVIRON["LISTEN_RE"]
        fallback = ENVIRON["FALLBACK_RE"]
        client = ENVIRON["CLIENT_RE"]
        compose = ENVIRON["COMPOSE_RE"]
        readers = ENVIRON["READERS"]
        while ((getline line < readers) > 0) skip[line] = 1
        close(readers)
        nown = split(ENVIRON["OWN_PORTS"], ports, "\n")
        for (i = 1; i <= nown; i++) if (ports[i] != "") is_own[ports[i]] = 1
      }
      /^diff --git / { file = ""; next }
      /^\+\+\+ / {
        path = substr($0, 5)
        if (substr(path, 1, 1) == "\"") path = substr(path, 2, length(path) - 2)
        sub(/^b\//, "", path)
        file = path
        next
      }
      file == "" || (file in skip) { next }
      /^@@/ { split($3, a, ","); n = substr(a[1], 2) + 0; next }
      /^\+/ {
        text = substr($0, 2)
        line_no = n
        n++
        if (fallback != "" && text ~ fallback) next
        bad = (listen != "" && text ~ listen)
        if (!bad && client != "" && text ~ client) {
          rest = text
          while (match(rest, client)) {
            chunk = substr(rest, RSTART, RLENGTH)
            rest = substr(rest, RSTART + RLENGTH)
            if (match(chunk, /[0-9]{4,5}/) && (substr(chunk, RSTART, RLENGTH) in is_own)) bad = 1
          }
        }
        if (!bad) {
          base = file
          sub(/^.*\//, "", base)
          if (base ~ /compose/ && base ~ /\.ya?ml$/ && compose != "" && text ~ compose) bad = 1
        }
        if (bad) print file ":" line_no ":" text
      }
    ' "${diff_cache}" | sort -t: -k1,1 -k2,2n -u
  )"
  if [[ -n "${hits}" ]]; then
    printf '%s\n' "${hits}" >&2
    status=1
  fi


  if [[ "${status}" -ne 0 ]]; then
    echo "hardcoded dev port: read \$PORT from the environment (a literal fallback default is fine) and run the app with PORT set per checkout (e.g. through 'mise run dev')." >&2
  fi
  exit "${status}"
  """#

scripts {
  ["dev-profile-hardcoded-dev-port"] = hardcodedDevPort
}
