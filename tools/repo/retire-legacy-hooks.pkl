amends "../../lib/Tool.pkl"

doc =
  "Doctor warning and healer, no hook: retires per-repo .git/hooks files written by retired hook managers, so only the global hk hooks run. Worktrunk runs it on every switch; --check only warns."

local retireLegacyHooks =
  #"""
  \#(bash)
  # Git runs .git/hooks/<name> in addition to the global config-based hk hooks.
  # A hook left by a retired manager (a lefthook stub, zq, trunk, husky, yorkie,
  # pre-commit.com) then fails or runs twice. Rename it aside, never delete it:
  # undo with mv. A hook that matches no manager here, and git-lfs hooks, stay.
  #   dev-profile-retire-legacy-hooks [--check] [repo]
  #   --check   warn and exit 0 for each retired hook; rename nothing
  retired_suffix=".retired-by-dev-profile"

  # The retired hook managers: <manager>=<ERE matching a hook file's content>.
  retired_managers=(
    "lefthook=lefthook"
    "zq=managed by zq"
    "trunk=trunk-managed|trunk git-hooks|\.trunk/"
    "husky=husky"
    "yorkie=yorkie"
    "pre-commit.com=File generated by pre-commit"
  )

  usage="usage: dev-profile-retire-legacy-hooks [--check] [repo]"
  check=false
  if [[ "${1:-}" == --check ]]; then
    check=true
    shift
  fi
  [[ $# -le 1 ]] || {
    echo "${usage}" >&2
    exit 2
  }
  repo="${1:-.}"
  common_dir="$(git -C "${repo}" rev-parse --path-format=absolute --git-common-dir)" || {
    echo "dev-profile-retire-legacy-hooks: ${repo} is not a git repository" >&2
    exit 2
  }
  hooks_dir="${common_dir}/hooks"
  [[ -d "${hooks_dir}" ]] || exit 0

  # The retired manager that wrote hook file $1, or nothing. Git LFS hooks and
  # binary files are never matched.
  retired_manager_of() {
    local entry
    grep -qIE 'git-lfs' -- "$1" && return 0
    for entry in "${retired_managers[@]}"; do
      if grep -qIE -- "${entry#*=}" "$1"; then
        echo "${entry%%=*}"
        return 0
      fi
    done
  }

  # A free name for hook $1 aside: <hook>.retired-by-dev-profile, then .1, .2...
  aside_name() {
    local target="$1${retired_suffix}" n=0
    while [[ -e "${target}" || -L "${target}" ]]; do
      n=$((n + 1))
      target="$1${retired_suffix}.${n}"
    done
    echo "${target}"
  }

  for hook in "${hooks_dir}"/*; do
    [[ -f "${hook}" && ! -L "${hook}" ]] || continue
    case "${hook}" in *.sample | *"${retired_suffix}"*) continue ;; esac
    manager="$(retired_manager_of "${hook}")"
    [[ -n "${manager}" ]] || continue
    if [[ "${check}" == true ]]; then
      echo "doctor: ${hook} is a retired ${manager} hook; run: dev-profile-retire-legacy-hooks ${repo}" >&2
    else
      aside="$(aside_name "${hook}")"
      mv -- "${hook}" "${aside}"
      echo "retired ${manager} hook: ${hook} -> ${aside}"
    fi
  done
  exit 0
  """#

scripts {
  ["dev-profile-retire-legacy-hooks"] = retireLegacyHooks
}
