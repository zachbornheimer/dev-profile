amends "../../lib/Tool.pkl"

doc =
  "Doctor warning, no hook: names files and runtime pins in a repo that the profile already owns (README \"Repo contract\"). Run by the contract doctor; warns and exits 0."

scripts {
  ["dev-profile-owned-files"] =
    let (r = read?("owned-files.sh")) if (r is String) r else if (r == null) "" else r.text
}
