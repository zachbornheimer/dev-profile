amends "../../lib/Tool.pkl"

doc =
  "Files whose first line is a shebang become executable in the worktree and the git index at commit. An hk fixer; chmod +x is a mode change, not a content rewrite."
on {
  ["pre-commit"] {
    types = List("text")
    fix = "dev-profile-shebang-scripts-executable {{files}}"
  }
}

scripts {
  ["dev-profile-shebang-scripts-executable"] =
    module.fileText(read?("shebang-scripts-executable.sh"))
}
