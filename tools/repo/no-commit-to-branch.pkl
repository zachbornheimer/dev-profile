amends "../../lib/Tool.pkl"

doc =
  "No direct commits on main or master, except when finishing a merge, cherry-pick, revert or rebase, in a repo with no origin, or with DEV_PROFILE_ALLOW_DEFAULT_BRANCH_COMMIT set."
on {
  ["pre-commit"] = (module.builtins.no_commit_to_branch) {
    check = "dev-profile-no-commit-to-default-branch"
  }
}

scripts {
  ["dev-profile-no-commit-to-default-branch"] =
    let (r = read?("no-commit-to-default-branch.sh"))
      if (r is String) r else if (r == null) "" else r.text
}
