amends "../../lib/Tool.pkl"

doc =
  "trunk and prettier are banned on this machine: a staged add or modify of their config fails, deletions pass."
on {
  ["pre-commit"] { check = "dev-profile-ban-trunk-prettier" }
}

local banTrunkPrettier =
  #"""
  #!/usr/bin/env bash
  set -euo pipefail
  # Commit guard: a staged add or modify of trunk or prettier config fails. Deleting stays allowed.
  banned_file='(^|/)(\.trunk/|\.prettierrc[^/]*$|prettier\.config\.[^/]*$|\.prettierignore$)'
  # Added lines only: removing a dependency or tool line must pass.
  banned_package_line='^\+.*"(prettier|@prettier/[^"]*)"[[:space:]]*:'
  banned_mise_line='^\+[[:space:]]*"?[^=]*\b(prettier|trunk)\b[^=]*"?[[:space:]]*='
  failed=0
  while IFS= read -r path; do
    [[ -n "${path}" ]] || continue
    if [[ "${path}" =~ ${banned_file} ]]; then
      echo "banned: ${path}" >&2
      failed=1
      continue
    fi
    case "${path}" in
      package.json | */package.json) pattern="${banned_package_line}" ;;
      mise.toml | */mise.toml | .mise*.toml | */.mise*.toml | mise.*.toml | */mise.*.toml | */mise/*.toml)pattern="${banned_mise_line}" ;;
      *) continue ;;
    esac
    if git diff --cached -U0 --no-color -- "${path}" | grep -Eq "${pattern}"; then
      echo "banned: ${path} adds trunk or prettier" >&2
      failed=1
    fi
  done < <(git diff --cached --name-only --diff-filter=ACMRT)
  if [[ "${failed}" -ne 0 ]]; then
    echo "trunk and prettier are banned on this machine. Use dprint via mise (system config ~/Developer/Personal/dprint.jsonc); delete the files instead." >&2
    exit 1
  fi
  """#

scripts {
  ["dev-profile-ban-trunk-prettier"] = banTrunkPrettier
}
