amends "../../lib/Tool.pkl"

doc =
  "trunk and prettier are banned on this machine: a staged add or modify of their config fails, deletions pass."
on {
  ["pre-push"] { check = "dev-profile-ban-trunk-prettier" }
}

scripts {
  ["dev-profile-ban-trunk-prettier"] =
    let (r = read?("ban-trunk-prettier.sh")) if (r is String) r else if (r == null) "" else r.text
}
