amends "../../lib/Tool.pkl"

doc =
  "One checkout's local dev stack behind portless: `mise run dev` prints the state, starts it detached when it is down and prints the state again; `dev:status` is the only probe (it reads a pidfile, never a port or `ps`), `dev:start` is idempotent and never kills, `dev:stop` and `dev:restart` are the only verbs that stop, and `dev:attach` runs it in the foreground. A recorded pid counts as the stack only while its process is at least as old as the pidfile, so a pid a reboot handed to another process never passes for a running stack. When worktrunk is available the stack runs under its tether (`wt step tether`), which kills the whole process group when the worktree is removed; otherwise it is a plain detached spawn. Every process a stack starts carries `DEV_PROFILE_DEV_STACK=<checkout>`, so what leaves the group (`op run` leads one of its own) is still stopped by `dev:restart` and by `dev-profile-dev reap <worktree-path>`, which worktrunk's post-remove hook runs. Between portless and the serve command sits `dev-relay.mjs`, which records the last request in `<checkout>.touched`, holds a request that arrives while the app is still booting, and runs `dev:stop` once no request has come for `DEV_PROFILE_DEV_IDLE_SECONDS` (default 24 hours); the next `cd` starts it again. A repo declares its own serve command by shipping an executable `mise-tasks/dev-serve`."

local dev =
  #"""
  \#(bash)
  # One checkout's dev stack. `dev:status` is the only probe: it reads the
  # recorded pid, so nothing has to scan ports or grep `ps`. `dev:start` starts
  # the stack detached under an exclusive lock and is idempotent, under
  # worktrunk's tether when it is available. `dev:stop` and `dev:restart` are
  # the only verbs that signal a process; the relay runs `dev:stop` itself once
  # the stack has gone a day without a request. `dev:attach` runs it in the
  # foreground. Bare `dev` is status -> start when down -> status.
  verb="${1:-}"

  # A DNS label: lowercase, anything else folded to single dashes.
  slug() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' |
      sed -e 's/[^a-z0-9]/-/g' -e 's/--*/-/g' -e 's/^-*//' -e 's/-*$//'
  }

  # One pidfile, one lockfile (and the daemon's log) per checkout.
  cache="${XDG_CACHE_HOME:-${HOME}/.cache}/dev-profile/dev"
  stop_timeout="${DEV_PROFILE_DEV_STOP_TIMEOUT:-10}" # seconds before SIGKILL

  # --- the stack tag
  #
  # A process group does not hold a stack together: `op run` leads a group of its
  # own, so the tether's group kill reaches portless and misses the `mastra dev`
  # below it, which then respawns its server for a worktree that is gone. The
  # environment follows a process through setpgid and reparenting, so every process
  # a stack starts carries DEV_PROFILE_DEV_STACK=<checkout> and is found by it.

  # Every process with its environment after the command. macOS's ps wants `-ax`
  # here and procps rejects it, so each gets its own spelling.
  process_table() {
    if [[ "$(uname -s)" == Darwin ]]; then
      ps eww -ax -o pid=,command=
    else
      ps eww ax -o pid=,command=
    fi
  }

  # The pids tagged with a checkout, never this process or its parent. The tag
  # is assembled inside awk: macOS awk rewrites a `-v tag=<tag>` argument in
  # place to `tag <tag>`, so awk would otherwise find itself and every reap
  # would wait out stop_timeout on a process that is already gone.
  stack_pids() {
    process_table |
      awk -v checkout="$1" -v self="$$" -v parent="${PPID}" '
        BEGIN { tag = "DEV_PROFILE_DEV_STACK=" checkout }
        $1 == self || $1 == parent { next }
        { for (i = 2; i <= NF; i++) if ($i == tag) { print $1; next } }'
  }

  # SIGTERM every process tagged with a checkout, then SIGKILL what is left after
  # stop_timeout. Only tagged processes: nothing this family did not start.
  reap_stack() {
    local pids waited=0
    pids="$(stack_pids "$1")"
    [[ -n "${pids}" ]] || return 0
    # shellcheck disable=SC2086 # one pid per word
    kill -TERM ${pids} 2>/dev/null || :
    while pids="$(stack_pids "$1")"; [[ -n "${pids}" ]]; do
      if (( waited >= stop_timeout )); then
        # shellcheck disable=SC2086
        kill -KILL ${pids} 2>/dev/null || :
        break
      fi
      sleep 1
      waited=$((waited + 1))
    done
  }

  # A checkout is live while git still names its directory as a work tree root.
  live_checkout() {
    [[ "$(git -C "$1" rev-parse --show-toplevel 2>/dev/null)" == "$1" ]]
  }

  # `reap <worktree-path>`: the worktree is gone, stop what it left behind.
  # `reap`: the same for every recorded stack whose checkout is gone. Neither
  # needs a git checkout to run in, so worktrunk's post-remove hook calls it from
  # wherever it runs.
  reap() {
    local path="${1:-}" pidfile root name
    if [[ -n "${path}" ]]; then
      if live_checkout "${path}"; then
        echo "dev:reap: ${path} is a live checkout; use dev:restart to stop its stack" >&2
        return 1
      fi
      name="$(slug "$(basename "${path}")")"
      reap_stack "${name}"
      rm -f "${cache}/${name}.pid"
      return 0
    fi
    for pidfile in "${cache}"/*.pid; do
      [[ -e "${pidfile}" ]] || continue
      root="$(sed -n 4p "${pidfile}")"
      if [[ -n "${root}" ]] && ! live_checkout "${root}"; then
        name="$(basename "${pidfile}" .pid)"
        reap_stack "${name}"
        rm -f "${pidfile}"
      fi
    done
  }

  if [[ "${verb}" == reap ]]; then
    reap "${2:-}"
    exit
  fi

  root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "dev: ${PWD} is not inside a git repository" >&2
    exit 2
  }
  cd "${root}"

  # --- checkout identity

  # The checkout directory's name keys the state files, so every worktree has
  # its own pid, lock and log. The route is the repo's name for the main
  # checkout (https://<repo>.localhost) and <branch>.<repo> for a linked
  # worktree (https://feat-x.<repo>.localhost for branch feat/x).
  checkout="$(slug "$(basename "${root}")")"
  common_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
  git_dir="$(git rev-parse --path-format=absolute --git-dir)"

  # The repo's name from its common git dir: <repo>/.git and <repo>/.bare name
  # the repo by their parent, <repo>.git by itself. Any other layout (a
  # submodule's .git/modules/<name>) has no repo name to share, so it keeps its
  # checkout name.
  repo_name() {
    case "$(basename "${common_dir}")" in
      .git | .bare) slug "$(basename "$(dirname "${common_dir}")")" ;;
      *.git) slug "$(basename "${common_dir}" .git)" ;;
      *) echo "${checkout}" ;;
    esac
  }
  repo="$(repo_name)"

  # A linked worktree's subdomain: its whole branch name, slashes folded to
  # dashes (feat/x and fix/x stay apart as feat-x and fix-x). A detached HEAD has
  # no branch, so the worktree's directory name stands in. A DNS label is at most
  # 63 characters; a longer one keeps its head and gains a checksum of the whole.
  worktree_label() {
    local branch label
    branch="$(git branch --show-current)"
    if [[ -n "${branch}" ]]; then
      label="$(slug "${branch//\//-}")"
    else
      label="$(slug "${checkout#"${repo}"-}")"
    fi
    if (( ${#label} > 63 )); then
      label="${label:0:52}-$(printf '%s' "${label}" | cksum | cut -d' ' -f1)"
    fi
    echo "${label}"
  }

  # The host this checkout registers with portless. The script owns the whole
  # name because portless's own worktree prefix keeps only a branch's last path
  # segment and skips main, master and a detached HEAD.
  route_name() {
    if [[ "${git_dir}" == "${common_dir}" ]]; then
      echo "${repo}"
    else
      echo "$(worktree_label).${repo}"
    fi
  }

  # portless is run from the cache directory, outside any git repo, so it applies
  # no worktree prefix of its own to the name it is given.
  portless_here() {
    mkdir -p "${cache}"
    (cd "${cache}" && portless "$@")
  }

  # The serve command, run from the checkout: portless starts it in the cache
  # directory, so it first returns to the root.
  in_root() {
    echo "cd $(printf '%q' "${root}") && $1"
  }

  # The URL portless serves this stack on, asked of portless so it cannot drift
  # from the route it registers. Falls back to the plain name when portless
  # cannot answer, so a status line is never malformed.
  route_url() {
    local name
    name="$(recorded_route)"
    name="${name:-$(route_name)}"
    portless_here get "${name}" 2>/dev/null || echo "https://${name}.localhost"
  }

  # A recorded pid can be alive while the URL serves nothing: the proxy's 502,
  # a route aimed at a port nobody listens on, an app that exited under a parent
  # that did not. `cd` must not report that as serving. A stack younger than the
  # grace window is still booting, so it is left alone; an older one whose URL
  # answers a gateway error or nothing is not serving. Any other response is the
  # app's own, and restarting would not fix it.
  route_serves() {
    local code written grace="${DEV_PROFILE_DEV_PROBE_GRACE:-60}"
    written="$(date -r "${pidfile}" +%s 2>/dev/null)" || return 0
    (($(date +%s) - written >= grace)) || return 0
    command -v curl >/dev/null 2>&1 || return 0
    code="$(curl -sk -o /dev/null -w '%{http_code}' --max-time "${DEV_PROFILE_DEV_PROBE_TIMEOUT:-3}" "$(route_url)/" 2>/dev/null || true)"
    code="${code//[$'\r\n']/}"
    case "${code}" in
      "" | 000 | 502 | 503 | 504) return 1 ;;
      *) return 0 ;;
    esac
  }

  # The pid portless reports as serving this checkout's route, if any. `get`
  # answers the URL only, so the route table is read; a holder that predates the
  # pidfile is invisible here only when nothing holds the route at all.
  route_holder() {
    local name
    name="$(recorded_route)"
    name="${name:-$(route_name)}"
    portless_here list 2>/dev/null |
      awk -v host="https://${name}.localhost" \
        '$1 == host && match($0, /\(pid [0-9]+\)/) { print substr($0, RSTART + 5, RLENGTH - 6) }'
  }

  # One pidfile, one lockfile (and the daemon's log) per checkout, and the time
  # of the last request the relay passed to the stack.
  cache="${XDG_CACHE_HOME:-${HOME}/.cache}/dev-profile/dev"
  pidfile="${cache}/${checkout}.pid"
  lockfile="${cache}/${checkout}.lock"
  logfile="${cache}/${checkout}.log"
  touchedfile="${cache}/${checkout}.touched"

  # Operational knobs, so a test or a fixture never waits the production time.
  ready_timeout="${DEV_PROFILE_DEV_READY_TIMEOUT:-60}" # seconds to wait for the stack
  settle="${DEV_PROFILE_DEV_SETTLE:-1}"                # seconds to catch an instant exit

  # The relay between portless and the serve command, rendered beside bin/.
  self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")"
  relay="$(dirname "$(dirname "${self}")")/dev-relay.mjs"

  alive() { kill -0 "$1" 2>/dev/null; }

  # Seconds since a process started, from ps's etime ([[dd-]hh:]mm:ss), the one
  # spelling macOS and procps share.
  process_age() {
    ps -o etime= -p "$1" 2>/dev/null | awk '
      NF {
        t = $1; d = 0
        if ((i = index(t, "-")) > 0) { d = substr(t, 1, i - 1); t = substr(t, i + 1) }
        n = split(t, p, ":"); s = 0
        for (j = 1; j <= n; j++) s = s * 60 + p[j]
        print d * 86400 + s
      }'
  }

  # The recorded pid is this checkout's stack only when its process is at least
  # as old as the pidfile: the stack writes the pidfile after it starts, while a
  # reboot hands the same pid to a newer, unrelated process that kill -0 alone
  # would call running. Two seconds absorb etime's rounding.
  recorded_alive() {
    local age written
    alive "$1" || return 1
    age="$(process_age "$1")"
    written="$(date -r "${pidfile}" +%s 2>/dev/null)" || return 1
    [[ -n "${age}" ]] && (($(date +%s) - age <= written + 2))
  }

  recorded_pid() {
    [[ -s "${pidfile}" ]] || return 0
    sed -n 1p "${pidfile}"
  }

  # How to signal the recorded stack: `tether` when worktrunk owns its process
  # group, `spawn` for a plain detached process. Line 4 is the checkout's root,
  # which `reap` tests to learn that the checkout is gone.
  recorded_mode() {
    sed -n 2p "${pidfile}"
  }

  # The name the recorded stack registered with portless, so a status line asks
  # portless about the route that is serving, not one recomputed now.
  recorded_route() {
    [[ -s "${pidfile}" ]] || return 0
    sed -n 3p "${pidfile}"
  }

  # Read-only: true when this checkout's recorded stack process is alive and is
  # the process the pidfile recorded.
  running() {
    local pid
    pid="$(recorded_pid)"
    [[ -n "${pid}" ]] && recorded_alive "${pid}"
  }

  # --- the serve command

  # aube runs npm, pnpm and aube projects; yarn and bun keep their own tool
  # (mirrors the node contract adapter).
  package_manager() {
    if [[ -f bun.lock || -f bun.lockb ]]; then
      echo bun
    elif [[ -f yarn.lock ]]; then
      echo yarn
    else
      echo aube
    fi
  }

  has_dev_script() {
    [[ -f package.json ]] && jq -e '.scripts.dev // empty' package.json >/dev/null 2>&1
  }

  # Reads only, and prints the command for the child shell, which sees
  # portless's PORT and HOST. A repo declaring its own serve script wins; else
  # the markers decide. Exit 1: nothing here serves. The port is left for the
  # child shell to expand (\$PORT): portless assigns it per checkout.
  serve_command() {
    if [[ -x mise-tasks/dev-serve ]]; then
      echo 'exec ./mise-tasks/dev-serve'
      return 0
    fi
    if [[ -f composer.json && -f package.json ]]; then
      # The ordinary pair: the app on the routed port, the JS dev server on its
      # own port, which do not collide.
      echo "php artisan serve --port=\$PORT & exec $(package_manager) run dev"
      return 0
    fi
    if [[ -f composer.json ]]; then
      echo "exec php artisan serve --port=\$PORT"
      return 0
    fi
    if has_dev_script; then
      echo "exec $(package_manager) run dev -- --port \$PORT"
      return 0
    fi
    return 1
  }

  # --- the tether

  # `wt step tether -- <cmd>` runs the stack in its own process group and kills
  # the whole group when the worktree is removed, so teardown needs no
  # pre-remove hook. It needs worktrunk and a git worktree; without either the
  # family falls back to a plain detached spawn.
  tether_available() {
    command -v wt >/dev/null 2>&1 || return 1
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 1
    wt step tether --help >/dev/null 2>&1
  }

  # What the tether runs. `$$` before the exec is the tether's own child, which
  # the tether made a process-group leader, so line 1 is the whole tree's pid;
  # then portless assigns the route's port and runs the relay, which runs the
  # serve command behind it.
  tether_child="cd \"\${DEV_PROFILE_DEV_CACHE}\"; printf \"%s\n%s\n%s\n%s\n\" \"\$\$\" tether \"\${DEV_PROFILE_DEV_ROUTE}\" \"\${DEV_PROFILE_DEV_ROOT}\" >\"\${DEV_PROFILE_DEV_PIDFILE}\"; exec portless run --name \"\${DEV_PROFILE_DEV_ROUTE}\" node \"\${DEV_PROFILE_DEV_RELAY}\" sh -c \"\${DEV_PROFILE_DEV_CMD}\""

  # --- verbs

  # Read-only probe: exit 0 and one machine-readable line when serving, exit 1
  # and one line otherwise. Nothing on this path writes. A down stack is answered
  # from the pidfile alone; a serving one adds one `portless get` (about 0.4s) for
  # its URL.
  status() {
    if running; then
      echo "state=running url=$(route_url) pid=$(recorded_pid)"
      return 0
    fi
    if ! serve_command >/dev/null; then
      echo "state=unconfigured"
      return 1
    fi
    echo "state=down"
    return 1
  }

  # One clear line, machine-readable prefix first, for an on-cd hook's log.
  unconfigured() {
    echo "state=unconfigured: nothing to serve here (declare mise-tasks/dev-serve, or add composer.json or a package.json dev script)"
  }

  require_flock() {
    command -v flock >/dev/null 2>&1 && return 0
    echo "dev:start: flock is required to serialise starts (install util-linux)" >&2
    return 1
  }

  # portless trusts kill -0 too: after a reboot the route it kept for this
  # checkout names a pid another process now owns, so it refuses every new
  # registration as a conflict, and `--force` would SIGTERM that bystander. The
  # route is dropped from portless's own table, under portless's own lock
  # (mkdir routes.lock), only when its holder is the stale pid this checkout
  # recorded; a live foreign holder is still dev:restart's to stop. Written in
  # place: the proxy watches the file's inode.
  drop_stale_route() {
    local stale="$1" holder state routes host updated tries=0
    holder="$(route_holder)"
    [[ -n "${holder}" && "${holder}" == "${stale}" ]] || return 0
    state="${PORTLESS_STATE_DIR:-${HOME}/.portless}"
    routes="${state}/routes.json"
    [[ -f "${routes}" ]] || return 0
    host="$(recorded_route).localhost"
    until mkdir "${state}/routes.lock" 2>/dev/null; do
      if ((tries++ >= 50)); then
        echo "dev: portless's route lock stayed held; ${host} may still name stale pid ${stale}" >&2
        return 0
      fi
      sleep 0.1
    done
    if updated="$(jq --arg host "${host}" --argjson pid "${stale}" \
      'map(select(.hostname != $host or .pid != $pid))' "${routes}")"; then
      printf '%s\n' "${updated}" >"${routes}"
      echo "dev: dropped portless's route ${host}, held by pid ${stale}, which is no longer this stack" >&2
    fi
    rmdir "${state}/routes.lock" 2>/dev/null || :
  }

  # One spawn path for `dev:start` and `dev:restart`: under the tether when
  # worktrunk can own the process group, a plain detach otherwise. Records the
  # pid and how to signal it, and prints the pid. Either way portless runs the
  # relay, which runs the serve command and is told where to record requests
  # and how to stop the stack once it sits idle.
  spawn() {
    local cmd="$1" pid waited=0 route stale
    route="$(route_name)"
    mkdir -p "${cache}"
    stale="$(recorded_pid)"
    if [[ -n "${stale}" ]]; then
      drop_stale_route "${stale}" 2>>"${logfile}"
    fi
    rm -f "${pidfile}"
    # A dead stack can leave children behind; a second stack beside them would
    # fight them for the route and the port.
    reap_stack "${checkout}"
    export DEV_PROFILE_DEV_ROOT="${root}" DEV_PROFILE_DEV_TOUCHED="${touchedfile}" \
      DEV_PROFILE_DEV_BIN="${self}"
    if tether_available; then
      DEV_PROFILE_DEV_CMD="$(in_root "${cmd}")" DEV_PROFILE_DEV_ROUTE="${route}" \
        DEV_PROFILE_DEV_STACK="${checkout}" DEV_PROFILE_DEV_CACHE="${cache}" \
        DEV_PROFILE_DEV_PIDFILE="${pidfile}" DEV_PROFILE_DEV_RELAY="${relay}" \
        nohup wt step tether -- sh -c "${tether_child}" >>"${logfile}" 2>&1 </dev/null 9>&- &
      pid=$!
      disown
      # The tether's child records the leader pid a moment after the spawn; wait
      # for it, failing fast when the tether itself is gone.
      while [[ -z "$(recorded_pid)" ]]; do
        if ! alive "${pid}"; then
          echo "dev:start: the tether exited before it started the stack; see ${logfile}" >&2
          return 1
        fi
        if (( waited >= ready_timeout )); then
          echo "dev:start: the tether did not start the stack within ${ready_timeout}s; see ${logfile}" >&2
          return 1
        fi
        sleep 1
        waited=$((waited + 1))
      done
    else
      (cd "${cache}" && export DEV_PROFILE_DEV_STACK="${checkout}" &&
        exec nohup portless run --name "${route}" node "${relay}" sh -c "$(in_root "${cmd}")") \
        >>"${logfile}" 2>&1 </dev/null 9>&- &
      pid=$!
      disown
      printf '%s\n%s\n%s\n%s\n' "${pid}" spawn "${route}" "${root}" >"${pidfile}"
    fi
    recorded_pid
  }

  start() {
    # Idempotent and silent: an already-running stack is success, never a kill.
    if running; then
      return 0
    fi
    local cmd
    if ! cmd="$(serve_command)"; then
      unconfigured
      return 1
    fi
    require_flock || return 1
    mkdir -p "${cache}"
    exec 9>"${lockfile}"
    flock 9
    # A concurrent start may have won the lock while we waited; the stack is a
    # singleton, so the loser reports success and starts nothing.
    if running; then
      return 0
    fi
    local pid
    # spawn reports the pid it recorded, or fails when the tether never started.
    if ! pid="$(spawn "${cmd}")"; then
      return 1
    fi
    # Readiness is the fact `dev:status` reports, so the daemon and the probe
    # can never disagree. A command that cannot start exits inside the settle
    # window; the deadline stops a slow machine from waiting forever.
    sleep "${settle}"
    local waited=0
    while ! running; do
      if ! alive "${pid}"; then
        echo "dev:start: the dev stack exited before it served; see ${logfile}" >&2
        return 1
      fi
      if (( waited >= ready_timeout )); then
        echo "dev:start: the dev stack did not come up within ${ready_timeout}s; see ${logfile}" >&2
        return 1
      fi
      sleep 1
      waited=$((waited + 1))
    done
    route_url
  }

  # Send a signal to the recorded stack: the whole process group when the tether
  # owns it, else the single recorded process.
  signal_stack() {
    if [[ "$(recorded_mode)" == tether ]]; then
      kill "-$2" -- "-$1" 2>/dev/null || :
    else
      kill "-$2" "$1" 2>/dev/null || :
    fi
  }

  # SIGTERM the recorded stack, then SIGKILL after stop_timeout, then reap what
  # left its group. Never touches a process this checkout did not start: a
  # recorded pid that is no longer the stack is dropped, never signalled, and
  # so is the portless route it left behind.
  stop() {
    local pid waited=0
    pid="$(recorded_pid)"
    if [[ -z "${pid}" ]] || ! recorded_alive "${pid}"; then
      [[ -z "${pid}" ]] || drop_stale_route "${pid}"
      reap_stack "${checkout}"
      rm -f "${pidfile}"
      return 0
    fi
    signal_stack "${pid}" TERM
    while alive "${pid}"; do
      if (( waited >= stop_timeout )); then
        signal_stack "${pid}" KILL
        break
      fi
      sleep 1
      waited=$((waited + 1))
    done
    reap_stack "${checkout}"
    rm -f "${pidfile}"
  }

  # The one escape hatch for a route this checkout did not record: a stack
  # started outside the family (a manual `portless <name> ...`) holds the route
  # the next start cannot register. restart alone kills it, and only the pid
  # portless reports for this checkout's own route, never a foreign name.
  stop_route_holder() {
    local holder
    holder="$(route_holder)"
    if [[ -z "${holder}" ]]; then
      return 0
    fi
    echo "dev:restart: stopping the route holder portless reports (pid ${holder}), not recorded by this checkout" >&2
    kill -TERM "${holder}" 2>/dev/null || :
    local waited=0
    while alive "${holder}"; do
      if (( waited >= stop_timeout )); then
        kill -KILL "${holder}" 2>/dev/null || :
        break
      fi
      sleep 1
      waited=$((waited + 1))
    done
    if alive "${holder}"; then
      echo "dev:restart: the route holder (pid ${holder}) survived SIGKILL; see ${logfile}" >&2
      return 1
    fi
  }

  restart() {
    stop
    stop_route_holder || return 1
    start
  }

  # Foreground, for a human who wants the logs: no pidfile, no lock.
  attach() {
    local cmd
    if ! cmd="$(serve_command)"; then
      unconfigured
      return 1
    fi
    local route
    route="$(route_name)"
    echo "dev:attach: $(portless_here get "${route}" 2>/dev/null || echo "https://${route}.localhost") in the foreground; Ctrl-C stops it" >&2
    mkdir -p "${cache}"
    cd "${cache}"
    exec portless run --name "${route}" sh -c "$(in_root "${cmd}")"
  }

  case "${verb}" in
    "" | dev)
      # Safe on every `cd`: a cheap no-op with one clear line when nothing is
      # configured, an immediate status line when the stack already serves, a
      # restart when it is recorded running but its URL does not answer, never
      # a second stack when two shells enter at once, and always a final status
      # line so an on-cd hook's log carries the checkout's URL.
      if ! serve_command >/dev/null; then
        unconfigured
        exit 1
      fi
      if status; then
        if route_serves; then
          exit 0
        fi
        echo "dev: stack is recorded running but $(route_url) does not answer; restarting" >&2
        restart || exit $?
        status
        exit $?
      fi
      start || exit $?
      status
      ;;
    status) status ;;
    start) start ;;
    stop) stop ;;
    restart) restart ;;
    attach) attach ;;
    *)
      echo "dev: unknown verb '${verb}'; expected dev, dev:status, dev:start, dev:stop, dev:restart, dev:attach or reap" >&2
      exit 2
      ;;
  esac
  """#

/// The relay portless runs in front of every stack's serve command. portless
/// keeps no record of requests, so this is where "last used" comes from.
local relay =
  #"""
  // Code generated by `mise run generate`. DO NOT EDIT.
  // Source of truth: profile.pkl
  //
  // The dev stack's relay. portless routes https://<name>.localhost to PORT; the
  // relay listens there, runs the serve command on a port of its own, and passes
  // every connection through, so it knows three things portless does not:
  //   - when the stack last received a request: DEV_PROFILE_DEV_TOUCHED holds
  //     its epoch seconds, written at most once per check;
  //   - that the app is still booting: a connection that arrives before the app
  //     listens waits up to DEV_PROFILE_DEV_BOOT_SECONDS for it, not a 502;
  //   - that nobody uses the stack: after DEV_PROFILE_DEV_IDLE_SECONDS (a day)
  //     without a request it runs `dev-profile-dev stop` for the checkout, and
  //     the next `cd` starts the stack again. An open connection that sends
  //     nothing (a forgotten tab's event stream) is not use.
  // Usage: node dev-relay.mjs <command> [args...]
  import { spawn } from "node:child_process";
  import { writeFileSync } from "node:fs";
  import net from "node:net";
  import { constants } from "node:os";
  import { Transform } from "node:stream";

  const env = process.env;
  const host = env.HOST || "127.0.0.1";
  const port = Number(env.PORT);
  const idleMs = Number(env.DEV_PROFILE_DEV_IDLE_SECONDS || 86400) * 1000;
  const bootMs = Number(env.DEV_PROFILE_DEV_BOOT_SECONDS || 60) * 1000;
  const [command, ...args] = process.argv.slice(2);
  if (!Number.isInteger(port) || port <= 0 || !command || !env.DEV_PROFILE_DEV_TOUCHED) {
    console.error("dev-relay: needs PORT, DEV_PROFILE_DEV_TOUCHED and a command to run");
    process.exit(64);
  }

  // The stack's start is its first use, so a fresh stack gets a full day.
  let lastUse = Date.now();
  let written = 0;
  const record = () => {
    if (written === lastUse) return;
    try {
      writeFileSync(env.DEV_PROFILE_DEV_TOUCHED, `${Math.floor(lastUse / 1000)}\n`);
      written = lastUse;
    } catch (err) {
      console.error(`dev-relay: cannot record the last request: ${err.message}`);
    }
  };
  record();

  // A request is any byte a client sends; the connection itself counts too.
  const used = () => new Transform({
    transform(chunk, _encoding, done) {
      lastUse = Date.now();
      done(null, chunk);
    },
  });

  const freePort = () =>
    new Promise((resolve, reject) => {
      const probe = net.createServer();
      probe.once("error", reject);
      probe.listen(0, host, () => {
        const { port: free } = probe.address();
        probe.close(() => resolve(free));
      });
    });
  const appPort = await freePort();

  const server = net.createServer({ allowHalfOpen: true }, (client) => {
    lastUse = Date.now();
    const deadline = lastUse + bootMs;
    let app;
    client.on("error", () => client.destroy());
    client.on("close", () => app?.destroy());
    const connect = () => {
      app = net.connect({ port: appPort, host, allowHalfOpen: true });
      app.once("connect", () => {
        client.pipe(used()).pipe(app);
        app.pipe(client);
      });
      app.on("error", (err) => {
        if (err.code === "ECONNREFUSED" && !client.destroyed && Date.now() < deadline) {
          setTimeout(connect, 200);
          return;
        }
        client.destroy();
      });
    };
    connect();
  });
  await new Promise((resolve, reject) => {
    server.once("error", reject);
    server.listen(port, host, resolve);
  });

  const child = spawn(command, args, { stdio: "inherit", env: { ...env, PORT: String(appPort) } });
  for (const signal of ["SIGTERM", "SIGINT", "SIGHUP"]) {
    process.on(signal, () => child.kill(signal));
  }
  child.on("exit", (code, signal) => {
    record();
    process.exit(code ?? 128 + (constants.signals[signal] ?? 0));
  });

  const check = setInterval(() => {
    record();
    if (Date.now() - lastUse < idleMs) return;
    clearInterval(check);
    console.log(`dev-relay: no request since ${new Date(lastUse).toISOString()}; stopping the stack`);
    // Outside the stack's process group and without its tag, so the stop
    // outlives the stack it ends.
    const { DEV_PROFILE_DEV_STACK: _tag, ...untagged } = env;
    spawn(env.DEV_PROFILE_DEV_BIN, ["stop"], {
      cwd: env.DEV_PROFILE_DEV_ROOT,
      detached: true,
      stdio: "ignore",
      env: untagged,
    }).unref();
  }, Math.min(60_000, Math.max(250, idleMs / 4)));
  """#

files {
  ["dev-relay.mjs"] = relay
}

scripts {
  ["dev-profile-dev"] = dev
  ["dev-profile-enter"] = read("enter.sh").text
}
