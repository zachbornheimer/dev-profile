amends "../../lib/Tool.pkl"

doc =
  "Git itself: the global gates are config-based hooks (`hook.<name>.event`), which 2.54 added; under an older git every one of them is skipped and nothing says so."
// mise's registry has no `git`; conda-forge ships the prebuilt 2.54+ binary for macOS and Linux.
pin { id = "conda:git"; version = "2.56.0" }

scripts {
  ["dev-profile-git-config-hooks"] = module.fileText(read?("git-config-hooks.sh"))
}
