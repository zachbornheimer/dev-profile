amends "../../lib/Tool.pkl"

doc =
  "A push never stops for a problem a tool can fix. dev-profile-push fixes the pushed commits and pushes in one command; dev-profile-pre-push is the git hook that does the same for a raw `git push`, which git cannot extend mid-push: it commits the fixes and asks for the same push again."

// A first push has no <remote>/HEAD. Setting it locally needs a remote that has a default branch.
local remoteHead =
  #"""
  # Point <remote>/HEAD at the remote's default branch, quietly: hk and the push judges
  # diff from it, and git prints "fatal: ref ... is not a symbolic ref" while it is missing.
  # An empty remote has no default branch yet; the call fails and the caller copes.
  set_remote_head() { # <remote>
    git config --get "remote.$1.url" >/dev/null || return 0
    git symbolic-ref -q "refs/remotes/$1/HEAD" >/dev/null && return 0
    git remote set-head "$1" -a >/dev/null 2>&1 || true
  }
  """#

local push =
  #"""
  \#(bash)
  # git push, after the profile's fixers have run on what it uploads:
  #   dev-profile-push [git push args...]
  # Fixes land as one `style: apply profile fixes` commit on the checked-out branch, then the real
  # push runs and its exit code is yours. HK=0 pushes as plain git does. Nothing is printed when
  # there is nothing to fix.
  \#(remoteHead)
  here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

  if [[ "${HK:-1}" == 0 ]]; then exec git push "$@"; fi

  # The remote the push targets: the first non-flag argument when it names a remote, else the
  # branch's own push remote.
  push_remote_of() {
    local arg skip=false
    for arg in "$@"; do
      if [[ "${skip}" == true ]]; then skip=false; continue; fi
      case "${arg}" in
      -o | --push-option | --receive-pack | --exec | --repo) skip=true ;;
      -*) ;;
      *)
        if git config --get "remote.${arg}.url" >/dev/null; then echo "${arg}"; return; fi
        break
        ;;
      esac
    done
    local branch key value
    branch="$(git symbolic-ref -q --short HEAD || true)"
    for key in "branch.${branch}.pushRemote" remote.pushDefault "branch.${branch}.remote"; do
      value="$(git config --get "${key}" || true)"
      if [[ -n "${value}" && "${value}" != . ]]; then echo "${value}"; return; fi
    done
    echo origin
  }

  # What the push would upload, in pre-push's stdin format ("<local ref> <local sha> <remote ref>
  # <remote sha>"), read off a dry run: the same refs git itself resolves from the arguments.
  pushed_refs() {
    local args=() arg flag spec summary from lsha rsha old zeros=0000000000000000000000000000000000000000
    for arg in "$@"; do
      case "${arg}" in -q | --quiet) ;; *) args+=("${arg}") ;; esac
    done
    git push --porcelain --dry-run --no-verify ${args[@]+"${args[@]}"} 2>/dev/null | while IFS=$'\t' read -r flag spec summary; do
      case "${flag}" in " " | "+" | "*") ;; *) continue ;; esac
      from="${spec%%:*}"
      [[ "${from}" == refs/heads/* ]] || continue
      lsha="$(git rev-parse -q --verify "${from}^{commit}")" || continue
      rsha="${zeros}"
      if [[ "${flag}" != "*" ]]; then
        old="${summary%%.*}"
        rsha="$(git rev-parse -q --verify "${old}^{commit}" 2>/dev/null)" || rsha="${zeros}"
      fi
      printf '%s %s %s %s\n' "${from}" "${lsha}" "${spec#*:}" "${rsha}"
    done || true
  }

  remote="$(push_remote_of "$@")"
  refs="$(mktemp)"
  trap 'rm -f "${refs}"' EXIT
  pushed_refs "$@" >"${refs}"

  if [[ -s "${refs}" ]]; then
    # A failed fixer pass must not stop the push; the pre-push checks still judge it.
    SAH_PUSH_REFS="${refs}" DEV_PROFILE_PUSH_REMOTE="${remote}" "${here}/dev-profile-autofix" || true
  fi

  code=0
  DEV_PROFILE_AUTOFIXED=1 git push "$@" || code=$?
  if ((code == 0)); then set_remote_head "${remote}"; fi
  exit "${code}"
  """#

local prePush =
  #"""
  \#(bash)
  # Git's pre-push hook command: hk's push checks, then, when they fail, the fixers.
  #   dev-profile-pre-push <remote> <url>   (pushed refs on stdin)
  # A hook cannot add commits to the push in progress. When the checks fail and the fixers change
  # something, the fixes are committed and the push stops with one line: run the same push again.
  \#(remoteHead)
  here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

  remote="${1:-origin}"
  refs="$(mktemp)"
  cat >"${refs}"
  export SAH_PUSH_REFS="${refs}" DEV_PROFILE_PUSH_REMOTE="${remote}"

  # hk diffs from <remote>/HEAD. A first push to an empty remote has none to set, so give hk a
  # stand-in at the pushed branch for this run only: its absence makes hk print a git fatal.
  head_ref="refs/remotes/${remote}/HEAD"
  stand_in=false
  cleanup() {
    rm -f "${refs}"
    if [[ "${stand_in}" == true ]]; then git symbolic-ref --delete "${head_ref}" >/dev/null 2>&1 || true; fi
  }
  trap cleanup EXIT
  set_remote_head "${remote}"
  if git config --get "remote.${remote}.url" >/dev/null && ! git symbolic-ref -q "${head_ref}" >/dev/null; then
    read -r _lref _lsha remote_ref _rsha <"${refs}" || true
    if [[ "${remote_ref:-}" == refs/heads/* ]]; then
      git symbolic-ref "${head_ref}" "refs/remotes/${remote}/${remote_ref#refs/heads/}" && stand_in=true
    fi
  fi

  code=0
  hk run pre-push "$@" <"${refs}" || code=$?
  if ((code == 0)) || [[ -n "${DEV_PROFILE_AUTOFIXED:-}" ]]; then exit "${code}"; fi

  before="$(git rev-parse HEAD)"
  "${here}/dev-profile-autofix" >/dev/null || true
  after="$(git rev-parse HEAD)"
  if [[ "${before}" == "${after}" ]]; then exit "${code}"; fi
  count="$(git diff --name-only "${before}" "${after}" | wc -l | tr -d ' ')"
  noun="files"
  if ((count == 1)); then noun="file"; fi
  echo "fixed ${count} ${noun} → $(git rev-parse --short HEAD); run the same push again" >&2
  exit 1
  """#

scripts {
  ["dev-profile-push"] = push
  ["dev-profile-pre-push"] = prePush
}
