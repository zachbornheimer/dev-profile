amends "../../lib/Tool.pkl"

doc = "clang-tidy modernize-* fixes at commit. Needs compile_commands.json; silent otherwise."
on {
  ["pre-push"] {
    glob = List("**/*.c", "**/*.cc", "**/*.cpp", "**/*.cxx", "**/*.h", "**/*.hpp")
    check = "dev-profile-clang-tidy {{files}}"
  }
}

scripts {
  ["dev-profile-clang-tidy"] =
    let (r = read?("clang-tidy.sh")) if (r is String) r else if (r == null) "" else r.text
}
