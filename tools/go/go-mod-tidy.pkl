amends "../../lib/Tool.pkl"

doc =
  "Keep go.mod and go.sum in step with the imports: tidy at commit, last of the Go fixers, and refuse a push whose modules are untidy."
glob = List("**/*.go", "**/go.mod", "**/go.sum")
on {
  // After every fixer that can add or drop an import: goimports resolves new
  // ones, go fix and golangci can replace a third-party package with stdlib.
  ["pre-commit"] {
    depends = List("go-imports", "go-fix", "go-modernize", "golangci-lint-fix")
    stage = List("**/go.mod", "**/go.sum")
    fix = "dev-profile-go-mod-tidy {{files}}"
  }
  ["pre-push"] { check = "dev-profile-go-mod-tidy --diff {{files}}" }
}

scripts {
  ["dev-profile-go-mod-tidy"] =
    let (r = read?("go-mod-tidy.sh")) if (r is String) r else if (r == null) "" else r.text
}
