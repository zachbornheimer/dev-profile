amends "../../lib/Tool.pkl"

doc =
  "go fix on the staged packages, then prove they still vet; a rewrite that breaks vet is reverted and blocks the commit. Needs compiling code, so goimports runs first."
on {
  ["pre-commit"] {
    glob = List("**/*.go")
    depends = List("go-imports")
    fix = "dev-profile-go-fix {{files}}"
  }
}

scripts {
  ["dev-profile-go-fix"] =
    let (r = read?("go-fix.sh")) if (r is String) r else if (r == null) "" else r.text
}
