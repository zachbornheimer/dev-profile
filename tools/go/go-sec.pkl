amends "../../lib/Tool.pkl"

doc = "Go security scanner at push; skips silently when gosec is not installed."
pin { id = "aqua:securego/gosec"; version = "2.29.0" }
on {
  ["pre-push"] = (module.builtins.go_sec) {
    check = "dev-profile-gosec-packages {{files}}"
  }
}

scripts {
  ["dev-profile-gosec-packages"] =
    let (r = read?("gosec-packages.sh")) if (r is String) r else if (r == null) "" else r.text
}
