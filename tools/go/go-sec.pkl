amends "../../lib/Tool.pkl"

doc = "Go security scanner at push; skips silently when gosec is not installed."
pin { id = "aqua:securego/gosec"; version = "2.29.0" }
on {
  ["pre-push"] = (module.builtins.go_sec) {
    check = "dev-profile-gosec-packages {{files}}"
  }
}

local gosecPackages =
  #"""
  \#(bash)
  # dev-profile-gosec-packages <files…>: gosec the Go packages that contain the
  # given files, but fail only on findings located in those files, so findings
  # already sitting in untouched files never block a push.
  # A file named facade.go or facades.go is a system boundary whose job is to
  # run a caller-given command, so the subprocess rules (G204 variable argv,
  # G702 syscall exec) do not apply there; every other rule still does.
  # Skips when gosec is not installed or no Go file is given.
  command -v gosec >/dev/null 2>&1 || exit 0
  root="$(pwd -P)"
  packages=()
  changed=()
  for file in "$@"; do
    [[ "${file}" == *.go ]] || continue
    packages+=("./$(dirname "${file}")")
    changed+=("${root}/${file#./}")
  done
  ((${#packages[@]})) || exit 0
  # gosec exits 1 on any finding; the verdict comes from the report below.
  report="$(printf '%s\n' "${packages[@]}" | sort -u | xargs gosec -fmt json 2>/dev/null || true)"
  if ! jq -e .Issues >/dev/null 2>&1 <<<"${report}"; then
    echo "gosec produced no readable report:" >&2
    echo "${report}" >&2
    exit 1
  fi
  findings="$(jq -r --arg root "${root}/" '
    .Issues[]
    | select(.file as $path | $ARGS.positional | index($path))
    | select(((.file | test("/facades?\\.go$")) and (.rule_id | IN("G204", "G702"))) | not)
    | "\(.file | ltrimstr($root)):\(.line) \(.rule_id) \(.details)"
  ' --args "${changed[@]}" <<<"${report}")"
  [[ -z "${findings}" ]] || { echo "${findings}" >&2; exit 1; }
  """#

scripts { ["dev-profile-gosec-packages"] = gosecPackages }
