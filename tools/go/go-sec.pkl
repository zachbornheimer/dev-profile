amends "../../lib/Tool.pkl"

doc =
  "Go security scanner at push; gosec has no new-issues mode, so only findings in pushed files fail. Skips silently when gosec is not installed."
pin { id = "aqua:securego/gosec"; version = "2.29.0" }
on {
  ["pre-push"] = (module.builtins.go_sec) {
    check =
      "dev-profile-if-installed gosec dev-profile-pushed-diagnostics gosec -fmt=golint ./... :: {{files}}"
  }
}
