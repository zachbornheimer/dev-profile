amends "../../lib/Tool.pkl"

doc =
  "Shell static analysis: at commit, applies only the fixes shellcheck is sure of (quoting a lone variable); at push, blocks on warnings and errors (info and style tips, such as SC2016 on an intentional single-quoted script, do not block)."
pin { id = "shellcheck"; version = "0.11.0" }
on {
  ["pre-commit"] {
    types = List("bash", "sh")
    fix = "dev-profile-shellcheck-fix {{files}}"
  }
  ["pre-push"] = (module.builtins.shellcheck) { check = "shellcheck --severity=warning {{files}}" }
}

scripts {
  ["dev-profile-shellcheck-fix"] =
    let (r = read?("shellcheck-fix.sh")) if (r is String) r else if (r == null) "" else r.text
}
