amends "../../lib/Tool.pkl"

doc = "rustfmt after clippy's fixes. Also the dprint exec command for Rust."
on {
  ["pre-commit"] {
    glob = List("**/*.rs")
    depends = List("clippy-fix")
    fix = "dev-profile-rustfmt {{files}}"
  }
}

scripts {
  ["dev-profile-rustfmt"] =
    let (r = read?("rustfmt.sh")) if (r is String) r else if (r == null) "" else r.text
}
