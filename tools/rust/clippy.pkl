amends "../../lib/Tool.pkl"

doc =
  "Rust lint. Commit applies cargo clippy --fix per crate, each fix verified to build; clippy has no new-issues mode, so at push only diagnostics in pushed files fail."
on {
  ["pre-commit"] { glob = List("**/*.rs"); fix = "dev-profile-clippy-fix {{files}}" }
  ["pre-push"] = (module.builtins.cargo_clippy) {
    check =
      "dev-profile-pushed-diagnostics cargo clippy --quiet --message-format=short :: {{files}}"
  }
}

scripts {
  ["dev-profile-clippy-fix"] =
    let (r = read?("clippy-fix.sh")) if (r is String) r else if (r == null) "" else r.text
}
