amends "../../lib/Tool.pkl"

doc =
  "PHP formatting by repo context: WordPress gets PHPCBF only, never mago or php-cs-fixer after it. Also the dprint exec command for PHP."
on {
  ["pre-commit"] {
    glob = List("**/*.php")
    depends = List("rector")
    fix = "dev-profile-php-fmt {{files}}"
  }
}

scripts {
  ["dev-profile-php-fmt"] =
    let (r = read?("php-fmt.sh")) if (r is String) r else if (r == null) "" else r.text
}
