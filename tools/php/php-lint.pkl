amends "../../lib/Tool.pkl"

doc = "Full PHP lint at push: PHPCS with WPCS on WordPress, the repo standard elsewhere."
on {
  ["pre-push"] { glob = List("**/*.php"); check = "dev-profile-php-lint {{files}}" }
}

scripts {
  ["dev-profile-php-lint"] =
    let (r = read?("php-lint.sh")) if (r is String) r else if (r == null) "" else r.text
}
