amends "../../lib/Tool.pkl"

doc = "Rector applies the repo rector.php PHP-version set first; php-fmt formats after."
on {
  ["pre-commit"] { glob = List("**/*.php"); fix = "dev-profile-rector-fix {{files}}" }
}

scripts {
  ["dev-profile-rector-fix"] =
    let (r = read?("rector-fix.sh")) if (r is String) r else if (r == null) "" else r.text
}
