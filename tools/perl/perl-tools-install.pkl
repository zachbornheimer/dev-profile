amends "../../lib/Tool.pkl"

doc =
  "Doctor and bootstrap step, no hook: installs Perl::Tidy and Perl::Critic from CPAN into ~/perl5 under a mise Perl when either command is missing. Run by the bootstrap post-tools hook (profile.bootstrapHooks); safe to repeat."

/// The mise Perl that builds the CPAN tools.
local perlVersion = "5.42.0.0"

facts { ["PROFILE_PERL_VERSION"] = perlVersion }

scripts {
  ["dev-profile-perl-tools-install"] =
    let (r = read?("perl-tools-install.sh")) if (r is String) r else if (r == null) "" else r.text
}
