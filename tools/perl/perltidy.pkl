amends "../../lib/Tool.pkl"

doc =
  "perltidy in place at commit, and the dprint exec command for Perl. Applies the profile's perltidyrc unless the repo root has its own .perltidyrc (perltidy never looks above the current directory). Installed by dev-profile-perl-tools-install."
on {
  ["pre-commit"] {
    glob = List("**/*.pl", "**/*.pm", "**/*.t")
    fix = "dev-profile-perltidy-fix {{files}}"
  }
}

local perltidyFix =
  #"""
  \#(bash)
  \#(perlTools)
  # perltidy in place with the profile's (or the repo's own) style.
  (($#)) || exit 0
  require_perl_tool perltidy
  exec perltidy --profile="$(perl_config perltidy .)" -b -bext='/' -q "$@"
  """#

local perltidyFormat =
  #"""
  \#(bash)
  \#(perlTools)
  # The dprint exec command: perltidy on stdin, in the style of the repo holding the file at $1.
  require_perl_tool perltidy
  exec perltidy --profile="$(perl_config perltidy "$(dirname "${1:-.}")")" -q
  """#

files {
  ["perltidyrc"] = read?("perltidyrc")?.text ?? ""
}

scripts {
  ["dev-profile-perltidy-fix"] = perltidyFix
  ["dev-profile-perltidy-format"] = perltidyFormat
}
