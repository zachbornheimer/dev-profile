amends "../../lib/Tool.pkl"

doc =
  "perltidy in place at commit, and the dprint exec command for Perl. Applies the profile's perltidyrc unless the repo root has its own .perltidyrc (perltidy never looks above the current directory). Installed by dev-profile-perl-tools-install."
on {
  ["pre-commit"] {
    glob = List("**/*.pl", "**/*.pm", "**/*.t")
    fix = "dev-profile-perltidy-fix {{files}}"
  }
}

files {
  ["perltidyrc"] =
    let (r = read?("perltidyrc")) if (r is String) r else if (r == null) "" else r.text
}

scripts {
  ["dev-profile-perltidy-fix"] =
    let (r = read?("perltidy-fix.sh")) if (r is String) r else if (r == null) "" else r.text
  ["dev-profile-perltidy-format"] =
    let (r = read?("perltidy-format.sh")) if (r is String) r else if (r == null) "" else r.text
}
