# 50-enter-converge.defer.zsh — on cd, hand the directory to a background worker.
#
# The interactive path does exactly one thing: fork `dev-profile-enter` and
# return. Everything slow or surprising — mise install, mise deps, node_modules,
# the portless proxy, `mise run dev` under worktrunk's tether — happens in that
# worker, which serialises one run per checkout and never prompts. `cd` costs a
# file test plus a fork.
#
# The worker is generated by the dev profile (tools/repo/dev.pkl), so the
# behaviour is the profile's, not this file's: it answers `state=unconfigured`
# in a checkout that serves nothing, starts nothing when a stack already runs,
# and its stack dies with the worktree that owns it.
#
# Disable: DEV_PROFILE_ENTER_DISABLE=1 (the old MISE_ENTER_CONVERGE=0 too).

autoload -Uz add-zsh-hook

_enter_converge_enabled() {
	emulate -L zsh
	[[ ${DEV_PROFILE_ENTER_DISABLE:-0} == 1 ]] && return 1
	[[ ${MISE_ENTER_CONVERGE-} == 0 ]] && return 1
	(($+commands[dev-profile-enter]))
}

# Cheap gate: one fork per cd is fine; a fork in every random directory is not.
# The worker proves the rest (git root, serve command) for itself.
_enter_converge_is_project() {
	emulate -L zsh
	local d="${1:-.}"
	[[ -f $d/mise.toml || -f $d/.mise.toml || -f $d/package.json ||
		-f $d/pyproject.toml || -f $d/go.mod || -f $d/composer.json ||
		-f $d/Gemfile || -f $d/aube-lock.yaml || -f $d/uv.lock ]] && return 0
	[[ -f $d/.gitmodules ]] || return 1
	git -C "$d" rev-parse --is-inside-work-tree >/dev/null 2>&1
}

_enter_converge_chpwd() {
	_enter_converge_enabled || return 0
	_enter_converge_is_project "$PWD" || return 0
	dev-profile-enter "$PWD" &!
}

add-zsh-hook -D chpwd _enter_converge_chpwd 2>/dev/null
add-zsh-hook chpwd _enter_converge_chpwd
