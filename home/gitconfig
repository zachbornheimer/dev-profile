[worktree]
	guessRemote = true
[difftool "difftastic"]
	cmd = difft "$LOCAL" "$REMOTE"
[difftool]
	prompt = false
[alias]
	dft = difftool -t difftastic
	lg = log --oneline --graph --decorate --all
[branch]
	sort = -committerdate
[diff]
	algorithm = histogram
[help]
	autocorrect = 20
[url "https://github.com/"]
	insteadOf = git@github.com:
[commit]
	gpgsign = true
[beads]
	role = maintainer
# Git runs these from any process (agents, launchd, cron), so the PATH a login shell
# builds is not guaranteed. hk steps call the dev-profile-* helpers by bare name; the
# hook puts their directory on PATH itself, after the caller's dirs so nothing is shadowed.
[hook "hk-commit-msg"]
	command = test \"${HK:-1}\" = \"0\" || PATH=\"${PATH}:/opt/homebrew/bin:${HOME}/.local/bin:${HOME}/.local/share/dev-profile/bin\" mise x hk -- hk run commit-msg
	event = commit-msg
[hook "hk-pre-commit"]
	command = test \"${HK:-1}\" = \"0\" || PATH=\"${PATH}:/opt/homebrew/bin:${HOME}/.local/bin:${HOME}/.local/share/dev-profile/bin\" mise x hk -- dev-profile-restore-tree-on-failure hk run pre-commit --staged
	event = pre-commit
[hook "hk-pre-push"]
	command = test \"${HK:-1}\" = \"0\" || DEV_PROFILE_HOOK_GIT_DIR=\"${GIT_DIR:-}\" PATH=\"${PATH}:/opt/homebrew/bin:${HOME}/.local/bin:${HOME}/.local/share/dev-profile/bin:${HOME}/.local/share/mise/shims\" mise x hk -- dev-profile-pre-push
	event = pre-push
[hook "hk-prepare-commit-msg"]
	command = test \"${HK:-1}\" = \"0\" || PATH=\"${PATH}:/opt/homebrew/bin:${HOME}/.local/bin:${HOME}/.local/share/dev-profile/bin\" mise x hk -- hk run prepare-commit-msg --from-hook
	event = prepare-commit-msg
[rebase]
	autoStash = true
[includeIf "worktree:/Users/zbornheimer/Developer/Software-Automation-Holdings/"]
	path = /Users/zbornheimer/Developer/Software-Automation-Holdings/.sah/git-hooks
[hook "wt-worktree-bootstrap"]
	command = ~/.agents/hooks/wt-post-checkout
	event = post-checkout
# Upstream agent skills are installed from agents/available-skills/.skill-lock.json, not
# committed. After a pull (merge or rebase) or checkout in the dev-profile checkout, install
# any the record names that are missing; every other repo returns at once.
[hook "agents-skills-sync"]
	command = \"$HOME/.agents/hooks/skills-sync-on-pull\"
	event = post-merge
	event = post-rewrite
	event = post-checkout
