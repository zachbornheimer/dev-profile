[merge]
	conflictstyle = zdiff3
[pager]
	diff = delta
	log = delta
	show = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	light = false
	line-numbers = true
[init]
