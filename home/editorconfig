# Cross-editor defaults — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Languages whose tooling expects tabs
[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_style = tab

[*.py]
indent_size = 4

# Don't strip trailing whitespace in Markdown (two spaces = hard line break)
[*.{md,markdown}]
trim_trailing_whitespace = false
