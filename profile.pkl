  new { id = "hk"; version = "2.5.0" }
  new { id = "dprint"; version = "0.59.0" }
  new { id = "worktrunk"; version = "0.80.0" }
  new { id = "go"; version = "1.27" }
  new { id = "node"; version = "24" }
  new { id = "ruff"; version = "0.16.9" }
  new { id = "oxlint"; version = "1.84.0" }
  new { id = "golangci-lint"; version = "2.13.2" }
  new { id = "stylua"; version = "2.5.2" }
  new { id = "shellcheck"; version = "0.11.0" }
  new { id = "shellharden"; version = "4.3.2" }
  new { id = "aube"; version = "latest" }
  new { id = "uv"; version = "latest" }
  new { id = "hadolint"; version = "latest" }
  // Worktree env isolation (deps symlinks, ports, DB names); run by the wt pre-start hook.
  new { id = "github:rohansx/workz"; version = "0.11.0" }
  new { id = "go:golang.org/x/tools/cmd/goimports"; version = "latest" }
  new { id = "go:golang.org/x/vuln/cmd/govulncheck"; version = "1.8.0" }
  new { id = "npm:@agentclientprotocol/codex-acp"; version = "latest" }
  new { id = "npm:@agentclientprotocol/claude-agent-acp"; version = "latest" }
}

brewPackages: Mapping<String, String> = new {
  ["brew:git"] = "latest"
}

/// The only absolute path allowed in generated files.
llmCommand: String = "/Users/zbornheimer/.local/bin/_llm"

worktreePath: String = "{{ repo_path }}/../.worktrees/{{ repo }}-{{ branch | sanitize }}"

