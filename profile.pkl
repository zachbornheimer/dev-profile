/// Single source of truth for the developer profile.
/// Consumers (hk, dprint, mise, worktrunk, Conform) are generated from this file.
module profile

import "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl" as hk

import "lib/contract.pkl"
import "lib/render.pkl"
import "lib/shared.pkl"
import "lib/Tool.pkl"
import "lib/types.pkl"

/// Formatters and linters touch source only. Golden, fixture and generated
/// files are compared or consumed verbatim, so `testdata/` and `fixtures/`
/// at any depth (and `generated/`) are skipped by hk and dprint alike.
exclude: Listing<String> = new {
  "**/testdata"
  "**/fixtures"
  "node_modules"
  ".venv"
  "vendor"
  "dist"
  "build"
  "coverage"
  ".next"
  ".turbo"
  ".cache"
  ".beads"
}

/// Package-manager lockfiles are machine-written, so formatters and content
/// linters (dprint, yamllint) and the large-file guard skip them. Secret
/// scanners still read them. `*.lock` covers yarn, composer, Cargo, uv, poetry,
/// Gemfile and mise.
lockfiles: Listing<String> = new {
  "**/pnpm-lock.yaml"
  "**/package-lock.json"
  "**/go.sum"
  "**/bun.lock*"
  "**/*.lock"
}

dprintExcludes: Listing<String> = new {
  ...lockfiles
  "**/node_modules"
  "**/.venv"
  "**/vendor"
  "**/target"
  "**/.git"
  "**/dist"
  "**/.runners"
  "**/testdata"
  "**/fixtures"
  "**/generated"
  "generated"
  "mise/conf.d/**"
  "dprint.jsonc"
  "**/.beads/**"
}

/// Wasm plugins. PHP is never mago — WordPress PHPCBF/WPCS owns PHP formatting.
dprintPlugins: Listing<String> = new {
  "npm:@dprint/typescript@0.96.1"
  "npm:@dprint/json@0.25.2"
  "npm:@dprint/markdown@0.26.0"
  "npm:@dprint/toml@0.9.0"
  "npm:@dprint/dockerfile@0.7.0"
  "npm:dprint-plugin-yaml@0.6.0"
  "npm:@dprint/ruff@0.9.1"
  "npm:@jakebailey/dprint-plugin-gofumpt@0.0.19"
  "npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67"
  "npm:@kachick/dprint-plugin-sh@0.1.2"
  // HTML/Vue/Svelte/Astro templates (markup_fmt) and CSS/SCSS/Less (malva).
  "https://plugins.dprint.dev/g-plane/markup_fmt-v0.27.5.wasm"
  "https://plugins.dprint.dev/g-plane/malva-v0.16.0.wasm"
}

/// Where `mise run generate` writes outputs. Set once in mise.toml [env].
installPath: String =
  read?("env:DEV_PROFILE_OUT") ?? throw("DEV_PROFILE_OUT is unset; run `mise run generate`")

/// installPath with ~ for consumers that expand it (mise, dotfiles, Neovim).
installDir: String = installPath.replaceFirst(read("env:HOME"), "~")

/// The code root this profile renders: the overlay and shared tool configs live here.
codeRoot: String = "~/Developer/Personal"

/// Live config path → generated file. Linked only by `mise run install-live`.
liveTargets: Mapping<String, String> = new {
  ["~/.config/hk/config.pkl"] = "hk-config.pkl"
  ["~/.config/dprint/dprint.jsonc"] = "dprint.jsonc"
  ["~/.config/worktrunk/config.toml"] = "worktrunk.toml"
  ["~/.config/mise/conf.d/dev-profile.toml"] = "mise-profile.toml"
  ["~/.config/nvim/lua/zach/plugins/conform.lua"] = "conform.lua"
  ["\(codeRoot)/dprint.jsonc"] = "dprint.jsonc"
  ["\(codeRoot)/mise.toml"] = "personal-overlay.toml"
  // Shared tool configs, found by parent-directory lookup from every repo.
  ["\(codeRoot)/.golangci.yml"] = "golangci.yml"
  ["\(codeRoot)/.editorconfig"] = "editorconfig"
  ["\(codeRoot)/deny.toml"] = "deny.toml"
  // User-level defaults; a repo's own .markdownlint* / .yamllint still wins.
  ["~/.markdownlintrc"] = "markdownlintrc.json"
  ["~/.config/yamllint/config"] = "yamllint.yaml"
}

phase: types.Policy = new {}

/// Shell init, in order: tool → command whose output is eval'd. Rendered to
/// shell.zsh; ~/.zshrc only needs `source ~/.local/share/dev-profile/shell.zsh`.
shellInit: Mapping<String, String> = new {
  ["mise"] = "mise activate zsh"
  // Lets `wt switch` change the shell's directory.
  ["wt"] = "wt config shell init zsh"
}

/// Every tool the hooks run, keyed by hk step name: one file per tool under
/// `tools/<category>/<name>.pkl`, each amending lib/Tool.pkl. A tool declares
/// its pin, scripts and the step it contributes to each hook; the maps below
/// are derived from that. Adding a tool is adding a file.
catalog: Mapping<String, Tool>(length == toolModules.length) = new {
  for (path, tool in toolModules) { [toolName(path)] = tool }
}

/// Tool name → `tools/` subdirectory, for profile.json and `mise run explain`.
toolCategories: Mapping<String, String> = new {
  for (path, _ in toolModules) { [toolName(path)] = path.replaceAll("tools/", "").split("/").first }
}

local toolModules: Mapping<String, Tool> = import*("tools/**/*.pkl")

local function toolName(path: String): String = path.split("/").last.replaceAll(".pkl", "")

/// The hk step name of a tool's pre-commit entry. A tool in both hooks with
/// different steps is `<name>-fix` or `<name>-staged` at commit, so the push
/// step keeps the plain name; a hygiene tool (same step in both) keeps one name.
function commitStepName(name: String, tool: Tool): String =
  if (!tool.on.containsKey("pre-push") || tool.on["pre-commit"] == tool.on["pre-push"])
    name
  else if (tool.on["pre-commit"].fix != null)
    "\(name)-fix"
  else
    "\(name)-staged"

/// A hook entry, with the tool-level glob or types filled in when it has none.
local function entry(tool: Tool, hook: Tool.Hook): hk.Step = (tool.on[hook]) {
  when (tool.on[hook].glob == null && tool.on[hook].types == null) {
    when (tool.glob != null) { glob = tool.glob }
    when (tool.types != null) { types = tool.types }
  }
  when (tool.skipsLockfiles) { exclude = module.lockfiles.toList() }
}

/// Commit: the pre-commit `fix` entries. Each rewrites what it safely can and
/// is restaged; fixers never fail on what they cannot fix. Push judges that.
fixers: Mapping<String, hk.Step> = new {
  for (name, tool in catalog) {
    when (tool.on.containsKey("pre-commit") && tool.on["pre-commit"].fix != null) {
      [commitStepName(name, tool)] = entry(tool, "pre-commit")
    }
  }
}

/// hk profile the lint verb enables; commit guards are tagged to skip it.
lintProfile: String = "lint"

/// Commit guards: the pre-commit `check` entries. They judge the staged change
/// and may block the commit; an `afterFixers` guard runs after every fixer.
commitGuards: Mapping<String, hk.Step> = new {
  for (name, tool in catalog) {
    when (tool.on.containsKey("pre-commit") && tool.on["pre-commit"].fix == null) {
      [commitStepName(name, tool)] = (entry(tool, "pre-commit")) {
        when (tool.afterFixers) { depends = fixers.keys.toList() }
      }
    }
  }
}

/// Push: the pre-push entries, check mode only, so nothing is rewritten. hk
/// selects the files in the pushed range (the default branch to HEAD), so
/// per-file linters judge only what is uploaded; whole-program linters use a
/// new-issues mode against that same base. Full-tree runs are explicit:
/// `mise run lint` / `mise run scan`, or `hk check --slow --all`.
checks: Mapping<String, hk.Step> = new {
  for (name, tool in catalog) {
    when (tool.on.containsKey("pre-push")) { [name] = entry(tool, "pre-push") }
  }
}

/// The pins tools declare; mise installs them after `tools`.
toolPins: Listing<types.Pin> = new {
  for (_, tool in catalog) { when (tool.pin != null) { tool.pin } }
}

/// Global git hooks (git 2.54+ config-based hooks), written by bootstrap.
/// No `--from-hook`: that mode skips every repo without its own hk.pkl.
gitHooks: Mapping<String, String> = new {
  ["pre-commit"] = "hk run pre-commit --staged"
  ["pre-push"] = "hk run pre-push"
  // Profile-agnostic: the active hk config (HK_CONFIG_DIR) owns the rules, so
  // the SAH and personal profiles can share this one global hook.
  ["commit-msg"] = "hk run commit-msg"
}

/// Conventional Commit types the commit-msg hook accepts.
conventionalCommitTypes: Listing<String> = new {
  "feat"
  "fix"
  "docs"
  "style"
  "refactor"
  "perf"
  "test"
  "build"
  "ci"
  "chore"
  "revert"
}

/// The repo task contract (devops-standards): verb → description. The root
/// overlay renders `profile:<verb>` (the dispatch) and `<verb>` (depends on it),
/// so a repo overrides `<verb>` or extends it with `depends = ["profile:<verb>"]`.
contractVerbs: Mapping<String, String> = new {
  ["setup"] = "Install tools and deps (mise deps providers)"
  ["build"] = "Produce the deployable artifact"
  ["lint"] = "Format check + static analysis via the native tools"
  ["test"] = "Run all tests"
  ["scan"] = "Secrets on the tree + dependency vulnerability scanning"
  ["doctor"] = "Verify the repo meets the contract"
}

/// `ci` runs these contract verbs in order, all of them, then fails if any failed.
ciVerbs: Listing<String> = new { "lint"; "test"; "scan" }

/// Ecosystems by marker file, in run order. Bodies live in lib/contract.pkl.
contractAdapters: Listing<types.Adapter> = new {
  new { id = "go"; markers { "go.work"; "**/go.mod" } }
  new {
    id = "node"
    markers {
      "**/aube-lock.yaml"
      "**/pnpm-lock.yaml"
      "**/package-lock.json"
      "**/yarn.lock"
      "**/bun.lock"
      "**/bun.lockb"
    }
  }
  new { id = "php"; markers { "composer.json" } }
  new { id = "python"; markers { "uv.lock"; "pyproject.toml" } }
  new { id = "dotnet"; markers { "**/*.sln"; "**/*.csproj" } }
  new { id = "ruby"; markers { "Gemfile" } }
  new { id = "perl"; markers { "cpanfile"; "Makefile.PL" } }
  new { id = "opentofu"; markers { "**/*.tf" } }
  new { id = "buf"; markers { "**/buf.yaml" } }
  new { id = "swift"; markers { "Package.swift" } }
  // Every repo: deps setup, suppressions, secrets, structure.
  new { id = "repo" }
}

/// One switch: report lists inline suppressions; enforce blocks push and lint.
/// `pkl eval -p suppressionMode=enforce` renders the enforcing variant (tests).
suppressionMode: types.SuppressionMode = read?("prop:suppressionMode") ?? "report"

/// Unavoidable suppressions, declared once: {path, rule, ticket}. Empty by design.
suppressionExceptions: Listing<types.SuppressionException> = new {}

// Split so the literal directive tokens never appear in this source.
local no = "no"
local disable = "dis" + "able"
local ignore = "ig" + "nore"

/// Inline suppression directives, id → POSIX ERE.
suppressionDirectives: Mapping<String, String> = new {
  ["golangci"] = "//[[:space:]]*\(no)lint"
  ["gosec"] = "#\(no)sec"
  ["ruff"] = "#[[:space:]]*\(no)qa"
  ["mypy"] = "#[[:space:]]*type:[[:space:]]*\(ignore)"
  ["eslint"] = "(eslint|oxlint)-\(disable)"
  ["typescript"] = "@ts-(\(ignore)|expect-error)"
  ["phpcs"] = "phpcs:(\(ignore)|\(disable))|@codingStandardsIgnore"
  ["phpstan"] = "@phpstan-\(ignore)"
  ["rubocop"] = "rubocop:(\(disable)|todo)"
  ["shellcheck"] = "shellcheck[[:space:]]+\(disable)="
  ["swiftlint"] = "swiftlint:\(disable)"
}

