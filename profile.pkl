/// Single source of truth for the developer profile.
/// Consumers (hk, dprint, mise, worktrunk, Conform) are generated from this file.
module profile

import "lib/types.pkl"
import "lib/render.pkl"

hkSchemaVersion: String = "2.5.0"

exclude: Listing<String> = new {
  "node_modules"
  ".venv"
  "vendor"
  "dist"
  "build"
  "coverage"
  ".next"
  ".turbo"
  ".cache"
}

dprintExcludes: Listing<String> = new {
  "**/*-lock.json"
  "**/node_modules"
  "**/.venv"
  "**/vendor"
  "**/target"
  "**/.git"
  "**/dist"
  "**/.runners"
  "**/testdata"
  "**/*malformed*"
  "**/generated"
  "generated"
  "mise/conf.d/**"
  "dprint.jsonc"
}

/// Wasm plugins. PHP is never mago — WordPress PHPCBF/WPCS owns PHP formatting.
dprintPlugins: Listing<String> = new {
  "npm:@dprint/typescript@0.96.1"
  "npm:@dprint/json@0.25.1"
  "npm:@dprint/markdown@0.26.0"
  "npm:@dprint/toml@0.8.0"
  "npm:@dprint/dockerfile@0.6.0"
  "npm:dprint-plugin-yaml@0.6.0"
  "npm:@dprint/ruff@0.9.1"
  "npm:@jakebailey/dprint-plugin-gofumpt@0.0.18"
  "npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67"
  "npm:@kachick/dprint-plugin-sh@0.1.2"
}

/// Where `mise run generate` writes outputs. Set once in mise.toml [env].
installDir: String =
  (read?("env:DEV_PROFILE_OUT") ?? throw("DEV_PROFILE_OUT is unset; run `mise run generate`"))
    .replaceFirst(read("env:HOME"), "~")

/// Live config path → generated file. Linked only by `mise run install-live`.
liveTargets: Mapping<String, String> = new {
  ["~/.config/hk/config.pkl"] = "hk.pkl"
  ["~/.config/dprint/dprint.jsonc"] = "dprint.jsonc"
  ["~/.config/worktrunk/config.toml"] = "worktrunk.toml"
  ["~/.config/mise/conf.d/dev-profile.toml"] = "mise-profile.toml"
  ["~/.config/nvim/lua/zach/plugins/conform.lua"] = "conform.lua"
  ["~/Developer/Personal/dprint.jsonc"] = "dprint.jsonc"
  ["~/Developer/Personal/mise.toml"] = "personal-overlay.toml"
}

phase: types.Policy = new {}

settings: types.Settings = new {}

deps: Listing<types.DepProvider> = new {
  new { id = "aube" }
  new { id = "pnpm" }
  new { id = "npm" }
  new { id = "uv" }
  new { id = "composer" }
  new { id = "bundler" }
  new { id = "go" }
  new { id = "git-submodule" }
}

/// Kernel tool required before generation. Also listed here so generated mise can reinstall it.
kernelTools: Listing<types.Pin> = new {
  new { id = "pkl"; version = "0.32.1" }
}

tools: Listing<types.Pin> = new {
  new { id = "hk"; version = "2.5.0" }
  new { id = "dprint"; version = "0.59.0" }
  new { id = "worktrunk"; version = "0.80.0" }
  new { id = "go"; version = "1.27" }
  new { id = "node"; version = "24" }
  new { id = "ruff"; version = "0.16.9" }
  new { id = "oxlint"; version = "1.84.0" }
  new { id = "golangci-lint"; version = "2.13.2" }
  new { id = "stylua"; version = "2.5.2" }
  new { id = "shellcheck"; version = "0.11.0" }
  new { id = "shellharden"; version = "4.3.2" }
  new { id = "aube"; version = "latest" }
  new { id = "uv"; version = "latest" }
  new { id = "hadolint"; version = "latest" }
  new { id = "go:golang.org/x/tools/cmd/goimports"; version = "latest" }
  new { id = "go:golang.org/x/vuln/cmd/govulncheck"; version = "1.8.0" }
  new { id = "npm:@agentclientprotocol/codex-acp"; version = "latest" }
  new { id = "npm:@agentclientprotocol/claude-agent-acp"; version = "latest" }
}

brewPackages: Mapping<String, String> = new {
  ["brew:git"] = "latest"
}

/// The only absolute path allowed in generated files.
llmCommand: String = "/Users/zbornheimer/.local/bin/_llm"

worktreePath: String = "{{ repo_path }}/../.worktrees/{{ repo }}-{{ branch | sanitize }}"

