// Rendered outputs: `mise run generate` evaluates this into installDir.
output {
  files {
    // hk evaluates its config as Pkl, so ship the typed sources it imports.
    ["src/profile.pkl"] { text = read("profile.pkl").text }
    ["src/lib/types.pkl"] { text = read("lib/types.pkl").text }
    ["src/lib/render.pkl"] { text = read("lib/render.pkl").text }
    ["src/lib/hk.pkl"] { text = read("lib/hk.pkl").text }
    // Linked as ~/.config/hk/config.pkl. Absolute, because Pkl resolves relative
    // imports from the symlink's directory, not its target's.
    ["hk-config.pkl"] { text = "amends \"\(installPath)/src/lib/hk.pkl\"\n" }
    ["dprint.jsonc"] { text = render.jsoncFile(render.dprint) }
    // Not named mise.toml: tools run from this dir must not auto-load it as a project config.
    ["mise-profile.toml"] { text = render.tomlFile(render.mise) }
    ["worktrunk.toml"] { text = render.tomlFile(render.worktrunk) }
    ["personal-overlay.toml"] { text = render.tomlFile(render.personalOverlay) }
    // Hand-written adapter; copied so install-live links one directory.
    ["shell.zsh"] { text = render.shellZsh }
    ["conform.lua"] { text = read("conform.lua").text }
    ["profile.json"] {
      value = render.manifest
      renderer = new JsonRenderer { indent = "  " }
    }
    for (name, body in render.wrappers) {
      ["bin/\(name)"] { text = body }
    }
  }
}
