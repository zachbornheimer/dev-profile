#!/usr/bin/env bash
#MISE description="Restore live configs from the newest install-live backup"
set -euo pipefail
latest=""
for dir in "$DEV_PROFILE_BACKUPS"/*; do
	[[ -e "$dir" && "$dir" != *.restored ]] && latest="${dir##*/}"
done
[[ -n "$latest" ]] || {
	echo "no install-live backup to restore" >&2
	exit 1
}
backup="$DEV_PROFILE_BACKUPS/$latest"
while IFS= read -r target || [[ -n "$target" ]]; do
	live="${target/#\~/$HOME}"
	if [[ -e "$backup$live" || -L "$backup$live" ]]; then
		rm -f "$live"
		cp -pP "$backup$live" "$live"
	elif [[ -L "$live" ]]; then
		rm -f "$live" # a link the profile made where nothing was before
	fi
	# Anything else is a regular file this backup never held, such as a merged
	# config with keys you added: it stays, and its history keeps every version.
done <"$backup/targets"
mv "$backup" "$backup.restored"
echo "restored live configs from $backup"
