// profile.pkl is no longer the source: this file is, and mise run generate is refused.
// No @dprint/typescript plugin: a repository owns the formatter for its own TypeScript and
// JavaScript (oxfmt, biome, prettier), and this is the global fallback for every repository,
// so it rewrote tab-indented sources to 2 spaces on every commit.
{
  "shebangs": {
    "#!/usr/bin/env python3": "py",
    "#!/usr/bin/env python": "py",
    "#!/usr/bin/env node": "js",
    "#!/usr/bin/env bash": "bash",
    "#!/usr/bin/env sh": "sh",
    "#!/bin/bash": "bash",
    "#!/bin/sh": "sh",
    "#!/usr/bin/env zsh": "zsh",
    "#!/bin/zsh": "zsh",
    "#!/usr/bin/zsh": "zsh",
    "#!/usr/bin/env perl": "pl"
  },
  "excludes": [
    "**/aube-lock.yaml",
    "**/pnpm-lock.yaml",
    "**/package-lock.json",
    "**/go.sum",
    "**/bun.lock*",
    "**/*.lock",
    "**/node_modules",
    "**/.venv",
    "**/vendor",
    "**/third_party",
    "**/target",
    "**/.git",
    "**/dist",
    "**/.runners",
    "**/testdata",
    "**/fixtures",
    "**/generated",
    "generated",
    "mise/conf.d/**",
    "dprint.jsonc",
    "**/.beads/**",
    "**/*.pb.*",
    "**/*.dist.*",
    "**/*.gen.*",
    "**/*.generated.*",
    "**/*.min.*",
    "**/*.map",
    "**/*.snap"
  ],
  "exec": {
    "cwd": "${configDir}",
    "timeout": 30,
    "commands": [
      {
        "command": "dev-profile-php-fmt --stdin-path {{file_path}}",
        "exts": [
          "php"
        ]
      },
      {
        "command": "dev-profile-perltidy-format {{file_path}}",
        "exts": [
          "pl",
          "pm",
          "t"
        ]
      },
      {
        "command": "stylua -",
        "exts": [
          "lua"
        ]
      },
      {
        "command": "dev-profile-pkl-fmt",
        "exts": [
          "pkl"
        ]
      },
      {
        "command": "dev-profile-rustfmt --stdin-path {{file_path}}",
        "exts": [
          "rs"
        ]
      },
      {
        "command": "dev-profile-clang-format",
        "exts": [
          "c",
          "h",
          "cc",
          "cpp",
          "cxx",
          "hpp"
        ]
      },
      {
        "command": "dev-profile-swift-format --stdin-path {{file_path}}",
        "exts": [
          "swift"
        ]
      },
      {
        "command": "tofu fmt -",
        "exts": [
          "tf"
        ]
      }
    ]
  },
  "plugins": [
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.26.0",
    "npm:@dprint/toml@0.9.0",
    "npm:@dprint/dockerfile@0.7.0",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/ruff@0.9.1",
    "npm:@jakebailey/dprint-plugin-gofumpt@0.0.19",
    "npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67",
    "npm:@kachick/dprint-plugin-sh@0.1.2",
    "https://plugins.dprint.dev/g-plane/markup_fmt-v0.27.5.wasm",
    "https://plugins.dprint.dev/g-plane/malva-v0.16.0.wasm"
  ]
}
