// profile.pkl is no longer the source: this file is, and mise run generate is refused.
// dprint owns TypeScript and JavaScript (@dprint/typescript) in every repository, the same as
// the Software-Automation-Holdings profile, except a repository that declares its own oxfmt, biome
// or prettier config and no dprint config: hk's dprint step skips it (hk/hk.pkl). oxlint stays as
// the JS linter.
{
  "shebangs": {
    "#!/usr/bin/env python3": "py",
    "#!/usr/bin/env python": "py",
    "#!/usr/bin/env node": "js",
    "#!/usr/bin/env bash": "bash",
    "#!/usr/bin/env sh": "sh",
    "#!/bin/bash": "bash",
    "#!/bin/sh": "sh",
    "#!/usr/bin/env zsh": "zsh",
    "#!/bin/zsh": "zsh",
    "#!/usr/bin/zsh": "zsh",
    "#!/usr/bin/env perl": "pl"
  },
  "excludes": [
    "**/aube-lock.yaml",
    "**/pnpm-lock.yaml",
    "**/package-lock.json",
    "**/go.sum",
    "**/bun.lock*",
    "**/*.lock",
    "**/node_modules",
    "**/.venv",
    "**/vendor",
    "**/third_party",
    "**/target",
    "**/.git",
    "**/dist",
    "**/.runners",
    "**/testdata",
    "**/fixtures",
    "**/generated",
    "generated",
    "mise/conf.d/**",
    "dprint.jsonc",
    "**/.beads/**",
    "**/*.pb.*",
    "**/*.dist.*",
    "**/*.gen.*",
    "**/*.generated.*",
    "**/*.min.*",
    "**/*.map",
    "**/*.snap",
    // Bats @test blocks remain outside the profile's shell formatting contract.
    "**/*.bats",
    // Vendored third-party sources: upstream owns their formatting, so reformatting
    // them here would be an unrelated mass edit.
    "**/vim/bundle/**",
    "**/kitty/gattino/**",
    // State an app writes at runtime; never authored here. Same exclusion as the
    // ~/.config/zab_ai entry in config/mise.toml.
    "**/apps/zab_ai/sign_state.json",
    // Template sources that render to shell: the shebang describes the rendered
    // script, not the file as stored, so no shell formatter can parse them. Excluded
    // as a classification, not to suppress a formatter error.
    "**/home/scripts/refresh-launch-agents.sh",
    "**/home/scripts/enable-tmpdir-reaper.sh"
  ],
  "sh": {
    "associations": [
      "!**/*.{sh,bash,ksh,mksh,dash,bats}",
      "!**/.{envrc,bashrc,bash_profile,bash_login,bash_aliases,bash_logout,profile}"
    ]
  },
  "exec": {
    "cwd": "${configDir}",
    "timeout": 30,
    "commands": [
      // shuck 0.2.11 still grows brace-substitution indentation each pass.
      // Explicit flags ignore EditorConfig, matching the old plugin's defaults.
      {
        "command": "shfmt --indent 0 --language-dialect auto --filename {{file_path_with_ext}}",
        "cacheKeyFiles": ["../languages/common/tools.toml"],
        "exts": ["sh", "bash", "ksh", "mksh", "dash"],
        "fileNames": [
          ".envrc", ".bashrc", ".bash_profile", ".bash_login", ".bash_aliases",
          ".bash_logout", ".profile"
        ]
      },
      {
        "command": "dev-profile-php-fmt --stdin-path {{file_path}}",
        "exts": [
          "php"
        ]
      },
      {
        "command": "dev-profile-perltidy-format {{file_path}}",
        "exts": [
          "pl",
          "pm",
          "t"
        ]
      },
      {
        "command": "stylua -",
        "exts": [
          "lua"
        ]
      },
      {
        "command": "dev-profile-pkl-fmt",
        "exts": [
          "pkl"
        ]
      },
      {
        "command": "dev-profile-rustfmt --stdin-path {{file_path}}",
        "exts": [
          "rs"
        ]
      },
      {
        "command": "dev-profile-clang-format",
        "exts": [
          "c",
          "h",
          "cc",
          "cpp",
          "cxx",
          "hpp"
        ]
      },
      {
        "command": "dev-profile-swift-format --stdin-path {{file_path}}",
        "exts": [
          "swift"
        ]
      },
      {
        "command": "tofu fmt -",
        "exts": [
          "tf"
        ]
      }
    ]
  },
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.26.0",
    "npm:@dprint/toml@0.9.0",
    "npm:@dprint/dockerfile@0.7.0",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/ruff@0.9.1",
    "npm:@jakebailey/dprint-plugin-gofumpt@0.0.19",
    "https://plugins.dprint.dev/exec-0.8.0.json@1f2dfbf5dec6d2e590b2c8b0ba6dbfaf80d0320fa9bd4c3f4f29efb99cd2bd6f",
    // Keep Zsh on its existing parser; exec takes precedence for Bash/POSIX.
    "npm:@kachick/dprint-plugin-sh@0.1.2",
    "https://plugins.dprint.dev/g-plane/markup_fmt-v0.27.5.wasm",
    "https://plugins.dprint.dev/g-plane/malva-v0.16.0.wasm"
  ]
}
