#!/usr/bin/env python3
"""Block only the workflow-lint findings a change introduces.

A finding already present in the file's base version — its content at the merge
base with origin's default branch — is debt the change inherited, so it never
blocks a push; only a finding the change adds does. That is the ratchet
`dev-profile-golangci-ratchet` and `dev-profile-ruff-new` apply to their tools,
and the same rule `mise run lint` deliberately does not use: the lint verb
judges the whole tree.

Findings are keyed by rule plus the stripped text of the line they point at, so
a finding that only moved with surrounding edits is still recognised as old.

Usage: dev-profile-lint-ratchet <actionlint|yamllint|zizmor> [tool args...] -- <file>...
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
import tempfile
from collections import Counter
from pathlib import Path

TOOLS = ("actionlint", "yamllint", "zizmor")


def git(*args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(["git", *args], capture_output=True, text=True, check=False)


def repo_root() -> Path:
    top = git("rev-parse", "--show-toplevel").stdout.strip()
    return Path(top) if top else Path.cwd()


def base_commit() -> str | None:
    """The upstream default branch's merge base, or None when there is none."""
    head = git(
        "symbolic-ref", "-q", "--short", "refs/remotes/origin/HEAD"
    ).stdout.strip()
    for ref in (head, "origin/main", "origin/master"):
        if (
            not ref
            or git("rev-parse", "-q", "--verify", f"{ref}^{{commit}}").returncode != 0
        ):
            continue
        base = git("merge-base", "HEAD", ref).stdout.strip()
        if base:
            return base
    return None


def base_text(base: str, path: str) -> str | None:
    proc = git("show", f"{base}:{path}")
    return proc.stdout if proc.returncode == 0 else None


def finding(rule: str, path: str, line: int, column: int, message: str) -> dict:
    return {
        "rule": rule,
        "path": path,
        "line": line,
        "column": column,
        "message": message,
    }


def run_actionlint(extra: list[str], paths: list[str], cwd: Path) -> list[dict]:
    found: list[dict] = []
    for path in paths:
        proc = subprocess.run(
            ["actionlint", "-format", "{{json .}}", *extra, path],
            capture_output=True,
            text=True,
            check=False,
            cwd=cwd,
        )
        if proc.returncode not in (0, 1):
            sys.stderr.write(proc.stderr)
            raise SystemExit(proc.returncode)
        try:
            items = json.loads(proc.stdout or "[]")
        except json.JSONDecodeError:
            # actionlint's own complaint is the finding; block on it.
            found.append(
                finding("parse", path, 0, 0, (proc.stdout or proc.stderr or "")[:2000])
            )
            continue
        for item in items or []:
            found.append(
                finding(
                    str(item.get("kind") or ""),
                    path,
                    int(item.get("line") or 0),
                    int(item.get("column") or 0),
                    str(item.get("message") or ""),
                )
            )
    return found


def run_yamllint(extra: list[str], paths: list[str], cwd: Path) -> list[dict]:
    proc = subprocess.run(
        ["yamllint", "-f", "parsable", *extra, *paths],
        capture_output=True,
        text=True,
        check=False,
        cwd=cwd,
    )
    # yamllint reports a verdict as its exit code: 0 nothing found, 1 errors, and
    # 2 warnings-only under the --strict every caller passes. Only anything else is
    # the tool failing rather than judging the file, and warnings must reach the
    # ratchet so inherited ones can be excused instead of aborting the run.
    if proc.returncode not in (0, 1, 2):
        sys.stderr.write(proc.stderr)
        raise SystemExit(proc.returncode)
    found: list[dict] = []
    for raw in proc.stdout.splitlines():
        parts = raw.split(":", 3)
        if len(parts) < 4:
            continue
        body = parts[3].strip()
        rule = body.rsplit("(", 1)[-1].rstrip(")") if body.endswith(")") else body
        found.append(finding(rule, parts[0], _int(parts[1]), _int(parts[2]), body))
    return found


def run_zizmor(extra: list[str], paths: list[str], cwd: Path) -> list[dict]:
    # zizmor reads GH_TOKEN; hk exports GITHUB_TOKEN, and an unauthenticated
    # API call only slows the action-pin audits down.
    env = dict(os.environ)
    if env.get("GITHUB_TOKEN") and not env.get("GH_TOKEN"):
        env["GH_TOKEN"] = env["GITHUB_TOKEN"]
    proc = subprocess.run(
        ["zizmor", "--format", "sarif", "--no-progress", *extra, *paths],
        capture_output=True,
        text=True,
        check=False,
        cwd=cwd,
        env=env,
    )
    if not proc.stdout.strip():
        # Nothing to parse: a clean run, or a real failure. zizmor's own exit
        # codes separate findings (non-zero) from errors, so trust the output.
        if proc.returncode == 0:
            return []
        sys.stderr.write(proc.stderr)
        raise SystemExit(proc.returncode)
    found: list[dict] = []
    for run in json.loads(proc.stdout).get("runs", []):
        for result in run.get("results", []):
            where = (result.get("locations") or [{}])[0].get("physicalLocation", {})
            path = (where.get("artifactLocation") or {}).get("uri", "")
            line = (where.get("region") or {}).get("startLine", 0)
            message = (result.get("message") or {}).get("text", "")
            found.append(
                finding(
                    str(result.get("ruleId") or ""),
                    path,
                    int(line or 0),
                    _int(str((where.get("region") or {}).get("startColumn", 0))),
                    message,
                )
            )
    return found


RUNNERS = {"actionlint": run_actionlint, "yamllint": run_yamllint, "zizmor": run_zizmor}


def _int(value: str) -> int:
    try:
        return int(value)
    except ValueError:
        return 0


def line_text(source: str, line: int) -> str:
    rows = source.splitlines()
    return rows[line - 1].strip() if 0 < line <= len(rows) else ""


def key(item: dict, sources: dict[str, str]) -> tuple[str, str, str]:
    return (
        item["rule"],
        Path(item["path"]).as_posix(),
        line_text(sources.get(Path(item["path"]).as_posix(), ""), item["line"]),
    )


def main(argv: list[str]) -> int:
    if not argv or argv[0] not in TOOLS or "--" not in argv:
        sys.stderr.write(__doc__ or "")
        return 2
    tool = argv[0]
    split = argv.index("--")
    extra, paths = argv[1:split], argv[split + 1 :]
    runner = RUNNERS[tool]
    root = repo_root()
    relative = [Path(path).as_posix() for path in paths]

    base = base_commit()
    if base is None:
        # No upstream to measure against: judge the whole file, as before.
        proc = subprocess.run([tool, *extra, *paths], check=False)
        return proc.returncode

    current_sources = {}
    old_sources = {}
    with tempfile.TemporaryDirectory() as scratch:
        mirror = Path(scratch)
        old_paths = []
        for path in relative:
            source = root / path
            if not source.exists():
                continue
            current_sources[path] = source.read_text()
            old = base_text(base, path)
            if old is None:
                continue
            old_sources[path] = old
            copy = mirror / path
            copy.parent.mkdir(parents=True, exist_ok=True)
            copy.write_text(old)
            old_paths.append(path)

        current = runner(extra, relative, root)
        inherited = Counter()
        if old_paths:
            inherited = Counter(
                key(item, old_sources) for item in runner(extra, old_paths, mirror)
            )

    introduced = 0
    for item in current:
        item["key"] = key(item, current_sources)
        if inherited[item["key"]] > 0:
            inherited[item["key"]] -= 1
            continue
        introduced += 1
        rule = (
            f" [{item['rule']}]"
            if item["rule"] and item["rule"] not in item["message"]
            else ""
        )
        print(
            f"{item['path']}:{item['line']}:{item['column']}: {item['message']}{rule}"
        )

    if introduced:
        print(
            f"{tool}: {introduced} finding(s) this change introduces", file=sys.stderr
        )
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
