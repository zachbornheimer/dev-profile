#!/usr/bin/env bash
set -euo pipefail
# Code generated by `mise run generate`. DO NOT EDIT.
# Source of truth: profile.pkl

# Run every applicable contract adapter for one verb, from the repo root.
# Adapter exit: 0 ok, 3 nothing to do, anything else failed.
verb="${1:?usage: dev-profile-contract <verb>}"
if ! root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
	echo "dev-profile-contract: ${PWD} is not inside a git repository" >&2
	exit 2
fi
cd "${root}"

ran=0
failed=()

# True when the repo has a tracked or unignored file matching any pathspec.
has_marker() {
	[[ -n "$(git ls-files --cached --others --exclude-standard -- "$@")" ]]
}

run_adapter() {
	local id="$1" code=0
	"dev-profile-contract-${id}" "${verb}" || code=$?
	case "${code}" in
	0)
		ran=$((ran + 1))
		echo "ok    ${id} ${verb}"
		;;
	3)
		echo "skip  ${id} ${verb} (nothing to ${verb})"
		;;
	*)
		ran=$((ran + 1))
		failed+=("${id}")
		echo "FAIL  ${id} ${verb} (exit ${code})"
		;;
	esac
}

if has_marker ':(glob)go.work' ':(glob)**/go.mod'; then run_adapter go; fi
if has_marker ':(glob)**/aube-lock.yaml' ':(glob)**/pnpm-lock.yaml' ':(glob)**/package-lock.json' ':(glob)**/yarn.lock' ':(glob)**/bun.lock' ':(glob)**/bun.lockb'; then run_adapter node; fi
if has_marker ':(glob)composer.json'; then run_adapter php; fi
if has_marker ':(glob)uv.lock' ':(glob)pyproject.toml'; then run_adapter python; fi
if has_marker ':(glob)**/*.sln' ':(glob)**/*.csproj'; then run_adapter dotnet; fi
if has_marker ':(glob)Gemfile'; then run_adapter ruby; fi
if has_marker ':(glob)cpanfile' ':(glob)Makefile.PL'; then run_adapter perl; fi
if has_marker ':(glob)**/*.tf'; then run_adapter opentofu; fi
if has_marker ':(glob)**/buf.yaml'; then run_adapter buf; fi
if has_marker ':(glob)Package.swift'; then run_adapter swift; fi
run_adapter repo

if [[ "${ran}" -eq 0 ]]; then
	echo "nothing to ${verb}"
	exit 0
fi
if [[ "${#failed[@]}" -gt 0 ]]; then
	echo "${verb} failed: ${failed[*]}" >&2
	exit 1
fi
