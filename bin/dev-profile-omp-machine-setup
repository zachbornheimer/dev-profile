#!/usr/bin/env bash
set -euo pipefail
# Install the stable omp entrypoint and the reference-transaction hook that
# keeps oh-my-pi's `main` a read-only mirror (both run by `mise run setup`).
#
# omp itself is installed by mise from the fork's GitHub releases
# (`github:zachbornheimer/oh-my-pi` in the global mise config). mise owns the
# real binary under ~/.local/share/mise/installs/ and exposes it through
# shims, but consumers exist whose PATH has ~/.local/bin without the shims
# dir (the capability gateway shells out to plain `omp`). ~/.local/bin/omp is
# therefore the stable entrypoint: a symlink to the mise shim, recreated
# idempotently here on every machine. The old path (a symlink into the
# oh-my-pi source checkout, rewritten by dev-profile-omp-sync) is gone.

# Where mise keeps its shims (honor MISE_DATA_DIR, default ~/.local/share/mise).
shims_dir="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims"

# Restore the entrypoint if the shim was upgraded away (mise replaces the
# shims dir atomically), or create it on a fresh machine.
mkdir -p "$HOME/.local/bin"
ln -sfn "$shims_dir/omp" "$HOME/.local/bin/omp"

# Install the reference-transaction hook in oh-my-pi and any fork repo under
# ~/Developer that tracks an `upstream` remote or holds `.omp-build/`.
install_fork_reference_transaction_hook() {
	local repo_dir="$1"
	local is_omp="$2"
	[ -d "$repo_dir/.git" ] || return 0
	mkdir -p "$repo_dir/.git/hooks"
	cat >"$repo_dir/.git/hooks/reference-transaction" <<EOF
#!/usr/bin/env bash
set -euo pipefail
state="\${1:-}"
[ "\$state" = "prepared" ] || exit 0
is_omp="$is_omp"
origin_main_sha="\$(git rev-parse --verify -q refs/remotes/origin/main 2>/dev/null || true)"
while read -r _old_value new_value ref_name; do
	if [ "\$is_omp" = "1" ] && [ "\$ref_name" = "refs/heads/main" ] && [ -n "\$origin_main_sha" ]; then
		if [ "\$new_value" != "0000000000000000000000000000000000000000" ] && [ "\$new_value" != "\$origin_main_sha" ]; then
			echo "ERROR [oh-my-pi reference-transaction]: refs/heads/main must match origin/main (\$origin_main_sha)." >&2
			echo "origin/main is upstream plus one carry commit, changed only through the fork (see the updating-oh-my-pi skill). Put changes on a topic branch pushed to 'origin' and add a file under .omp-build/branches/ so CI builds it." >&2
			exit 1
		fi
	fi
	case "\$ref_name" in
		refs/heads/assembled|refs/heads/next|refs/heads/seen)
			if [ "\$new_value" != "0000000000000000000000000000000000000000" ]; then
				short_branch="\${ref_name#refs/heads/}"
				remote_sha="\$(git rev-parse --verify -q "refs/remotes/origin/\$short_branch" 2>/dev/null || true)"
				if [ "\$new_value" != "\$remote_sha" ] && ! git rev-parse --verify -q "\${new_value}^2" >/dev/null 2>&1; then
					echo "ERROR [fork reference-transaction]: \$ref_name is an integration branch; direct non-merge commits and cherry-picks are forbidden." >&2
					echo "Create a topic branch off origin/main instead and register it under .omp-build/branches/<topic>.toml." >&2
					exit 1
				fi
			fi
			;;
	esac
done
EOF
	chmod +x "$repo_dir/.git/hooks/reference-transaction"
}

REPO_DIR="$HOME/Developer/Personal/oh-my-pi"
install_fork_reference_transaction_hook "$REPO_DIR" "1"

for root in "$HOME/Developer/Personal" "$HOME/Developer/Software-Automation-Holdings"; do
	[ -d "$root" ] || continue
	for candidate in "$root"/*; do
		[ -d "$candidate/.git" ] || continue
		[ "$candidate" = "$REPO_DIR" ] && continue
		if [ -d "$candidate/.omp-build" ] || git -C "$candidate" remote get-url upstream >/dev/null 2>&1; then
			install_fork_reference_transaction_hook "$candidate" "0"
		fi
	done
done
