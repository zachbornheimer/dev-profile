#!/usr/bin/env bash
set -euo pipefail
# Install the stable omp entrypoint and the reference-transaction hook that
# keeps oh-my-pi's `main` a read-only mirror (both run by `mise run setup`).
#
# omp itself is installed by mise from the fork's GitHub releases
# (`github:zachbornheimer/oh-my-pi` in the global mise config). mise owns the
# real binary under ~/.local/share/mise/installs/ and exposes it through
# shims, but consumers exist whose PATH has ~/.local/bin without the shims
# dir (the capability gateway shells out to plain `omp`). ~/.local/bin/omp is
# therefore the stable entrypoint: a symlink to the mise shim, recreated
# idempotently here on every machine. The old path (a symlink into the
# oh-my-pi source checkout, rewritten by dev-profile-omp-sync) is gone.

# Where mise keeps its shims (honor MISE_DATA_DIR, default ~/.local/share/mise).
shims_dir="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims"

# Restore the entrypoint if the shim was upgraded away (mise replaces the
# shims dir atomically), or create it on a fresh machine.
mkdir -p "$HOME/.local/bin"
ln -sfn "$shims_dir/omp" "$HOME/.local/bin/omp"

# Install the reference-transaction hook (see the header comment).
REPO_DIR="$HOME/Developer/Personal/oh-my-pi"

[ -d "$REPO_DIR/.git" ] || exit 0
mkdir -p "$REPO_DIR/.git/hooks"
cat >"$REPO_DIR/.git/hooks/reference-transaction" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
state="${1:-}"
[ "$state" = "prepared" ] || exit 0
origin_main_sha="$(git rev-parse --verify -q refs/remotes/origin/main 2>/dev/null || true)"
[ -n "$origin_main_sha" ] || exit 0
while read -r _old_value new_value ref_name; do
	if [ "$ref_name" = "refs/heads/main" ]; then
		if [ "$new_value" != "0000000000000000000000000000000000000000" ] && [ "$new_value" != "$origin_main_sha" ]; then
			echo "ERROR [oh-my-pi reference-transaction]: refs/heads/main is read-only and must match origin/main ($origin_main_sha)." >&2
			echo "Never commit or merge onto 'main' in oh-my-pi. Keep changes on a topic branch pushed to 'fork' and listed in the fork's .github/omp-rebuild.toml so CI builds them." >&2
			exit 1
		fi
	fi
done
EOF
chmod +x "$REPO_DIR/.git/hooks/reference-transaction"
