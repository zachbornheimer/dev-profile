#!/usr/bin/env bash
set -euo pipefail
real_wt() {
	local dir cand self_dir rest
	self_dir=$(cd "$(dirname "$0")" && pwd -P) || return 127
	rest=$PATH
	while [ -n "$rest" ]; do
		dir=${rest%%:*}
		case $rest in
		*:*) rest=${rest#*:} ;;
		*) rest= ;;
		esac
		[ -n "$dir" ] || continue
		cand=$dir/wt
		[ -x "$cand" ] || continue
		[ "$cand" -ef "$self_dir/wt" ] && continue
		printf '%s\n' "$cand"
		return 0
	done
	printf '%s\n' 'wt: no worktrunk binary on PATH' >&2
	return 127
}
if [ -n "${COMPLETE:-}" ]; then
	real=$(real_wt) || exit $?
	exec "$real" "$@"
fi

# Sets WT_ARGS to the real wt argv with `--fix` removed. Returns 0 only
# when the command is `step commit` and `--fix` was present after it.
commit_fix_args() {
	local arg fix
	local -a kept
	WT_ARGS=()
	kept=()
	fix=0
	while [ $# -gt 0 ]; do
		arg=$1
		shift
		case "$arg" in
		--config=* | --config-set=*)
			kept[${#kept[@]}]=$arg
			;;
		-C | --config | --config-set)
			kept[${#kept[@]}]=$arg
			if [ $# -eq 0 ]; then
				return 1
			fi
			kept[${#kept[@]}]=$1
			shift
			;;
		--)
			return 1
			;;
		-*)
			kept[${#kept[@]}]=$arg
			;;
		step)
			if [ "${1:-}" != commit ]; then
				return 1
			fi
			kept[${#kept[@]}]=step
			kept[${#kept[@]}]=commit
			shift
			while [ $# -gt 0 ]; do
				arg=$1
				shift
				if [ "$arg" = -- ]; then
					kept[${#kept[@]}]=$arg
					while [ $# -gt 0 ]; do
						kept[${#kept[@]}]=$1
						shift
					done
					break
				fi
				if [ "$arg" = --fix ]; then
					fix=1
					continue
				fi
				kept[${#kept[@]}]=$arg
			done
			[ "$fix" -eq 1 ] || return 1
			WT_ARGS=("${kept[@]}")
			return 0
			;;
		*)
			return 1
			;;
		esac
	done
	return 1
}

# Native aliases spawn wt again: preserve an explicit user config across that boundary.
inherit_config_path() {
	local base config
	base=$PWD
	config=
	WT_EXPLICIT_YES=0
	while [ $# -gt 0 ]; do
		case $1 in
		-C)
			[ $# -gt 1 ] || return 0
			base=$2
			shift 2
			;;
		--config)
			[ $# -gt 1 ] || return 0
			config=$2
			shift 2
			;;
		--config=*)
			config=${1#--config=}
			shift
			;;
		--config-set)
			[ $# -gt 1 ] || return 0
			shift 2
			;;
		-y | --yes)
			export DEV_PROFILE_WT_YES=1
			WT_EXPLICIT_YES=1
			shift
			;;
		--config-set=* | -*) shift ;;
		*) break ;;
		esac
	done
	[ -n "$config" ] || return 0
	case $config in
	/*) export WORKTRUNK_CONFIG_PATH=$config ;;
	*)
		base=$(cd "$base" && pwd -P) || return 0
		export WORKTRUNK_CONFIG_PATH=$base/$config
		;;
	esac
}
inherit_config_path "$@"
if [ "${DEV_PROFILE_WT_YES:-}" = 1 ] && [ "$WT_EXPLICIT_YES" = 0 ]; then
	set -- --yes "$@"
fi
if commit_fix_args "$@"; then
	exec "${0%/*}/dev-profile-commit-fix" "${WT_ARGS[@]}"
fi
real=$(real_wt) || exit $?
# WT_BENCH=1|2 times this call; see dev-profile-bench. Off, this is a plain exec.
if [ -n "${WT_BENCH:-}" ] && [ "$WT_BENCH" != 0 ]; then
	exec "${0%/*}/dev-profile-bench" run "wt $*" -- "$real" "$@"
fi
exec "$real" "$@"
