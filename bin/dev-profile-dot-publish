#!/usr/bin/env bash
# Save a dot checkpoint that publishes only the paths this turn wrote.
#
# `mise dot save <path>` validates that a path is tracked but captures the whole
# tracked delta anyway (measured 2026-11-17: naming one path in a two-dirty-path
# home saved both in one checkpoint), so a bare `mise dot save` publishes files
# another process wrote and the turn later describes work it did not author.
# Until mise scopes capture to named paths, this wrapper is the turn-side gate:
#
#   1. every tracked path with unsaved edits that the turn did not name is an
#      extra; with extras present the save is refused (exit 2) and each extra is
#      listed with its reason;
#   2. after the save the newest checkpoint's own file list is asserted against
#      the authored set, so a save that publishes more than it was asked to is
#      reported instead of passing as the turn's own work (exit 3);
#   3. extras the caller accepted with --allow-extras are echoed as untouched.
#
# Usage: dev-profile-dot-publish [--description TEXT] --paths <path>... [--allow-extras]
set -uo pipefail

readonly EXIT_REFUSED=2
readonly EXIT_UNSCOPED=3

description=""
allow_extras=0
declare -a authored=()

while [ $# -gt 0 ]; do
	case "$1" in
	--description | -d)
		description=${2:-}
		shift 2
		;;
	--paths)
		shift
		while [ $# -gt 0 ] && [ "${1#--}" = "$1" ]; do
			authored+=("$1")
			shift
		done
		;;
	--allow-extras)
		allow_extras=1
		shift
		;;
	-h | --help)
		sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'
		exit 0
		;;
	*)
		printf 'dev-profile-dot-publish: unexpected argument %s\n' "$1" >&2
		exit 64
		;;
	esac
done

if [ ${#authored[@]} -eq 0 ]; then
	printf 'dev-profile-dot-publish: --paths names at least one tracked path\n' >&2
	exit 64
fi

# mise reports tracked paths in `~/...` form; compare in that form.
mise_path() {
	local p=$1
	while [ "${p%/}" != "$p" ] && [ "$p" != "/" ]; do p=${p%/}; done
	case "$p" in
	"$HOME") printf '~' ;;
	"$HOME"/*) printf '~%s' "${p#"$HOME"}" ;;
	/*) printf '%s' "$p" ;;
	*) printf '~/%s' "${p#./}" ;;
	esac
}

status_json=$(mise dot status --json 2>/dev/null) || {
	printf 'dev-profile-dot-publish: `mise dot status --json` failed; nothing saved\n' >&2
	exit 1
}

# Tracked targets come back as `~/...` already; unsaved edits are the turn's
# competition for what a checkpoint would publish.
unsaved=()
while IFS= read -r line; do unsaved+=("$line"); done < <(
	printf '%s' "$status_json" | jq -r '.history.unsaved[]?' 2>/dev/null
)

declare -a authored_mise=()
for p in "${authored[@]}"; do authored_mise+=("$(mise_path "$p")"); done

declare -a extras=()
for u in "${unsaved[@]}"; do
	found=0
	for a in "${authored_mise[@]}"; do
		[ "$u" = "$a" ] && found=1 && break
	done
	[ "$found" -eq 0 ] && extras+=("$u")
done

if [ ${#extras[@]} -gt 0 ] && [ "$allow_extras" -eq 0 ]; then
	printf 'dev-profile-dot-publish: refusing the save; it would publish paths this turn did not write:\n' >&2
	for e in "${extras[@]}"; do
		printf '  untouched  %s  modified outside this turn\n' "$e" >&2
	done
	printf '%s\n' \
		'`mise dot save` captures the whole tracked delta; it cannot yet be scoped to named paths' \
		'(ZYS-9739). Re-run with --allow-extras to publish them anyway and say so in the reply.' >&2
	exit "$EXIT_REFUSED"
fi

declare -a save_args=(save)
[ -n "$description" ] && save_args+=(--description "$description")
save_args+=("${authored[@]}")

if ! mise dot "${save_args[@]}" >/dev/null 2>&1; then
	printf 'dev-profile-dot-publish: `mise dot %s` failed; nothing verified\n' "${save_args[*]}" >&2
	exit 1
fi

# The assertion: the newest checkpoint must name nothing the turn did not write
# and did not accept as an extra.
checkpoint=$(mise dot history -J -n 1 2>/dev/null) || {
	printf 'dev-profile-dot-publish: checkpoint saved but unreadable; treat the publish as unverified\n' >&2
	exit 1
}
published=()
while IFS= read -r line; do published+=("$line"); done < <(
	printf '%s' "$checkpoint" | jq -r '.[0] | (.changes.modified // [])[]?' 2>/dev/null
)

declare -a unexpected=()
for f in "${published[@]}"; do
	found=0
	for a in "${authored_mise[@]}"; do [ "$f" = "$a" ] && found=1 && break; done
	if [ "$found" -eq 0 ]; then
		for e in "${extras[@]}"; do [ "$f" = "$e" ] && found=1 && break; done
	fi
	[ "$found" -eq 0 ] && unexpected+=("$f")
done

if [ ${#unexpected[@]} -gt 0 ]; then
	printf 'dev-profile-dot-publish: the checkpoint published paths outside this turn'"'"'s work:\n' >&2
	for f in "${unexpected[@]}"; do printf '  unexpected  %s\n' "$f" >&2; done
	exit "$EXIT_UNSCOPED"
fi

printf 'dev-profile-dot-publish: saved %d path(s)%s\n' "${#published[@]}" \
	"${description:+ — $description}"
for e in "${extras[@]}"; do
	printf '  untouched  %s  modified outside this turn; published because --allow-extras was given\n' "$e"
done
