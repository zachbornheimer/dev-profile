#!/usr/bin/env bash
set -euo pipefail
# Push guard: an add or modify, in the commits being pushed, of config or a dependency for a retired
# formatter (trunk, prettier, biome, oxfmt) or hook runner (lefthook, husky, lint-staged,
# simple-git-hooks, the pre-commit framework) fails. dprint formats and hk runs the hooks.
# Deleting stays allowed.
"$(dirname "${BASH_SOURCE[0]}")/dev-profile-repo-owned" || exit 0
banned_file='(^|/)(\.trunk/|\.husky/|\.prettierrc[^/]*$|prettier\.config\.[^/]*$|\.prettierignore$|\.?biome\.jsonc?$|\.oxfmtrc(\.jsonc?)?$|oxfmt\.(jsonc?|config\.[^/]*)$|\.?lefthook(-local)?\.(ya?ml|json|toml)$|\.lintstagedrc[^/]*$|lint-staged\.config\.[^/]*$|\.simple-git-hooks\.[^/]*$|simple-git-hooks\.config\.[^/]*$|\.pre-commit-config\.ya?ml$)'
# Added lines only: removing a dependency or tool line must pass.
banned_package_line='^\+[[:space:]]*"(prettier|@prettier/[^"]*|@biomejs/[^"]*|oxfmt|husky|lint-staged|lefthook|@evilmartians/lefthook|simple-git-hooks|yorkie)"[[:space:]]*:|^\+[[:space:]]*"[^"]+"[[:space:]]*:[[:space:]]*"[^"]*\b(husky|lefthook|lint-staged|simple-git-hooks)\b[^"]*"'
banned_mise_line='^\+[[:space:]]*"?[^=]*\b(prettier|trunk|biome|oxfmt|lefthook|husky|lint-staged|simple-git-hooks)\b[^=]*"?[[:space:]]*=|^\+[[:space:]]*"?([a-z]+:)?pre-commit"?[[:space:]]*='
# The base is the newest commit the pushed commits share with remote history, so a
# dependency the remote default branch already carries is not "added". Reused clones
# often have no refs/remotes/origin/HEAD, so it is one candidate among several; the
# empty tree is only for a repository with no remote history at all.
remote_base() {
	local ref remote_sha pushed_branch
	# 1. The remote default branch.
	git merge-base HEAD origin/HEAD 2>/dev/null && return 0
	# 2. The remote tip of each pushed ref (pre-push stdin saved to SAH_PUSH_REFS).
	if [[ -n "${SAH_PUSH_REFS:-}" && -r "${SAH_PUSH_REFS}" ]]; then
		while read -r _ _ _ remote_sha; do
			[[ "${remote_sha:-}" =~ ^0*$ ]] && continue
			git cat-file -e "${remote_sha}^{commit}" 2>/dev/null || continue
			git merge-base HEAD "${remote_sha}" 2>/dev/null && return 0
		done <"${SAH_PUSH_REFS}"
	fi
	# 3. The same-named branch on a remote, the usual default branches, then any remote branch.
	pushed_branch="$(git symbolic-ref -q --short HEAD 2>/dev/null || true)"
	for ref in ${pushed_branch:+"origin/${pushed_branch}"} origin/main origin/master; do
		git rev-parse -q --verify "refs/remotes/${ref}^{commit}" >/dev/null || continue
		git merge-base HEAD "refs/remotes/${ref}" 2>/dev/null && return 0
	done
	while IFS= read -r ref; do
		[[ "${ref}" == */HEAD ]] && continue
		git merge-base HEAD "${ref}" 2>/dev/null && return 0
	done < <(git for-each-ref --format='%(refname)' refs/remotes)
	return 1
}
base="$(remote_base || git hash-object -t tree /dev/null)"
failed=0
while IFS= read -r path; do
	[[ -n "${path}" ]] || continue
	if [[ "${path}" =~ ${banned_file} ]]; then
		echo "banned: ${path}" >&2
		failed=1
		continue
	fi
	case "${path}" in
	package.json | */package.json) pattern="${banned_package_line}" ;;
	mise.toml | */mise.toml | .mise*.toml | */.mise*.toml | mise.*.toml | */mise.*.toml | */mise/*.toml) pattern="${banned_mise_line}" ;;
	*) continue ;;
	esac
	if git diff -U0 --no-color "${base}" HEAD -- "${path}" | grep -Eq "${pattern}"; then
		echo "banned: ${path} adds a retired formatter or hook runner" >&2
		failed=1
	fi
done < <(git diff --name-only --diff-filter=ACMRT "${base}" HEAD)
if [[ "${failed}" -ne 0 ]]; then
	echo "trunk, prettier, biome, oxfmt, lefthook, husky, lint-staged, simple-git-hooks and the pre-commit framework are banned on this machine. dprint formats (system config ~/Developer/Personal/dprint.jsonc) and hk runs the hooks; delete the files instead." >&2
	exit 1
fi
