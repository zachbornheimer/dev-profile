#!/usr/bin/env bash
# Run a per-file hk step over only the files this operation introduces.
#
# Usage: dev-profile-changed-files <command...> -- <candidate-file>...
#
# hk expands {{files}} to every file between the push base and the pushed
# tip, so a branch that merged its default branch hands a step — and its
# fixer — thousands of inherited files. This filter hands the command only
# the introduced candidates, measured per pushed ref from
# DEV_PROFILE_PUSH_REFS (the original pre-push stdin, captured by
# dev-profile-pre-push; the first standalone `--` separates the command —
# a command that itself contains one runs wrapped in `sh -c '...'`).
#
# A file is introduced when its content at the pushed tip differs from its
# content at every base the push inherited:
#
#   the remote tip     advanced by dev-profile-push-base when the branch
#                      moved onto a newer default branch; an unborn remote
#                      ref falls back to the branch's published tip on any
#                      remote-tracking ref (a push of an already-published
#                      branch introduces nothing it has not published),
#                      then to the merge base with origin's default branch;
#   the merge base     of the pushed tip with origin's default branch;
#   published parents  of the pushed tip — the upstream line a fork branch
#                      merged in, which the push did not write.
#
# Without push refs (pre-commit, `hk run check`, a direct run) the candidate
# files pass through untouched. A step whose candidates the push does not
# touch exits 0 without running its command, so an empty file list can
# never reach a tool as a usage error.
set -euo pipefail

is_all_zeros() {
	case "${1:-}" in
	'' | *[!0]*) return 1 ;;
	*) return 0 ;;
	esac
}

is_commit() { git rev-parse -q --verify "$1^{commit}" >/dev/null 2>&1; }

default_branch() { git symbolic-ref -q --short refs/remotes/origin/HEAD || echo origin/main; }

published() {
	[ -n "$(git for-each-ref "--contains=$1" --format='%(refname)' refs/remotes 2>/dev/null)" ]
}

cmd=()
candidates=()
after_separator=0
for arg in "$@"; do
	if [[ "${after_separator}" -eq 0 && "${arg}" == "--" ]]; then
		after_separator=1
	elif [[ "${after_separator}" -eq 0 ]]; then
		cmd+=("${arg}")
	else
		candidates+=("${arg}")
	fi
done
if [[ "${after_separator}" -eq 0 || "${#cmd[@]}" -eq 0 ]]; then
	echo "usage: dev-profile-changed-files <command...> -- <file>..." >&2
	exit 2
fi
if [[ "${#candidates[@]}" -eq 0 ]]; then
	exit 0
fi

refs="${DEV_PROFILE_PUSH_REFS:-}"
if [[ -z "${refs}" || ! -r "${refs}" ]]; then
	printf 'dev-profile-changed-files: %d candidate file(s), no push refs: running %s on all\n' \
		"${#candidates[@]}" "${cmd[0]}" >&2
	exec "${cmd[@]}" "${candidates[@]}"
fi

push_base="$(cd "$(dirname "$0")" && pwd)/dev-profile-push-base"
tmp="$(mktemp -d)"
union="${tmp}/introduced"
: >"${union}"
pushed_refs=0

# The remote ref name is not read: every base is resolved from the shas the
# push sends (local_sha, remote_sha), so that field only has to advance `read`.
while read -r local_ref local_sha _ remote_sha; do
	is_all_zeros "${local_sha:-}" && continue
	is_commit "${local_sha}" || continue
	pushed_refs=$((pushed_refs + 1))

	bases="${tmp}/bases"
	: >"${bases}"
	if ! is_all_zeros "${remote_sha:-}" && is_commit "${remote_sha}"; then
		base="$(${push_base} --pair "${local_sha}" "${remote_sha}" 2>/dev/null || true)"
		if [[ -n "${base}" ]]; then
			echo "${base}" >>"${bases}"
		fi
	else
		# Unborn on its remote: the branch's own published tip is what the
		# push is measured from, when it is already published somewhere.
		branch="${local_ref#refs/heads/}"
		for tracked in $(git for-each-ref --format='%(refname)' refs/remotes); do
			[[ "${tracked}" == refs/remotes/*/"${branch}" ]] || continue
			git merge-base --is-ancestor "${tracked}" "${local_sha}" 2>/dev/null || continue
			echo "${tracked}" >>"${bases}"
			break
		done
	fi
	base="$(git merge-base "${local_sha}" "$(default_branch)" 2>/dev/null || true)"
	if [[ -n "${base}" ]]; then
		echo "${base}" >>"${bases}"
	fi
	for parent in $(git rev-list --parents -n 1 "${local_sha}" 2>/dev/null | cut -d' ' -f 2-); do
		if published "${parent}"; then
			echo "${parent}" >>"${bases}"
		fi
	done

	if [[ ! -s "${bases}" ]]; then
		# No base resolved: judge every candidate, as an unfiltered step would.
		printf '%s\n' "${candidates[@]}" >>"${union}"
		continue
	fi
	# A file the push introduces differs from every base; one matching any
	# base is inherited. The per-ref introduced set is the intersection of
	# the per-base diff sets.
	inter="${tmp}/introduced-in-ref"
	first=1
	while read -r base; do
		[[ -n "${base}" ]] || continue
		diffset="${tmp}/diffset"
		git diff --name-only --no-renames "${base}" "${local_sha}" >"${diffset}" 2>/dev/null || continue
		sort -u "${diffset}" -o "${diffset}"
		if [[ "${first}" -eq 1 ]]; then
			mv "${diffset}" "${inter}"
			first=0
		else
			comm -12 "${inter}" "${diffset}" >"${tmp}/narrowed"
			mv "${tmp}/narrowed" "${inter}"
		fi
	done <"${bases}"
	if [[ "${first}" -eq 0 ]]; then
		cat "${inter}" >>"${union}"
	fi
done <"${refs}"

if [[ "${pushed_refs}" -eq 0 ]]; then
	# Refs that parse to nothing: judge every candidate, as an unfiltered step would.
	printf 'dev-profile-changed-files: %d candidate file(s), no parsable push refs: running %s on all\n' \
		"${#candidates[@]}" "${cmd[0]}" >&2
	rm -rf "${tmp}"
	exec "${cmd[@]}" "${candidates[@]}"
fi

# Candidates may be spelled relative to a workspace hk switched the step
# into; the diff sets are root-relative. Match either spelling.
prefix="$(git rev-parse --show-prefix 2>/dev/null || true)"
keys="${tmp}/keys"
map="${tmp}/map"
: >"${keys}"
: >"${map}"
for candidate in "${candidates[@]}"; do
	printf '%s\n%s\n' "${candidate}" "${prefix}${candidate}" >>"${keys}"
	printf '%s\t%s\n' "${candidate}" "${candidate}" >>"${map}"
	printf '%s\t%s\n' "${prefix}${candidate}" "${candidate}" >>"${map}"
done
sort -u "${keys}" -o "${keys}"
sort -u "${union}" -o "${union}"
comm -12 "${keys}" "${union}" >"${tmp}/matched"
awk -F'\t' 'NR == FNR { matched[$1] = 1; next } matched[$1] && !printed[$2]++ { print $2 }' \
	"${tmp}/matched" "${map}" >"${tmp}/introduced-list"
introduced=()
while IFS= read -r file; do
	[[ -n "${file}" ]] && introduced+=("${file}")
done <"${tmp}/introduced-list"

if [[ "${#introduced[@]}" -eq 0 ]]; then
	printf 'dev-profile-changed-files: 0 of %d candidate file(s) introduced by this push: %s skipped\n' \
		"${#candidates[@]}" "${cmd[0]}" >&2
	rm -rf "${tmp}"
	exit 0
fi
printf 'dev-profile-changed-files: %d of %d candidate file(s) introduced by this push: running %s\n' \
	"${#introduced[@]}" "${#candidates[@]}" "${cmd[0]}" >&2
rm -rf "${tmp}"
exec "${cmd[@]}" "${introduced[@]}"
