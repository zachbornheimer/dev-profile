#!/bin/sh
set -eu
# Code generated by `mise run generate`. DO NOT EDIT.
# Source of truth: profile.pkl
mise_data="${MISE_DATA_DIR:-${XDG_DATA_HOME:-${HOME}/.local/share}/mise}"
pinned="${mise_data}/installs/dprint/0.64.3/dprint"
[ -x "${pinned}" ] && exec "${pinned}" "$@"
[ -x "${mise_data}/shims/dprint" ] && exec "${mise_data}/shims/dprint" "$@"
exec dprint "$@"
