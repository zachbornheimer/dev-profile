#!/usr/bin/env bash
set -euo pipefail

# dev-profile-gosec-packages <files…>: gosec the Go packages that contain the
# given files, but fail only on findings the branch adds. A finding in an
# untouched file never blocks a push, and neither does one in a changed file
# whose rule and source line the upstream default branch already carries, so
# touching a file does not make its old debt the push's.
# A system boundary is exempt from the rule that describes its job, and from
# nothing else: the subprocess rules (G204 variable argv, G702 syscall exec)
# do not apply in a file named facade.go/facades.go or in a package directory
# named process; the file-inclusion rule (G304 path from a variable) does not
# apply in a facade file or in a package directory named fs. Every other rule
# still applies there, and every rule applies everywhere else.
# Skips when gosec is not installed or no Go file is given.
command -v gosec >/dev/null 2>&1 || exit 0
root="$(pwd -P)"
packages=()
changed=()
for file in "$@"; do
	[[ "${file}" == *.go ]] || continue
	packages+=("./$(dirname "${file}")")
	changed+=("${root}/${file#./}")
done
((${#packages[@]})) || exit 0
# gosec exits 1 on any finding; the verdict comes from the report below.
report="$(printf '%s\n' "${packages[@]}" | sort -u | xargs gosec -fmt json 2>/dev/null || true)"
if ! jq -e .Issues >/dev/null 2>&1 <<<"${report}"; then
	echo "gosec produced no readable report:" >&2
	echo "${report}" >&2
	exit 1
fi
findings="$(jq -r --arg root "${root}/" '
  .Issues[]
  | select(.file as $path | $ARGS.positional | index($path))
  | select(((.file | test("/facades?\\.go$|/process/[^/]+\\.go$")) and (.rule_id | IN("G204", "G702"))) | not)
  | select(((.file | test("/facades?\\.go$|/fs/[^/]+\\.go$")) and .rule_id == "G304") | not)
  | [.file, .line, .rule_id, .details] | @tsv
' --args "${changed[@]}" <<<"${report}")"
[[ -n "${findings}" ]] || exit 0

# Drop findings the upstream default branch already carries. A finding is
# inherited when its trimmed source line, in the same file, occurs at the merge
# base at least as many times as findings for that rule on that text have been
# seen so far: a second copy of an old line is the branch's own. Without a base
# ref (no remote, fresh clone) every finding stays.
base=""
for ref in "$(git symbolic-ref -q --short refs/remotes/origin/HEAD || true)" origin/main origin/master; do
	if [[ -n "${ref}" ]] && git rev-parse -q --verify "${ref}^{commit}" >/dev/null; then
		base="$(git merge-base "${ref}" HEAD 2>/dev/null || true)"
		[[ -n "${base}" ]] && break
	fi
done
seen="$(mktemp)"
trap 'rm -f "${seen}"' EXIT
reported=""
while IFS=$'\t' read -r file line rule details; do
	rel="${file#"${root}"/}"
	if [[ -n "${base}" ]]; then
		text="$(sed -n "${line}p" "${file}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
		key="${rel}"$'\t'"${rule}"$'\t'"${text}"
		prior="$(grep -cxF -- "${key}" "${seen}" || true)"
		printf '%s\n' "${key}" >>"${seen}"
		in_base="$(git show "${base}:${rel}" 2>/dev/null | T="${text}" awk '{ s = $0; gsub(/^[ \t]+|[ \t]+$/, "", s); if (s == ENVIRON["T"]) n++ } END { print n + 0 }')"
		((prior < in_base)) && continue
	fi
	reported+="${rel}:${line} ${rule} ${details}"$'\n'
done <<<"${findings}"
[[ -z "${reported}" ]] || {
	printf '%s' "${reported}" >&2
	exit 1
}
