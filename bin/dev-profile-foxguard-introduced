#!/usr/bin/env bash
# Scan the given TypeScript files with foxguard's rule pack and report only the
# findings the branch introduces since its common ancestor with a target ref.
#
# Usage: dev-profile-foxguard-introduced --rules <pack> --target <ref> [--] <file>...
#
# foxguard's own `diff <ref>` walks the whole tree on both sides whatever path
# it is given, which on a monorepo-sized checkout costs tens of minutes per
# push, and every fix round pays it again. The engine's scoped mode
# (`--changed-files-from`, which keeps the scan path as the analysis root so
# cross-file taint context survives) scans only the named files, in seconds.
# The one thing it loses is suppression of inherited findings, so this helper
# scans the common ancestor's copy of the same files. Comparing with the target
# tip would mistake old branch code for new findings when upstream rewrites it.
# A finding's identity is its rule, path, and snippet, never its line numbers:
# edits that only shift lines do not introduce anything.
#
# Run from the repo root, as hk does, with the files a push introduces.
# Exits 1 when the branch introduces a finding, 0 when it introduces none, and
# fails closed with 2 when a scan could not run or a listed file could not be
# scanned.
set -euo pipefail

usage() {
	echo "usage: dev-profile-foxguard-introduced --rules <pack> --target <ref> [--] <file>..." >&2
	exit 2
}

rules=""
target=""
inherited_ref=""
while (($#)); do
	case "$1" in
	--rules)
		(($# >= 2)) || usage
		rules="$2"
		shift 2
		;;
	--target)
		(($# >= 2)) || usage
		target="$2"
		shift 2
		;;
	--inherited-ref)
		(($# >= 2)) || usage
		inherited_ref="$2"
		shift 2
		;;
	--)
		shift
		break
		;;
	-*) usage ;;
	*) break ;;
	esac
done
[[ -n "${rules}" && -n "${target}" ]] || usage
files=("$@")
# A push that introduces no file runs no scan: the same verdict as a scan that
# finds nothing, without paying for one.
((${#files[@]})) || exit 0

root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
	echo "dev-profile-foxguard-introduced: not inside a git worktree" >&2
	exit 2
}
git rev-parse --verify --quiet "${target}^{commit}" >/dev/null || {
	echo "dev-profile-foxguard-introduced: target ${target} is not a commit here" >&2
	exit 2
}

# A push can publish refs other than HEAD. Both the branch scan and its merge
# base must describe each outgoing commit, never unrelated checkout contents.
if [[ -n "${DEV_PROFILE_PUSH_REFS:-}" ]]; then
	# The CLI resolves rule packs relative to the caller, not the snapshot.
	[[ "${rules}" = /* ]] || rules="${PWD}/${rules}"
	[[ -r "${DEV_PROFILE_PUSH_REFS}" ]] || {
		echo "dev-profile-foxguard-introduced: push refs are unreadable" >&2
		exit 2
	}
	push_work="$(mktemp -d)"
	push_trees=()
	cleanup_push_trees() {
		for tree in ${push_trees[@]+"${push_trees[@]}"}; do
			git -C "${root}" worktree remove --force "${tree}" >/dev/null 2>&1 || true
		done
		rm -rf "${push_work}"
	}
	trap cleanup_push_trees EXIT
	: >"${push_work}/tips"
	sha_pattern='^[0-9a-f]{40,64}$'
	while read -r local_ref local_sha remote_ref remote_sha extra || [[ -n "${local_ref:-}" ]]; do
		if [[ -z "${local_ref:-}" || -z "${remote_ref:-}" || -n "${extra:-}" ||
			! "${local_sha:-}" =~ ${sha_pattern} || ! "${remote_sha:-}" =~ ${sha_pattern} ]]; then
			echo "dev-profile-foxguard-introduced: malformed push refs" >&2
			exit 2
		fi
		[[ ! "${local_sha}" =~ ^0+$ ]] || continue
		git -C "${root}" cat-file -e "${local_sha}^{commit}" 2>/dev/null || {
			echo "dev-profile-foxguard-introduced: outgoing commit ${local_sha} is unavailable" >&2
			exit 2
		}
		if [[ ! "${remote_sha}" =~ ^0+$ ]] && ! git -C "${root}" cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
			echo "dev-profile-foxguard-introduced: previous remote commit ${remote_sha} is unavailable" >&2
			exit 2
		fi
		printf '%s %s\n' "${local_sha}" "${remote_sha}" >>"${push_work}/tips"
	done <"${DEV_PROFILE_PUSH_REFS}"
	sort -u "${push_work}/tips" >"${push_work}/unique-tips"
	helper="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
	push_status=0
	while read -r tip previous; do
		tree="${push_work}/${tip}-${previous}"
		push_trees+=("${tree}")
		git -C "${root}" worktree add --detach --quiet "${tree}" "${tip}" || exit 2
		status=0
		inherited=()
		[[ "${previous}" =~ ^0+$ ]] || inherited=(--inherited-ref "${previous}")
		(cd "${tree}" && env -u DEV_PROFILE_PUSH_REFS "${helper}" --rules "${rules}" --target "${target}" ${inherited[@]+"${inherited[@]}"} -- "${files[@]}") || status=$?
		case "${status}" in
		0 | 1) ((status <= push_status)) || push_status="${status}" ;;
		*) push_status=2 ;;
		esac
	done <"${push_work}/unique-tips"
	exit "${push_status}"
fi

baseline="$(git -C "${root}" merge-base HEAD "${target}")" || {
	echo "dev-profile-foxguard-introduced: could not find a common ancestor of HEAD and ${target}" >&2
	exit 2
}
work="$(mktemp -d)"
base="${work}/base"
# shellcheck disable=SC2064 # the paths are resolved now, on purpose
trap "git -C '${root}' worktree remove --force '${base}' >/dev/null 2>&1 || true; rm -rf '${work}'" EXIT

# foxguard reads repo-root-relative paths, the way the scan root spells them.
list="${work}/files"
: >"${list}"
for file in "${files[@]}"; do
	printf '%s\n' "${file#./}" >>"${list}"
done

# Measure inherited findings in their original surrounding context.
if ! git -C "${root}" worktree add --detach --quiet "${base}" "${baseline}" 2>"${work}/worktree.err"; then
	cat "${work}/worktree.err" >&2
	echo "dev-profile-foxguard-introduced: could not check out common ancestor ${baseline}" >&2
	exit 2
fi

# A listed file foxguard skipped — a parse error, unreadable or non-UTF-8
# content — was never scanned, and a pass would be silence about it: the
# pack's readiness warnings on stderr start with "Warning", the per-file skip
# notices with "warning", so the lowercase anchor never matches the report.
# A file the common ancestor could not scan cannot be a regression: the branch
# introduced nothing that scanning could have attributed to it, so it is
# reported on stderr and does not fail the push. A file only the branch could
# not scan (the branch broke its parse) still fails closed.
skipped_files() { # skipped_files <err-file>: the sorted, ./-stripped skipped paths
	grep '^warning: skipping' "$1" | sed -E 's/^warning: skipping (.*) \([^()]*\)$/\1/; s#^\./##' | sort -u || true
}
require_fully_scanned() { # require_fully_scanned <branch-err> <base-err>
	local branch_only both
	branch_only="$(comm -23 <(skipped_files "$1") <(skipped_files "$2"))"
	if [ -n "${branch_only}" ]; then
		cat "$1" >&2
		echo "dev-profile-foxguard-introduced: a listed file could not be scanned (the scan of the branch): ${branch_only//$'\n'/ }" >&2
		exit 2
	fi
	both="$(comm -12 <(skipped_files "$1") <(skipped_files "$2"))"
	if [ -n "${both}" ]; then
		echo "dev-profile-foxguard-introduced: not scanned on the common ancestor either, so nothing it carries is introduced: ${both//$'\n'/ }" >&2
	fi
}

base_json="${work}/base.json"
current_json="${work}/current.json"

# A scan's own findings are its verdict's input, so exit 1 here is success;
# anything beyond it means the scan itself failed.
base_status=0
base_list="${work}/base-files"
: >"${base_list}"
while IFS= read -r file; do
	[ ! -f "${base}/${file}" ] || printf '%s\n' "${file}" >>"${base_list}"
done <"${list}"
if [ -s "${base_list}" ]; then
	(cd "${base}" && foxguard --rules "${rules}" --changed-files-from "${base_list}" --format json .) >"${base_json}" 2>"${work}/base.err" || base_status=$?
else
	# There is no ancestor-side input when every listed file is new on the branch.
	printf '{"findings":[]}\n' >"${base_json}"
	: >"${work}/base.err"
fi
case "${base_status}" in
0 | 1) ;;
*)
	cat "${work}/base.err" >&2
	echo "dev-profile-foxguard-introduced: the scan of common ancestor ${baseline} failed" >&2
	exit 2
	;;
esac

# A prior published tip is an additional inherited basis for a replacement
# push, even when that code was never on the target's upstream ancestry.
inherited_json="${work}/inherited.json"
printf '{"findings":[]}\n' >"${inherited_json}"
if [[ -n "${inherited_ref}" && "${inherited_ref}" != "${baseline}" ]]; then
	git -C "${base}" switch --detach --quiet "${inherited_ref}" || exit 2
	: >"${base_list}"
	while IFS= read -r file; do
		[ ! -f "${base}/${file}" ] || printf '%s\n' "${file}" >>"${base_list}"
	done <"${list}"
	if [[ -s "${base_list}" ]]; then
		inherited_status=0
		(cd "${base}" && foxguard --rules "${rules}" --changed-files-from "${base_list}" --format json .) >"${inherited_json}" 2>"${work}/inherited.err" || inherited_status=$?
		case "${inherited_status}" in
		0 | 1) ;;
		*)
			cat "${work}/inherited.err" >&2
			echo "dev-profile-foxguard-introduced: the scan of previous remote commit failed" >&2
			exit 2
			;;
		esac
	fi
fi

current_status=0
(cd "${root}" && foxguard --rules "${rules}" --changed-files-from "${list}" --format json .) >"${current_json}" 2>"${work}/current.err" || current_status=$?
require_fully_scanned "${work}/current.err" "${work}/base.err"
case "${current_status}" in
0 | 1) ;;
*)
	echo "dev-profile-foxguard-introduced: the scan of the branch failed (exit ${current_status})" >&2
	exit 2
	;;
esac

# A finding of the same rule on the same path with the same snippet is
# inherited, whatever the scan's line and column numbers say, because edits
# that only shift lines do not introduce anything.
set +e
python3 - "${base_json}" "${current_json}" "${inherited_json}" >"${work}/introduced.txt" <<'PY'
from collections import Counter
import json
import sys

base_findings = json.load(open(sys.argv[1]))["findings"]
inherited_findings = json.load(open(sys.argv[3]))["findings"]
current_findings = json.load(open(sys.argv[2]))["findings"]


def identity(finding):
    return (
        finding["rule_id"],
        finding["file"].removeprefix("./"),
        finding["snippet"].strip(),
    )


existing = Counter(map(identity, base_findings)) | Counter(map(identity, inherited_findings))
introduced = []
for finding in current_findings:
    key = identity(finding)
    if existing[key]:
        existing[key] -= 1
    else:
        introduced.append(finding)
for f in introduced:
    path = identity(f)[1]
    print(f"./{path}:{f['line']}:{f['column']}  [{f['severity'].lower()}]  {f['rule_id']}")
    print(f"\t{f['snippet'].strip()}")
print(f"introduced {len(introduced)} finding{'s' if introduced else ''}")
sys.exit(1 if introduced else 0)
PY
compare=$?
set -e
case "${compare}" in
0)
	cat "${work}/introduced.txt"
	exit 0
	;;
1)
	cat "${work}/introduced.txt"
	exit 1
	;;
*)
	echo "dev-profile-foxguard-introduced: could not compare the scans" >&2
	exit 2
	;;
esac
