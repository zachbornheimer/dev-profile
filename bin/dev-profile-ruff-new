#!/usr/bin/env python3
"""Block only the ruff findings a change introduces.

A finding already present in the file's base version, its content at the merge
base with origin's default branch, is debt the change inherited. That covers
upstream's own code in a fork. Only findings the change adds block. Findings
are matched by rule code and the stripped text of the line they point at, so a
finding that only moved with surrounding edits is still recognized as old.

Usage: dev-profile-ruff-new <file>...
"""

from __future__ import annotations

import json
import subprocess
import sys
from collections import Counter


def git(*args: str) -> str | None:
    proc = subprocess.run(["git", *args], capture_output=True, text=True, check=False)
    return proc.stdout.strip() if proc.returncode == 0 else None


def base_commit() -> str:
    default = (
        git("symbolic-ref", "-q", "--short", "refs/remotes/origin/HEAD")
        or "origin/main"
    )
    return git("merge-base", "HEAD", default) or "HEAD"


def findings(path: str, source: str) -> list[dict]:
    proc = subprocess.run(
        [
            "ruff",
            "check",
            "--force-exclude",
            "--output-format=json",
            "--stdin-filename",
            path,
            "-",
        ],
        input=source,
        capture_output=True,
        text=True,
        check=False,
    )
    if proc.returncode not in (0, 1):
        sys.stderr.write(proc.stderr)
        raise SystemExit(proc.returncode)
    return json.loads(proc.stdout or "[]")


def key(finding: dict, lines: list[str]) -> tuple[str, str]:
    row = finding["location"]["row"]
    text = lines[row - 1].strip() if 0 < row <= len(lines) else ""
    return (finding.get("code") or "", text)


def main(paths: list[str]) -> int:
    base = base_commit()
    introduced = 0
    for path in paths:
        with open(path, encoding="utf-8") as handle:
            current = handle.read()
        old = git("show", f"{base}:{path}")
        current_lines = current.splitlines()
        inherited = Counter()
        if old is not None:
            old_lines = old.splitlines()
            inherited = Counter(key(f, old_lines) for f in findings(path, old))
        for finding in findings(path, current):
            k = key(finding, current_lines)
            if inherited[k] > 0:
                inherited[k] -= 1
                continue
            introduced += 1
            loc = finding["location"]
            print(
                f"{path}:{loc['row']}:{loc['column']}: {finding.get('code')} {finding.get('message')}"
            )
    if introduced:
        print(
            f"ruff: {introduced} finding(s) introduced by this change (inherited ones are not counted)",
            file=sys.stderr,
        )
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
