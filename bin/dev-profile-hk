#!/usr/bin/env bash
set -euo pipefail
# Run hk with the profile's own config, never the machine's ~/.config/hk.
# XDG_CONFIG_HOME points every tool in the gate at the profile root's xdg/ render, where
# each finds the config it reads: xdg/hk/config.pkl, xdg/yamllint/config,
# xdg/dprint/dprint.jsonc. With no render hk has no config and fails here, instead of a
# tool silently falling back to its built-in defaults.
render_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
export MISE_CONFIG_DIR="${MISE_CONFIG_DIR:-${XDG_CONFIG_HOME:-${HOME}/.config}/mise}"
export XDG_CONFIG_HOME="${render_dir}/xdg"
exec hk "$@"
