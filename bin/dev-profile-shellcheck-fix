#!/usr/bin/env bash
set -euo pipefail

# Apply the fixes shellcheck is sure of to the staged shell files. Its parser
# understands heredocs, and it leaves expansions that may split on purpose
# ($(seq 3), ${CMD:-mise latest}) as warnings for a person, so a fix never
# changes what the script does. The pre-push shellcheck reports the rest.
#
# Shellcheck reads any text as shell, and a template literal in a source file
# looks like an unquoted command substitution, so a file that is not shell is
# refused before anything is patched: a wrong selection fails loudly and
# corrupts nothing.
if [[ $# -eq 0 ]]; then
	exit 0
fi

# A shell file is named *.sh or *.bash, or opens with a bash, sh, dash or ksh
# shebang (directly or through env). zsh is not shellcheck's language.
shebang='^#![[:space:]]*(/[^[:space:]]*/)?(env[[:space:]]+(-S[[:space:]]+)?)?(ba|da|k)?sh([[:space:]]|$)'
is_shell_file() {
	case "$1" in
	*.sh | *.bash) return 0 ;;
	esac
	local first=''
	IFS= read -r first <"$1" || [[ -n "${first}" ]] || return 1
	[[ "${first}" =~ ${shebang} ]]
}

refused=0
for file in "$@"; do
	if ! is_shell_file "${file}"; then
		echo "dev-profile-shellcheck-fix: ${file}: not a shell file, refusing to rewrite it" >&2
		refused=1
	fi
done
if ((refused)); then
	exit 2
fi
patch="$(shellcheck --format=diff "$@" 2>/dev/null || true)"
if [[ -z "${patch}" ]]; then
	exit 0
fi
git apply --whitespace=nowarn <<<"${patch}"
