#!/usr/bin/env bash
set -euo pipefail
# Code generated by `mise run generate`. DO NOT EDIT.
# Source of truth: profile.pkl

# Contract adapter: python. Exit 0 ok, 1 failed, 3 nothing to do.
verb="${1:?usage: dev-profile-contract-python <verb>}"
failed=0

# Run one tool; record a failure and keep going so every check reports.
step() {
	echo "+ $*" >&2
	"$@" || failed=1
}

nothing_to_do() {
	exit 3
}

pytest_no_tests=5

# pip-audit reads the locked requirements uv exports.
audit() {
	local requirements
	requirements="$(mktemp)"
	step uv export --frozen --format requirements-txt --no-hashes --output-file "${requirements}"
	step uvx pip-audit --disable-pip --no-deps -r "${requirements}"
	rm -f "${requirements}"
}

case "${verb}" in
build)
	grep -qF '[build-system]' pyproject.toml 2>/dev/null || nothing_to_do
	step uv build
	;;
test)
	code=0
	uv run --with pytest pytest || code=$?
	[[ "${code}" -ne "${pytest_no_tests}" ]] || nothing_to_do
	[[ "${code}" -eq 0 ]] || failed=1
	;;
scan) audit ;;
*) nothing_to_do ;;
esac
exit "${failed}"
