#!/usr/bin/env bash
# The files a push introduces, measured once for the whole hook run.
#
# Usage: dev-profile-push-introduced [--added] <advanced-refs-file>
#
# --added measures the files the push adds instead: present at the pushed
# tip, absent at every base. A modified file a base already tracks is
# introduced but never added, so a step that judges only additions
# (check-added-large-files, driven through dev-profile-changed-files --added)
# never sees it.
#
# Input: pre-push ref lines whose remote tips dev-profile-push-base already
# advanced to their push bases (its line mode is the producer). Output on
# stdout: the sorted unique root-relative paths the push introduces, or a
# single `*` line when the push cannot be measured from any base — every
# candidate then counts as introduced, as an unfiltered step would judge it.
#
# dev-profile-pre-push runs this once and hands every step the result through
# DEV_PROFILE_PUSH_INTRODUCED, so a push with many steps pays for the diff
# walk once instead of once per step; dev-profile-changed-files falls back to
# running it per step when that variable is absent.
#
# A file is introduced when its content at the pushed tip differs from its
# content at every base the push inherited:
#
#   the advanced remote tip   what dev-profile-push-base handed over: the
#                             ref's remote tip, or the merge base with
#                             origin's default branch when the branch moved
#                             onto a newer one; an unborn remote falls back
#                             to the branch's published tip on any
#                             remote-tracking ref (a push of an
#                             already-published branch introduces nothing it
#                             has not published);
#   the merge base            of the pushed tip with origin's default branch;
#   published parents         of the pushed tip — the upstream line a fork
#                             branch merged in, which the push did not write.
#
# The per-ref introduced set is the intersection of the per-base diff sets;
# the printed union is their sort -u. A ref with no base at all, or a refs
# file that parses to no ref, cannot bound the push: the `*` line makes every
# candidate count as introduced rather than silently judging none.
set -euo pipefail

added_only=0
if [[ "${1:-}" == "--added" ]]; then
	added_only=1
	shift
fi

if [[ $# -ne 1 || ! -r "$1" ]]; then
	echo "usage: dev-profile-push-introduced [--added] <advanced-refs-file>" >&2
	exit 2
fi
refs="$1"

is_all_zeros() {
	case "${1:-}" in
	'' | *[!0]*) return 1 ;;
	*) return 0 ;;
	esac
}

is_commit() { git rev-parse -q --verify "$1^{commit}" >/dev/null 2>&1; }

default_branch() { git symbolic-ref -q --short refs/remotes/origin/HEAD || echo origin/main; }

published() {
	[ -n "$(git for-each-ref "--contains=$1" --format='%(refname)' refs/remotes 2>/dev/null)" ]
}

tmp="$(mktemp -d)"
trap 'rm -rf "${tmp}"' EXIT
union="${tmp}/introduced"
: >"${union}"
pushed_refs=0
unmeasured=0

while read -r local_ref local_sha _remote_ref remote_sha; do
	is_all_zeros "${local_sha:-}" && continue
	is_commit "${local_sha}" || continue
	pushed_refs=$((pushed_refs + 1))

	bases="${tmp}/bases"
	: >"${bases}"
	if ! is_all_zeros "${remote_sha:-}" && is_commit "${remote_sha}"; then
		# Already advanced by dev-profile-push-base; advancing again would
		# cost the same git calls per ref to reach the same tip.
		echo "${remote_sha}" >>"${bases}"
	else
		# Unborn on its remote: the branch's own published tip is what the
		# push is measured from, when it is already published somewhere.
		branch="${local_ref#refs/heads/}"
		for tracked in $(git for-each-ref --format='%(refname)' refs/remotes); do
			[[ "${tracked}" == refs/remotes/*/"${branch}" ]] || continue
			git merge-base --is-ancestor "${tracked}" "${local_sha}" 2>/dev/null || continue
			echo "${tracked}" >>"${bases}"
			break
		done
	fi
	base="$(git merge-base "${local_sha}" "$(default_branch)" 2>/dev/null || true)"
	if [[ -n "${base}" ]]; then
		echo "${base}" >>"${bases}"
	fi
	for parent in $(git rev-list --parents -n 1 "${local_sha}" 2>/dev/null | cut -d ' ' -f 2-); do
		if published "${parent}"; then
			echo "${parent}" >>"${bases}"
		fi
	done
	# A later authored commit must not turn a merged upstream tree into debt
	# authored by this push. Retain published side parents of earlier merges.
	if [[ -n "${base}" ]]; then
		while read -r _merge _first_parent side_parents; do
			for parent in ${side_parents}; do
				if published "${parent}"; then
					echo "${parent}" >>"${bases}"
				fi
			done
		done < <(git rev-list --merges --parents "${base}..${local_sha}")
	fi

	if [[ ! -s "${bases}" ]]; then
		# No base resolved: the push cannot be bounded, so judge everything.
		unmeasured=1
		continue
	fi
	sort -u "${bases}" -o "${bases}"
	# A file the push introduces differs from every base; one matching any
	# base is inherited. The per-ref introduced set is the intersection of
	# the per-base diff sets; in --added mode each diff set holds only the
	# files absent at that base, so the intersection is the files the push
	# adds.
	inter="${tmp}/introduced-in-ref"
	first=1
	while read -r base; do
		[[ -n "${base}" ]] || continue
		diffset="${tmp}/diffset"
		if [[ "${added_only}" -eq 1 ]]; then
			git diff --name-only --no-renames --diff-filter=A "${base}" "${local_sha}" >"${diffset}" 2>/dev/null || continue
		else
			git diff --name-only --no-renames "${base}" "${local_sha}" >"${diffset}" 2>/dev/null || continue
		fi
		sort -u "${diffset}" -o "${diffset}"
		if [[ "${first}" -eq 1 ]]; then
			mv "${diffset}" "${inter}"
			first=0
		else
			comm -12 "${inter}" "${diffset}" >"${tmp}/narrowed"
			mv "${tmp}/narrowed" "${inter}"
		fi
	done <"${bases}"
	if [[ "${first}" -eq 0 ]]; then
		cat "${inter}" >>"${union}"
	fi
done <"${refs}"

if [[ "${pushed_refs}" -eq 0 || "${unmeasured}" -eq 1 ]]; then
	echo '*'
else
	sort -u "${union}"
fi
