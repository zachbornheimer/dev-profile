#!/usr/bin/env bash
set -euo pipefail
# Code generated by `mise run generate`. DO NOT EDIT.
# Source of truth: profile.pkl

# `dotnet format` style and analyzer fixes, limited to the staged files of each
# solution or project.
(($#)) || exit 0
command -v dotnet >/dev/null 2>&1 || exit 0
root="$(cd "$(git rev-parse --show-toplevel)" && pwd -P)"

# The nearest directory at or above file $1, up to the repo root, that holds a
# file matching glob $2. Prints nothing when there is none.
nearest_up() {
	local dir
	dir="$(cd "$(dirname "$1")" && pwd -P)"
	while :; do
		if compgen -G "${dir}/$2" >/dev/null; then
			echo "${dir}"
			return 0
		fi
		if [[ "${dir}" == "${root}" || "${dir}" == / ]]; then return 0; fi
		dir="$(dirname "${dir}")"
	done
}

# Absolute path of a staged file.
absolute() {
	echo "$(cd "$(dirname "$1")" && pwd -P)/$(basename "$1")"
}

for file in "$@"; do
	abs="$(absolute "${file}")"
	dir="$(nearest_up "${abs}" '*.sln')"
	[[ -n "${dir}" ]] || dir="$(nearest_up "${abs}" '*.csproj')"
	[[ -n "${dir}" ]] || continue
	printf '%s\x1f%s\n' "${dir}" "${abs}"
done | sort | {
	current=""
	files=()
	flush() {
		[[ -n "${current}" ]] || return 0
		(cd "${current}" && dotnet format --no-restore --include "${files[@]}") || true
	}
	while IFS=$'\x1f' read -r dir abs; do
		if [[ "${dir}" != "${current}" ]]; then
			flush
			current="${dir}"
			files=()
		fi
		files+=("${abs}")
	done
	flush
}
