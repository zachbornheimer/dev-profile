#!/usr/bin/env bash
set -euo pipefail
# A repo whose mise.toml clears GIT_DIR (so dependency installers do not act on
# the outer checkout) would strip the bare GIT_DIR git set for a `mise dot sync`
# or `--git-dir` push when the hook enters through `mise x`. Restore it when
# the hook was handed a bare repository.
if [[ -z "${GIT_DIR:-}" && -n "${DEV_PROFILE_HOOK_GIT_DIR:-}" ]] &&
	[[ "$(git --git-dir="${DEV_PROFILE_HOOK_GIT_DIR}" rev-parse --is-bare-repository 2>/dev/null)" == "true" ]]; then
	export GIT_DIR="${DEV_PROFILE_HOOK_GIT_DIR}"
fi

refs="$(mktemp)"
trap 'rm -f "${refs}"' EXIT
cat >"${refs}"

# A bare repository (such as ~/.local/state/mise/history/repo.git pushed by
# `mise dot origin set`, `mise dot sync`, or `history-watch`) has no working
# tree: `hk run pre-push` runs `git status --porcelain=v2`, which exits 128 in
# any bare repo, and file-based steps would read the process cwd instead of the
# bare store. Scan every pushed commit range in the bare repo with gitleaks and
# betterleaks directly.
if [[ "$(git rev-parse --is-bare-repository 2>/dev/null)" == "true" ]]; then
	git_dir="$(git rev-parse --git-dir)"
	all_zeros='^0+$'
	while read -r _local_ref local_sha _remote_ref remote_sha; do
		[[ -n "${local_sha:-}" && ! "${local_sha}" =~ ${all_zeros} ]] || continue
		if [[ -z "${remote_sha:-}" || "${remote_sha}" =~ ${all_zeros} ]] ||
			! git --git-dir="${git_dir}" cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
			range="${local_sha}"
		else
			range="${remote_sha}..${local_sha}"
		fi
		if command -v gitleaks >/dev/null 2>&1; then
			gitleaks git --redact --no-banner --log-opts="${range}" "${git_dir}"
		fi
		if command -v betterleaks >/dev/null 2>&1; then
			betterleaks git --redact --no-banner --log-opts="${range}" "${git_dir}"
		fi
		if git --git-dir="${git_dir}" log -p "${range}" |
			grep -Eq '^\+.*-----BEGIN (RSA |DSA |EC |OPENSSH |PGP )?PRIVATE KEY( BLOCK)?-----'; then
			echo "pre-push: private key block detected in bare repository commit range ${range}" >&2
			exit 1
		fi
	done <"${refs}"
	exit 0
fi

# Refuse publishing the default branch. `main`/`master` move through a merge
# request (`wt pr`) or `wt land`, never a direct push. The opt-out is the
# human's: an agent must not have a reason to set it.
if [[ -z "${DEV_PROFILE_ALLOW_DEFAULT_BRANCH_PUSH:-}" ]]; then
	while read -r _local_ref _local_sha remote_ref _remote_sha; do
		case "${remote_ref}" in
		refs/heads/main | refs/heads/master)
			printf 'ERROR: refusing to push %s. Open a PR with wt pr, or land it with wt land; set DEV_PROFILE_ALLOW_DEFAULT_BRANCH_PUSH=1 to override.\n' "${remote_ref}" >&2
			exit 1
			;;
		esac
	done <"${refs}"
fi

export DEV_PROFILE_PUSH_REFS="${refs}"

# The introduced set, computed once for the push: every per-file step routes
# through dev-profile-changed-files, and each call would otherwise re-derive the
# same set from the same refs. A push whose refs cannot be read exports nothing,
# and each step derives the set itself.
push_files="$(mktemp)"
trap 'rm -f "${refs}" "${push_files}"' EXIT
if dev-profile-push-files >"${push_files}"; then
	export DEV_PROFILE_PUSH_FILES="${push_files}"
else
	rm -f "${push_files}"
fi

# A signal from outside -- a job supervisor's deadline, a closed terminal --
# stops the gate mid-run. hk cancels the steps that were running and reports
# whichever command it killed as "command was cancelled", naming a step that
# never reached a verdict: nothing in the gate found anything. Ignore the
# catchable ones here so hk's own status survives to be read, then say what
# stopped the run rather than leave hk's line as the only account of it.
trap '' HUP INT TERM

status=0
hk run pre-push "$@" < <(dev-profile-push-base <"${refs}") || status=$?

if ((status > 128 && status < 193)); then
	signal_number=$((status - 128))
	signal_name="$(kill -l "${signal_number}" 2>/dev/null || printf 'signal %d' "${signal_number}")"
	cat >&2 <<EOF
dev-profile-pre-push: the gate was stopped by ${signal_name} (exit ${status}) before it finished.
Nothing in the gate failed: hk names the step that was running when the signal arrived as
"command was cancelled", which marks a step that was killed, not one that found something.
The push is refused and nothing was pushed. Re-run it where no deadline can cut it short, e.g.
  setsid git push <remote> <refspec> >/tmp/push.log 2>&1 &   # then read /tmp/push.log
EOF
fi

exit "${status}"
