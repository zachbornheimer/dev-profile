#!/usr/bin/env bash
set -euo pipefail
# A repo whose mise.toml clears GIT_DIR (so dependency installers do not act on
# the outer checkout) would strip the bare GIT_DIR git set for a `mise dot sync`
# or `--git-dir` push when the hook enters through `mise x`. Restore it when
# the hook was handed a bare repository.
if [[ -z "${GIT_DIR:-}" && -n "${DEV_PROFILE_HOOK_GIT_DIR:-}" ]] &&
	[[ "$(git --git-dir="${DEV_PROFILE_HOOK_GIT_DIR}" rev-parse --is-bare-repository 2>/dev/null)" == "true" ]]; then
	export GIT_DIR="${DEV_PROFILE_HOOK_GIT_DIR}"
fi

refs="$(mktemp)"
advanced="$(mktemp)"
introduced="$(mktemp)"
trap 'rm -f "${refs}" "${advanced}" "${introduced}"' EXIT
cat >"${refs}"

# A bare repository (such as ~/.local/state/mise/history/repo.git pushed by
# `mise dot origin set`, `mise dot sync`, or `history-watch`) has no working
# tree: `hk run pre-push` runs `git status --porcelain=v2`, which exits 128 in
# any bare repo, and file-based steps would read the process cwd instead of the
# bare store. Scan every pushed commit range in the bare repo with gitleaks and
# betterleaks directly.
if [[ "$(git rev-parse --is-bare-repository 2>/dev/null)" == "true" ]]; then
	git_dir="$(git rev-parse --git-dir)"
	all_zeros='^0+$'
	while read -r _local_ref local_sha _remote_ref remote_sha; do
		[[ -n "${local_sha:-}" && ! "${local_sha}" =~ ${all_zeros} ]] || continue
		if [[ -z "${remote_sha:-}" || "${remote_sha}" =~ ${all_zeros} ]] ||
			! git --git-dir="${git_dir}" cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
			range="${local_sha}"
		else
			range="${remote_sha}..${local_sha}"
		fi
		if command -v gitleaks >/dev/null 2>&1; then
			gitleaks git --redact --no-banner --log-opts="${range}" "${git_dir}"
		fi
		if command -v betterleaks >/dev/null 2>&1; then
			betterleaks git --redact --no-banner --log-opts="${range}" "${git_dir}"
		fi
		if git --git-dir="${git_dir}" log -p "${range}" |
			grep -Eq '^\+.*-----BEGIN (RSA |DSA |EC |OPENSSH |PGP )?PRIVATE KEY( BLOCK)?-----'; then
			echo "pre-push: private key block detected in bare repository commit range ${range}" >&2
			exit 1
		fi
	done <"${refs}"
	exit 0
fi

# Refuse publishing the default branch. `main`/`master` move through a merge
# request (`wt pr`) or `wt land`, never a direct push. The opt-out is the
# human's: an agent must not have a reason to set it.
if [[ -z "${DEV_PROFILE_ALLOW_DEFAULT_BRANCH_PUSH:-}" ]]; then
	while read -r _local_ref _local_sha remote_ref _remote_sha; do
		case "${remote_ref}" in
		refs/heads/main | refs/heads/master)
			printf 'ERROR: refusing to push %s. Open a PR with wt pr, or land it with wt land; set DEV_PROFILE_ALLOW_DEFAULT_BRANCH_PUSH=1 to override.\n' "${remote_ref}" >&2
			exit 1
			;;
		esac
	done <"${refs}"
fi

# hk's stdin is the pushed refs with each ref's old tip moved to its push
# base. The introduced set that base implies is measured once here and
# shared with every step through DEV_PROFILE_PUSH_INTRODUCED: measuring per
# step (dev-profile-changed-files' fallback) costs tens of seconds of git
# per step in a large repository, and a push with dozens of steps then
# cannot finish at all.

# hk also bounds each step's candidate files from those refs. Handed none it
# selects every tracked file, and the steps then run their tools across the whole
# tree: a push that reached this hook without refs scanned the repository and
# failed on a tool with nothing to do with what it wrote. Refs this hook cannot
# read are refs it cannot gate on, so it refuses the push instead.
if ! dev-profile-push-base <"${refs}" >"${advanced}"; then
	printf 'pre-push: refusing the push: advancing the pushed refs failed, so the files it introduces cannot be known (proceeding would scan the whole repository)\n' >&2
	exit 1
fi
if ! grep -Eq '^[^[:space:]]+ [0-9a-f]{40,64} [^[:space:]]+ [0-9a-f]{40,64}$' "${advanced}"; then
	printf 'pre-push: refusing the push: git passed no readable push refs, so the files it introduces cannot be known (proceeding would scan the whole repository)\n' >&2
	exit 1
fi
if dev-profile-push-introduced "${advanced}" >"${introduced}"; then
	export DEV_PROFILE_PUSH_INTRODUCED="${introduced}"
else
	# Never share a failed measurement: an empty union would skip every
	# gate. Without the variable each step measures, as before.
	printf 'pre-push: measuring the introduced files failed; steps measure for themselves\n' >&2
fi
export DEV_PROFILE_PUSH_REFS="${refs}"
hk run pre-push "$@" <"${advanced}"
