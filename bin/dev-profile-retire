#!/usr/bin/env bash
set -euo pipefail
# Code generated by `mise run generate`. DO NOT EDIT.
# Source of truth: profile.pkl

# Retire this clone. First `wt sync` backs it up; then an independent check
# proves GitHub holds every branch, stash, uncommitted change and detached
# commit; only then do the clone and its worktrees go to the Trash.
# Refuses, and deletes nothing, when anything is not on GitHub, a file was
# too big to back up, or a separate repository sits inside a worktree.
# Ignored files (.env, build output) are not backed up: they are listed, and
# stay recoverable from the Trash. --dry-run checks without deleting.
dry_run=false
case "${1:-}" in
--dry-run) dry_run=true ;;
"") ;;
*)
	echo "usage: dev-profile-retire [--dry-run]" >&2
	exit 2
	;;
esac

# 0: all on GitHub. 3: only conflicts remain, each already backed up.
# DEV_PROFILE_RETIRE_SYNC swaps the backup step; the fixture uses it to prove
# the check below stands on its own.
sync_cmd="${DEV_PROFILE_RETIRE_SYNC:-${HOME}/.local/share/dev-profile/bin/dev-profile-sync}"
code=0
if [[ "${dry_run}" == true ]]; then
	"${sync_cmd}" --dry-run || code=$?
else
	"${sync_cmd}" || code=$?
fi
if [[ "${code}" -ne 0 && "${code}" -ne 3 ]]; then
	echo "Not retiring: wt sync could not back everything up (exit ${code}); see above" >&2
	exit 1
fi

# Only origin: another remote that fails must not stop this. PR heads land in
# refs/sync/pull, out of `git branch -r`, so work GitHub holds only as a PR counts.
git fetch --prune --quiet origin '+refs/heads/*:refs/remotes/origin/*' '+refs/pull/*/head:refs/sync/pull/*'
git symbolic-ref --quiet refs/remotes/origin/HEAD >/dev/null ||
	git remote set-head origin --auto >/dev/null 2>&1 || true
default_branch="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || :)"
default_branch="${default_branch#origin/}"
default_branch="${default_branch:-main}"
base="refs/remotes/origin/${default_branch}"

# True when a branch or PR head on origin already contains commit $1.
on_github() {
	[[ -n "$(git for-each-ref --contains "$1" --count=1 refs/remotes/origin refs/sync/pull)" ]]
}

# True when merging $1 into $2 would change nothing: an ancestor, or content
# already there (a squash merge, or a rebase that $2 went through).
adds_nothing() {
	git merge-base --is-ancestor "$1" "$2" && return 0
	local tree
	tree="$(git merge-tree --write-tree "$2" "$1" 2>/dev/null | sed -n 1p)" || return 1
	[[ "${tree}" == "$(git rev-parse "$2^{tree}")" ]]
}

# Worktrees, the primary first, one per line as fields split by ${sep} (empty
# fields survive, unlike tabs): path, branch (empty when detached), HEAD, and
# "locked" or empty.
sep=$'\037'
worktrees() {
	git worktree list --porcelain | awk -v OFS="${sep}" '
    function emit() { if (path != "") print path, branch, head, locked }
    /^worktree / { emit(); path = substr($0, 10); branch = ""; head = ""; locked = "" }
    /^HEAD / { head = substr($0, 6) }
    /^branch refs\/heads\// { branch = substr($0, 19) }
    /^locked/ { locked = "locked" }
    END { emit() }'
}

# The worktree line for branch $1, if it has one.
worktree_of() { worktrees | awk -F "${sep}" -v b="$1" '$2 == b && !found { print; found = 1 }'; }
max_file_mb="${DEV_PROFILE_SYNC_MAX_FILE_MB:-50}"
left_out="$(mktemp)" nested="$(mktemp)"
trap 'rm -f "${left_out}" "${nested}"' EXIT
clone_id() { git config --get dev-profile.sync-clone || :; }

report() { printf '  %-13s %s\n' "$1" "$2"; }

# A commit of HEAD plus every staged, unstaged and untracked change in
# worktree $1, built in a scratch index: the worktree itself is untouched.
# A file over the size limit keeps its committed version (or stays out, if
# new) and is recorded in ${left_out}. A nested repository is recorded as a
# pointer only, listed in ${nested} and reported: run wt sync inside it.
snapshot() {
	local index tree path size
	index="$(mktemp)"
	cp "$(git -C "$1" rev-parse --path-format=absolute --git-path index)" "${index}"
	GIT_INDEX_FILE="${index}" git -C "$1" add -A 2>/dev/null # quiet about nested repositories; a failure still stops here
	while IFS= read -r -d '' path; do
		size="$(GIT_INDEX_FILE="${index}" git -C "$1" cat-file -s ":${path}" 2>/dev/null)" || continue
		if ((size > max_file_mb * 1024 * 1024)); then
			GIT_INDEX_FILE="${index}" git -C "$1" reset --quiet HEAD -- "${path}"
			echo "$1/${path}" >>"${left_out}"
			report skipped "$1/${path}: over ${max_file_mb} MB" >&2
		fi
	done < <(GIT_INDEX_FILE="${index}" git -C "$1" diff --cached --name-only -z --diff-filter=AM HEAD)
	GIT_INDEX_FILE="${index}" git -C "$1" diff --cached --raw --diff-filter=A HEAD |
		awk -F '\t' '$1 ~ / 160000 / { print $2 }' | while IFS= read -r path; do
		echo "$1/${path}" >>"${nested:-/dev/null}"
		report nested "$1/${path}: a repository of its own; run wt sync inside it" >&2
	done
	tree="$(GIT_INDEX_FILE="${index}" git -C "$1" write-tree)"
	rm -f "${index}"
	git -C "$1" commit-tree "${tree}" -p HEAD -m "wip: uncommitted changes in $1"
}
clone="$(clone_id)"
# gap: not on GitHub (a real run's sync backs it up first). blocker: sync
# cannot back it up, so the clone stays.
missing=0 blockers=0
gap() {
	report missing "$1"
	missing=$((missing + 1))
}
blocker() {
	report blocked "$1"
	blockers=$((blockers + 1))
}

echo "checking GitHub holds everything in this clone"
while read -r branch tip <&3; do
	on_github "${tip}" && continue # its own name, a PR head, or a backup
	adds_nothing "${tip}" "${base}" && continue
	remote="refs/remotes/origin/${branch}"
	if git rev-parse --verify --quiet "${remote}" >/dev/null && adds_nothing "${tip}" "${remote}"; then continue; fi
	gap "branch ${branch}"
done 3< <(git for-each-ref --format='%(refname:short) %(objectname)' refs/heads)

while read -r stash <&3; do
	[[ -z "${stash}" ]] || on_github "${stash}" || gap "stash ${stash:0:12}"
done 3< <(git stash list --format=%H)

primary="$(worktrees | sed -n 1p | cut -d "${sep}" -f1)"
doomed=()
while IFS="${sep}" read -r dir branch head _ <&3; do
	[[ -d "${dir}" ]] || continue
	[[ "${dir}" == "${primary}" ]] || doomed+=("${dir}")
	[[ -n "${head}" ]] || continue # a bare primary has no HEAD of its own
	name="${branch:-detached-${head:0:12}}"
	[[ -n "${branch}" ]] || on_github "${head}" || gap "detached commit ${head:0:12} in ${dir}"
	[[ -n "$(git -C "${dir}" status --porcelain)" ]] || continue
	# The uncommitted work as it stands now must equal its backup.
	commit="$(snapshot "${dir}" 2>/dev/null)"
	ref="refs/remotes/origin/backup/${clone}/wip/${name}"
	if [[ -z "${clone}" || "$(git rev-parse --verify --quiet "${ref}^{tree}")" != "$(git rev-parse "${commit}^{tree}")" ||
	"$(git rev-parse --verify --quiet "${ref}^")" != "${head}" ]]; then
		gap "uncommitted changes in ${dir}"
	fi
done 3< <(worktrees)

while IFS= read -r path; do blocker "a file too big to back up: ${path}"; done <"${left_out}"

# Ignored paths, one "<worktree><sep><path>" per line; they are listed below.
# An ignored directory holding its own repository joins ${nested}.
ignored_list="$(mktemp)"
trap 'rm -f "${left_out}" "${nested}" "${ignored_list}"' EXIT
for dir in "${primary}" ${doomed[@]+"${doomed[@]}"}; do
	git -C "${dir}" status --porcelain=v1 --ignored 2>/dev/null | sed -n 's/^!! //p' | sed 's:/$::' |
		awk -v d="${dir}" -v s="${sep}" '{ print d s $0 }'
done >"${ignored_list}"
while IFS="${sep}" read -r dir path; do
	if [[ -e "${dir}/${path}/.git" ]]; then echo "${dir}/${path}" >>"${nested}"; fi
done <"${ignored_list}"

# Why repository $1 holds work its own GitHub lacks, or nothing when it holds
# none. "Unique" means what wt sync means by it (a PR head or a squash merge
# already counts as on GitHub), so ask sync itself, without pushing.
nested_unique() {
	local plan
	git -C "$1" remote get-url origin >/dev/null 2>&1 || { echo "it has no origin" && return; }
	plan="$(cd "$1" && "${HOME}/.local/share/dev-profile/bin/dev-profile-sync" --dry-run 2>&1)" || { echo "wt sync cannot check it" && return; }
	if grep -qE '^  (would push|would back up|diverged|skipped|nested) ' <<<"${plan}"; then
		echo "work its own GitHub lacks"
	fi
}

# A repository nested in a worktree goes to the Trash with it: fine when its
# own GitHub holds everything in it, a blocker otherwise.
while IFS= read -r path; do
	path="${path%/}"
	[[ -n "${path}" ]] || continue
	worktrees | cut -d "${sep}" -f1 | grep -qxF -- "${path}" && continue # one of this clone's worktrees
	why="$(nested_unique "${path}")"
	if [[ -n "${why}" ]]; then
		blocker "a separate repository at ${path}: ${why} (run wt sync there, or move it out)"
	else
		report nested "${path}: its own GitHub holds everything"
	fi
done < <(sed 's:/$::' "${nested}" | sort -u)

if [[ "${blockers}" -gt 0 ]]; then
	echo "Not retiring: ${blockers} item(s) above cannot be backed up. Nothing was deleted." >&2
	exit 1
fi
if [[ "${dry_run}" == true && "${missing}" -gt 0 ]]; then
	echo "Dry run: ${missing} item(s) above are not on GitHub yet; a real run backs them up, checks again, then retires"
	exit 0
fi
if [[ "${missing}" -gt 0 ]]; then
	echo "Not retiring: ${missing} item(s) above are not on GitHub. Nothing was deleted." >&2
	exit 1
fi

# Ignored files are not backed up anywhere; say which, so nothing surprises.
ignored="$(cut -d "${sep}" -f2 "${ignored_list}" | sort | uniq -c | sort -rn | awk 'NR <= 8 { print $2 }' | paste -sd, -)"
[[ -z "${ignored}" ]] || report ignored "not backed up, recoverable from the Trash: ${ignored}"

if [[ "${dry_run}" == true ]]; then
	echo "Dry run: GitHub holds everything; would move ${primary} and ${#doomed[@]} worktree(s) to the Trash"
	exit 0
fi
cd "$(dirname "${primary}")"
for dir in ${doomed[@]+"${doomed[@]}"} "${primary}"; do
	trash "${dir}" && report trashed "${dir}"
done
echo "Retired ${primary}; its work lives on GitHub (backup/${clone}/ for what had no branch)"
