#!/usr/bin/env bash
set -euo pipefail
# The files on this branch are the source (mise.toml); mise run generate is
# retired, so this wrapper is edited in place.

# The profile repo root, resolved through the installed bin symlink: the rc
# files live at config/<tool>rc there (the installed dir holds no rc files).
profile_repo="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd -P)"

# Where dev-profile-perl-tools-install puts the CPAN tools. Hooks and GUI editors
# may not have the shell's local::lib environment, so find them here.
perl_lib_root="${HOME}/perl5"
export PATH="${PATH}:${perl_lib_root}/bin"
export PERL5LIB="${perl_lib_root}/lib/perl5${PERL5LIB:+:${PERL5LIB}}"

# Fail the step, never skip it: a formatter or linter that silently does nothing is worse than none.
require_perl_tool() { # <tool>
	if ! command -v "$1" >/dev/null 2>&1; then
		echo "$1 is not installed; install it with: dev-profile-perl-tools-install" >&2
		exit 1
	fi
}

# The rc file for tool $1: the repo's own .<tool>rc at the root of the repo holding dir $2, else the profile's config/<tool>rc.
perl_config() { # <tool> <dir>
	local repo_root
	repo_root="$(git -C "$2" rev-parse --show-toplevel 2>/dev/null)" || repo_root="$2"
	if [[ -f "${repo_root}/.$1rc" ]]; then
		echo "${repo_root}/.$1rc"
	else
		# The tracked rc lives at config/<tool>rc in the profile repo
		# (the symlinked install dir holds no rc files).
		echo "${profile_repo}/config/$1rc"
	fi
}
# Install what is missing; repeat runs change nothing.
if command -v perltidy >/dev/null 2>&1 && command -v perlcritic >/dev/null 2>&1; then exit 0; fi
exec mise exec "perl@5.42.0.0" -- cpanm --quiet --notest --local-lib "${perl_lib_root}" Perl::Tidy Perl::Critic
