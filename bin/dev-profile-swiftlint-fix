#!/usr/bin/env bash
set -euo pipefail
# Sibling scripts are called by path: hk runs this without the bin dir on PATH.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if ! command -v swiftlint >/dev/null 2>&1; then
	exit 0
fi
if [[ $# -eq 0 ]]; then
	exit 0
fi
exec "${here}/dev-profile-fix" swiftlint --fix --quiet "$@"
