#!/usr/bin/env bash
set -euo pipefail
# Exit 0 when the current git repository belongs to Zach's accounts/orgs (or is a
# local/non-GitHub repository); exit 1 when it belongs to an external owner (or is
# a fork of an external owner's repository).
if [[ -n "${DEV_PROFILE_REPO_OWNED:-}" ]]; then
	[[ "${DEV_PROFILE_REPO_OWNED}" == "1" ]]
	exit $?
fi

git rev-parse --show-toplevel >/dev/null 2>&1 || exit 0

github_slug() { # <remote-url> -> owner/repo on github.com, or empty
	local url="${1:-}" path=""
	case "${url}" in
	https://github.com/* | http://github.com/*)
		path="${url#*github.com/}"
		;;
	git@github.com:* | ssh://git@github.com/*)
		path="${url#*github.com}"
		path="${path#:}"
		path="${path#/}"
		;;
	*)
		return 1
		;;
	esac
	path="${path%.git}"
	path="${path%/}"
	[[ "${path}" == */* ]] || return 1
	printf '%s\n' "${path}"
}

is_owned_owner() { # <owner>
	"$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/dev-profile-owners" "$1"
}

upstream_url="$(git config --get remote.upstream.url 2>/dev/null || true)"
if upstream_slug="$(github_slug "${upstream_url}")"; then
	upstream_owner="${upstream_slug%%/*}"
	is_owned_owner "${upstream_owner}" || exit 1
fi

origin_url="$(git config --get remote.origin.url 2>/dev/null || true)"
origin_slug="$(github_slug "${origin_url}" || true)"
# Non-GitHub or local remotes (including test fixtures) are treated as owned.
[[ -n "${origin_slug}" ]] || exit 0

origin_owner="${origin_slug%%/*}"
is_owned_owner "${origin_owner}" || exit 1

# A personal fork (zachbornheimer/<repo>) of an external upstream repository is
# still an unowned codebase whose upstream conventions win. Cache the parent owner
# in the git common dir so gh is asked at most once per clone.
#
# Only a GitHub login counts as an owner answer. gh prints the HTTP error body on stdout when
# it cannot read the repository — a checkout that was never authenticated, a rate limit, no
# network — so its output is an answer only when it is a login and gh exited 0: a repository
# gh cannot see stays classified by its own remote. A cache file holding anything but a login
# is ignored, so a clone poisoned by an older profile does not inherit that verdict.
login_re='^[A-Za-z0-9]([A-Za-z0-9-]{0,37}[A-Za-z0-9])?$'
common_dir="$(git rev-parse --git-common-dir 2>/dev/null || true)"
cache_file="${common_dir:+"${common_dir}/dev-profile-effective-owner"}"
effective_owner=""
if [[ -n "${cache_file}" && -r "${cache_file}" ]]; then
	effective_owner="$(<"${cache_file}")"
fi
[[ "${effective_owner}" =~ ${login_re} ]] || effective_owner=""
if [[ -z "${effective_owner}" ]] && command -v gh >/dev/null 2>&1; then
	if effective_owner="$(gh api "repos/${origin_slug}" \
		--jq 'if .fork and .parent.owner.login then .parent.owner.login else .owner.login end' \
		2>/dev/null)"; then
		[[ "${effective_owner}" =~ ${login_re} ]] || effective_owner=""
	else
		effective_owner=""
	fi
	if [[ -n "${effective_owner}" && -n "${cache_file}" ]]; then
		printf '%s\n' "${effective_owner}" >"${cache_file}" 2>/dev/null || true
	fi
fi

if [[ -n "${effective_owner}" ]]; then
	is_owned_owner "${effective_owner}" || exit 1
fi
exit 0
