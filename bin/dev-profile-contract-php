#!/usr/bin/env bash
set -euo pipefail
# Code generated by `mise run generate`. DO NOT EDIT.
# Source of truth: profile.pkl

# Contract adapter: php. Exit 0 ok, 1 failed, 3 nothing to do.
verb="${1:?usage: dev-profile-contract-php <verb>}"
failed=0

# Run one tool; record a failure and keep going so every check reports.
step() {
	echo "+ $*" >&2
	"$@" || failed=1
}

nothing_to_do() {
	exit 3
}

has_script() {
	jq -e --arg name "$1" '.scripts[$name] // empty' composer.json >/dev/null
}

case "${verb}" in
lint) step composer validate --no-check-publish ;;
test)
	if has_script test; then
		step composer run-script test
	elif [[ -x vendor/bin/phpunit ]]; then
		step vendor/bin/phpunit
	else
		nothing_to_do
	fi
	;;
scan)
	# `composer audit --locked` needs composer.lock; without one there is nothing to audit.
	if [[ -f composer.lock ]]; then
		step composer audit --locked
	else
		nothing_to_do
	fi
	;;
*) nothing_to_do ;;
esac
exit "${failed}"
