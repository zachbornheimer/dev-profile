#!/Users/zbornheimer/.local/bin/python3
"""HTTP front for `omp auth-gateway stdio`, so ocr can call omp's @default model.

ocr speaks OpenAI HTTP, including tool calls. omp's auth-gateway already
translates that, including tools, and resolves @default. This process only
turns HTTP into the gateway's JSON-lines stdio.
"""

import json
import os
import shutil
import subprocess
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HOST = "127.0.0.1"
PORT = 18765
OMP = (
    shutil.which("omp")
    or next(
        (p for p in (os.path.expanduser("~/.local/bin/omp"), "/opt/homebrew/bin/omp") if os.access(p, os.X_OK)),
        "omp",
    )
)

_lock = threading.Lock()
_proc = None
_next_id = 1


def _start():
    proc = subprocess.Popen(
        [OMP, "auth-gateway", "stdio"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        bufsize=1,
    )
    ready = json.loads(proc.stdout.readline())
    if not ready.get("ready"):
        proc.kill()
        raise RuntimeError("omp auth-gateway did not become ready")
    return proc


def _session():
    global _proc
    if _proc is None or _proc.poll() is not None:
        _proc = _start()
    return _proc


def forward(path, body):
    global _proc, _next_id
    with _lock:
        proc = _session()
        request_id = _next_id
        _next_id += 1
        proc.stdin.write(json.dumps({"id": request_id, "path": path, "body": body}) + "\n")
        proc.stdin.flush()
        line = proc.stdout.readline()
        if line == "":
            _proc = None
            raise RuntimeError("omp auth-gateway closed")
        reply = json.loads(line)
        if reply.get("id") != request_id:
            _proc = None
            raise RuntimeError("omp auth-gateway replied out of order")
        return int(reply.get("status") or 502), reply.get("body") or {"error": {"message": "empty gateway body"}}


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        return

    def _send(self, status, payload):
        raw = json.dumps(payload).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(raw)))
        self.end_headers()
        self.wfile.write(raw)

    def do_GET(self):
        path = self.path.split("?", 1)[0]
        if path.rstrip("/") == "/healthz":
            self._send(200, {"ok": True})
            return
        try:
            status, body = forward(path, None)
        except Exception as error:  # noqa: BLE001 — returned to ocr as the provider error
            self._send(502, {"error": {"message": str(error)}})
            return
        self._send(status, body)

    def do_POST(self):
        path = self.path.split("?", 1)[0]
        length = int(self.headers.get("Content-Length") or "0")
        try:
            body = json.loads(self.rfile.read(length) or b"{}")
        except json.JSONDecodeError:
            self._send(400, {"error": {"message": "invalid JSON"}})
            return
        try:
            status, reply = forward(path, body)
        except Exception as error:  # noqa: BLE001
            self._send(502, {"error": {"message": str(error)}})
            return
        self._send(status, reply)


if __name__ == "__main__":
    ThreadingHTTPServer((HOST, PORT), Handler).serve_forever()
