#!/usr/bin/env bash
set -euo pipefail
# Code generated by `mise run generate`. DO NOT EDIT.
# Source of truth: profile.pkl

# Contract adapter: swift. Exit 0 ok, 1 failed, 3 nothing to do.
verb="${1:?usage: dev-profile-contract-swift <verb>}"
failed=0

# Run one tool; record a failure and keep going so every check reports.
step() {
	echo "+ $*" >&2
	"$@" || failed=1
}

nothing_to_do() {
	exit 3
}

case "${verb}" in
build) step swift build ;;
test) step swift test ;;
*) nothing_to_do ;;
esac
exit "${failed}"
