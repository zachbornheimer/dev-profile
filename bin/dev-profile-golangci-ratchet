#!/usr/bin/env bash
set -euo pipefail
# Push gate for golangci-lint. dev-profile-changed-files hands this script only
# the Go files the push introduces, so a push that introduces none never reaches
# it and old debt in untouched files never blocks. Each file is linted by the
# module that owns it — its nearest go.mod ancestor — because golangci-lint
# needs the module's type context: a whole-tree run from a repository root
# without a go.mod is a typechecking error, not a verdict. Within a module,
# only issues the branch adds relative to the default branch of the remote it
# mirrors (upstream for a fork, else origin) are reported, so debt in files the
# push re-touched but did not write still passes. Without a base ref (no
# remote, fresh clone) the introduced files are linted in full.

fix=(--fix=false)
if [[ "${1:-}" == "--fix" ]]; then
	fix=(--fix)
	shift
fi
((${#} > 0)) || exit 0

root="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
root="$(cd "${root}" && pwd -P)"

mirror_base="$(cd "$(dirname "$0")" && pwd -P)/dev-profile-mirror-base"
base="$("${mirror_base}" 2>/dev/null || true)"
new_from=()
if [[ -n "${base}" ]]; then
	if git merge-base "${base}" HEAD >/dev/null 2>&1; then
		new_from=(--new-from-merge-base="${base}")
	else
		echo "golangci-ratchet: ${base} shares no history with HEAD; linting introduced files in full" >&2
		base=""
	fi
fi
if [[ -z "${base}" ]]; then
	echo "golangci-ratchet: no default branch of a mirrored remote; linting introduced files in full" >&2
fi

module_of() { # <absolute-file> -> the module dir owning it, or nothing
	local dir
	dir="$(dirname "$1")"
	while :; do
		if [[ -f "${dir}/go.mod" ]]; then
			printf '%s\n' "${dir}"
			return 0
		fi
		[[ "${dir}" == "${root}" || "${dir}" == / ]] && return 1
		dir="$(dirname "${dir}")"
	done
}

declare -A files_by_module=()
for file in "$@"; do
	abs="$(cd "$(dirname "${file}")" && pwd -P)/$(basename "${file}")"
	if module="$(module_of "${abs}")"; then
		files_by_module["${module}"]+="${abs}"$'\n'
	else
		echo "golangci-ratchet: no Go module owns ${file}; skipping (no type context to lint in)" >&2
	fi
done

status=0
for module in $(printf '%s\n' "${!files_by_module[@]}" | sort); do
	lint_files=()
	while IFS= read -r file; do
		[[ -n "${file}" ]] && lint_files+=("${file}")
	done <<<"${files_by_module["${module}"]}"
	(
		cd "${module}"
		# A go.work that does not list this module breaks ./... resolution for
		# it; lint the module on its own.
		if [[ -z "${GOWORK:-}" ]]; then
			workdir="${module}"
			while :; do
				[[ -f "${workdir}/go.work" ]] && break
				[[ "${workdir}" == "${root}" || "${workdir}" == / ]] && {
					workdir=""
					break
				}
				workdir="$(dirname "${workdir}")"
			done
			if [[ -n "${workdir}" ]]; then
				rel="${module#"${workdir}"}"
				rel="${rel#/}"
				members="$(cd "${workdir}" && go work edit -json |
					jq -r '.Use[]?.DiskPath | sub("^\\./"; "") | sub("/$"; "") | if . == "" then "." else . end')"
				grep -qxF -- "${rel:-.}" <<<"${members}" || export GOWORK=off
			fi
		fi
		exec golangci-lint run "${fix[@]}" --allow-parallel-runners "${new_from[@]}" -- "${lint_files[@]}"
	) || status=1
done
exit "${status}"
