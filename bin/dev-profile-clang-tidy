#!/usr/bin/env bash
set -euo pipefail
# Code generated by `mise run generate`. DO NOT EDIT.
# Source of truth: profile.pkl

# clang-tidy modernize-* findings, judged at push. Needs compile_commands.json beside the file, in a
# parent directory, or in a build/ directory; without one there is nothing to do.
(($#)) || exit 0
command -v clang-tidy >/dev/null 2>&1 || exit 0
root="$(cd "$(git rev-parse --show-toplevel)" && pwd -P)"

# The nearest directory at or above file $1, up to the repo root, that holds a
# file matching glob $2. Prints nothing when there is none.
nearest_up() {
	local dir
	dir="$(cd "$(dirname "$1")" && pwd -P)"
	while :; do
		if compgen -G "${dir}/$2" >/dev/null; then
			echo "${dir}"
			return 0
		fi
		if [[ "${dir}" == "${root}" || "${dir}" == / ]]; then return 0; fi
		dir="$(dirname "${dir}")"
	done
}

# Absolute path of a staged file.
absolute() {
	echo "$(cd "$(dirname "$1")" && pwd -P)/$(basename "$1")"
}

database_dir() {
	local dir
	dir="$(nearest_up "$1" compile_commands.json)"
	if [[ -n "${dir}" ]]; then
		echo "${dir}"
		return 0
	fi
	dir="$(nearest_up "$1" build/compile_commands.json)"
	if [[ -n "${dir}" ]]; then echo "${dir}/build"; fi
}

failed=0
for file in "$@"; do
	abs="$(absolute "${file}")"
	db="$(database_dir "${abs}")"
	[[ -n "${db}" ]] || continue
	# Exit is non-zero for files outside the database; only a modernize finding fails.
	out="$(clang-tidy -p "${db}" --checks='-*,modernize-*' --quiet "${abs}" 2>&1 || true)"
	if grep -Eq 'warning: .*\[modernize-' <<<"${out}"; then
		echo "${out}" >&2
		failed=1
	fi
done
exit "${failed}"
