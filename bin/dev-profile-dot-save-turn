#!/usr/bin/env bash
# Save a turn's checkpoint with provenance, then report what it really captured.
#
# `mise dot save` records a snapshot of every tracked `autosave = true` path,
# whatever the caller names: the `[PATH]…` argument only force-includes
# `autosave = false` entries (mise `history/checkpoint.rs`, `manual_plan`). A
# checkpoint therefore cannot be a delta, so this wrapper makes it an honest
# snapshot instead: it stamps the checkpoint as the agent's (`trigger = agent`,
# `--task <ticket>`), reads the checkpoint's own change set back, and splits it
# into the paths the turn named and the paths it swept in from elsewhere.
#
# The reply quotes the `captured-not-authored:` lines verbatim; a sweep is
# reported, never refused — the watcher would capture the same content seconds
# later, and a refusal would only deadlock a busy machine.
#
# Usage: dev-profile-dot-save-turn <ticket> <path>... [--description TEXT]
# Exit: 0 only when the saved checkpoint and its complete change set were
# verified. A failed read after save is non-zero: the checkpoint may exist, but
# nothing is printed as captured.
set -uo pipefail

usage() { sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; }

ticket=""
description=""
declare -a named=()

while [ $# -gt 0 ]; do
	case "$1" in
	--description | -d)
		description=${2:-}
		shift 2
		;;
	-h | --help)
		usage
		exit 0
		;;
	-*)
		printf 'dev-profile-dot-save-turn: unexpected argument %s\n' "$1" >&2
		exit 64
		;;
	*)
		if [ -z "$ticket" ]; then ticket=$1; else named+=("$1"); fi
		shift
		;;
	esac
done

if ! printf '%s' "$ticket" | grep -Eq '^[A-Za-z][A-Za-z0-9]*-[1-9][0-9]*$'; then
	printf 'dev-profile-dot-save-turn: first argument must be a ticket id like ZYS-9739 (got %s)\n' "${ticket:-none}" >&2
	exit 64
fi
if [ ${#named[@]} -eq 0 ]; then
	printf 'dev-profile-dot-save-turn: name at least one tracked path this turn wrote\n' >&2
	exit 64
fi

# mise reports captured paths in `~/...` form; compare in that form.
mise_path() {
	local p=$1
	while [ "${p%/}" != "$p" ] && [ "$p" != "/" ]; do p=${p%/}; done
	case "$p" in
	"$HOME") printf '~' ;;
	"$HOME"/*) printf '~%s' "${p#"$HOME"}" ;;
	/*) printf '%s' "$p" ;;
	*) printf '~/%s' "${p#./}" ;;
	esac
}

declare -a named_mise=()
for p in "${named[@]}"; do named_mise+=("$(mise_path "$p")"); done

# Save emits the created checkpoint's id. Quiet settings must not hide that
# receipt. Reading `latest` instead races the watcher and other agent turns.
description=${description:-"agent: $ticket"}
if ! save_out=$(MISE_QUIET=0 MISE_SILENT=0 MISE_LOG_LEVEL=info mise dot save "${named[@]}" --trigger agent --task "$ticket" -d "$description" 2>&1); then
	printf '%s\n' "$save_out" >&2
	printf 'dev-profile-dot-save-turn: mise refused the save; no capture is verified\n' >&2
	exit 1
fi

unverified() {
	printf '%s\n' "$save_out" >&2
	printf 'dev-profile-dot-save-turn: checkpoint save returned but %s; report it as unverified\n' "$1" >&2
	exit 1
}

# The index is one JSON file, not a traversal of every checkpoint's metadata.
# This cache layout belongs to mise history schema 2. Refuse an incompatible
# record rather than falling back to an unbounded history list/show command.
id=$(printf '%s\n' "$save_out" | sed -nE 's/^.*history: saved checkpoint ([0-9]+): .*$/\1/p')
[[ "$id" =~ ^[1-9][0-9]*$ ]] || unverified "no unambiguous shared checkpoint receipt was emitted"
state=${MISE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/mise}
index="$state/history/index"
entry=$(jq -ce --argjson id "$id" '[.entries[] | select(.id == $id)] | if length == 1 then .[0] else error("ambiguous checkpoint id") end' "$index/checkpoints.json" 2>/dev/null) || unverified "its index entry is unreadable"
uuid=$(printf '%s' "$entry" | jq -r '.uuid')
[[ "$uuid" =~ ^[a-f0-9]{40}$ ]] || unverified "its checkpoint identity is unsupported"
checkpoint=$(jq -ce --arg uuid "$uuid" --arg ticket "$ticket" --arg description "$description" '
	select(.schema_version == 2 and .uuid == $uuid and .trigger == "agent"
		and .task == $ticket and .description_source == "agent"
		and .description == $description and .tree.available == true
		and .changes.truncated == false)
	| select([.changes.modified, .changes.added, .changes.removed]
		| all(.[]; . == null or (type == "array" and all(.[]; type == "string"))))
' "$index/meta/$uuid.json" 2>/dev/null) || unverified "its complete checkpoint provenance is unreadable or mismatched"

printf 'checkpoint %s  trigger=agent  task=%s  description_source=agent\n' "$id" "$ticket"

declare -a authored=() swept=()
while IFS= read -r path; do
	[ -n "$path" ] || continue
	seen=0
	for n in "${named_mise[@]}"; do [ "$path" = "$n" ] && seen=1 && break; done
	if [ "$seen" -eq 1 ]; then authored+=("$path"); else swept+=("$path"); fi
done < <(printf '%s' "$checkpoint" | jq -r '[(.changes.modified // [])[], (.changes.added // [])[], (.changes.removed // [])[]] | unique[]')

printf 'authored:\n'
if [ ${#authored[@]} -eq 0 ]; then printf '  (none: no named path changed since the last checkpoint)\n'; fi
for p in "${authored[@]}"; do printf '  %s\n' "$p"; done

printf 'captured-not-authored:\n'
if [ ${#swept[@]} -eq 0 ]; then printf '  (none)\n'; fi
for p in "${swept[@]}"; do printf '  %s\n' "$p"; done

exit 0
