#!/usr/bin/env bash
# Daily: fast-forward every zachbornheimer fork's mirror branch to upstream, then
# start each managed fork's build. The build checks the merged tree, publishes a
# prerelease, installs it on CI runners with mise and only then promotes it;
# `mise up` (omp-daily-sync, 05:00) installs what was promoted.
#
# The fork tool (~/.omp/agent/tools/fork) owns both steps; this is its launchd entry.
# A mirror that has its own commits is never rewritten: `fork sync` reports it.
# After the sync, the fork report lists every fork's mirror, last build and install, and
# `fork doctor` checks every fork's layout. A finding is printed and fails the run, so
# drift surfaces within a day instead of waiting for the next fast-forward to refuse.
# Exit: 0 every mirror is current and no fork violates the layout; 1 some mirror could
# not fast-forward; 2 tool error; 3 a fork violates the layout (`fork doctor`).
set -euo pipefail

PATH="${FORK_SYNC_PATH:-$HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin}:$PATH"
export PATH

cli="$HOME/.omp/agent/tools/fork/cli.ts"
command -v bun >/dev/null 2>&1 || {
	echo "fork sync: bun is required" >&2
	exit 2
}
[[ -f "${cli}" ]] || {
	echo "fork sync: ${cli} is missing" >&2
	exit 2
}

# A cold network or a TLS stall on the first run of the day is not a fork failure: the
# sync is fast-forward only and idempotent, so retry a few times before a tool error.
out=""
for attempt in 1 2 3; do
	out="$(bun "${cli}" sync)" && break
	rc=$?
	if [[ ${attempt} -eq 3 ]]; then
		echo "${out}" >&2
		echo "fork sync: sync failed ${attempt} times (last exit ${rc})" >&2
		exit 2
	fi
	echo "fork sync: sync failed (exit ${rc}); retrying in $((attempt * 10))s" >&2
	sleep $((attempt * 10))
done
echo "${out}"

# Managed forks build; contribution-only forks only sync. GitHub's own schedule is
# best-effort and can drop a slot under load, so this clock dispatches both: the build
# right after the fast-forward, and the GitHub-side sync for forks that have no build.
bun "${cli}" status | jq -r '.[] | "\(.repo)\t\(.managed)"' | while IFS="$(printf '\t')" read -r repo managed; do
	if [ "${managed}" = "true" ]; then wf=fork.yml; else wf=fork-sync.yml; fi
	if gh workflow run "${wf}" -R "zachbornheimer/${repo}" --ref fork >/dev/null 2>&1; then
		echo "fork sync: dispatched ${wf} for ${repo}"
	else
		echo "fork sync: could not dispatch ${wf} for ${repo}" >&2
	fi
done

# The table is a log of health, not a gate: a stale install or a missing release
# does not change the exit code. Exit 1 stays reserved for a mirror that could not
# fast-forward.
report="$HOME/.omp/agent/tools/fork/report.ts"
if [[ -f "${report}" ]]; then
	bun "${report}" || echo "fork sync: report failed" >&2
fi

if echo "${out}" | jq -e 'any(.[]; .action == "refuse" or (.action == "fast_forward" and (.detail | startswith("fast-forwarded") | not)))' >/dev/null; then
	echo "fork sync: some mirrors did not fast-forward (see above)" >&2
	exit 1
fi

# doctor changes nothing. A finding names the one thing wrong and the command that
# fixes it; exiting here is what makes the daily job notice.
doctor="$(bun "${cli}" doctor)" || {
	echo "${doctor}" >&2
	exit 2
}
echo "${doctor}"
if echo "${doctor}" | jq -e 'any(.[]; .findings | length > 0)' >/dev/null; then
	echo "${doctor}" | jq -r '.[] | select(.findings | length > 0) | .repo as $repo | .findings[] | "fork sync: \($repo) \(.check): \(.detail)"' >&2
	exit 3
fi
