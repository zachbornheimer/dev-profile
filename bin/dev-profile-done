#!/usr/bin/env bash
set -euo pipefail
# Code generated by `mise run generate`. DO NOT EDIT.
# Source of truth: profile.pkl

# Fetch, fast-forward a default branch that is strictly behind, and restack.
# Then commit, push, open draft pull requests, and prune.
#   --no-commit  skip branches with uncommitted work, stashes, and detached HEAD
#   --no-push    do not push
#   --no-pr      do not open pull requests
#   --no-prune   do not delete local or origin refs
#   --drop       Trash the clone when every tip is on origin
#   --dry-run    print the plan; git fetch is the only change
# --commit, --push, --pr, and --prune are accepted and are already the default.
usage() {
	echo "usage: dev-profile-done [--dry-run] [--no-commit] [--no-push] [--no-pr] [--no-prune] [--drop]" >&2
}

dry_run=false
do_commit=true
do_push=true
do_pr=true
do_prune=true
do_drop=false
while [[ $# -gt 0 ]]; do
	case "$1" in
	--dry-run) dry_run=true ;;
	--commit) do_commit=true ;;
	--push) do_push=true ;;
	--pr) do_pr=true ;;
	--prune) do_prune=true ;;
	--no-commit) do_commit=false ;;
	--no-push) do_push=false ;;
	--no-pr) do_pr=false ;;
	--no-prune) do_prune=false ;;
	--drop) do_drop=true ;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		usage
		exit 2
		;;
	esac
	shift
done

# This command parks unfinished work; hk would block snapshot commits and stale-branch pushes.
export HK=0
export GIT_TERMINAL_PROMPT=0
max_file_mb="${DEV_PROFILE_SYNC_MAX_FILE_MB:-50}"
failures=0

git rev-parse --git-dir >/dev/null 2>&1 || {
	echo "dev-profile-done must run inside a git clone" >&2
	exit 1
}
git remote get-url origin >/dev/null 2>&1 || {
	echo "origin is required" >&2
	exit 1
}
common="$(git rev-parse --path-format=absolute --git-common-dir)"
primary="$(cd "$(dirname "${common}")" && pwd -P)"
cd "${primary}" || exit 1

state="$(mktemp -d)"
root_state="${state}"
trap 'rm -rf "${root_state}"' EXIT
for f in skipped conflicts pushed backed planned unpushed hold blockers worktrees pretip reserved failures; do
	: >"${state}/${f}"
done

worker_count() {
	local jobs="${DEV_PROFILE_DONE_JOBS:-}" limit="${DEV_PROFILE_DONE_MAX_JOBS:-8}" cpus
	if [[ -n "${jobs}" && "${jobs}" =~ ^[1-9][0-9]*$ ]]; then
		printf '%s\n' "${jobs}"
		return 0
	fi
	cpus="$(getconf _NPROCESSORS_ONLN 2>/dev/null || nproc 2>/dev/null || echo 4)"
	[[ "${cpus}" =~ ^[1-9][0-9]*$ ]] || cpus=4
	if [[ "${limit}" =~ ^[1-9][0-9]*$ ]] && ((cpus > limit)); then
		cpus="${limit}"
	fi
	printf '%s\n' "${cpus}"
}
max_jobs="$(worker_count)"

with_lock() {
	local lock="${root_state}/lock.$1" rc=0
	shift
	while ! mkdir "${lock}" 2>/dev/null; do
		sleep 0.01
	done
	"$@" || rc=$?
	rmdir "${lock}" 2>/dev/null || true
	return "${rc}"
}

fail_one() {
	if [[ "${state}" != "${root_state}" ]]; then
		printf '1\n' >>"${state}/failures"
	else
		failures=$((failures + 1))
	fi
}

wave_dir=""
wave_count=0
wave_pids=()

wave_start() {
	wave_dir="$(mktemp -d "${root_state}/wave.XXXXXX")"
	wave_count=0
	wave_pids=()
}

wave_spawn() {
	local slot="${wave_dir}/${wave_count}" f
	wave_count=$((wave_count + 1))
	mkdir -p "${slot}"
	for f in skipped conflicts pushed backed planned unpushed hold reserved; do
		cp "${root_state}/${f}" "${slot}/${f}"
	done
	for f in blockers failures out; do
		: >"${slot}/${f}"
	done
	for f in worktrees pretip restack-stopped; do
		if [[ -f "${root_state}/${f}" ]]; then
			ln -s "${root_state}/${f}" "${slot}/${f}"
		fi
	done
	if ((${#wave_pids[@]} >= max_jobs)); then
		wait "${wave_pids[0]}" || true
		wave_pids=("${wave_pids[@]:1}")
	fi
	(
		state="${slot}"
		"$@" >"${slot}/out"
	) &
	wave_pids+=("$!")
}

wave_finish() {
	local pid i slot f line
	if ((${#wave_pids[@]} > 0)); then
		for pid in "${wave_pids[@]}"; do
			wait "${pid}" || true
		done
	fi
	for ((i = 0; i < wave_count; i++)); do
		slot="${wave_dir}/${i}"
		if [[ -s "${slot}/out" ]]; then
			cat "${slot}/out"
		fi
		for f in skipped conflicts pushed backed planned unpushed hold; do
			while IFS= read -r line; do
				[[ -z "${line}" ]] && continue
				mark_once "${root_state}/${f}" "${line}"
			done <"${slot}/${f}"
		done
		if [[ -s "${slot}/blockers" ]]; then
			cat "${slot}/blockers" >>"${root_state}/blockers"
		fi
		while IFS= read -r line; do
			[[ -z "${line}" ]] && continue
			failures=$((failures + 1))
		done <"${slot}/failures"
	done
	rm -rf "${wave_dir}"
	wave_dir=""
	wave_count=0
	wave_pids=()
}

report() { printf '  %-16s %s\n' "$1" "$2"; }
say() {
	local verb="$1"
	shift
	if [[ "${dry_run}" == true ]]; then verb="would-${verb}"; fi
	report "${verb}" "$*"
}
marked() { grep -Fxq -- "$1" "$2"; }
mark_once() {
	if marked "$2" "$1"; then return 0; fi
	printf '%s\n' "$2" >>"$1"
}

clone_id() { git config --get dev-profile.sync-clone || :; }

record_tips() {
	local branch remote
	: >"${state}/pretip"
	while IFS= read -r branch; do
		eligible "${branch}" || continue
		remote=""
		if git rev-parse --verify --quiet "refs/remotes/origin/${branch}" >/dev/null; then
			remote="$(git rev-parse "refs/remotes/origin/${branch}")"
		fi
		printf '%s\t%s\t%s\n' "${branch}" "$(git rev-parse "refs/heads/${branch}")" "${remote}" >>"${state}/pretip"
	done < <(each_branch)
}

pretip_of() {
	awk -F '\t' -v b="$1" '$1 == b { print $2; exit }' "${state}/pretip"
}

# 0 when a skipped checkout still has uncommitted work that rebase cannot move.
restack_blocked() {
	local branch
	while IFS=$'\t' read -r _ branch _; do
		if [[ -z "${branch}" ]]; then
			if marked "detached" "${state}/skipped"; then return 0; fi
			continue
		fi
		if marked "${branch}" "${state}/skipped"; then return 0; fi
	done <"${state}/worktrees"
	return 1
}

prunable_worktree() {
	local path="$1" branch="$2" locked="$3" tip remote
	[[ "${path}" == "${primary}" ]] && return 1
	[[ -z "${branch}" ]] && return 1
	[[ "${branch}" == "${default_branch}" ]] && return 1
	case "${branch}" in
	backup/*) return 1 ;;
	esac
	if marked "${branch}" "${state}/skipped"; then return 1; fi
	if marked "${branch}" "${state}/unpushed"; then return 1; fi
	[[ "${locked}" == locked ]] && return 1
	tip="$(git -C "${path}" rev-parse HEAD)"
	remote=""
	if git rev-parse --verify --quiet "refs/remotes/origin/${branch}" >/dev/null; then
		remote="$(git rev-parse "refs/remotes/origin/${branch}")"
	fi
	if [[ -n "${remote}" && "${tip}" == "${remote}" ]]; then return 0; fi
	if marked "${branch}" "${state}/conflicts" && contained "${tip}"; then return 0; fi
	if [[ "${dry_run}" == true && "${do_push}" == true ]] &&
		{
			marked "${branch}" "${state}/planned" || marked "${branch}" "${state}/pushed"
		}; then
		return 0
	fi
	return 1
}

write_worktrees() {
	git worktree list --porcelain | awk '
    function emit() { if (path != "") print path "\t" branch "\t" locked }
    /^worktree / { emit(); path = substr($0, 10); branch = ""; locked = "" }
    /^branch refs\/heads\// { branch = substr($0, 19) }
    /^locked/ { locked = "locked" }
    END { emit() }
  ' >"${state}/worktrees"
}

worktree_of() {
	awk -F '\t' -v b="$1" '$2 == b { print $1; exit }' "${state}/worktrees"
}

eligible() {
	[[ "$1" == "${default_branch}" ]] && return 1
	case "$1" in
	backup/*) return 1 ;;
	esac
	if marked "$1" "${state}/skipped"; then return 1; fi
	return 0
}

diverged() {
	local upstream="refs/remotes/origin/$1" local_tip remote_tip
	git rev-parse --verify --quiet "${upstream}" >/dev/null || return 1
	local_tip="$(git rev-parse "refs/heads/$1")"
	remote_tip="$(git rev-parse "${upstream}")"
	[[ "${local_tip}" == "${remote_tip}" ]] && return 1
	if git merge-base --is-ancestor "${local_tip}" "${remote_tip}"; then return 1; fi
	if git merge-base --is-ancestor "${remote_tip}" "${local_tip}"; then return 1; fi
	return 0
}

contained() {
	[[ -n "$(git for-each-ref --contains "$1" --count=1 refs/remotes/origin)" ]]
}

free_name() {
	local base="$1" name="$1" n=2
	while git show-ref --verify --quiet "refs/heads/${name}" ||
		marked "${name}" "${state}/planned" || marked "${name}" "${state}/hold" ||
		marked "${name}" "${state}/reserved"; do
		name="${base}-${n}"
		n=$((n + 1))
	done
	printf '%s\n' "${name}"
}

# 0 when this worktree holds a nested repo or a file over the size limit.
tree_blocked() {
	local dir="$1" rel bytes max blocked=false
	max=$((max_file_mb * 1024 * 1024))
	while IFS= read -r -d '' rel; do
		[[ -z "${rel}" ]] && continue
		if [[ -e "${dir}/${rel}/.git" ]]; then
			report nested "${dir}/${rel}"
			blocked=true
		fi
	done < <(git -C "${dir}" ls-files -z --others --directory --exclude-standard)
	while IFS= read -r rel; do
		[[ -z "${rel}" ]] && continue
		# A gitlink's commit is not in this repo, so cat-file -e fails. rev-parse
		# still sees the tree entry.
		if git -C "${dir}" rev-parse -q --verify "HEAD:${rel}" >/dev/null; then
			if [[ ! -e "${dir}/${rel}" ]]; then
				report skip "${dir}/${rel}: submodule checkout missing"
				blocked=true
			fi
			continue
		fi
		report nested "${dir}/${rel}"
		blocked=true
	done < <(git -C "${dir}" ls-files -s | awk -F '\t' '$1 ~ /^160000 / { print $2 }')
	while IFS= read -r -d '' rel; do
		[[ -f "${dir}/${rel}" ]] || continue
		bytes="$(wc -c <"${dir}/${rel}")"
		bytes="${bytes#"${bytes%%[![:space:]]*}"}"
		if ((bytes > max)); then
			report skip "${dir}/${rel}: over ${max_file_mb} MB"
			blocked=true
		fi
	done < <(git -C "${dir}" ls-files -z --others --exclude-standard)
	[[ "${blocked}" == true ]]
}

commit_tree() {
	local path="$1" label="$2"
	if tree_blocked "${path}"; then
		report skip "${label}: left uncommitted"
		mark_once "${state}/skipped" "${label}"
		return 1
	fi
	if ! git -C "${path}" add -A; then
		report skip "${label}: commit failed"
		mark_once "${state}/skipped" "${label}"
		return 1
	fi
	if [[ -n "$(git -C "${path}" status --porcelain)" ]] &&
		! git -C "${path}" commit -q --no-verify -m "chore: save uncommitted work on ${label}"; then
		report skip "${label}: commit failed"
		mark_once "${state}/skipped" "${label}"
		return 1
	fi
}

commit_default_dirty() {
	local path="$1" name
	if [[ "${do_commit}" != true ]]; then
		report skip "${default_branch}: uncommitted work"
		mark_once "${state}/skipped" "${default_branch}"
		return 0
	fi
	name="$(free_name wip)"
	say commit "${path}: uncommitted work onto ${name}"
	mark_once "${state}/planned" "${name}"
	mark_once "${state}/hold" "${name}"
	[[ "${dry_run}" == false ]] || return 0
	with_lock config git -C "${path}" switch -c "${name}"
	if ! commit_tree "${path}" "${name}"; then
		with_lock config git -C "${path}" switch "${default_branch}" || true
		with_lock config git -C "${path}" branch -D "${name}" || true
		mark_once "${state}/skipped" "${default_branch}"
		return 0
	fi
	with_lock config git -C "${path}" switch "${default_branch}"
}

commit_branch_dirty() {
	local path="$1" branch="$2"
	if [[ "${do_commit}" != true ]]; then
		report skip "${branch}: uncommitted work"
		mark_once "${state}/skipped" "${branch}"
		return 0
	fi
	if tree_blocked "${path}"; then
		report skip "${branch}: left uncommitted"
		mark_once "${state}/skipped" "${branch}"
		return 0
	fi
	say commit "${branch}: uncommitted work"
	mark_once "${state}/planned" "${branch}"
	[[ "${dry_run}" == false ]] || return 0
	git -C "${path}" add -A
	git -C "${path}" commit -q --no-verify -m "chore: save uncommitted work on ${branch}" || {
		report skip "${branch}: commit failed"
		mark_once "${state}/skipped" "${branch}"
	}
}

commit_detached() {
	local path="$1" pre_name="${2:-}" sha name base stashed=false
	if [[ "${do_commit}" != true ]]; then
		report skip "${path}: detached HEAD"
		mark_once "${state}/skipped" "detached"
		return 0
	fi
	if tree_blocked "${path}"; then
		report skip "${path}: left uncommitted"
		mark_once "${state}/skipped" "detached"
		return 0
	fi
	# Name the branch from the commit the edit sits on. Aborting a rebase
	# checks out orig-head and would discard that edit, so a dry-run stops
	# here and a real run stashes before the abort.
	if [[ -n "${pre_name}" ]]; then
		name="${pre_name}"
	else
		sha="$(git -C "${path}" rev-parse --short=12 HEAD)"
		name="$(free_name "detached-${sha}")"
	fi
	say commit "${path}: detached HEAD onto ${name}"
	mark_once "${state}/planned" "${name}"
	mark_once "${state}/hold" "${name}"
	[[ "${dry_run}" == false ]] || return 0
	base="$(git -C "${path}" rev-parse HEAD)"
	if [[ -d "$(git -C "${path}" rev-parse --git-path rebase-merge)" || -d "$(git -C "${path}" rev-parse --git-path rebase-apply)" ]]; then
		if [[ -n "$(git -C "${path}" status --porcelain)" ]]; then
			if ! with_lock stash git -C "${path}" stash push -u -q -m "wt done before rebase abort"; then
				report skip "${path}: could not stash before rebase abort"
				mark_once "${state}/skipped" "detached"
				return 0
			fi
			stashed=true
		fi
		if ! git -C "${path}" rebase --abort; then
			if [[ "${stashed}" == true ]]; then
				report skip "${path}: rebase still in progress; edit is in the stash"
			else
				report skip "${path}: rebase in progress"
			fi
			mark_once "${state}/skipped" "detached"
			return 0
		fi
	fi
	if ! with_lock config git -C "${path}" switch -c "${name}" "${base}"; then
		if [[ "${stashed}" == true ]]; then
			report skip "${path}: could not leave detached HEAD; edit is in the stash"
		else
			report skip "${path}: could not leave detached HEAD"
		fi
		mark_once "${state}/skipped" "detached"
		return 0
	fi
	if [[ "${stashed}" == true ]]; then
		if ! with_lock stash git -C "${path}" stash pop -q; then
			git -C "${path}" reset --merge -q || true
			report skip "${path}: stash pop failed; edit remains in the stash"
			mark_once "${state}/skipped" "detached"
			return 0
		fi
	fi
	if [[ -n "$(git -C "${path}" status --porcelain)" ]]; then
		commit_tree "${path}" "${name}" || return 0
	fi
}

# Porcelain with missing submodule checkouts removed. Those are restored,
# not committed.
commit_status() {
	local path="$1" line rel
	while IFS= read -r line; do
		[[ -z "${line}" ]] && continue
		rel="${line# D }"
		if [[ "${line}" == " D ${rel}" && -f "${path}/.gitmodules" ]] &&
			git -C "${path}" rev-parse -q --verify "HEAD:${rel}" >/dev/null &&
			git -C "${path}" config -f .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null |
			awk -v p="${rel}" '$2 == p { found = 1 } END { exit !found }'; then
			continue
		fi
		printf '%s\n' "${line}"
	done < <(git -C "${path}" status --porcelain)
}

commit_worktree_one() {
	local path="$1" branch="$2" pre_name="${3:-}" dirty=false
	if [[ -n "$(commit_status "${path}")" ]]; then dirty=true; fi
	if [[ -z "${branch}" ]]; then
		commit_detached "${path}" "${pre_name}"
	elif [[ "${dirty}" == true && "${branch}" == "${default_branch}" ]]; then
		commit_default_dirty "${path}"
	elif [[ "${dirty}" == true ]]; then
		commit_branch_dirty "${path}" "${branch}"
	fi
}

commit_worktrees() {
	local path branch locked sha pre_name
	wave_start
	while IFS=$'\t' read -r path branch locked; do
		pre_name=""
		if [[ -z "${branch}" && "${do_commit}" == true ]]; then
			sha="$(git -C "${path}" rev-parse --short=12 HEAD)"
			pre_name="$(free_name "detached-${sha}")"
			mark_once "${state}/reserved" "${pre_name}"
		fi
		wave_spawn commit_worktree_one "${path}" "${branch}" "${pre_name}"
	done <"${state}/worktrees"
	wave_finish
}

commit_stash() {
	local current target switched
	git rev-parse --verify --quiet refs/stash >/dev/null || return 0
	if [[ "${do_commit}" != true ]]; then
		report skip "stash"
		mark_once "${state}/skipped" "stash"
		return 0
	fi
	current="$(git symbolic-ref --quiet HEAD || true)"
	current="${current#refs/heads/}"
	if [[ -z "${current}" || "${current}" == "${default_branch}" ]]; then
		target="$(free_name wip)"
	else
		target="${current}"
	fi
	mark_once "${state}/hold" "${target}"
	say commit "stash onto ${target}"
	mark_once "${state}/planned" "${target}"
	[[ "${dry_run}" == false ]] || return 0
	switched=false
	if [[ "${target}" != "${current}" ]]; then
		git switch -c "${target}"
		switched=true
	fi
	if ! git stash pop -q; then
		git reset --merge -q || true
		if [[ "${switched}" == true ]]; then git switch "${default_branch}" || true; fi
		report skip "stash: pop failed"
		mark_once "${state}/skipped" "stash"
		return 0
	fi
	if tree_blocked "${primary}"; then
		git stash push -u -q -m "wt done left this uncommitted" || true
		report skip "stash: left uncommitted"
		mark_once "${state}/skipped" "stash"
		if [[ "${switched}" == true ]]; then
			git switch "${default_branch}" || true
			git branch -D "${target}" || true
		fi
		return 0
	fi
	if [[ -n "$(git status --porcelain)" ]]; then
		if ! git add -A || ! git commit -q --no-verify -m "chore: save uncommitted work on ${target}"; then
			report skip "stash: commit failed"
			mark_once "${state}/skipped" "stash"
		fi
	fi
	if [[ "${switched}" == true ]]; then git switch "${default_branch}"; fi
}

ff_default() {
	local local_tip remote_tip path
	if marked "${default_branch}" "${state}/skipped"; then return 0; fi
	local_tip="$(git rev-parse --verify --quiet "refs/heads/${default_branch}" || true)"
	[[ -n "${local_tip}" ]] || return 0
	remote_tip="$(git rev-parse "refs/remotes/origin/${default_branch}")"
	[[ "${local_tip}" == "${remote_tip}" ]] && return 0
	git merge-base --is-ancestor "${local_tip}" "${remote_tip}" || return 0
	say ff "${default_branch}"
	[[ "${dry_run}" == false ]] || return 0
	path="$(worktree_of "${default_branch}")"
	if [[ -n "${path}" ]]; then
		git -C "${path}" merge --ff-only --quiet "origin/${default_branch}"
	else
		git update-ref "refs/heads/${default_branch}" "${remote_tip}" "${local_tip}"
	fi
}

note_conflict() {
	local path
	path="$(worktree_of "$1")"
	if [[ -n "${path}" ]]; then git -C "${path}" rebase --abort >/dev/null 2>&1 || true; fi
	if [[ -n "${DEV_PROFILE_DONE_RESTACK:-}" ]]; then git rebase --abort >/dev/null 2>&1 || true; fi
	mark_once "${state}/conflicts" "$1"
	report conflict "$1"
}

# `%(refname:short)` prints `heads/main` when a tag is also named main.
# Callers then look up `refs/heads/heads/main` and the script dies.
each_branch() {
	local ref
	while IFS= read -r ref; do
		printf '%s\n' "${ref#refs/heads/}"
	done < <(git for-each-ref --format='%(refname)' refs/heads)
}

stop_restack() {
	printf '1\n' >"${state}/restack-stopped"
	fail_one
}

restack_dry_one() {
	local branch="$1"
	if diverged "${branch}"; then
		mark_once "${state}/conflicts" "${branch}"
		report conflict "${branch}"
	fi
}

restack_one() {
	local branch="$1" path
	if diverged "${branch}"; then
		note_conflict "${branch}"
		return 0
	fi
	if git merge-base --is-ancestor "refs/remotes/origin/${default_branch}" "refs/heads/${branch}"; then
		return 0
	fi
	path="$(worktree_of "${branch}")"
	[[ -n "${path}" ]] || return 0
	if ! git -C "${path}" -c rebase.updateRefs=false rebase --no-autostash --quiet "origin/${default_branch}"; then
		note_conflict "${branch}"
	fi
}

restack_branches() {
	local branch
	if restack_blocked; then
		report skip "restack: uncommitted work blocks restack; pass --commit"
		if [[ "${dry_run}" == true ]]; then return 0; fi
		stop_restack
		return 0
	fi
	if [[ "${dry_run}" == true ]]; then
		say restack "origin/${default_branch}"
		wave_start
		while IFS= read -r branch; do
			eligible "${branch}" || continue
			wave_spawn restack_dry_one "${branch}"
		done < <(each_branch)
		wave_finish
		return 0
	fi
	record_tips
	if [[ -n "${DEV_PROFILE_DONE_RESTACK:-}" ]]; then
		while IFS= read -r branch; do
			eligible "${branch}" || continue
			if ! "${DEV_PROFILE_DONE_RESTACK}" "${branch}"; then
				note_conflict "${branch}"
				stop_restack
			fi
		done < <(each_branch)
		return 0
	fi
	wave_start
	while IFS= read -r branch; do
		eligible "${branch}" || continue
		wave_spawn restack_one "${branch}"
	done < <(each_branch)
	wave_finish
}

push_ok() {
	local tip="$1" ref="$2" mode="$3" spec ok
	if [[ "${dry_run}" == true ]]; then
		say push "${ref}"
		return 0
	fi
	spec="${tip}:refs/heads/${ref}"
	ok=0
	case "${mode}" in
	lease)
		git push --quiet --no-verify --force-with-lease="refs/heads/${ref}" origin "${spec}" || ok=1
		;;
	backup)
		git push --quiet --no-verify --force-with-lease="refs/heads/${ref}" origin "${spec}" || ok=1
		;;
	plain)
		git push --quiet --no-verify origin "${spec}" || ok=1
		;;
	*)
		echo "unknown push mode ${mode}" >&2
		return 1
		;;
	esac
	[[ "${ok}" -eq 0 ]] || return 1
	git update-ref "refs/remotes/origin/${ref}" "$(git rev-parse "${tip}^{commit}")"
	report push "${ref}"
}

backup_conflict() {
	local branch="$1" tip="$2" ref
	ref="backup/conflicts/${clone}/${branch}"
	mark_once "${state}/conflicts" "${branch}"
	if [[ "${do_push}" != true ]]; then
		report skip "${ref}: pass --push"
		mark_once "${state}/unpushed" "${branch}"
		return 0
	fi
	if push_ok "${tip}" "${ref}" backup; then
		mark_once "${state}/backed" "${branch}"
	else
		report failed "${ref}"
		fail_one
	fi
}

publish_main() {
	local local_tip remote_tip ref
	if marked "${default_branch}" "${state}/skipped"; then return 0; fi
	local_tip="$(git rev-parse --verify --quiet "refs/heads/${default_branch}" || true)"
	[[ -n "${local_tip}" ]] || return 0
	remote_tip="$(git rev-parse "refs/remotes/origin/${default_branch}")"
	[[ "${local_tip}" == "${remote_tip}" ]] && return 0
	if git merge-base --is-ancestor "${local_tip}" "${remote_tip}"; then return 0; fi
	if [[ "${do_push}" != true ]]; then
		report skip "${default_branch}: pass --push"
		mark_once "${state}/unpushed" "${default_branch}"
		return 0
	fi
	if git merge-base --is-ancestor "${remote_tip}" "${local_tip}"; then
		ref="backup/main/${clone}"
		if push_ok "${local_tip}" "${ref}" plain; then
			mark_once "${state}/backed" "mainahead"
		else
			report failed "${ref}"
			fail_one
		fi
		return 0
	fi
	report conflict "${default_branch}"
	backup_conflict "${default_branch}" "${local_tip}"
}

publish_branch_one() {
	local branch="$1" tip remote mode saved
	if marked "${branch}" "${state}/conflicts"; then
		saved="$(pretip_of "${branch}")"
		[[ -n "${saved}" ]] || saved="$(git rev-parse "refs/heads/${branch}")"
		backup_conflict "${branch}" "${saved}"
		return 0
	fi
	if [[ "${dry_run}" == true ]] && marked "${branch}" "${state}/planned"; then
		if [[ "${do_push}" != true ]]; then
			report skip "${branch}: pass --push"
			mark_once "${state}/unpushed" "${branch}"
		else
			say push "${branch}"
			mark_once "${state}/pushed" "${branch}"
		fi
		return 0
	fi
	tip="$(git rev-parse "refs/heads/${branch}")"
	remote=""
	if git rev-parse --verify --quiet "refs/remotes/origin/${branch}" >/dev/null; then
		remote="$(git rev-parse "refs/remotes/origin/${branch}")"
	fi
	saved="$(pretip_of "${branch}")"
	if [[ -n "${saved}" && "${tip}" != "${saved}" ]]; then
		if [[ "${do_push}" != true ]]; then
			report skip "${branch}: pass --push"
			mark_once "${state}/unpushed" "${branch}"
			return 0
		fi
		mode="plain"
		if [[ -n "${remote}" ]]; then mode="lease"; fi
		if push_ok "${tip}" "${branch}" "${mode}"; then
			mark_once "${state}/pushed" "${branch}"
		else
			report conflict "${branch}: push refused"
			backup_conflict "${branch}" "${tip}"
		fi
		return 0
	fi
	if [[ -f "${state}/restack-stopped" && -n "${saved}" && "${tip}" == "${saved}" ]]; then
		if [[ -n "${remote}" && "${tip}" == "${remote}" ]]; then
			report current "${branch}"
			return 0
		fi
		report skip "${branch}: restack stopped"
		mark_once "${state}/unpushed" "${branch}"
		return 0
	fi
	if [[ -n "${remote}" && "${tip}" == "${remote}" ]]; then
		report current "${branch}"
		return 0
	fi
	if [[ -n "${remote}" ]] && git merge-base --is-ancestor "${tip}" "${remote}"; then
		return 0
	fi
	if [[ -n "${remote}" ]] && ! git merge-base --is-ancestor "${remote}" "${tip}"; then
		if ! marked "${branch}" "${state}/conflicts"; then report conflict "${branch}"; fi
		backup_conflict "${branch}" "${tip}"
		return 0
	fi
	if [[ "${do_push}" != true ]]; then
		report skip "${branch}: pass --push"
		mark_once "${state}/unpushed" "${branch}"
		return 0
	fi
	mode="plain"
	if [[ -n "${remote}" ]]; then mode="lease"; fi
	if push_ok "${tip}" "${branch}" "${mode}"; then
		mark_once "${state}/pushed" "${branch}"
	else
		report conflict "${branch}: push refused"
		backup_conflict "${branch}" "${tip}"
	fi
}

publish_branches() {
	local branch
	wave_start
	while IFS= read -r branch; do
		eligible "${branch}" || continue
		wave_spawn publish_branch_one "${branch}"
	done < <(each_branch)
	wave_finish
	[[ "${dry_run}" == true ]] || return 0
	while IFS= read -r branch; do
		[[ -z "${branch}" ]] && continue
		git show-ref --verify --quiet "refs/heads/${branch}" && continue
		if [[ "${do_push}" != true ]]; then
			report skip "${branch}: pass --push"
			mark_once "${state}/unpushed" "${branch}"
			continue
		fi
		say push "${branch}"
		mark_once "${state}/pushed" "${branch}"
	done <"${state}/planned"
}

open_pr() {
	local kind="$1" head="$2" base="$3" title="$4" body existing head_oid base_oid
	body="Opened by wt done from ${clone}."
	say pr "${kind} ${head} into ${base}"
	[[ "${dry_run}" == false ]] || return 0
	existing="$(gh pr list --head "${head}" --state open --json number --jq '.[0].number' 2>/dev/null || true)"
	if [[ -n "${existing}" ]]; then
		report current "${head} pull request #${existing}"
		return 0
	fi
	head_oid="$(git rev-parse --verify --quiet "refs/remotes/origin/${head}" || true)"
	base_oid="$(git rev-parse --verify --quiet "refs/remotes/origin/${base}" || true)"
	if [[ -n "${head_oid}" && -n "${base_oid}" && "${head_oid}" == "${base_oid}" ]]; then
		report skip "${head}: no commits into ${base}"
		return 0
	fi
	if [[ -z "${base_oid}" ]]; then
		report skip "${head}: ${base} is not on origin"
		return 0
	fi
	if [[ "${kind}" == draft ]]; then
		gh pr create --draft --head "${head}" --base "${base}" --title "${title}" --body "${body}" || {
			report failed "pull request for ${head}"
			fail_one
		}
	else
		gh pr create --head "${head}" --base "${base}" --title "${title}" --body "${body}" || {
			report failed "pull request for ${head}"
			fail_one
		}
	fi
}

open_mainahead_pr() {
	local head="backup/main/${clone}"
	open_pr ready "${head}" "${default_branch}" "Commits ahead of ${default_branch} from ${clone}"
	say pr "auto-merge ${head}"
	if [[ "${dry_run}" != true ]] && ! gh pr merge "${head}" --auto --merge; then
		report skip "auto-merge was not armed for ${head}"
	fi
}

publish_prs() {
	local branch head
	if [[ "${do_pr}" != true ]]; then return 0; fi
	if [[ "${do_push}" != true ]]; then
		report skip "pull requests: pass --push"
		return 0
	fi
	if [[ "${dry_run}" != true ]] && ! command -v gh >/dev/null 2>&1; then
		echo "GitHub CLI (gh) is required for --pr" >&2
		fail_one
		return 0
	fi
	wave_start
	while IFS= read -r branch; do
		[[ -z "${branch}" ]] && continue
		if marked "${branch}" "${state}/hold"; then continue; fi
		head="backup/conflicts/${clone}/${branch}"
		wave_spawn open_pr draft "${head}" "${branch}" "Local commits on ${branch} did not rebase"
	done <"${state}/conflicts"
	if marked "mainahead" "${state}/backed"; then
		wave_spawn open_mainahead_pr
	fi
	while IFS= read -r branch; do
		[[ -z "${branch}" ]] && continue
		[[ "${branch}" == "${default_branch}" ]] && continue
		if marked "${branch}" "${state}/conflicts"; then continue; fi
		if marked "${branch}" "${state}/hold"; then continue; fi
		wave_spawn open_pr draft "${branch}" "${default_branch}" "${branch}"
	done <"${state}/pushed"
	wave_finish
}

prune_worktree_one() {
	local path="$1" branch="$2" locked="$3"
	prunable_worktree "${path}" "${branch}" "${locked}" || return 0
	say prune "${path}"
	[[ "${dry_run}" == false ]] || return 0
	git worktree remove --force "${path}"
	if ! git worktree list --porcelain | grep -Fxq -- "branch refs/heads/${branch}"; then
		with_lock config git branch -D "${branch}"
	fi
}

prune_branch_one() {
	local branch="$1"
	if marked "${branch}" "${state}/unpushed"; then return 0; fi
	[[ -n "$(worktree_of "${branch}")" ]] && return 0
	git rev-parse --verify --quiet "refs/remotes/origin/${branch}" >/dev/null || return 0
	[[ "$(git rev-parse "refs/heads/${branch}")" == "$(git rev-parse "refs/remotes/origin/${branch}")" ]] || return 0
	say prune "${branch}"
	[[ "${dry_run}" == false ]] || return 0
	with_lock config git branch -D "${branch}"
}

prune_local() {
	local path branch locked
	write_worktrees
	wave_start
	while IFS=$'\t' read -r path branch locked; do
		wave_spawn prune_worktree_one "${path}" "${branch}" "${locked}"
	done <"${state}/worktrees"
	wave_finish

	write_worktrees
	wave_start
	while IFS= read -r branch; do
		eligible "${branch}" || continue
		wave_spawn prune_branch_one "${branch}"
	done < <(each_branch)
	wave_finish
}

prune_remote_one() {
	local ref="$1" branch tip listing
	# origin/HEAD is a symref, not a branch.
	[[ "${ref}" == refs/remotes/origin || "${ref}" == refs/remotes/origin/HEAD ]] && return 0
	branch="${ref#refs/remotes/origin/}"
	[[ "${branch}" == HEAD || "${branch}" == "${default_branch}" ]] && return 0
	case "${branch}" in
	backup/*) return 0 ;;
	esac
	if marked "${branch}" "${state}/skipped"; then return 0; fi
	if marked "${branch}" "${state}/unpushed"; then return 0; fi
	tip="$(git rev-parse --verify --quiet "${ref}" || true)"
	[[ -n "${tip}" ]] || return 0
	git merge-base --is-ancestor "${tip}" "refs/remotes/origin/${default_branch}" || return 0
	say prune "origin/${branch}"
	[[ "${dry_run}" == false ]] || return 0
	if ! command -v gh >/dev/null 2>&1; then
		report skip "origin/${branch}: gh is not installed; kept"
		return 0
	fi
	if ! listing="$(gh pr list --head "${branch}" --state open --json number 2>/dev/null)"; then
		report skip "origin/${branch}: could not list pull requests; kept"
		return 0
	fi
	if [[ "${listing}" == *number* ]]; then
		report skip "origin/${branch}: open pull request"
		return 0
	fi
	if ! git push --quiet --no-verify --force-with-lease="refs/heads/${branch}:${tip}" --delete origin "${branch}"; then
		report skip "origin/${branch}: remote moved; kept"
	fi
}

prune_remote() {
	local ref
	wave_start
	while IFS= read -r ref; do
		wave_spawn prune_remote_one "${ref}"
	done < <(git for-each-ref --format='%(refname)' refs/remotes/origin)
	wave_finish
}

scan_danger_one() {
	local path="$1" rel bytes max
	max=$((max_file_mb * 1024 * 1024))
	while IFS= read -r -d '' rel; do
		[[ -z "${rel}" ]] && continue
		if [[ -e "${path}/${rel}/.git" ]]; then
			printf '%s\n' "nested repository ${path}/${rel}" >>"${state}/blockers"
		fi
	done < <(git -C "${path}" ls-files -z --others --directory --exclude-standard)
	while IFS= read -r rel; do
		[[ -z "${rel}" ]] && continue
		printf '%s\n' "nested repository ${path}/${rel}" >>"${state}/blockers"
	done < <(git -C "${path}" ls-files -s | awk -F '\t' '$1 ~ /^160000 / { print $2 }')
	while IFS= read -r -d '' rel; do
		[[ -f "${path}/${rel}" ]] || continue
		bytes="$(wc -c <"${path}/${rel}")"
		bytes="${bytes#"${bytes%%[![:space:]]*}"}"
		if ((bytes > max)); then
			printf '%s\n' "${path}/${rel}: over ${max_file_mb} MB" >>"${state}/blockers"
		fi
	done < <(git -C "${path}" ls-files -z --others --exclude-standard)
}

drop_branch_one() {
	local branch="$1" tip
	if marked "${branch}" "${state}/skipped"; then return 0; fi
	tip="$(git rev-parse "refs/heads/${branch}")"
	if contained "${tip}"; then return 0; fi
	if [[ "${dry_run}" == true && "${do_push}" == true ]]; then return 0; fi
	printf '%s\n' "${branch} is not on origin" >>"${state}/blockers"
}

drop_planned_one() {
	local branch="$1"
	[[ -z "${branch}" ]] && return 0
	git show-ref --verify --quiet "refs/heads/${branch}" && return 0
	printf '%s\n' "${branch} is not on origin" >>"${state}/blockers"
}

drop_worktree_one() {
	local path="$1" branch="$2" locked="$3"
	[[ "${path}" == "${primary}" ]] && return 0
	if [[ "${do_prune}" != true ]]; then
		printf '%s\n' "linked worktree ${path}; pass --prune" >>"${state}/blockers"
		return 0
	fi
	if ! prunable_worktree "${path}" "${branch}" "${locked}"; then
		printf '%s\n' "linked worktree ${path} would remain" >>"${state}/blockers"
	fi
}

drop_clone() {
	local line branch path locked
	while IFS= read -r line; do
		[[ -z "${line}" ]] && continue
		printf '%s\n' "${line} was skipped" >>"${state}/blockers"
	done <"${state}/skipped"
	write_worktrees
	wave_start
	while IFS= read -r branch; do
		wave_spawn drop_branch_one "${branch}"
	done < <(each_branch)
	if [[ "${dry_run}" == true && "${do_push}" != true ]]; then
		while IFS= read -r branch; do
			wave_spawn drop_planned_one "${branch}"
		done <"${state}/planned"
	fi
	while IFS=$'\t' read -r path branch locked; do
		wave_spawn drop_worktree_one "${path}" "${branch}" "${locked}"
	done <"${state}/worktrees"
	while IFS=$'\t' read -r path _ _; do
		wave_spawn scan_danger_one "${path}"
	done <"${state}/worktrees"
	wave_finish
	if [[ -s "${state}/blockers" ]]; then
		while IFS= read -r line; do
			say refuse "${line}"
		done <"${state}/blockers"
		[[ "${dry_run}" == true ]] || exit 1
		return 0
	fi
	report ignored "ignored files are not pushed; the Trash keeps them"
	[[ "${dry_run}" == false ]] || {
		say drop "${primary}"
		return 0
	}
	command -v trash >/dev/null 2>&1 || {
		echo "trash is not installed; nothing was deleted" >&2
		exit 1
	}
	write_worktrees
	while IFS=$'\t' read -r path _ _; do
		[[ "${path}" == "${primary}" ]] && continue
		if [[ -d "${path}" ]]; then
			say refuse "linked worktree ${path} still exists"
			exit 1
		fi
	done <"${state}/worktrees"
	say drop "${primary}"
	cd "$(dirname "${primary}")" || exit 1
	trash "${primary}"
}

# A submodule that is still in HEAD but missing on disk is an uninitialized
# checkout. Restoring it is not a commit, and committing it would record a deletion.
missing_submodules() {
	local rel listed
	[[ -f .gitmodules ]] || return 0
	listed="$(git config -f .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null || true)"
	while IFS= read -r rel; do
		[[ -z "${rel}" ]] && continue
		[[ -e "${rel}" ]] && continue
		git rev-parse -q --verify "HEAD:${rel}" >/dev/null || continue
		awk -v p="${rel}" '$2 == p { found = 1 } END { exit !found }' <<<"${listed}" || continue
		printf '%s\n' "${rel}"
	done < <(git ls-files -s | awk -F '\t' '$1 ~ /^160000 / { print $2 }')
}

restore_submodules() {
	local rel
	while IFS= read -r rel; do
		[[ -z "${rel}" ]] && continue
		say restore "${rel}"
		[[ "${dry_run}" == false ]] || continue
		if ! git submodule update --init -- "${rel}"; then
			report skip "${rel}: submodule checkout missing"
		fi
	done < <(missing_submodules)
}

git fetch --prune --quiet origin '+refs/heads/*:refs/remotes/origin/*' || {
	echo "fetch of origin failed" >&2
	exit 1
}
if ! git symbolic-ref --quiet refs/remotes/origin/HEAD >/dev/null 2>&1; then
	if [[ "${dry_run}" != true ]]; then
		git remote set-head origin --auto >/dev/null 2>&1 || true
	fi
fi
default_branch="$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null || true)"
default_branch="${default_branch#refs/remotes/origin/}"
default_branch="${default_branch:-main}"

clone="$(clone_id)"
if [[ -z "${clone}" ]]; then
	clone="$(hostname -s)-$(basename "${primary}")-$(od -An -N3 -tx1 /dev/urandom | tr -d ' \n')"
	clone="$(tr '[:upper:]' '[:lower:]' <<<"${clone}" | tr -c 'a-z0-9.\n-' '-')"
	if [[ "${dry_run}" != true ]]; then
		git config --local dev-profile.sync-clone "${clone}"
	fi
fi
report clone "${clone}"

restore_submodules
write_worktrees
commit_worktrees
commit_stash
ff_default
write_worktrees
restack_branches
publish_main
publish_branches
publish_prs
if [[ "${do_prune}" == true ]]; then
	prune_local
	prune_remote
fi
if [[ "${do_drop}" == true ]]; then
	drop_clone
fi
if [[ "${dry_run}" == true ]]; then
	echo "dry-run: fetched origin; no other changes"
	exit 0
fi
if ((failures > 0)); then exit 1; fi
