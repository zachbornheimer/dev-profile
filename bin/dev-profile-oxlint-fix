#!/usr/bin/env bash
set -euo pipefail
# Code generated by `mise run generate`. DO NOT EDIT.
# Source of truth: profile.pkl

# Safe fixes plus suggestions (modernize); never --fix-dangerously.
# Exit 1 = diagnostics left for push; anything else is a real error.
code=0
if "$(dirname "${BASH_SOURCE[0]}")/dev-profile-repo-owned"; then
	oxlint --fix --fix-suggestions "$@" || code=$?
else
	root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
	if [[ -f "${root}/.oxlintrc.json" ]] || { [[ -f "${root}/package.json" ]] && grep -q '"oxlint"' "${root}/package.json"; }; then
		oxlint --fix "$@" || code=$?
	fi
fi
[[ "${code}" -le 1 ]] || exit "${code}"
