#!/usr/bin/env bash
set -euo pipefail
# Code generated by `mise run generate`. DO NOT EDIT.
# Source of truth: profile.pkl

# Worktrunk's post-start copy: `wt step copy-ignored` reflinks the source
# worktree's ignored files, which is what makes a new worktree cheap. Composer's
# optimized autoloader is the exception — autoload_classmap.php and its
# neighbours bake absolute paths — so a copied vendor/ points PHP at the source
# checkout and `php artisan` dies on the app's own classes until someone dumps
# the autoloader by hand. Do it here, so entering a worktree just works. A repo
# without a built autoloader is untouched.
#
# The repair is advisory: an autoloader that cannot be rebuilt leaves the
# worktree usable and says what to run, but never fails the start. The copy
# itself keeps its own failure, since a start without the copied files is wrong,
# once it has been retried (see below).
usage="usage: dev-profile-worktree-copy [--help]"
if [[ "${1:-}" == --help || "${1:-}" == -h ]]; then
	echo "${usage}"
	exit 0
fi
[[ $# -eq 0 ]] || {
	echo "${usage}" >&2
	exit 2
}

root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
	echo "dev-profile-worktree-copy: ${PWD} is not inside a git repository" >&2
	exit 2
}
cd "${root}"

# The source worktree may be serving, and a dev server rewrites its build
# output (a bundler's .mastra/ or .next/) while the copy walks it, so a file the
# copy listed can be gone by the time it is cloned. That is a race, not a broken
# copy: copy-ignored skips what already landed, so a second pass finishes the
# rest. A copy that still fails after the last pass keeps its failure.
copy_attempts="${DEV_PROFILE_WORKTREE_COPY_ATTEMPTS:-3}"
copy_retry_delay="${DEV_PROFILE_WORKTREE_COPY_RETRY_DELAY:-2}" # seconds
attempt=1
until wt step copy-ignored; do
	if ((attempt >= copy_attempts)); then
		echo "dev-profile-worktree-copy: the copy failed ${attempt} times; run: wt step copy-ignored" >&2
		exit 1
	fi
	attempt=$((attempt + 1))
	sleep "${copy_retry_delay}"
done

# A branch whose tree carries no ignore rules (a tooling branch) has none for
# the copied build output either: git presents every copied file as
# non-ignored untracked, and each hook enumerates and stashes them all. A
# per-worktree info/exclude has no effect on this git; a per-worktree
# core.excludesFile does. Write rules for exactly what the copy landed here,
# folded with the global ignore rules the key replaces.
exclude_copied_output() { # <primary-worktree> <this-worktree>
	local primary="$1" current="$2" entry path pattern git_dir excludes inherited patterns
	patterns=()
	while IFS= read -r -d '' entry; do
		[[ "${entry:0:2}" == '!!' ]] || continue # not ignored in the primary
		path="${entry:3}"
		[[ -n "${path}" && "${path}" != *$'\n'* && -e "${current}/${path}" ]] || continue # the copy did not land it here
		if git check-ignore -q -- "${path}"; then continue; fi                            # this branch's rules cover it
		patterns+=("/${path}")
	done < <(git -C "${primary}" status --porcelain --ignored -z)
	((${#patterns[@]})) || return 0
	git config extensions.worktreeConfig true || return 1
	git_dir="$(git rev-parse --path-format=absolute --git-dir)"
	excludes="${git_dir}/info/copy-ignored-excludes"
	# The key replaces the global ignore outright, so fold its rules in. Read
	# --local (the shared config; a worktree key reads empty there) then
	# --global, else the default, so a re-run never stacks its own file.
	inherited="$(git config --local core.excludesFile 2>/dev/null || true)"
	[[ -n "${inherited}" ]] || inherited="$(git config --global core.excludesFile 2>/dev/null || true)"
	[[ -n "${inherited}" ]] || inherited="${XDG_CONFIG_HOME:-${HOME}/.config}/git/ignore"
	inherited="${inherited/#\~/${HOME}}"
	mkdir -p "${git_dir}/info" || return 1
	if [[ ! -e "${excludes}" ]]; then
		{
			echo "# dev-profile-worktree-copy: rules for the build output copied into a"
			echo "# branch whose tree carries none. The global rules the worktree's"
			echo "# core.excludesFile key replaces are folded in above them. Dies with"
			echo "# this worktree."
			if [[ -f "${inherited}" ]]; then
				cat "${inherited}"
			fi
		} >"${excludes}" || return 1
	fi
	for pattern in "${patterns[@]}"; do
		grep -qxF -- "${pattern}" "${excludes}" || printf '%s\n' "${pattern}" >>"${excludes}"
	done
	git config --worktree core.excludesFile "${excludes}" || return 1
	echo "dev-profile-worktree-copy: excluding ${#patterns[@]} copied path(s) in this worktree"
}

# Like the autoloader repair below, the excludes are advisory: a start that
# cannot hide the copied output is noisy, not broken. Only a worktree that is
# not the primary needs them.
primary="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
current="$(pwd -P)"
if [[ -d "${primary}" && "${primary}" != "${current}" ]]; then
	if ! exclude_copied_output "${primary}" "${current}"; then
		echo "dev-profile-worktree-copy: could not exclude the copied output; run: git config extensions.worktreeConfig true; git config --worktree core.excludesFile \"\$(git rev-parse --path-format=absolute --git-dir)/info/copy-ignored-excludes\"" >&2
	fi
fi

# Both markers: composer.json alone is a repo whose dependencies were never
# installed, and a vendor/ without autoload.php is not an autoloader to rebuild.
[[ -f composer.json && -f vendor/autoload.php ]] || exit 0

repair_timeout="${DEV_PROFILE_WORKTREE_COPY_TIMEOUT:-60}" # seconds

# Bounded without timeout(1), which a clean machine need not have: a post-start
# hook that hangs blocks every switch.
bounded() { # <seconds> <cmd...>
	local limit="$1" pid watchdog status=0
	shift
	"$@" &
	pid=$!
	(
		sleep "${limit}"
		kill -TERM "${pid}" 2>/dev/null
	) &
	watchdog=$!
	wait "${pid}" || status=$?
	kill "${watchdog}" 2>/dev/null || :
	wait "${watchdog}" 2>/dev/null || :
	return "${status}"
}

if ! command -v composer >/dev/null 2>&1; then
	reason="composer is not installed"
elif bounded "${repair_timeout}" composer dump-autoload --no-interaction --quiet; then
	echo "dev-profile-worktree-copy: rebuilt the copied Composer autoloader for this checkout"
	exit 0
else
	reason="composer dump-autoload failed"
fi
# One line, naming the fix: the checkout is usable, its vendor/ is not.
echo "dev-profile-worktree-copy: ${reason}: the copied vendor/ points at another checkout; run: composer dump-autoload" >&2
exit 0
