#!/usr/bin/env bash
set -euo pipefail
# Sibling scripts are called by path: dprint and hk run this without the bin dir on PATH.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Format PHP. WordPress → PHPCBF only. Never mago / php-cs-fixer after PHPCBF.

phpcbf_ok() {
	local code=0
	"$@" || code=$?
	# 0 nothing to fix, 1 fixed, 2 unfixable remain (push judges); 3+ is a real error.
	if [[ "${code}" -le 2 ]]; then
		return 0
	fi
	return "${code}"
}

# phpcbf must rewrite the file it was given. A standard's <arg name="basepath">
# moves that write whenever the file sits outside the basepath — and the temp
# copy of stdin dprint hands us always does: Common::stripBasepath drops the
# path's leading separator and Reports/Cbf re-prepends the basepath, so the
# write lands inside the basepath tree and dies with
# "file_put_contents(<basepath>/private/var/...): Failed to open stream".
# An explicit empty --basepath= overrides the standard's setting, so phpcbf
# rewrites the file it read. phpcs keeps the standard's basepath: it only
# shortens reported paths.
phpcbf_fmt() {
	phpcbf_ok phpcbf --basepath= "$@"
}

# $1 = file to rewrite; $2 = path whose repo decides the context (defaults to $1).
format_file() {
	local file="$1"
	local ctx root
	ctx="$("${here}/dev-profile-php-context" "${2:-$1}")"
	root="${ctx#* }"
	case "${ctx%% *}" in
	wordpress)
		if [[ -f "${root}/phpcs.xml" ]]; then
			phpcbf_fmt --standard="${root}/phpcs.xml" "${file}"
		elif [[ -f "${root}/phpcs.xml.dist" ]]; then
			phpcbf_fmt --standard="${root}/phpcs.xml.dist" "${file}"
		elif [[ -f "${root}/.phpcs.xml" ]]; then
			phpcbf_fmt --standard="${root}/.phpcs.xml" "${file}"
		elif [[ -f "${root}/.phpcs.xml.dist" ]]; then
			phpcbf_fmt --standard="${root}/.phpcs.xml.dist" "${file}"
		else
			phpcbf_fmt --standard=WordPress "${file}"
		fi
		;;
	php-cs-fixer)
		# Run the repo's own pinned fixer with the repo's own config. A bare
		# `php-cs-fixer` resolves to whatever is on PATH, and without --config the
		# tool discovers one from the CWD — which for dprint's exec is its own
		# config dir, so a stray template there decides formatting for every repo
		# and fails the hook when its rules need a fixer newer than the repo pins.
		# PHP_CS_FIXER_IGNORE_ENV keeps a local runtime above the fixer's supported
		# max from blocking commits; CI still formats and checks on the repo's 8.2.
		local fixer="php-cs-fixer" config=()
		if [[ -x "${root}/vendor/bin/php-cs-fixer" ]]; then
			fixer="${root}/vendor/bin/php-cs-fixer"
		fi
		for candidate in .php-cs-fixer.dist.php .php-cs-fixer.php; do
			if [[ -f "${root}/${candidate}" ]]; then
				config=(--config="${root}/${candidate}")
				break
			fi
		done
		PHP_CS_FIXER_IGNORE_ENV=1 "${fixer}" fix --using-cache=no "${config[@]}" "${file}"
		;;
	phpcs)
		if [[ -f "${root}/phpcs.xml" ]]; then
			phpcbf_fmt --standard="${root}/phpcs.xml" "${file}"
		elif [[ -f "${root}/phpcs.xml.dist" ]]; then
			phpcbf_fmt --standard="${root}/phpcs.xml.dist" "${file}"
		else
			phpcbf_fmt "${file}"
		fi
		;;
	*)
		if command -v php-cs-fixer >/dev/null 2>&1 && [[ -f "${HOME}/.config/php-cs-fixer/.php-cs-fixer.dist.php" ]]; then
			php-cs-fixer fix --using-cache=no --config="${HOME}/.config/php-cs-fixer/.php-cs-fixer.dist.php" "${file}"
		elif command -v phpcbf >/dev/null 2>&1; then
			phpcbf_fmt "${file}"
		else
			cat "${file}" >/dev/null
		fi
		;;
	esac
}

format_stdin() {
	# Global, not local: the EXIT trap runs after this function returns.
	# A real .php name in a temp dir: phpcbf skips files without the extension.
	tmpdir="$(mktemp -d)"
	trap 'rm -rf "${tmpdir}"' EXIT
	local tmp="${tmpdir}/stdin.php"
	cat >"${tmp}"
	# stdout is the formatted file for dprint; formatter chatter goes to stderr.
	format_file "${tmp}" "$1" >&2
	cat "${tmp}"
}

if [[ "${1:-}" == "--stdin-path" ]]; then
	format_stdin "$2"
	exit 0
fi
if [[ $# -eq 0 ]]; then
	format_stdin "${PWD}"
	exit 0
fi

for f in "$@"; do
	format_file "${f}"
done
