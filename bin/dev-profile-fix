#!/usr/bin/env bash
set -euo pipefail
# Code generated by `mise run generate`. DO NOT EDIT.
# Source of truth: profile.pkl

# Run a fixer; exit 1 means "issues left for push to judge", not a failure.
if [[ -f go.mod && -z "${GOWORK:-}" ]] && root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
	root="$(cd "${root}" && pwd -P)"
	module="$(pwd -P)"
	dir="${module}"
	workdir=""
	while :; do
		if [[ -f "${dir}/go.work" ]]; then
			workdir="${dir}"
			break
		fi
		[[ "${dir}" == "${root}" || "${dir}" == / ]] && break
		dir="$(dirname "${dir}")"
	done
	if [[ -n "${workdir}" ]]; then
		rel="${module#"${workdir}"}"
		rel="${rel#/}"
		members="$(cd "${workdir}" && go work edit -json |
			jq -r '.Use[]?.DiskPath | sub("^\\./"; "") | sub("/$"; "") | if . == "" then "." else . end')"
		grep -qxF -- "${rel:-.}" <<<"${members}" || export GOWORK=off
	fi
fi
code=0
"$@" || code=$?
[[ "${code}" -le 1 ]] || exit "${code}"
