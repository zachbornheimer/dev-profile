#!/usr/bin/env bash
set -euo pipefail
# Code generated by `mise run generate`. DO NOT EDIT.
# Source of truth: profile.pkl

# Whole-program linters with no new-issues mode (go vet, cargo clippy): run the command,
# then fail only on diagnostics located in the pushed files. Usage: CMD ARGS... :: FILES...
if [[ -f go.mod && -z "${GOWORK:-}" ]] && root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
	root="$(cd "${root}" && pwd -P)"
	module="$(pwd -P)"
	dir="${module}"
	workdir=""
	while :; do
		if [[ -f "${dir}/go.work" ]]; then
			workdir="${dir}"
			break
		fi
		[[ "${dir}" == "${root}" || "${dir}" == / ]] && break
		dir="$(dirname "${dir}")"
	done
	if [[ -n "${workdir}" ]]; then
		rel="${module#"${workdir}"}"
		rel="${rel#/}"
		members="$(cd "${workdir}" && go work edit -json |
			jq -r '.Use[]?.DiskPath | sub("^\\./"; "") | sub("/$"; "") | if . == "" then "." else . end')"
		grep -qxF -- "${rel:-.}" <<<"${members}" || export GOWORK=off
	fi
fi
cmd=()
while (($#)) && [[ "$1" != "::" ]]; do
	cmd+=("$1")
	shift
done
shift || true
((${#cmd[@]})) || {
	echo "usage: dev-profile-pushed-diagnostics CMD ARGS... :: FILES..." >&2
	exit 2
}
out="$("${cmd[@]}" 2>&1)" && exit 0
fail=0
while IFS= read -r diag; do
	path="${diag%%:*}"
	path="${path#./}"
	for f in "$@"; do
		if [[ "${f}" == "${path}" || "${f}" == */"${path}" || "${path}" == */"${f}" ]]; then
			echo "${diag}" >&2
			fail=1
		fi
	done
done < <(grep -E '^[^ :]+\.(go|rs):[0-9]+(:[0-9]+)?: ' <<<"${out}" || true)
if [[ "${fail}" -eq 0 ]] && ! grep -Eq '^[^ :]+\.(go|rs):[0-9]+' <<<"${out}"; then
	echo "${out}" >&2 # failure with no file diagnostics (build or setup error): surface it
	exit 1
fi
exit "${fail}"
