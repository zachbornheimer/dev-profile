#!/usr/bin/env bash
set -euo pipefail
# Run markdownlint on owned repositories, or on unowned repositories that declare
# their own .markdownlint* configuration at the repository root. A --fix run
# heals what it can and then re-judges what remains: hk runs a step's fixer
# after its check failed and passes the step when the fixer exits 0, and
# dev-profile-fix alone swallows markdownlint's exit 1, so an unhealable finding
# must be re-reported here or it reads as fixed.
fix=0
if [[ "${1:-}" == "--fix" ]]; then
	fix=1
	shift
fi
(($# > 0)) || exit 0

bin_dir="$(dirname "${BASH_SOURCE[0]}")"
if "${bin_dir}/dev-profile-repo-owned"; then
	if ((fix)); then
		"${bin_dir}/dev-profile-fix" markdownlint --fix "$@" || exit $?
	fi
	exec markdownlint "$@"
fi

root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cfg=""
for candidate in \
	"${root}/.markdownlint.json" \
	"${root}/.markdownlint.jsonc" \
	"${root}/.markdownlint.yaml" \
	"${root}/.markdownlint.yml" \
	"${root}/.markdownlintrc"; do
	if [[ -f "${candidate}" ]]; then
		cfg="${candidate}"
		break
	fi
done
[[ -n "${cfg}" ]] || exit 0

if ((fix)); then
	"${bin_dir}/dev-profile-fix" markdownlint --config "${cfg}" --fix "$@" || exit $?
fi
exec markdownlint --config "${cfg}" "$@"
