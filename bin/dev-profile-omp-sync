#!/usr/bin/env bash
# Sync the custom omp release, then prove the installed binary is that release.
#
# mise caches the GitHub "latest release" response under ~/.cache/mise/github.
# A release published minutes ago is invisible to `mise up` until that entry
# expires, so `mise up` can report "up to date" while a newer build exists.
# Drop the cached response first, upgrade, then require the binary's own
# identity (`omp --version` second line) to name the version mise has active.
set -euo pipefail

# A systemd/launchd run has a minimal PATH; mise and the entrypoint live in
# ~/.local/bin, and the entrypoint is a mise shim.
PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
export PATH

repo="github:zachbornheimer/oh-my-pi"
entrypoint="${OMP_ENTRYPOINT:-$HOME/.local/bin/omp}"

# mise resolves its cache directory per platform: XDG on Linux, ~/Library/Caches
# on macOS. Clearing only the XDG path is a no-op on the Mac, which is how
# "mise up" kept reporting "up to date" while a newer build was Latest.
for cache_dir in "${XDG_CACHE_HOME:-$HOME/.cache}"/mise/github* "$HOME/Library/Caches"/mise/github*; do
	rm -f "$cache_dir"/*oh-my-pi*.msgpack.z 2>/dev/null || true
done

mise up "$repo"

active="$(mise current "$repo" 2>/dev/null || true)"
if [ -z "$active" ]; then
	echo "omp sync: mise has no active version for $repo after mise up" >&2
	exit 1
fi

installed="$("$entrypoint" --version | sed -n '2p')"
expected="github.com/zachbornheimer/oh-my-pi@$active"
if [ "$installed" != "$expected" ]; then
	echo "omp sync: installed '${installed:-<no identity line>}' but mise has '$expected'" >&2
	exit 1
fi
echo "omp sync: $installed"
