#!/usr/bin/env bash
# Build the custom `omp` binary from a fresh, throwaway clone.
#
# Every run builds from a fresh, throwaway checkout in a temp dir: a persistent
# bare object cache at ~/.cache/omp-sync/oh-my-pi.git keeps full objects between
# runs (seeded once from the user's checkout), and each run syncs only upstream
# main plus the configured fork branches into it before cloning it locally. The
# build branch is created at upstream main, the configured fork branches are
# merged in order, then `omp` is compiled and installed. `~/Developer/Personal/oh-my-pi`
# is never checked out, rebased, cherry-picked, stashed, or fetched: the only
# write there is the reference-transaction hook that keeps its `main` read-only.
#
# On any merge conflict or missing configured branch the run names the branch
# and the conflicting files and exits non-zero: nothing is installed, nothing is
# pushed, and the temp clone is removed (kept with --keep for inspection).
set -euo pipefail

# Ensure environment PATH has necessary dev tools and shims on both macOS (MBP) and Linux (VPS)
# rustup's proxies come first: they honor oh-my-pi's rust-toolchain.toml (a pinned nightly);
# a mise or Homebrew stable cargo ahead of them fails the native build.
export PATH="$HOME/.cargo/bin:$HOME/Developer/Personal/dev-profile/bin:$HOME/.local/share/mise/shims:$HOME/.local/bin:$HOME/.bun/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

REPO_DIR="${OMP_REPO_DIR:-$HOME/Developer/Personal/oh-my-pi}"
REBUILD_CONFIG="${OMP_REBUILD_CONFIG:-$HOME/Developer/Personal/dev-profile/config/omp-rebuild.toml}"
LOG_FILE="${OMP_SYNC_LOG:-$HOME/.local/state/omp-sync.log}"
INSTALL_DIR="${OMP_SYNC_INSTALL_DIR:-$HOME/.local/bin}"
UPSTREAM_URL="https://github.com/can1357/oh-my-pi.git"
FORK_URL="https://github.com/zachbornheimer/oh-my-pi.git"

load_config() {
	# One parse owns the remote/branch names and the ordered branch list.
	local parsed key val
	parsed="$(
		python3 - "$REBUILD_CONFIG" <<'PY'
import sys, tomllib
from pathlib import Path
path = Path(sys.argv[1])
data = tomllib.loads(path.read_text(encoding="utf-8")) if path.is_file() else {}
def value(key, default):
    v = data.get(key)
    return v.strip() if isinstance(v, str) and v.strip() else default
print("upstream_remote\t" + value("upstream_remote", "origin"))
print("upstream_branch\t" + value("upstream_branch", "main"))
print("fork_remote\t" + value("fork_remote", "fork"))
print("build_branch\t" + value("build_branch", "omp-build"))
for b in data.get("branches", []):
    if isinstance(b, str) and b.strip():
        print("branch\t" + b.strip())
for s in data.get("required_in_tree", []):
    if isinstance(s, str) and s.strip():
        print("required\t" + s.strip())
PY
	)" || die "cannot parse $REBUILD_CONFIG"
	branches_csv=""
	required_csv=""
	while IFS=$'\t' read -r key val; do
		case "$key" in
		upstream_remote) UPSTREAM_REMOTE="$val" ;;
		upstream_branch) UPSTREAM_BRANCH="$val" ;;
		fork_remote) FORK_REMOTE="$val" ;;
		build_branch) BUILD_BRANCH="$val" ;;
		branch) branches_csv="${branches_csv:+$branches_csv$'\n'}$val" ;;
		required) required_csv="${required_csv:+$required_csv$'\n'}$val" ;;
		esac
	done <<<"$parsed"
}

update_rebuild_config() {
	local op="$1" branch="$2"
	[ -f "$REBUILD_CONFIG" ] || {
		echo "Error: rebuild config not found at $REBUILD_CONFIG" >&2
		exit 1
	}
	python3 - "$REBUILD_CONFIG" "$op" "$branch" <<'PY'
import re, sys, tomllib
from pathlib import Path
path = Path(sys.argv[1])
op = sys.argv[2]
branch = sys.argv[3].strip()
text = path.read_text(encoding="utf-8")
data = tomllib.loads(text)
branches = list(data.get("branches", []))
if op == "include":
    if branch not in branches:
        branches.append(branch)
elif op == "exclude":
    branches = [b for b in branches if b != branch]
formatted = "branches = [\n" + "".join(f'  "{b}",\n' for b in branches) + "]"
new_text = re.sub(r"branches\s*=\s*\[[^\]]*\]", formatted, text, count=1, flags=re.DOTALL)
path.write_text(new_text, encoding="utf-8")
PY
}

mkdir -p "$(dirname "$LOG_FILE")"

log() {
	local ts
	ts="$(date '+%Y-%m-%d %H:%M:%S')"
	echo "[$ts] $*" | tee -a "$LOG_FILE"
}

err() {
	local ts
	ts="$(date '+%Y-%m-%d %H:%M:%S')"
	echo "[$ts] $*" | tee -a "$LOG_FILE" >&2
}

die() {
	err "$*"
	exit 1
}

phase_done() {
	local name="$1" started="$2"
	log "phase $name: $(($(date +%s) - started))s"
}

natives_pkg_version() {
	# The natives package version keys the ~/.omp/natives/<ver> addon cache.
	python3 - "$1/packages/natives/package.json" <<'PY'
import json, sys
from pathlib import Path
p = Path(sys.argv[1])
if p.is_file():
    v = json.loads(p.read_text(encoding="utf-8")).get("version")
    if isinstance(v, str) and v.strip():
        print(v.strip())
PY
}

addon_is_current() {
	# Reuse an addon only when it carries this release's identity, checked with
	# the repo's own helper (packages/natives/native/version-sentinel.js): the
	# embed step rejects unstamped addons, and an addon built from another commit
	# must never be embedded even when its package version matches.
	local candidate="$1"
	if [ -z "${native_version:-}" ] || [ ! -f "$candidate" ] || [ ! -f "$CLONE_DIR/packages/natives/native/version-sentinel.js" ]; then
		return 1
	fi
	OMP_ADDON_PATH="$candidate" OMP_ADDON_VERSION="$native_version" \
		bun -e 'const m = await import("./packages/natives/native/version-sentinel.js"); const { readFileSync } = await import("node:fs"); const bytes = readFileSync(process.env.OMP_ADDON_PATH); const ok = m.containsVersionStamp(bytes, process.env.OMP_ADDON_VERSION) || m.containsLegacyVersionSentinel(bytes, process.env.OMP_ADDON_VERSION); process.exit(ok ? 0 : 1)' \
		>>"$LOG_FILE" 2>&1
}

try_native() {
	# Adopt a candidate addon only when it carries this release's identity.
	if [ -n "$1" ] && [ -f "$1" ] && addon_is_current "$1"; then
		native_src="$1"
		return 0
	fi
	return 1
}

show_status() {
	if [ ! -d "$REPO_DIR/.git" ]; then
		echo "Error: oh-my-pi repository not found at $REPO_DIR" >&2
		exit 1
	fi

	cd "$REPO_DIR"

	local omp_bin="$INSTALL_DIR/omp"
	local omp_ver="unknown"
	if [ -x "$omp_bin" ]; then
		omp_ver="$("$omp_bin" --version 2>/dev/null || echo "error")"
	elif command -v omp >/dev/null 2>&1; then
		omp_ver="$(omp --version 2>/dev/null || echo "error")"
	fi

	local active_branch head_sha head_short
	active_branch="$(git symbolic-ref --short -q HEAD 2>/dev/null || echo "detached")"
	head_sha="$(git rev-parse HEAD 2>/dev/null || echo "unknown")"
	head_short="$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")"

	local upstream_remote upstream_branch fork_remote build_branch branches_csv
	load_config
	upstream_remote="$UPSTREAM_REMOTE"
	upstream_branch="$UPSTREAM_BRANCH"
	fork_remote="$FORK_REMOTE"
	build_branch="$BUILD_BRANCH"

	local main_ahead="0"
	if git rev-parse --verify --quiet "$upstream_remote/$upstream_branch" >/dev/null && git rev-parse --verify --quiet main >/dev/null; then
		main_ahead="$(git rev-list --count "$upstream_remote/$upstream_branch"..main 2>/dev/null || echo "unknown")"
	fi

	local ahead_origin="unknown"
	if git rev-parse --verify --quiet "$upstream_remote/$upstream_branch" >/dev/null; then
		ahead_origin="$(git rev-list --count "$upstream_remote/$upstream_branch"..HEAD 2>/dev/null || echo "unknown")"
	fi

	local ahead_fork="unknown" behind_fork="unknown"
	if git rev-parse --verify --quiet "$fork_remote/$build_branch" >/dev/null; then
		ahead_fork="$(git rev-list --count "$fork_remote/$build_branch"..HEAD 2>/dev/null || echo "unknown")"
		behind_fork="$(git rev-list --count "HEAD..$fork_remote/$build_branch" 2>/dev/null || echo "unknown")"
	fi

	local branches_display
	branches_display="$(printf '%s' "$branches_csv" | paste -sd ',' - | sed 's/,/, /g')"

	echo "platform:             $(uname -s)/$(uname -m)"
	echo "omp version:          $omp_ver"
	echo "active branch:        $active_branch"
	echo "active HEAD SHA:      $head_sha ($head_short)"
	echo "installed SHA stamp:  $(cat "$INSTALL_DIR/.omp-sha" 2>/dev/null || echo "none")"
	echo "main == $upstream_remote/$upstream_branch:  $([ "$main_ahead" = "0" ] && echo "clean (0 custom commits on main)" || echo "DIRTY ($main_ahead custom commits on main)")"
	echo "ahead of $upstream_remote/$upstream_branch: $ahead_origin (on $active_branch)"
	echo "vs fork/$build_branch:    ahead $ahead_fork, behind $behind_fork"
	echo "rebuild config:       $REBUILD_CONFIG"
	echo "included branches:    ${branches_display:-none}"
	exit 0
}

INCLUDE_BRANCH=""
EXCLUDE_BRANCH=""
PUSH_FORK=0
KEEP_WORK=0
ALLOW_DROP=0

usage() {
	echo "Usage: dev-profile-omp-sync [--status|--keep|--include <branch>|--exclude <branch>|--push|--help]"
	echo ""
	echo "Build the custom omp binary from a fresh temp clone: upstream main plus the branches"
	echo "listed in $REBUILD_CONFIG, merged in order onto the build branch,"
	echo "then compiled and installed to $INSTALL_DIR/omp (always compiled). The checkout at"
	echo "$REPO_DIR is never modified. On any merge conflict or missing configured"
	echo "branch the run names the branch and the conflicting files and exits non-zero without"
	echo "installing or pushing anything."
	echo ""
	echo "  --status            Show sync/build status and exit"
	echo "  --keep              Keep the temp build dir for inspection"
	echo "  --include <branch>  Add <branch> to the rebuild config, then rebuild"
	echo "  --exclude <branch>  Remove <branch> from the rebuild config, then rebuild"
	echo "  --push              Force-push the rebuilt build branch to the fork (lease-protected)"
	echo "  --allow-drop        With --push: push even when the fork's build branch carries"
	echo "                      commits the build would drop (they are printed first)"
	echo "  -h, --help          Show this help"
}

while [ $# -gt 0 ]; do
	case "$1" in
	--status)
		show_status
		;;
	--keep)
		KEEP_WORK=1
		;;
	--push)
		PUSH_FORK=1
		;;
	--allow-drop)
		ALLOW_DROP=1
		;;
	--include)
		[ $# -ge 2 ] || {
			echo "Error: --include requires a branch name" >&2
			exit 2
		}
		INCLUDE_BRANCH="$2"
		shift
		;;
	--exclude)
		[ $# -ge 2 ] || {
			echo "Error: --exclude requires a branch name" >&2
			exit 2
		}
		EXCLUDE_BRANCH="$2"
		shift
		;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		echo "Unknown argument: $1" >&2
		usage >&2
		exit 1
		;;
	esac
	shift
done

log "=== Starting dev-profile-omp-sync ($(uname -s)/$(uname -m)) ==="

if [ -n "$INCLUDE_BRANCH" ]; then
	log "Adding '$INCLUDE_BRANCH' to $REBUILD_CONFIG..."
	update_rebuild_config include "$INCLUDE_BRANCH"
fi
if [ -n "$EXCLUDE_BRANCH" ]; then
	log "Removing '$EXCLUDE_BRANCH' from $REBUILD_CONFIG..."
	update_rebuild_config exclude "$EXCLUDE_BRANCH"
fi

[ -f "$REBUILD_CONFIG" ] || die "rebuild config not found at $REBUILD_CONFIG"

phase_started="$(date +%s)"
load_config

# The only write to the user's checkout: a reference-transaction hook that keeps
# its `main` a read-only mirror of upstream.
if [ -d "$REPO_DIR/.git" ]; then
	mkdir -p "$REPO_DIR/.git/hooks"
	cat >"$REPO_DIR/.git/hooks/reference-transaction" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
state="${1:-}"
[ "$state" = "prepared" ] || exit 0
origin_main_sha="$(git rev-parse --verify -q refs/remotes/origin/main 2>/dev/null || true)"
[ -n "$origin_main_sha" ] || exit 0
while read -r _old_value new_value ref_name; do
	if [ "$ref_name" = "refs/heads/main" ]; then
		if [ "$new_value" != "0000000000000000000000000000000000000000" ] && [ "$new_value" != "$origin_main_sha" ]; then
			echo "ERROR [oh-my-pi reference-transaction]: refs/heads/main is read-only and must match origin/main ($origin_main_sha)." >&2
			echo "Never commit or merge onto 'main' in oh-my-pi. Create a topic branch off origin/main, push it to the fork, and register it via 'dev-profile-omp-sync --include <branch> --push'." >&2
			exit 1
		fi
	fi
done
EOF
	chmod +x "$REPO_DIR/.git/hooks/reference-transaction"
fi
phase_done "startup" "$phase_started"

# The temp clone is a build sandbox. The global config-defined git hooks (hk lint
# gates, wt bootstrap, skills sync) guard real working trees; integration commits
# and the build-branch push carry only topic-branch content that already passed
# the gate when it was pushed to the fork, and the pre-push gate is very slow on
# the large ranges a rebuilt build branch produces. HK=0 is the hooks' own off
# switch. The clone has no repo hooks of its own, which is fine.
export HK=0

WORK_DIR=""
cleanup() {
	if [ -n "$WORK_DIR" ]; then
		if [ "$KEEP_WORK" = "1" ]; then
			log "Keeping build dir $WORK_DIR (--keep)"
		else
			# The temp clone holds node_modules; deleting it can take a minute, so
			# let it finish after the run has reported.
			(rm -rf "$WORK_DIR" >>"$LOG_FILE" 2>&1 &)
		fi
	fi
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 143' TERM
trap 'exit 130' INT

WORK_DIR="$(mktemp -d "${TMPDIR:-/tmp}/omp-sync.XXXXXX")"
CLONE_DIR="$WORK_DIR/oh-my-pi"
# The clone's mise.toml pins the toolchain its build runs with; the build already
# executes the clone's code, so its config is trusted for this throwaway dir only
# (resolved path: mise compares canonical paths, and /var is a symlink on macOS).
MISE_TRUSTED_CONFIG_PATHS="$(cd "$WORK_DIR" && pwd -P)${MISE_TRUSTED_CONFIG_PATHS:+:$MISE_TRUSTED_CONFIG_PATHS}"
export MISE_TRUSTED_CONFIG_PATHS
log "Building in a fresh clone at $CLONE_DIR (removed on exit unless --keep)"

phase_started="$(date +%s)"
# Persistent object cache: full blobs, pruned to the refs this config needs. The
# temp clone shares its objects (--shared) and is deleted after the build; the
# cache is seeded once from the user's checkout's objects and then stands alone.
CACHE_DIR="$HOME/.cache/omp-sync/oh-my-pi.git"
if [ ! -d "$CACHE_DIR" ]; then
	log "Seeding object cache $CACHE_DIR..."
	# A plain clone: seeding via --reference --dissociate repacks the user's
	# multi-gigabyte object store and took 25+ minutes here before giving up.
	git clone --bare --single-branch --branch "$UPSTREAM_BRANCH" --no-tags -o "$UPSTREAM_REMOTE" \
		"$UPSTREAM_URL" "$CACHE_DIR" >>"$LOG_FILE" 2>&1 ||
		die "failed to seed object cache from $UPSTREAM_URL"
	phase_done "cache seed" "$phase_started"
fi
if ! git -C "$CACHE_DIR" remote get-url "$FORK_REMOTE" >/dev/null 2>&1; then
	git -C "$CACHE_DIR" remote add "$FORK_REMOTE" "$FORK_URL"
fi

phase_started="$(date +%s)"
# One incremental cache sync: every configured branch must exist on the fork
# (no silent skips), and the build-branch sha seeds the --push lease.
fork_refs="$(git -C "$CACHE_DIR" ls-remote "$FORK_REMOTE" 2>>"$LOG_FILE")" || die "cannot reach $FORK_REMOTE ($FORK_URL)"
fork_build_sha="$(printf '%s\n' "$fork_refs" | awk -v ref="refs/heads/$BUILD_BRANCH" '$2 == ref {print $1}')"
fetch_refs=()
missing_branches=""
while IFS= read -r branch; do
	[ -n "$branch" ] || continue
	if printf '%s\n' "$fork_refs" | awk -v ref="refs/heads/$branch" '$2 == ref {found=1} END {exit !found}'; then
		fetch_refs+=("+refs/heads/$branch:refs/remotes/$FORK_REMOTE/$branch")
	else
		missing_branches="$missing_branches $branch"
	fi
done <<<"$branches_csv"
if [ -n "$missing_branches" ]; then
	die "configured branch(es) missing on $FORK_REMOTE ($FORK_URL):$missing_branches. No silent skips: push them first (git -C '$REPO_DIR' push $FORK_REMOTE <branch>) or drop them with 'dev-profile-omp-sync --exclude <branch>'."
fi
if [ -n "$fork_build_sha" ]; then
	fetch_refs+=("+refs/heads/$BUILD_BRANCH:refs/remotes/$FORK_REMOTE/$BUILD_BRANCH")
fi
git -C "$CACHE_DIR" fetch --no-tags --prune "$UPSTREAM_REMOTE" "+refs/heads/$UPSTREAM_BRANCH:refs/heads/main" >>"$LOG_FILE" 2>&1 ||
	die "cannot fetch $UPSTREAM_URL"
if [ "${#fetch_refs[@]}" -gt 0 ]; then
	git -C "$CACHE_DIR" fetch --no-tags --prune "$FORK_REMOTE" "${fetch_refs[@]}" >>"$LOG_FILE" 2>&1 ||
		die "cannot fetch configured branches from $FORK_REMOTE ($FORK_URL)"
fi
phase_done "cache fetch" "$phase_started"

# Compute the tree the build would produce without cloning, and stop before the
# clone when the installed binary was already built from that tree (and the fork
# does not need the push).
phase_started="$(date +%s)"
up_to_date=0
computed_tree=""
installed_sha="$(cat "$INSTALL_DIR/.omp-sha" 2>/dev/null || true)"
# Everything a build is a function of: upstream, each configured branch tip, the
# required strings. Equal inputs mean an equal build even when a recorded
# resolution (rerere, which merge-tree cannot replay) merged a branch.
build_inputs="$(
	{
		git -C "$CACHE_DIR" rev-parse "refs/heads/$UPSTREAM_BRANCH"
		while IFS= read -r branch; do
			[ -n "$branch" ] || continue
			printf '%s %s\n' "$branch" "$(git -C "$CACHE_DIR" rev-parse "refs/remotes/$FORK_REMOTE/$branch")"
		done <<<"$branches_csv"
		printf 'required %s\n' "$required_csv"
	} | git hash-object --stdin
)"
# The installed build commit lives only in its throwaway clone unless it was
# pushed, so equal inputs decide alone; a --push run also needs the fork to
# already hold that build.
if [ -n "$installed_sha" ] && [ -x "$INSTALL_DIR/omp" ] &&
	[ "$(cat "$INSTALL_DIR/.omp-inputs" 2>/dev/null || true)" = "$build_inputs" ] &&
	{ [ "$PUSH_FORK" != "1" ] || [ "$fork_build_sha" = "$installed_sha" ]; }; then
	computed_tree="$(git -C "$CACHE_DIR" rev-parse -q --verify "$installed_sha^{tree}" 2>/dev/null || echo "inputs $build_inputs")"
	up_to_date=1
elif [ -n "$installed_sha" ] && git -C "$CACHE_DIR" cat-file -e "$installed_sha^{tree}" 2>/dev/null; then
	chain="$(git -C "$CACHE_DIR" rev-parse "refs/heads/$UPSTREAM_BRANCH")"
	chain_ok=1
	while IFS= read -r branch; do
		[ -n "$branch" ] || continue
		branch_tip="$(git -C "$CACHE_DIR" rev-parse "refs/remotes/$FORK_REMOTE/$branch")"
		if ! merged_tree="$(git -C "$CACHE_DIR" merge-tree --write-tree "$chain" "$branch_tip" 2>>"$LOG_FILE")"; then
			chain_ok=0
			break
		fi
		chain="$(git -C "$CACHE_DIR" commit-tree "$merged_tree" -p "$chain" -p "$branch_tip" -m "omp-sync tree check")"
	done <<<"$branches_csv"
	if [ "$chain_ok" = "1" ]; then
		computed_tree="$(git -C "$CACHE_DIR" rev-parse "$chain^{tree}")"
		if [ "$computed_tree" = "$(git -C "$CACHE_DIR" rev-parse "$installed_sha^{tree}")" ]; then
			up_to_date=1
		fi
	fi
fi
if [ "$up_to_date" = "1" ] && [ "$PUSH_FORK" = "1" ] && [ -n "$fork_build_sha" ]; then
	fork_tree="$(git -C "$CACHE_DIR" rev-parse "$fork_build_sha^{tree}" 2>/dev/null || echo stale)"
	if [ "$fork_tree" != "$computed_tree" ]; then
		log "fork/$BUILD_BRANCH is behind the computed tree; rebuilding so the push can carry it."
		up_to_date=0
	fi
fi
phase_done "tree check" "$phase_started"
if [ "$up_to_date" = "1" ]; then
	log "up to date: computed tree $computed_tree matches installed $installed_sha — skipping clone, bun install, natives, build, install."
	log "=== dev-profile-omp-sync completed successfully ==="
	exit 0
fi

phase_started="$(date +%s)"
git clone --shared --no-tags --branch "$UPSTREAM_BRANCH" -o "$UPSTREAM_REMOTE" "$CACHE_DIR" "$CLONE_DIR" >>"$LOG_FILE" 2>&1 ||
	die "failed to clone from object cache $CACHE_DIR"
cd "$CLONE_DIR"
git remote add "$FORK_REMOTE" "$FORK_URL"
clone_refs=()
while IFS= read -r branch; do
	[ -n "$branch" ] || continue
	clone_refs+=("+refs/remotes/$FORK_REMOTE/$branch:refs/remotes/$FORK_REMOTE/$branch")
done <<<"$branches_csv"
if [ -n "$fork_build_sha" ]; then
	clone_refs+=("+refs/remotes/$FORK_REMOTE/$BUILD_BRANCH:refs/remotes/$FORK_REMOTE/$BUILD_BRANCH")
fi
if [ "${#clone_refs[@]}" -gt 0 ]; then
	git fetch --no-tags "$CACHE_DIR" "${clone_refs[@]}" >>"$LOG_FILE" 2>&1 ||
		die "cannot import $FORK_REMOTE refs from the object cache"
fi
git checkout -B "$BUILD_BRANCH" "$UPSTREAM_REMOTE/$UPSTREAM_BRANCH"
# A conflict resolved once (by hand, in a --keep clone) is replayed on every later
# run: rerere's cache lives beside the object cache, outside the throwaway clone.
mkdir -p "$CACHE_DIR/rr-cache"
ln -s "$CACHE_DIR/rr-cache" "$CLONE_DIR/.git/rr-cache"
git config rerere.enabled true
git config rerere.autoUpdate true
# Changelog entries from different branches stack instead of conflicting.
echo '**/CHANGELOG.md merge=union' >>"$CLONE_DIR/.git/info/attributes"
phase_done "clone" "$phase_started"

# Resolutions travel with the fork: each merge in the last pushed build
# (fork/<build branch>) is replayed and its result recorded with rerere, so a
# machine that never resolved a conflict by hand replays it too.
if [ -n "$fork_build_sha" ]; then
	phase_started="$(date +%s)"
	train_dir="$WORK_DIR/rerere-train"
	if git worktree add -q --detach "$train_dir" "$fork_build_sha" >>"$LOG_FILE" 2>&1; then
		learned=0
		while read -r merge_commit first_parent second_parent _; do
			[ -n "${second_parent:-}" ] || continue
			git -C "$train_dir" checkout -q --detach "$first_parent" >>"$LOG_FILE" 2>&1 || continue
			if ! git -C "$train_dir" -c commit.gpgsign=false merge --no-commit --no-ff "$second_parent" >>"$LOG_FILE" 2>&1 &&
				[ -n "$(git -C "$train_dir" diff --name-only --diff-filter=U)" ]; then
				git -C "$train_dir" checkout "$merge_commit" -- . >>"$LOG_FILE" 2>&1 &&
					git -C "$train_dir" rerere >>"$LOG_FILE" 2>&1 && learned=$((learned + 1))
			fi
			git -C "$train_dir" merge --abort >/dev/null 2>&1 || git -C "$train_dir" reset -q --hard
		done < <(git rev-list --parents --merges --first-parent -n 50 "$fork_build_sha")
		git worktree remove --force "$train_dir" >>"$LOG_FILE" 2>&1 || true
		[ "$learned" = 0 ] || log "Learned $learned merge resolution(s) from $FORK_REMOTE/$BUILD_BRANCH"
	fi
	phase_done "rerere training" "$phase_started"
fi

# A configured branch another configured branch contains is merged through that
# branch, so its stale copy never conflicts on its own (identical tips merge
# once, from the last copy listed).
merge_names=()
merge_tips=()
while IFS= read -r branch; do
	[ -n "$branch" ] || continue
	merge_names+=("$branch")
	merge_tips+=("$(git rev-parse "refs/remotes/$FORK_REMOTE/$branch")")
done <<<"$branches_csv"
if [ "${#merge_names[@]}" -gt 0 ]; then
	for i in "${!merge_names[@]}"; do
		branch="${merge_names[$i]}"
		tip="${merge_tips[$i]}"
		container=""
		for j in "${!merge_names[@]}"; do
			[ "$j" != "$i" ] || continue
			# Identical tips: only the last copy is merged.
			[ "${merge_tips[$j]}" != "$tip" ] || [ "$j" -gt "$i" ] || continue
			if git merge-base --is-ancestor "$tip" "${merge_tips[$j]}"; then
				container="${merge_names[$j]}"
				break
			fi
		done
		if [ -n "$container" ]; then
			log "Merge $branch: contained in $container"
			continue
		fi
		if git merge-base --is-ancestor "$tip" HEAD; then
			log "Merge $branch: already contained"
			continue
		fi
		ref="refs/remotes/$FORK_REMOTE/$branch"
		log "Integrating configured branch '$branch' into '$BUILD_BRANCH'..."
		phase_started="$(date +%s)"
		if ! git -c commit.gpgsign=false merge --no-ff --no-edit -m "Merge $branch into $BUILD_BRANCH" "$ref" >>"$LOG_FILE" 2>&1; then
			unresolved="$(git diff --name-only --diff-filter=U)"
			if [ -z "$unresolved" ] && git -c commit.gpgsign=false commit --no-edit >>"$LOG_FILE" 2>&1; then
				log "Merge $branch: conflicts resolved by recorded resolutions (rerere)"
				phase_done "merge $branch" "$phase_started"
				continue
			fi
			err "ERROR: merge conflict while integrating configured branch '$branch' into '$BUILD_BRANCH'."
			err "Conflicting files:"
			while IFS= read -r conflict; do
				if [ -n "$conflict" ]; then
					err "  $conflict"
				fi
			done <<<"$unresolved"
			die "Nothing was installed and nothing was pushed. Merge $UPSTREAM_REMOTE/$UPSTREAM_BRANCH into '$branch' and push it to $FORK_REMOTE, or rerun with --keep, resolve the merge in $WORK_DIR and commit it: rerere replays that resolution on every later run here, and the next --push carries it to other machines through $FORK_REMOTE/$BUILD_BRANCH."
		fi
		phase_done "merge $branch" "$phase_started"
	done
fi

build_sha="$(git rev-parse HEAD)"
log "Build branch $BUILD_BRANCH is at $build_sha"
# Features this build must never ship without (e.g. Neon session storage), from `required_in_tree`.
while IFS= read -r needle; do
	[ -n "$needle" ] || continue
	git grep -q -F "$needle" HEAD -- packages/coding-agent/src ||
		die "merged tree lacks required '$needle' in packages/coding-agent/src; nothing was installed"
done <<<"$required_csv"
phase_started="$(date +%s)"
log "Running bun install --frozen-lockfile..."
bun install --frozen-lockfile >>"$LOG_FILE" 2>&1
phase_done "bun install" "$phase_started"

os_name="$(uname -s)"
arch_name="$(uname -m)"
if [ "$os_name" = "Darwin" ]; then
	native_pattern="pi_natives.darwin-*.node"
else
	native_pattern="pi_natives.linux-*.node"
fi
phase_started="$(date +%s)"
mkdir -p "$CLONE_DIR/packages/natives/native"
if ! compgen -G "$CLONE_DIR/packages/natives/native/$native_pattern" >/dev/null; then
	native_version="$(natives_pkg_version "$CLONE_DIR")"
	native_plat="$(uname -s | tr '[:upper:]' '[:lower:]')-$arch_name"
	native_dest="$CLONE_DIR/packages/natives/native/pi_natives.$native_plat.node"
	native_src=""
	if [ -n "$native_version" ] && [ -d "$HOME/.omp/natives/$native_version" ]; then
		try_native "$(find "$HOME/.omp/natives/$native_version" -name "$native_pattern" 2>/dev/null | head -n 1 || true)" || true
	fi
	if [ -z "$native_src" ] && [ -n "$native_version" ] && [ "$(natives_pkg_version "$REPO_DIR")" = "$native_version" ]; then
		try_native "$(find "$REPO_DIR/packages/natives/native" -name "$native_pattern" 2>/dev/null | head -n 1 || true)" || true
	fi
	if [ -z "$native_src" ]; then
		# The published release addon matches whenever the native sources
		# have not moved since the release tag for this version.
		if [ -n "$native_version" ] &&
			git fetch --no-tags "$UPSTREAM_URL" "+refs/tags/v$native_version:refs/tags/v$native_version" >>"$LOG_FILE" 2>&1 &&
			git diff --quiet "v$native_version" HEAD -- crates/ Cargo.toml Cargo.lock rust-toolchain.toml; then
			native_pkg="@oh-my-pi/pi-natives-$native_plat@$native_version"
			try_native "$(find "$CLONE_DIR/node_modules/@oh-my-pi/pi-natives-$native_plat" -name 'pi_natives.*.node' 2>/dev/null | head -n 1 || true)" || true
			if [ -z "$native_src" ]; then
				try_native "$(find "$HOME/.bun/install/cache/@oh-my-pi" -maxdepth 2 -type f -name 'pi_natives.*.node' -path "*pi-natives-$native_plat@$native_version@@@*" 2>/dev/null | head -n 1 || true)" || true
			fi
			if [ -z "$native_src" ] && command -v npm >/dev/null 2>&1; then
				native_tarball="$(cd "$WORK_DIR" && npm pack --silent "$native_pkg" 2>>"$LOG_FILE" | tail -n 1 || true)"
				if [ -n "$native_tarball" ] && [ -f "$WORK_DIR/$native_tarball" ]; then
					mkdir -p "$WORK_DIR/native-pkg"
					tar -xzf "$WORK_DIR/$native_tarball" -C "$WORK_DIR/native-pkg" >>"$LOG_FILE" 2>&1 || true
					try_native "$(find "$WORK_DIR/native-pkg" -name 'pi_natives.*.node' 2>/dev/null | head -n 1 || true)" || true
				fi
			fi
		fi
	fi
	if [ -n "$native_src" ]; then
		log "Reusing native addon $native_src (natives $native_version)"
		cp -p "$native_src" "$native_dest"
		case "$native_src" in
		"$HOME/.omp/natives/$native_version"/*) ;;
		*)
			# Keep the validated addon so later runs skip the download.
			mkdir -p "$HOME/.omp/natives/$native_version"
			cp -p "$native_src" "$HOME/.omp/natives/$native_version/" >>"$LOG_FILE" 2>&1 || true
			;;
		esac
	else
		log "Building native addon for $os_name/$arch_name (no addon cached or published for natives ${native_version:-unknown})..."
		CARGO_TARGET_DIR="$HOME/.cache/omp-sync/cargo-target" OMP_NATIVE_CARGO_PROFILE=ci \
			bun --cwd=packages/natives run build >>"$LOG_FILE" 2>&1
		# Keep the stamped result for the next run, once it passes the check.
		native_built="$(find "$CLONE_DIR/packages/natives/native" -name "$native_pattern" 2>/dev/null | head -n 1 || true)"
		if [ -n "$native_version" ] && [ -n "$native_built" ] && addon_is_current "$native_built"; then
			mkdir -p "$HOME/.omp/natives/$native_version"
			cp -p "$native_built" "$HOME/.omp/natives/$native_version/" >>"$LOG_FILE" 2>&1 || true
		fi
	fi
fi
phase_done "natives" "$phase_started"

phase_started="$(date +%s)"
log "Compiling standalone omp binary (bun --cwd=packages/coding-agent run build)..."
bun --cwd=packages/coding-agent run build >>"$LOG_FILE" 2>&1
phase_done "build" "$phase_started"

phase_started="$(date +%s)"
mkdir -p "$INSTALL_DIR"
tmp_bin="$INSTALL_DIR/.omp.tmp.$$"
if ! install -m 0755 "$CLONE_DIR/packages/coding-agent/dist/omp" "$tmp_bin"; then
	rm -f "$tmp_bin"
	die "failed to stage the compiled binary into $INSTALL_DIR"
fi
if [ "$os_name" = "Darwin" ] && [ -f "$CLONE_DIR/scripts/macos-entitlements.plist" ]; then
	codesign --force --sign - --entitlements "$CLONE_DIR/scripts/macos-entitlements.plist" "$tmp_bin" >>"$LOG_FILE" 2>&1 || true
fi
mv -f "$tmp_bin" "$INSTALL_DIR/omp"
printf '%s\n' "$build_sha" >"$INSTALL_DIR/.omp-sha"
printf '%s\n' "$build_inputs" >"$INSTALL_DIR/.omp-inputs"
log "Installed compiled omp to $INSTALL_DIR/omp ($build_sha)"
phase_done "install" "$phase_started"

current_version="$("$INSTALL_DIR/omp" --version 2>/dev/null || echo "failed")"
if [ "$current_version" = "failed" ]; then
	die "Error: $INSTALL_DIR/omp --version failed!"
fi
log "omp version: $current_version"

if [ "$PUSH_FORK" = "1" ]; then
	phase_started="$(date +%s)"
	# Drop guard: never silently drop commits the fork's build branch carries and
	# the build does not account for. A commit is covered when it is reachable
	# from upstream main or a configured branch, patch-equivalent to such a
	# commit (git cherry), or a recorded cherry-pick of one. Uncovered commits
	# are printed and the push is refused unless --allow-drop.
	drop_bases=("$UPSTREAM_REMOTE/$UPSTREAM_BRANCH")
	while IFS= read -r branch; do
		[ -n "$branch" ] || continue
		drop_bases+=("refs/remotes/$FORK_REMOTE/$branch")
	done <<<"$branches_csv"
	uncovered=()
	if [ -n "$fork_build_sha" ]; then
		patched="$(for base in "${drop_bases[@]}"; do git cherry "$base" "$fork_build_sha" 2>>"$LOG_FILE"; done | awk '/^-/ {print $2}' | sort -u)"
		while IFS= read -r sha; do
			[ -n "$sha" ] || continue
			if printf '%s\n' "$patched" | awk -v s="$sha" '$1 == s {found=1} END {exit !found}'; then
				continue
			fi
			origin_sha="$(git log -1 --format=%B "$sha" | sed -n 's/.*(cherry picked from commit \([0-9a-f]\{7,40\}\).*/\1/p' | head -n 1)"
			covered=0
			if [ -n "$origin_sha" ]; then
				for base in "${drop_bases[@]}"; do
					if git merge-base --is-ancestor "$origin_sha" "$base" 2>>"$LOG_FILE"; then
						covered=1
						break
					fi
				done
			fi
			if [ "$covered" = "0" ]; then
				uncovered+=("$sha")
			fi
		done <<<"$(git rev-list --no-merges "$fork_build_sha" --not "${drop_bases[@]}" 2>>"$LOG_FILE")"
	fi
	if [ "${#uncovered[@]}" -gt 0 ]; then
		err "$FORK_REMOTE/$BUILD_BRANCH carries commits the build does not account for:"
		for sha in "${uncovered[@]}"; do
			err "  $(git log -1 --oneline "$sha" 2>/dev/null || echo "$sha")"
		done
		if [ "$ALLOW_DROP" = "1" ]; then
			err "Continuing the push because --allow-drop was given."
		else
			die "Refusing to push: those commits would be dropped. Review them, move the work onto a topic branch, or rerun with --allow-drop."
		fi
	fi
	log "Pushing $BUILD_BRANCH to $FORK_REMOTE ($FORK_URL) with --force-with-lease..."
	if ! push_output="$(git push "$FORK_REMOTE" "$BUILD_BRANCH:refs/heads/$BUILD_BRANCH" --force-with-lease="$BUILD_BRANCH:$fork_build_sha" 2>&1)"; then
		printf '%s\n' "$push_output" >>"$LOG_FILE"
		while IFS= read -r line; do
			if [ -n "$line" ]; then
				err "  $line"
			fi
		done <<<"$push_output"
		die "pushing $BUILD_BRANCH to $FORK_REMOTE failed (lease $BUILD_BRANCH:${fork_build_sha:-<absent>} expected). See $LOG_FILE."
	fi
	log "Pushed $BUILD_BRANCH to $FORK_REMOTE/$BUILD_BRANCH."
	phase_done "push" "$phase_started"
fi
log "=== dev-profile-omp-sync completed successfully ==="
