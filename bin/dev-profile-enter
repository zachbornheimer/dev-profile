#!/usr/bin/env bash
set -euo pipefail
# Code generated by `mise run generate`. DO NOT EDIT.
# Source of truth: profile.pkl

# Called detached from a shell's chpwd hook (`dev-profile-enter "$PWD" &!`).
# Installs tools and deps, fills node_modules, starts the portless proxy, then
# hands the decision to the profile's `dev` family, which starts the stack
# under worktrunk's tether (killed when the worktree goes) or answers
# state=unconfigured in a checkout that serves nothing.
set -uo pipefail
target="${1:-$PWD}"
root="$(command git -C "${target}" rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "${root}" 2>/dev/null || exit 0
[[ ${DEV_PROFILE_ENTER_DISABLE:-0} == 1 ]] && exit 0

cache="${XDG_CACHE_HOME:-${HOME}/.cache}/dev-profile/enter"
command mkdir -p "${cache}" || exit 0
name="$(printf '%s' "$(basename "${root}")" | tr '[:upper:]' '[:lower:]' |
	sed -e 's/[^a-z0-9]/-/g' -e 's/--*/-/g' -e 's/^-*//' -e 's/-*$//')"
exec >>"${cache}/${name}.log" 2>&1
# One worker per checkout: a second cd while the first runs is a no-op.
if command -v flock >/dev/null 2>&1; then
	exec 9>"${cache}/${name}.lock"
	command flock -n 9 || exit 0
fi
printf '== %s %s\n' "$(date '+%F %T')" "${root}"

# Trust without ever prompting: only repos this profile owns, and only once.
if ! command mise trust --show 2>/dev/null | command grep -q ': trusted'; then
	owner="$(command git remote get-url origin 2>/dev/null | command sed -nE 's#^(https?://github\.com/|git@github\.com:|ssh://git@github\.com/)([^/]+)/.*#\2#p')"
	if [[ -n "${owner}" ]] && "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/dev-profile-owners" "${owner}"; then
		command mise trust --yes >/dev/null 2>&1 || true
	else
		printf 'skip untrusted: %s\n' "${root}"
		exit 0
	fi
fi

# No `mise install` here: auto_install installs a missing tool the first time
# it runs, and a blanket install at every cd is what made cd feel slow.
command mise deps || true
# A repo that predates the deps providers still gets its modules.
if [[ -f package.json && ! -d node_modules ]]; then
	if [[ -f pnpm-lock.yaml ]]; then
		command pnpm install || true
	elif [[ -f bun.lock || -f bun.lockb ]]; then
		command bun install || true
	else
		command aube install || true
	fi
fi
# Nothing to serve (no dev-serve task, composer.json, dev script, Caddyfile):
# skip the proxy and the dev run. `dev` only logs state=unconfigured there.
case "$(command dev-profile-dev status 2>/dev/null)" in
*state=unconfigured*) exit 0 ;;
esac

# Routes are <name>.localhost: they need the proxy on port 443, and starting it
# needs root. The worker is detached from the shell, so a terminal "Password:"
# prompt would land on the user's prompt and stop this job on the tty. Ask in a
# GUI dialog instead (sudo -A), once; if it is declined, skip the proxy for an
# hour rather than asking at every cd.
proxy_up() { command nc -z 127.0.0.1 443 >/dev/null 2>&1; }
ensure_proxy() {
	proxy_up && return 0
	local declined="${cache}/proxy-declined"
	[[ -n "$(command find "${declined}" -mmin -60 -print 2>/dev/null)" ]] && return 1
	local askpass="${cache}/askpass.sh"
	printf '%s\n' '#!/bin/sh' \
		"exec /usr/bin/osascript -e 'display dialog \"portless needs your password to start its HTTPS proxy on port 443.\" default answer \"\" with hidden answer with title \"dev-profile\" with icon caution' -e 'text returned of result'" \
		>"${askpass}"
	command chmod 700 "${askpass}"
	# -v caches the credential for this tty, so the sudo portless runs itself
	# succeeds without prompting. -n re-checks it: no cached credential, no start.
	if SUDO_ASKPASS="${askpass}" command sudo -A -v </dev/null 2>/dev/null && command sudo -n true 2>/dev/null; then
		command timeout 20 portless proxy start </dev/null >/dev/null 2>&1 || true
	else
		command touch "${declined}"
		printf 'proxy skipped: sudo not granted\n'
		return 1
	fi
	proxy_up
}
ensure_proxy || exit 0
command mise run dev
