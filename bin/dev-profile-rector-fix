#!/usr/bin/env bash
set -euo pipefail
# Code generated by `mise run generate`. DO NOT EDIT.
# Source of truth: profile.pkl

# Rector rewrites PHP to the project's PHP-version set. The set lives in the
# repo's rector.php, so a repo without one opts out.
(($#)) || exit 0
root="$(cd "$(git rev-parse --show-toplevel)" && pwd -P)"

# The nearest directory at or above file $1, up to the repo root, that holds a
# file matching glob $2. Prints nothing when there is none.
nearest_up() {
	local dir
	dir="$(cd "$(dirname "$1")" && pwd -P)"
	while :; do
		if compgen -G "${dir}/$2" >/dev/null; then
			echo "${dir}"
			return 0
		fi
		if [[ "${dir}" == "${root}" || "${dir}" == / ]]; then return 0; fi
		dir="$(dirname "${dir}")"
	done
}

# Absolute path of a staged file.
absolute() {
	echo "$(cd "$(dirname "$1")" && pwd -P)/$(basename "$1")"
}

[[ -f "${root}/rector.php" ]] || exit 0
if [[ -x "${root}/vendor/bin/rector" ]]; then
	rector="${root}/vendor/bin/rector"
elif command -v rector >/dev/null 2>&1; then
	rector="$(command -v rector)"
else
	exit 0
fi
cd "${root}"
exec "${rector}" process --no-progress-bar --no-diffs --clear-cache --config rector.php "$@"
