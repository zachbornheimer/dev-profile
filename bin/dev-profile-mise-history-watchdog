#!/usr/bin/env bash
set -euo pipefail
# Self-heal and automatic omp fallback for the mise dotfile history service
# (dev.mise.mise-history).
#
# Failure modes observed 2026-11-01 onward (session omp_01a192d8):
#   1. A second `mise dot watch` beside the launchd-owned one; both contend
#      for ~/.local/state/mise/history/{operation,sync.lock} and publishing
#      stalls for hours with only "another history operation is running".
#   2. The watcher wedges (uninterruptible state, CPU climbing, health
#      timestamp frozen) while holding the lock.
#   3. Locks left behind after a kill keep blocking every operation.
#   4. Sync conflicts or sync/pull errors silently block ALL publishing while
#      local checkpoints pile up unpublished.
#   5. `mise dot apply` failures (conflicting target type, missing source, or
#      broken template/edit) leave declared dotfiles unapplied.
#
# Runs every 5 minutes on every machine that runs the watcher: the
# mise-history-watchdog LaunchAgent on macOS, the dev.mise.mise-history-watchdog
# systemd user timer on Linux (both declared in the global mise config, which the
# history sync carries to each machine). Heals 1-3 (plus encryption declarations
# and transient "reconcile again" stale-plan races) itself, and hands 4-5 to a
# headless omp agent run: each failure it cannot clear files one atask objective
# and drops directly into `omp --auto-approve -p` (dev-profile-mise-history-repair)
# to reconcile differences by hand. A person is notified only when no agent
# could be started, or when the attempts ran out. Idempotent: a healthy service
# produces no log lines.

# The service's own tools first, then whatever the caller had: a LaunchAgent starts
# with launchd's minimal PATH, and a caller that already resolved its own (a fixture's
# stubs, Homebrew on another prefix) keeps them. Replacing PATH broke the fixture's
# stubs, and on a runner without launchctl the `launchctl list` pipeline failed the
# whole tick under set -e + pipefail. The fixture may also put its stubs (launchctl,
# systemctl, pgrep) in front through MISE_HISTORY_WATCHDOG_PATH_PREFIX.
export PATH="${MISE_HISTORY_WATCHDOG_PATH_PREFIX:+$MISE_HISTORY_WATCHDOG_PATH_PREFIX:}$HOME/.local/share/mise/shims:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:${PATH:-/usr/bin:/bin}"

# Load the machine's shared agent state (ATASK_DB_URL, SESSIONS_DB_URL) when the
# service environment did not already supply an atask database, so objectives filed
# by the LaunchAgent land in the same database the worker session reads.
AGENT_ENV="${MISE_HISTORY_AGENT_ENV:-$HOME/.config/agent-state/env}"
if [ -z "${ATASK_DB:-}${ATASK_DB_URL:-}" ] && [ -r "$AGENT_ENV" ] && [ ! -L "$AGENT_ENV" ]; then
	set -a
	# shellcheck disable=SC1090
	. "$AGENT_ENV"
	set +a
fi

# One script for every machine that runs `mise dot watch`: a LaunchAgent on macOS, a
# systemd user timer on the Linux fleet boxes. The OS override lets the fixture drive
# both branches from one machine.
OS="${MISE_HISTORY_WATCHDOG_OS:-$(uname -s)}"
case "$OS" in
Darwin) LOG_DIR_DEFAULT="$HOME/Library/Logs" ;;
*) LOG_DIR_DEFAULT="${XDG_STATE_HOME:-$HOME/.local/state}/mise-history-watchdog" ;;
esac
# The repair script writes its spawn log beside this one.
export MISE_HISTORY_LOG_DIR="${MISE_HISTORY_LOG_DIR:-$LOG_DIR_DEFAULT}"
mkdir -p "$MISE_HISTORY_LOG_DIR"
LOG="$MISE_HISTORY_LOG_DIR/mise-history-watchdog.log"
HIST_DIR="$HOME/.local/state/mise/history"
SERVICE="dev.mise.mise-history"
SERVICE_UNIT="$SERVICE.service"
MY_UID=$(id -u)
# Overridable so the fixture can drive every branch with stubs; the machine uses
# what the LaunchAgent's PATH and this directory resolve.
MISE_BIN="${MISE_HISTORY_WATCHDOG_MISE:-mise}"
HEAL="${MISE_HISTORY_WATCHDOG_HEAL:-$(dirname "$0")/dev-profile-mise-dot-encryption-heal}"
REPAIR="${MISE_HISTORY_WATCHDOG_REPAIR:-$(dirname "$0")/dev-profile-mise-history-repair}"
NOTIFY="${MISE_HISTORY_WATCHDOG_NOTIFY:-}"
# Set by escalate; a tick that escalated nothing clears the repair ledger.
escalated=0

log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG"; }

# A desktop notification on a Mac. A fleet box has no desktop, so the stderr line
# (the systemd journal) is the record there and notify-send is only a bonus.
notify_user() {
	local title="$1" body="$2"
	case "$OS" in
	Darwin) "${NOTIFY:-osascript}" -e "display notification \"$body\" with title \"$title\"" >/dev/null 2>&1 || true ;;
	*)
		printf '%s: %s\n' "$title" "$body" >&2
		"${NOTIFY:-notify-send}" "$title" "$body" >/dev/null 2>&1 || true
		;;
	esac
}

# The pid the service manager owns for the watcher; empty when it owns none.
service_pid() {
	case "$OS" in
	Darwin) launchctl list 2>/dev/null | awk -v s="$SERVICE" '$3 == s && $1 != "-" {print $1}' | head -1 || true ;;
	*) systemctl --user show -p MainPID --value "$SERVICE_UNIT" 2>/dev/null | awk '$1 > 0 {print $1}' | head -1 || true ;;
	esac
}

restart_service() {
	case "$OS" in
	Darwin) launchctl kickstart -k "gui/$MY_UID/$SERVICE" 2>/dev/null || true ;;
	*) systemctl --user restart "$SERVICE_UNIT" 2>/dev/null || true ;;
	esac
}

# An unfixable failure becomes one atask objective with one omp agent run on it.
# The repair script keeps the attempt ledger and answers a verdict; this decides
# what the user hears: nothing while an attempt is in flight, one line when a run
# starts, and a notification only when no worker could be started or the attempts
# are spent. `running` and `alerted` are steady states and stay silent.
escalate() {
	local class="$1" detail="$2" verdict status=0 body reason
	verdict="$("$REPAIR" --class "$class" --detail "$detail" 2>&1)" || status=$?
	escalated=1
	if [ "$status" -eq 0 ]; then
		case "$verdict" in
		running* | alerted*) ;;
		*) log "$class: ${verdict:-the repair script produced no verdict}" ;;
		esac
		return 0
	fi
	reason="${verdict:-no verdict}"
	body="cannot fix $class automatically: ${detail:0:60} — ${reason:0:150}"
	body="${body//\"/}"
	log "$class: needs a person — ${reason:0:150}"
	notify_user "mise history watchdog" "${body:0:240}"
	return 0
}

# 1. Duplicate watchers: keep the service-manager-owned pid, kill every other.
main_pid=$(service_pid)
if [ -n "${main_pid:-}" ]; then
	for pid in $(pgrep -f 'mise dot watch' || true); do
		if [ "$pid" != "$main_pid" ]; then
			kill "$pid" 2>/dev/null || true
			log "killed duplicate watcher pid $pid (the service manager owns $main_pid)"
		fi
	done
fi

# 2. Wedged watcher: the health line stops updating when the internal loop
# is stuck; restart the service BEFORE clearing locks so a fresh watcher's
# own locks are never removed. `mise dot status` is read-only.
# mise prints the age as 13s, 54m or 2h; a frozen watcher reads in minutes, so every unit becomes seconds.
health=$("$MISE_BIN" dot status 2>/dev/null | sed -n 's/.*watcher health (updated \([0-9]*[smhd]\) ago).*/\1/p' | head -1 |
	awk '{ n = $0 + 0; u = substr($0, length($0)); print n * (u == "m" ? 60 : u == "h" ? 3600 : u == "d" ? 86400 : 1) }')
if [ -n "${health:-}" ] && [ "$health" -ge 600 ] 2>/dev/null; then
	restart_service
	log "watcher health frozen ${health}s; restarted $SERVICE"
fi

# 3. Stale locks: the watcher syncs every 60s and its operations take
# seconds, so a lock older than 10 minutes is orphaned (killed process,
# wedged watcher, or crash). Age alone decides; a live-process check would
# never fire because the watcher itself always matches it.
for lock in operation sync.lock; do
	f="$HIST_DIR/$lock"
	[ -e "$f" ] || continue
	# `date -r FILE` prints the file's mtime on both BSD and GNU date; `stat` does not agree across them.
	lock_age=$(($(date +%s) - $(date -r "$f" +%s)))
	if [ "$lock_age" -ge 600 ]; then
		rm -f "$f"
		log "removed stale $lock (${lock_age}s old)"
	fi
done

# 4. Encryption declarations: the policy is encrypt-by-default, and a bare
# `{ mode = "track" }` — exactly what `mise dot track` writes — records the
# path as plaintext while any encrypted sibling exists, and publishing stops
# for EVERY path until the declarations agree (2026-11-02: "cannot publish:
# encrypted path … has an unencrypted or invalid version in commit …", 39
# attempts, nothing notified). The repair is deterministic and no edit is
# lost: write the default down and save. A deliberate `encrypt = false` is
# left alone. A heal that cannot run at all is no longer a log line: it is the
# watchdog's own tooling failing, which a worker can fix.
if [ -x "$HEAL" ]; then
	if healed=$("$HEAL" 2>&1); then
		if [ -n "$healed" ]; then
			log "healed encryption declarations: $(tr '\n' ' ' <<<"$healed")"
		fi
	else
		escalate heal-failed "$(tr '\n' ' ' <<<"$healed")"
	fi
else
	escalate heal-failed "the heal tool is missing or not executable: $HEAL"
fi

# 5. Any failing publish or conflict blocks every path while local checkpoints
# wait, and only `mise dot status` says so: the 2026-11-01 outage was silent for
# hours, the 2026-11-02 one for 21, and the 2026-11-04 one notified every five
# minutes from 10:42 to 17:52 without repairing anything. Report whatever error
# the status carries, not just the literal "conflict(s)" (the status boilerplate
# mentions "sync conflicts" unconditionally and must not trigger this).
# When a local checkpoint landed mid-reconcile ("local saved history changed
# while planning; reconcile again"), retry `mise dot sync` and `mise dot pull`
# once before escalating so a transient race heals without spawning an agent.
# Otherwise an omp worker run gets the failure first and resolves a conflict by
# hand (both versions rescued first); the user hears of it only when the worker
# cannot start, runs out of attempts, or meets a secret-scan refusal.
status="$("$MISE_BIN" dot status 2>/dev/null || true)"
stall="$(sed -n 's/.*✗ last error: //p' <<<"$status" | head -1)"
if [[ "${stall:-}" == *"local saved history changed while planning; reconcile again"* ]]; then
	if "$MISE_BIN" dot sync >/dev/null 2>&1 && "$MISE_BIN" dot pull >/dev/null 2>&1; then
		log "cleared stale-plan reconcile race with mise dot sync && mise dot pull"
		status="$("$MISE_BIN" dot status 2>/dev/null || true)"
		stall="$(sed -n 's/.*✗ last error: //p' <<<"$status" | head -1)"
	fi
fi
if [ -z "$stall" ] && grep -q 'conflict(s)' <<<"$status"; then
	stall="sync conflicts are blocking publishing; run mise dot conflicts"
fi
if [ -n "$stall" ]; then
	stall="${stall//\"/}"
	escalate publishing-blocked "$stall"
fi

# 6. `mise dot apply --dry-run` checks that every `[dotfiles]` entry (symlinks,
# copies, templates, and edits) can apply cleanly without writing anything. A
# non-zero exit (conflicting target type, missing source, or broken template)
# escalates to an omp worker to reconcile the target and source by hand.
if ! apply_out="$("$MISE_BIN" dot apply --dry-run 2>&1)"; then
	apply_err="$(tr '\n\r' '  ' <<<"$apply_out")"
	apply_err="${apply_err//\"/}"
	escalate apply-failed "${apply_err:-mise dot apply --dry-run exited non-zero}"
fi

# 7. Manual-save files (autosave = false, like ~/.gitconfig, which tools rewrite
# constantly) never reach history on their own. Save each one once every 24
# hours so history is never more than a day behind. The stamp is only renewed
# when every save succeeded, so a failed save is retried on the next tick.
MANUAL_SAVE_STAMP="$MISE_HISTORY_LOG_DIR/manual-save.stamp"
MANUAL_SAVE_EVERY_S="${MISE_HISTORY_MANUAL_SAVE_EVERY_S:-86400}"
stamp_age=$MANUAL_SAVE_EVERY_S
[ ! -e "$MANUAL_SAVE_STAMP" ] || stamp_age=$(($(date +%s) - $(date -r "$MANUAL_SAVE_STAMP" +%s)))
if [ "$stamp_age" -ge "$MANUAL_SAVE_EVERY_S" ]; then
	manual_ok=1
	while read -r manual_path; do
		[ -n "$manual_path" ] || continue
		# Only a failure is logged: a day's success is the new checkpoint in `mise dot history`.
		if ! "$MISE_BIN" dot save "$manual_path" >/dev/null 2>&1; then
			log "daily save of $manual_path failed"
			manual_ok=0
		fi
	done < <("$MISE_BIN" dot paths 2>/dev/null | awk '$2 == "track" && $3 == "manual-save" {print $1}')
	[ "$manual_ok" = 1 ] && touch "$MANUAL_SAVE_STAMP"
fi

# A tick that escalated nothing clears the attempt ledger, so a failure that
# returns later starts a fresh budget instead of inheriting an exhausted one.
if [ "$escalated" = 0 ]; then
	"$REPAIR" --clear >/dev/null 2>&1 || true
fi
