#!/usr/bin/env bash
set -euo pipefail
# Code generated by `mise run generate`. DO NOT EDIT.
# Source of truth: profile.pkl

# stylelint --fix. Exit 2 = problems left for push; 78 = no config here.
(($#)) || exit 0
root="$(cd "$(git rev-parse --show-toplevel)" && pwd -P)"

# The nearest directory at or above file $1, up to the repo root, that holds a
# file matching glob $2. Prints nothing when there is none.
nearest_up() {
	local dir
	dir="$(cd "$(dirname "$1")" && pwd -P)"
	while :; do
		if compgen -G "${dir}/$2" >/dev/null; then
			echo "${dir}"
			return 0
		fi
		if [[ "${dir}" == "${root}" || "${dir}" == / ]]; then return 0; fi
		dir="$(dirname "${dir}")"
	done
}

# Absolute path of a staged file.
absolute() {
	echo "$(cd "$(dirname "$1")" && pwd -P)/$(basename "$1")"
}

if [[ -x "${root}/node_modules/.bin/stylelint" ]]; then
	stylelint="${root}/node_modules/.bin/stylelint"
elif command -v stylelint >/dev/null 2>&1; then
	stylelint="$(command -v stylelint)"
else
	exit 0
fi
# Under $HOME, stylelint's cosmiconfig walks up from the repo (so a repo config
# wins) and falls back to ~/.stylelintrc.json. Outside $HOME (e.g. /tmp), exit
# 78 falls back to the profile's config/stylelintrc.json when present.
profile_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
profile_cfg="${profile_dir}/config/stylelintrc.json"
[[ -f "${profile_cfg}" ]] || profile_cfg="${profile_dir}/stylelintrc.json"
code=0
out="$("${stylelint}" --fix --allow-empty-input "$@" 2>&1)" || code=$?
if [[ "${code}" -eq 78 && -f "${profile_cfg}" ]]; then
	code=0
	out="$("${stylelint}" --config "${profile_cfg}" --fix --allow-empty-input "$@" 2>&1)" || code=$?
fi
if [[ "${code}" -gt 2 && "${code}" -ne 78 ]]; then
	[[ -z "${out}" ]] || printf '%s\n' "${out}" >&2
	exit "${code}"
fi
