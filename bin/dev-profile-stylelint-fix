#!/usr/bin/env bash
set -euo pipefail
# Code generated by `mise run generate`. DO NOT EDIT.
# Source of truth: profile.pkl

# stylelint --fix. Exit 2 = problems left for push; 78 = no config here.
(($#)) || exit 0
root="$(cd "$(git rev-parse --show-toplevel)" && pwd -P)"

# The nearest directory at or above file $1, up to the repo root, that holds a
# file matching glob $2. Prints nothing when there is none.
nearest_up() {
	local dir
	dir="$(cd "$(dirname "$1")" && pwd -P)"
	while :; do
		if compgen -G "${dir}/$2" >/dev/null; then
			echo "${dir}"
			return 0
		fi
		if [[ "${dir}" == "${root}" || "${dir}" == / ]]; then return 0; fi
		dir="$(dirname "${dir}")"
	done
}

# Absolute path of a staged file.
absolute() {
	echo "$(cd "$(dirname "$1")" && pwd -P)/$(basename "$1")"
}

if [[ -x "${root}/node_modules/.bin/stylelint" ]]; then
	stylelint="${root}/node_modules/.bin/stylelint"
elif command -v stylelint >/dev/null 2>&1; then
	stylelint="$(command -v stylelint)"
else
	exit 0
fi
code=0
"${stylelint}" --fix --allow-empty-input "$@" || code=$?
[[ "${code}" -le 2 || "${code}" -eq 78 ]] || exit "${code}"
