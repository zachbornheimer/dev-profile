#!/usr/bin/env bash
set -euo pipefail

# dev-profile-semgrep <files…>: scan the given files with the Semgrep registry
# TypeScript pack (p/typescript) and fail on any finding.
# The pack is cached for a week so a commit never waits on semgrep.dev; when the
# registry is unreachable a stale copy is used. Only a machine that has never
# fetched the pack fails, with the fix printed. Runs the OSS engine, so a
# logged-in Pro install and a plain pinned install judge the same way.
# A scan that outlives DEV_PROFILE_SEMGREP_TIMEOUT seconds (default 120) fails
# the step: a hung scan must not hang every commit, and must not pass either.
[[ $# -gt 0 ]] || exit 0
cache="${XDG_CACHE_HOME:-${HOME}/.cache}/dev-profile/semgrep"
rules="${cache}/typescript.yml"
mkdir -p "${cache}"
export SEMGREP_LOG_FILE="${SEMGREP_LOG_FILE:-${cache}/semgrep.log}"
export SEMGREP_SETTINGS_FILE="${SEMGREP_SETTINGS_FILE:-${cache}/settings.yml}"
if [[ ! -s "${rules}" || -z "$(find "${rules}" -mtime -7 2>/dev/null)" ]]; then
	tmp="$(mktemp "${rules}.XXXXXX")"
	if curl -fsSL --connect-timeout 3 --max-time 20 -o "${tmp}" "https://semgrep.dev/c/p/typescript" && [[ -s "${tmp}" ]]; then
		mv "${tmp}" "${rules}"
	else
		rm -f "${tmp}"
		# Offline: keep the stale copy and wait another week before retrying,
		# so each commit does not pay the connect timeout again.
		[[ ! -s "${rules}" ]] || touch "${rules}"
	fi
fi
if [[ ! -s "${rules}" ]]; then
	echo "dev-profile-semgrep: no cached rules at ${rules} and https://semgrep.dev/c/p/typescript is unreachable. Connect once and retry, or skip hooks for this commit with HK=0." >&2
	exit 1
fi
limit="${DEV_PROFILE_SEMGREP_TIMEOUT:-120}"
semgrep scan --oss-only --config "${rules}" --metrics=off --disable-version-check --quiet --error "$@" &
scan=$!
# The bare hook PATH has no timeout(1), so the watchdog is a subshell.
(
	sleep "${limit}"
	pkill -TERM -P "${scan}" 2>/dev/null || true
	kill -TERM "${scan}" 2>/dev/null || true
) &
watch=$!
code=0
wait "${scan}" || code=$?
if kill -0 "${watch}" 2>/dev/null; then
	pkill -P "${watch}" 2>/dev/null || true
	kill "${watch}" 2>/dev/null || true
	exit "${code}"
fi
echo "dev-profile-semgrep: the scan exceeded ${limit}s and was stopped. Retry the commit, or skip hooks for this commit with HK=0." >&2
exit 1
