#!/usr/bin/env bash
set -euo pipefail
# Code generated by `mise run generate`. DO NOT EDIT.
# Source of truth: profile.pkl

# Contract adapter: perl. Exit 0 ok, 1 failed, 3 nothing to do.
verb="${1:?usage: dev-profile-contract-perl <verb>}"
failed=0

# Run one tool; record a failure and keep going so every check reports.
step() {
	echo "+ $*" >&2
	"$@" || failed=1
}

nothing_to_do() {
	exit 3
}

case "${verb}" in
test)
	[[ -d t ]] || nothing_to_do
	step prove -lr t
	;;
*) nothing_to_do ;;
esac
exit "${failed}"
