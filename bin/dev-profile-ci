#!/usr/bin/env bash
set -uo pipefail
# Code generated by `mise run generate`. DO NOT EDIT.
# Source of truth: profile.pkl
# Run every ci verb (repo overrides included), then fail if any failed.
failed=()
for verb in lint test scan; do
	mise run "${verb}" || failed+=("${verb}")
done
if [[ "${#failed[@]}" -gt 0 ]]; then
	echo "ci failed: ${failed[*]}" >&2
	exit 1
fi
echo "ci ok"
