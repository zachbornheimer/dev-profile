!/.github/zizmor.yml
!/profile.pkl
!/conform.lua
!/dev-relay.mjs
!/lib/
!/lib/*.pkl
!/tools/
!/tools/*/
!/tools/*/*.pkl
!/tests/
!/tests/*.sh
!/tests/*.pkl
!/tests/*.pcf
!/tests/kitty_tabs.py
!/tests/contract/
!/tests/contract/*.sh
!/tests/guards/
!/tests/guards/*.sh
!/docs/
!/docs/design/
!/docs/design/*
!/hk/
!/hk/*
!/config/
!/config/*
!/shell/
!/shell/**
!/nvim/
!/nvim/**
!/bin/
!/bin/**
!/kitty/
!/kitty/**
!/agents/
!/agents/**
!/home/
!/home/**
!/apps/
!/apps/**
!/more/
!/more/**
!/vim/
!/vim/**
!/xdg/
!/xdg/**
__pycache__/
*.pyc
.DS_Store
agents/hooks/state/
agents/learnings/launch.log
agents/learnings/handoffs/*.prompt.md
apps/opencode/service.json
home/ssh/known_hosts
