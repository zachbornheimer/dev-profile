# Sources only. `mise run generate` writes outputs to ~/.local/share/dev-profile.
*
!/.gitignore
!/README.md
!/mise.toml
!/action.yml
!/mise-tasks/
!/mise-tasks/*
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml
!/profile.pkl
!/conform.lua
!/lib/
!/lib/*.pkl
!/tools/
!/tools/*/
!/tools/*/*.pkl
!/tests/
!/tests/*.sh
!/tests/*.pkl
!/tests/*.pcf
