{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/correction-report.schema.json",
  "title": "UI Decomposition Correction Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewPass",
    "baseDecompositionSha256",
    "resultDecompositionSha256",
    "resolutions"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "reviewPass": { "type": "integer", "minimum": 1, "maximum": 2 },
    "baseDecompositionSha256": { "$ref": "#/$defs/sha256" },
    "resultDecompositionSha256": { "$ref": "#/$defs/sha256" },
    "resolutions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/resolution" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "locator"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "source-location",
            "selector",
            "design-node",
            "visible-text",
            "rendered-region",
            "interaction-trace",
            "other"
          ]
        },
        "source": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findingId", "disposition", "rationale", "affectedIds", "evidence"],
      "properties": {
        "findingId": { "$ref": "#/$defs/id" },
        "disposition": {
          "type": "string",
          "enum": ["applied", "rejected-source-contradicts"]
        },
        "rationale": { "type": "string", "minLength": 1 },
        "affectedIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    }
  }
}
