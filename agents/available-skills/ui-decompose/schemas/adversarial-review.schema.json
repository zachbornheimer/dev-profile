{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/adversarial-review.schema.json",
  "title": "Adversarial UI Decomposition Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewPass",
    "reviewedArtifacts",
    "changeRequested",
    "certification",
    "summary",
    "sourceFilesInspected",
    "surfaceAudits",
    "findings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1"
    },
    "reviewPass": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "reviewedArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestSha256", "decompositionSha256"],
      "properties": {
        "requestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "decompositionSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "changeRequested": {
      "type": "boolean"
    },
    "certification": {
      "type": "string",
      "enum": ["complete", "incomplete"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "sourceFilesInspected": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "surfaceAudits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/surfaceAudit"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "locator"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "source-location",
            "selector",
            "design-node",
            "visible-text",
            "rendered-region",
            "interaction-trace",
            "other"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "surfaceAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auditKey",
        "observedName",
        "observedType",
        "matchedSurfaceId",
        "evidence",
        "nodeAudits",
        "stateAudits",
        "interactionAudits"
      ],
      "properties": {
        "auditKey": {
          "$ref": "#/$defs/id"
        },
        "observedName": {
          "type": "string",
          "minLength": 1
        },
        "observedType": {
          "type": "string",
          "minLength": 1
        },
        "matchedSurfaceId": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "nodeAudits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entityAudit"
          }
        },
        "stateAudits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entityAudit"
          }
        },
        "interactionAudits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entityAudit"
          }
        }
      }
    },
    "entityAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auditKey", "observedName", "matchedId", "evidence"],
      "properties": {
        "auditKey": {
          "$ref": "#/$defs/id"
        },
        "observedName": {
          "type": "string",
          "minLength": 1
        },
        "matchedId": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "targetId", "instructions"],
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "add-surface",
            "add-node",
            "add-state",
            "add-interaction",
            "update",
            "remove",
            "split-node",
            "merge-nodes",
            "reparent",
            "resolve-unresolved",
            "inspect-source",
            "other"
          ]
        },
        "targetId": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "instructions": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "category",
        "description",
        "affectedIds",
        "evidence",
        "requiredChanges"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "severity": {
          "type": "string",
          "enum": ["blocking", "major", "minor"]
        },
        "category": {
          "type": "string",
          "enum": [
            "missing-surface",
            "missing-node",
            "under-decomposed-node",
            "incorrect-hierarchy",
            "missing-state",
            "missing-interaction",
            "missing-target-surface",
            "missing-visible-content",
            "missing-evidence",
            "unsupported-inference",
            "duplicate-or-ambiguous-ownership",
            "resolvable-unresolved",
            "uninspected-source",
            "scope-error",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "affectedIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "requiredChanges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/change"
          }
        }
      }
    }
  }
}
