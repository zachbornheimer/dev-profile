#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = []
# ///
"""Run the learn-from-transcript workflow on one session.

Both /learn (the omp command) and the agent-hooks question pipeline's learn effect call
this. The source is `<harness>:<id>` (omp, claude, codex, grok, cursor,
copilot, opencode, pi, hermes, agentmux), a bare omp id, or a Mastra thread
(`mastra:thread:<id>` or a Studio thread URL). The workflow resolves and
annotates the transcript, runs its forensics passes in one thread, saves the
thread, and files and dispatches every ticket it names as an atask objective by
default (pass --no-dispatch to file/report without starting workers). When
started on macOS and the fleet host (backend.ai.lan.zachandaj.com) is reachable,
it streams any local session transcript to the fleet and runs the workflow on
the fleet; when triggered on the fleet, it runs there directly.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

LEARNINGS_DIR = Path.home() / ".agents" / "learnings"
LAUNCH_LOG = LEARNINGS_DIR / "launch.log"
REF = re.compile(r"^([a-z][a-z0-9_-]*):([A-Za-z0-9._-]+)$")
HARNESSES = frozenset(
    {"omp", "claude", "codex", "grok", "cursor", "copilot", "opencode", "pi", "hermes", "agentmux"}
)
BARE_OMP_ID = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
MASTRA_REF = re.compile(r"^mastra:thread:([^\s:]+)$")
MASTRA_URL = re.compile(r"^https?://[^\s/?#]+/agents/[^\s/?#]+/threads/([^\s/?#:]+)/?(?:[?#]\S*)?$")
RUN_TIMEOUT_SECS = 2 * 60 * 60


def source_of(word: str) -> str | None:
    """The source the workflow accepts: a harness id, a bare omp id, or a Mastra thread ref."""
    text = word.strip()
    if BARE_OMP_ID.match(text):
        return f"omp:{text}"
    match = REF.match(text)
    if match and match.group(1) in HARNESSES:
        return text
    if MASTRA_REF.match(text):
        return text
    url = MASTRA_URL.match(text)
    if url:
        return f"mastra:thread:{url.group(1)}"
    return None


def release_stamp() -> None:
    """Drop the cooldown stamp a failed hook-launched run claimed, so the session can retry."""
    stamp = os.environ.get("LEARN_STAMP_FILE", "").strip()
    if not stamp:
        return
    try:
        Path(stamp).unlink(missing_ok=True)
    except OSError:
        pass


def error_excerpt(output: str, limit: int = 800) -> str:
    """Keep the tail of stderr where the fatal exception sits, plus the head when clipped."""
    text = output.strip()
    if len(text) <= limit:
        return text
    head = limit // 4
    tail = limit - head - 5
    return f"{text[:head]}\n...\n{text[-tail:]}"


def fail(message: str) -> None:
    release_stamp()
    print(f"learn-launch: {message}", file=sys.stderr)
    raise SystemExit(1)

def workflow_argv(source: str, dispatch: bool) -> list[str]:
    payload = {"source": source, "dispatch": dispatch}
    return ["capability", "run", "learn-from-transcript", "--input", json.dumps(payload)]


def record(entry: dict, mirror_fleet: bool = False) -> None:
    LEARNINGS_DIR.mkdir(parents=True, exist_ok=True)
    line = json.dumps(entry) + "\n"
    with LAUNCH_LOG.open("a", encoding="utf-8") as handle:
        handle.write(line)
    if mirror_fleet:
        try:
            subprocess.run(
                ["ssh", "-o", "ConnectTimeout=5", "-o", "BatchMode=yes", FLEET_HOST, "mkdir -p ~/.agents/learnings && cat >> ~/.agents/learnings/launch.log"],
                input=line,
                text=True,
                capture_output=True,
                timeout=10,
                check=False,
            )
        except OSError:
            pass
FLEET_HOST = os.environ.get("LEARN_FLEET_HOST", "backend.ai.lan.zachandaj.com")


def shlex_quote(value: str) -> str:
    return "'" + value.replace("'", "'\"'\"'") + "'"


def find_local_transcript(source: str, home: Path | None = None) -> Path | None:
    """Locate a local session transcript under ``home`` so a laptop launch can stream it to the fleet."""
    base = home or Path.home()
    match = REF.match(source)
    if not match:
        return None
    harness, sid = match.group(1), match.group(2)
    patterns: list[str] = []
    if harness == "omp":
        patterns.append(f".omp/agent/sessions/*/*_{sid}.jsonl")
    elif harness == "claude":
        patterns.extend([f".config/agentmux/transcripts/claude-code.{sid}.jsonl", f".claude/projects/*/{sid}.jsonl"])
    elif harness == "grok":
        patterns.extend([f".config/agentmux/transcripts/grok.{sid}.jsonl", f".grok/sessions/*/{sid}/chat_history.jsonl"])
    elif harness == "codex":
        patterns.extend([f".config/agentmux/transcripts/codex.{sid}.jsonl", f".codex/sessions/*/*/*/rollout-*-{sid}.jsonl"])
    elif harness == "pi":
        patterns.append(f".pi/agent/sessions/*/*_{sid}.jsonl")
    for pattern in patterns:
        hits = sorted(base.glob(pattern), key=lambda p: p.stat().st_mtime if p.is_file() else 0, reverse=True)
        for hit in hits:
            if hit.is_file():
                return hit
    return None


def sync_local_transcript_to_fleet(source: str, host: str = FLEET_HOST, home: Path | None = None) -> bool:
    """Stream a laptop-local transcript to the same ``$HOME``-relative path on the fleet.

    An omp session kept only in the session database is fetched from there and sent to the
    path omp recorded for it, so the fleet finds it exactly where a file-backed session would be.
    """
    base = home or Path.home()
    local_file = find_local_transcript(source, base)
    target = local_file
    if local_file is None:
        local_file, target = stored_omp_transcript(source)
    if local_file is None or target is None:
        return False
    try:
        rel = target.relative_to(base).as_posix()
    except ValueError:
        return False
    remote_dir = shlex_quote(str(Path(rel).parent.as_posix()))
    remote_rel = shlex_quote(rel)
    try:
        with local_file.open("rb") as handle:
            res = subprocess.run(
                ["ssh", "-o", "ConnectTimeout=5", "-o", "BatchMode=yes", host, f"mkdir -p ~/{remote_dir} && cat > ~/{remote_rel}"],
                stdin=handle,
                capture_output=True,
                timeout=30,
                check=False,
            )
        return res.returncode == 0
    except OSError:
        return False


def stored_omp_transcript(source: str) -> tuple[Path | None, Path | None]:
    """(a local copy, omp's recorded path) for an ``omp:<id>`` session held only in the session database."""
    match = REF.match(source)
    if not match or match.group(1) != "omp":
        return None, None
    sys.path.insert(0, str(Path.home() / ".agents" / "hooks" / "lib"))
    from omp_session_store import readable_transcript, stored_session_path

    recorded = stored_session_path(match.group(2))
    if recorded is None:
        return None, None
    return readable_transcript(recorded), Path(recorded)


def fleet_command(source: str, dispatch: bool, platform: str | None = None, host: str = FLEET_HOST) -> list[str] | None:
    """When invoked on macOS and the fleet box is reachable, offload execution to the fleet."""
    active_platform = platform or sys.platform
    if active_platform != "darwin" or os.environ.get("LEARN_ON_FLEET", "1") == "0":
        return None
    probe = subprocess.run(
        ["ssh", "-o", "ConnectTimeout=3", "-o", "BatchMode=yes", host, "test -x ~/.local/bin/capability"],
        capture_output=True,
        timeout=5,
        check=False,
    )
    if probe.returncode != 0:
        return None
    sync_local_transcript_to_fleet(source, host=host)
    payload = json.dumps({"source": source, "dispatch": dispatch})
    remote_cmd = (
        "if [ -r ~/.config/agent-state/env ]; then set -a; . ~/.config/agent-state/env; set +a; fi; "
        "if [ -z \"${OP_SERVICE_ACCOUNT_TOKEN:-}\" ] && [ -s ~/.config/dev-env/secrets/op-service-account-token ]; then "
        "export OP_SERVICE_ACCOUNT_TOKEN=\"$(cat ~/.config/dev-env/secrets/op-service-account-token)\"; fi; "
        "export PATH=\"$HOME/Developer/Personal/dev-profile/bin:$HOME/.local/bin:$HOME/.local/share/aube/bin:$HOME/.local/share/mise/shims:$HOME/.bun/bin:$PATH\"; "
        "export LEARNER=1 AGENTMUX_NESTED_RUN=1; "
        f"bun ~/.local/bin/capability run learn-from-transcript --input {shlex_quote(payload)}"
    )
    return ["ssh", "-o", "BatchMode=yes", host, remote_cmd]


def load_agent_state_env() -> dict[str, str]:
    loaded: dict[str, str] = {}
    env_file = Path.home() / ".config" / "agent-state" / "env"
    if env_file.is_file():
        for raw in env_file.read_text(encoding="utf-8", errors="ignore").splitlines():
            line = raw.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            if line.startswith("export "):
                line = line[len("export ") :].strip()
            key, _, val = line.partition("=")
            val = val.strip().strip("'").strip('"')
            if key.strip():
                loaded[key.strip()] = val
    op_token_file = Path.home() / ".config" / "dev-env" / "secrets" / "op-service-account-token"
    if "OP_SERVICE_ACCOUNT_TOKEN" not in loaded and op_token_file.is_file():
        token = op_token_file.read_text(encoding="utf-8", errors="ignore").strip()
        if token:
            loaded["OP_SERVICE_ACCOUNT_TOKEN"] = token
    return loaded

def main() -> None:
    parser = argparse.ArgumentParser(description="Run learn-from-transcript on one session.")
    parser.add_argument("ref", help="<harness>:<id>, a bare omp id, mastra:thread:<id>, or a Studio thread URL")
    parser.add_argument("--reason", default="manual /learn", help="why the run started; recorded only")
    parser.add_argument(
        "--dispatch",
        action=argparse.BooleanOptionalAction,
        default=True,
        help="start a start_atask_task worker for every objective atask will claim (default: enabled; --no-dispatch to disable)",
    )
    parser.add_argument("--dry-run", action="store_true", help="print the plan without running the workflow")
    args = parser.parse_args()

    source = source_of(args.ref)
    if source is None:
        fail(f"ref must be <harness>:<id> or a Mastra thread URL, got {args.ref!r}")
    plan = {"source": source, "dispatch": args.dispatch, "command": workflow_argv(source, args.dispatch)}
    if args.dry_run:
        print(json.dumps(plan))
        return

    extra_path = f"{Path.home() / 'Developer/Personal/dev-profile/bin'}:{Path.home() / '.local/bin'}:{Path.home() / '.local/share/aube/bin'}:{Path.home() / '.local/share/mise/shims'}:{Path.home() / '.bun/bin'}"
    current_path = os.environ.get("PATH", "/usr/bin:/bin")
    child_env = {
        **load_agent_state_env(),
        **os.environ,
        "PATH": f"{extra_path}:{current_path}",
        "LEARNER": "1",
        "AGENTMUX_NESTED_RUN": "1",
        "OMP_REMOTE": os.environ.get("OMP_REMOTE") or ("0" if os.environ.get("LEARN_ON_FLEET") == "0" else "auto"),
    }
    offloaded = fleet_command(source, args.dispatch)
    exec_cmd = offloaded or plan["command"]
    try:
        run = subprocess.run(
            exec_cmd,
            capture_output=True,
            text=True,
            timeout=RUN_TIMEOUT_SECS,
            env=child_env,
        )
    except OSError as exc:
        fail(f"could not start capability CLI: {exc}")
    if run.returncode != 0:
        detail = error_excerpt(run.stderr or run.stdout or "")
        fail(f"learn-from-transcript failed ({run.returncode}): {detail}")
    try:
        results = json.loads(run.stdout)
    except ValueError:
        fail(f"learn-from-transcript printed non-JSON: {run.stdout[:200]!r}")
    if not isinstance(results, list):
        fail(f"learn-from-transcript returned a non-list result: {run.stdout[:200]!r}")
    record(
        {"at": datetime.now(timezone.utc).isoformat(), "reason": args.reason, "executed_on": FLEET_HOST if offloaded else "local", **plan, "tickets": results},
        mirror_fleet=offloaded is not None,
    )
    print(run.stdout, end="")


if __name__ == "__main__":
    main()
