#!/bin/sh
# Wait until a terminal pane shows a pattern or an idle agent prompt. See ~/.omp/agent/extensions/mux/pane_wait.ts.
#
# Deployed to ~/.local/bin/mux-wait (config/mise.toml), so `command -v mux-wait` succeeds on the plain PATH a session
# inherits with no shell activation: a refusal that names this command must name one that resolves (ZYS-9797).
# Outside a multiplexer there is no pane to watch, so the pane-wait refusal is followed by the call that does work
# here, `bash` async plus `wait`, instead of leaving the reader at a command this host cannot run.
pane_wait="$HOME/.omp/agent/extensions/mux/pane_wait.ts"
out=$(bun "$pane_wait" "$@" 2>&1)
code=$?
printf '%s\n' "$out"
if [ "$code" -eq 2 ] && printf '%s' "$out" | grep -q 'not inside a supported multiplexer'; then
	echo "mux-wait: no pane (tern, herdr or tmux) surrounds this process. Run the work as its own \`bash\` call with \`async: true\`, then block on it with \`wait { job_id, timeout_seconds }\`; its completion also arrives as omp's own result message." >&2
fi
exit "$code"
