#!/usr/bin/env bash
# pkill-aged: signal matching processes, but only ones older than a minimum age.
#
# macOS pkill has no age limit (Linux `pkill -O` has no BSD equivalent), and an
# unscoped `pkill -f <pattern>` also hits other sessions' brand-new children,
# such as a `wt step commit` that is mid-write. This wrapper selects with
# `pgrep`, reads each process age from `ps`, and signals only the old ones.
# It never signals itself or any of its ancestors (a shell whose command line
# contains the pattern).
#
# Usage: pkill-aged [-f] [-x] [-i] [-O MIN_AGE_SECONDS] [-s SIGNAL | -SIGNAL] PATTERN
#
# Exit status follows pkill: 0 when something was signaled, 1 when nothing was,
# 2 on a usage error.
set -euo pipefail

readonly PROGRAM="pkill-aged"
readonly DEFAULT_MIN_AGE_SECONDS=300
readonly DEFAULT_SIGNAL="TERM"
readonly MIN_AGE_ENV="PKILL_AGED_MIN_SECONDS"
readonly EXIT_SIGNALED=0
readonly EXIT_NOTHING_SIGNALED=1
readonly EXIT_USAGE=2
readonly SECONDS_PER_MINUTE=60
readonly SECONDS_PER_DAY=86400

usage_error() {
	echo "${PROGRAM}: $1" >&2
	echo "usage: ${PROGRAM} [-f] [-x] [-i] [-O MIN_AGE_SECONDS] [-s SIGNAL | -SIGNAL] PATTERN" >&2
	exit "${EXIT_USAGE}"
}

# Space-delimited PIDs of this process and every ancestor, e.g. " 41 7 1 ".
ancestor_pids() {
	local pid=$$ chain=" "
	while [[ -n ${pid} && ${pid} -gt 1 ]]; do
		chain+="${pid} "
		pid=$(ps -o ppid= -p "${pid}" 2>/dev/null | tr -d ' ') || break
	done
	echo "${chain}"
}

# Age in whole seconds from ps etime ([[dd-]hh:]mm:ss); empty if the process is gone.
age_seconds() {
	ps -o etime= -p "$1" 2>/dev/null | awk \
		-v minute="${SECONDS_PER_MINUTE}" -v day="${SECONDS_PER_DAY}" '
		NF {
			clock = $1; days = 0
			if (split($1, dayParts, "-") == 2) { days = dayParts[1]; clock = dayParts[2] }
			fields = split(clock, clockParts, ":"); seconds = 0
			for (i = 1; i <= fields; i++) seconds = seconds * minute + clockParts[i]
			print days * day + seconds
		}'
}

min_age=${!MIN_AGE_ENV:-${DEFAULT_MIN_AGE_SECONDS}}
signal=${DEFAULT_SIGNAL}
match_flags=()

while (($#)); do
	if [[ $1 =~ ^-[fxi]+$ ]]; then
		match_flags+=("$1")
	elif [[ $1 == -O ]]; then
		(($# >= 2)) || usage_error "-O needs a number of seconds"
		min_age=$2
		shift
	elif [[ $1 == -s ]]; then
		(($# >= 2)) || usage_error "-s needs a signal"
		signal=$2
		shift
	elif [[ $1 =~ ^-[A-Z0-9]+$ ]]; then
		signal=${1#-}
	elif [[ $1 == -- ]]; then
		shift
		break
	elif [[ $1 == -* ]]; then
		usage_error "unsupported option $1"
	else
		break
	fi
	shift
done

(($# == 1)) || usage_error "expected exactly one PATTERN"
[[ ${min_age} =~ ^[0-9]+$ ]] || usage_error "minimum age must be whole seconds, got '${min_age}'"
pattern=$1

excluded=$(ancestor_pids)
signaled=0
skipped_young=0

while read -r pid; do
	[[ -n ${pid} && ${excluded} != *" ${pid} "* ]] || continue
	age=$(age_seconds "${pid}")
	[[ -n ${age} ]] || continue
	if ((age < min_age)); then
		skipped_young=$((skipped_young + 1))
	elif kill "-${signal}" "${pid}" 2>/dev/null; then
		signaled=$((signaled + 1))
	fi
done < <(pgrep ${match_flags[@]+"${match_flags[@]}"} -- "${pattern}" || true)

echo "${PROGRAM}: signaled ${signaled}, spared ${skipped_young} younger than ${min_age}s" >&2
((signaled > 0)) && exit "${EXIT_SIGNALED}"
exit "${EXIT_NOTHING_SIGNALED}"
