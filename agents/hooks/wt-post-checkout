#!/bin/bash
# git post-checkout dispatcher: bootstrap a worktree at creation, wt-natively.
# post-checkout receives a null prior HEAD and flag 1 exactly when git creates a
# worktree, never on ordinary checkouts. Registered globally in ~/.gitconfig as
# hook.wt-worktree-bootstrap (git 2.54+ config-defined hooks; coexists with the
# hk stanzas and any repo-local hooks). Every creator fires this — wt, Claude
# Code, herdr, plain `git worktree add` — and Worktrunk's global config owns
# what happens: only the named user pre-start hook runs (`pre-start user:copy`,
# the name Worktrunk's config gives it), so agent worktrees skip the dev-server
# post-start entirely.
[ "${3:-}" = "1" ] || exit 0
[ "${1:-}" = "0000000000000000000000000000000000000000" ] || exit 0
cd "$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
# atask provisions its own task worktrees. `atask claim` builds atask/<id> and
# then copies the source checkout's ignored dependencies into it itself
# (ai-task internal/workspace/manager.go, CopyIgnored), which its own comment
# assumes is not doubled by Worktrunk's post-start hook. Left in, this fires on
# top of that copy for every claim: a second clone of the whole ignored tree
# (26k files, 333MB in capability-replicas) behind Worktrunk's serialized hook
# path. Under a handful of concurrent claims that is minutes per claim, and a
# claim that outlives atask's five-minute ClaimWindow always fails — it is what
# takes `atask claim` past the capability's bound.
case "$(git symbolic-ref --short HEAD 2>/dev/null)" in
atask/*) exit 0 ;;
esac
command -v wt >/dev/null 2>&1 || exit 0
wt hook pre-start user:copy
