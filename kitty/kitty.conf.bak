# Kitty — calm by default. Color is reserved for meaning (red = error, green = ok,
# etc.), desaturated so nothing shouts; the UI chrome itself is near-monochrome.

#: Font
font_family      Ioskeley Mono
bold_font        auto
italic_font      auto
bold_italic_font auto
font_size        14.0

#: Window & chrome (quiet)
window_padding_width    1
background_blur         32
window_border_width     1px
draw_minimal_borders    no
macos_thin_strokes      yes
macos_option_as_alt     yes
# macos_titlebar_color    background
confirm_os_window_close 1
cursor_shape            block
cursor_blink_interval   0
enable_audio_bell       no

background_opacity 0.8

#: URL opening — cmd+click to open; ctrl+shift+e for keyboard picker
open_url_with           default
open_url_modifiers      cmd

#: Tab bar — powerline gives clear active/inactive hierarchy; colors come from theme
tab_bar_edge            bottom
tab_bar_style           powerline
tab_powerline_style     angled
active_tab_font_style   bold
inactive_tab_font_style normal

#: New tabs/windows inherit the current directory (via shell integration)
map cmd+t        new_tab_with_cwd
map cmd+enter    new_window_with_cwd
map cmd+n        new_os_window_with_cwd
#: Rename current tab — prompts for a title (popup at the top of the window).
#: Built-in default is also cmd+shift+i (macOS) / ctrl+shift+alt+t.
map cmd+shift+r  set_tab_title


#: --- Last-command capture + browse output in nvim (kitty-scrollback.nvim) ---
#: action_alias must be defined before any map that uses it. The kitten path is
#: the one the nvim plugin generated (:KittyScrollbackGenerateKittens).
action_alias kitty_scrollback_nvim kitten /Users/zbornheimer/.local/share/nvim/lazy/kitty-scrollback.nvim/python/kitty_scrollback_nvim.py
map cmd+shift+o  copy_last_command_output
map cmd+shift+g  kitty_scrollback_nvim --config ksb_builtin_last_cmd_output

#: --- Open file paths from terminal output in nvim (new tab) ---
#: Clicking a hyperlinked path opens nvim via open-actions.conf. But kitty only
#: makes paths clickable when a program emits them as real hyperlinks (OSC 8) —
#: bare paths in grep/compiler output are not. These cover those: they highlight
#: every path on screen so you pick one with a key.
#:   cmd+shift+e — path WITH a line number (grep, stack traces, file:line) →
#:                 nvim opens at that line, in a new tab.
#:   cmd+shift+f — any plain path → nvim, in a new tab.
map cmd+shift+e  kitten hints --type=linenum --linenum-action=tab nvim +{line} {path}
map cmd+shift+f  kitten hints --type=path --program "launch --type=tab nvim"

#: --- Command-output navigation (the Warp "blocks" feel; uses shell integration) ---
#: Jump to the previous / next command's prompt in the scrollback.
map cmd+up    scroll_to_prompt -1
map cmd+down  scroll_to_prompt 1
#: Browse output in nvim — colors preserved, links clickable, easy copy:
#: cmd+shift+g = last command's output (above) · ctrl+shift+h = full scrollback
#: · ctrl+shift+right-click = a clicked command's output.
map ctrl+shift+h  kitty_scrollback_nvim
mouse_map ctrl+shift+right press ungrabbed combine : mouse_select_command_output : kitty_scrollback_nvim --config ksb_builtin_last_visited_cmd_output

#: --- Notify when a long command finishes in a window you're not looking at ---
notify_on_cmd_finish unfocused 10.0

#: --- Splits: panes within a tab (editor + shell side by side, no tmux) ---
enabled_layouts splits,stack
map cmd+d         launch --location=vsplit --cwd=current
map cmd+shift+d   launch --location=hsplit --cwd=current
map cmd+alt+left  neighboring_window left
map cmd+alt+right neighboring_window right
map cmd+alt+up    neighboring_window up
map cmd+alt+down  neighboring_window down
map cmd+shift+z   toggle_layout stack          # zoom the focused split, toggle back

#: --- Keyboard hints already built in (kitty_mod = ctrl+shift) ---
#: ctrl+shift+e          open a URL without the mouse
#: ctrl+shift+p then h   copy a git SHA / hash   (n = line number, w = word)
#: (the cmd+shift+e / cmd+shift+f maps above route file paths to nvim.)

#: Remote control — allows kitten @ launch to add a tab to a running kitty
#: from the NvimKitty bundle. socket-only restricts it to local Unix socket.
allow_remote_control yes
listen_on unix:/tmp/kitty-$KITTY_PID

# agentmux — Shift+Enter / Ctrl+Enter for agents in tmux
include agentmux-compat.conf


#
# BEGIN_KITTY_THEME
# Rosé Pine Moon
include current-theme.conf
# END_KITTY_THEME

# Browser-inspired tabs
include browser-tabs.conf


