{
  "lastChangelogVersion": "1.3.0",
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "defaultProvider": "openrouter",
  "defaultModel": "openai/gpt-5.6-luna",
  "defaultThinkingLevel": "medium",
  "tuiMode": "fullscreen",
  "quietStartup": "header",
  "hideThinkingBlock": true,
  "telepathy": true,
  "defaultTools": [
    "+codemode",
    "+tool_search",
    "-read",
    "-write",
    "-edit",
    "-bash",
    "-grep",
    "-find",
    "-ls"
  ],
  "shellCommandPrefix": "export AWS_PROFILE=\"sah\"; export AWS_REGION=\"us-east-1\"; export CLAUDE_CODE_SUBAGENT_MODEL=\"sonnet\"; export CLAUDE_CODE_USE_BEDROCK=\"0\"; export QUALITY_GUARD_LOG_FILE=\"/tmp/qg-pretool.log\"; export QUALITY_GUARD_LOG_LEVEL=\"debug\"",
  "enableSkillCommands": true,
  "extensions": [
    "/Users/zbornheimer/.pi/agent/extensions/telepathy.ts",
    "/Users/zbornheimer/.pi/agent/extensions/editor-stash.ts",
    "/Users/zbornheimer/.pi/agent/extensions/decisions.ts",
    "/Users/zbornheimer/.pi/agent/extensions/herdr-tab-agents.ts",
    "+builtin:mcp"
  ],
  "packages": [
    "npm:@maxiaochao/pi-herdr-subagents",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-goal-x",
    "npm:pi-lens",
    "npm:pi-advisor-flow",
    "npm:pi-prefill",
    "npm:@aiwayds/pi-think-panel",
    "npm:pi-zentui"
  ],
  "terminal": {
    "showTerminalProgress": true
  },
  "transport": "auto",
  "markdown": {
    "mermaid": "final"
  },
  "defaultProjectTrust": "always",
  "treeFilterMode": "default",
  "theme": "system"
}
